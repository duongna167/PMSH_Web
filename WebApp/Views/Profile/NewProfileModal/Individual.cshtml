                <h6 class="modal-title mb-0">Search</h6>
            </div>
            <div class="modal-body pt-2">
                <div class="py-2">
                    <button id="pro_search_btnViewIndividual" class="mui-button mui-button-search">Search</button>
                    <button type="button" class="mui-button mui-button-close " data-bs-dismiss="modal"> Close</button>

                </div>
                <div class="row mb-1 align-items-center">
                    <label class="col-sm-2 col-form-label text-end">Search Name</label>
