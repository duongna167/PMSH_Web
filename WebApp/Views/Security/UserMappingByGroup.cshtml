<div class="modal fade" id="grpMap_modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-4by3 modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content modal-full-height">
            <div class="modal-header">
                <h5 class="modal-title">User mapping by group</h5>
            </div>
            <div class="modal-body">
                <div class="sticky-header bg-white p-2 shadow-sm z-3">
                    <div class="pb-2">
                        <button type="button" class="mui-button mui-button-search" id="grpMap_btnOk">OK</button>
                        <button type="button" class="mui-button mui-button-search" id="grpMap_btnSave">Save</button>
                        <button type="button" class="mui-button mui-button-new" id="grpMap_btnClose">Close</button>
                    </div>
                    <div class="rights-type-row pt-1">
                        <span class="fw-bold text-nowrap">Type Rights</span>
                        <label for="grpMap_fn">
                            <input type="radio" name="grpMap_rightsType" id="grpMap_fn" value="0" checked>
                            Functions rights
                        </label>
                        <label for="grpMap_data">
                            <input type="radio" name="grpMap_rightsType" id="grpMap_data" value="1">
                            Data rights
                        </label>
                    </div>
                </div>
                <div class="grpMap-body-row">
                    <div class="grpMap-left">
                        <div id="grpMap_grid" class="gridContainer"></div>
                        <div id="grpMap_users" class="gridContainer"></div>
                    </div>
                    <div class="grpMap-right">
                        <div id="grpMap_tree" class="gridContainer"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
(function (window, $) {
    function rowId(row) {
        if (!row) return 0;
        const v = row.id != null ? row.id : row.ID;
        return parseInt(v, 10) || 0;
    }

    var grpMap_Module = {
        selectedGroupId: 0,
        catalog: { "0": null, "1": null },
        rightsTree: null,
        grantReq: 0,
        init: function () {
            const self = this;
            $("#grpMap_fn").prop("checked", true);
            $("#grpMap_data").prop("checked", false);
            if (!self.rightsTree)
                self.rightsTree = window.SmcRightsTree.bind($("#grpMap_tree"), { caption: "List of group rights" });
            self.bindEvents();
            self.preloadCatalog();
            self.loadGroups();
            self.renderUsers([]);
            if (window.applyPopupRights) {
                window.applyPopupRights("usr_GroupUserRight", { save: "#grpMap_btnSave", ok: "#grpMap_btnOk" });
            }
        },
        bindEvents: function () {
            const self = this;
            $(document).off("click.grpMap", "#grpMap_btnClose").on("click.grpMap", "#grpMap_btnClose", function () {
                $("#grpMap_modal").modal("hide");
            });
            $(document).off("click.grpMap", "#grpMap_btnSave").on("click.grpMap", "#grpMap_btnSave", function () {
                self.save(false);
            });
            $(document).off("click.grpMap", "#grpMap_btnOk").on("click.grpMap", "#grpMap_btnOk", function () {
                self.save(true);
            });
            $(document).off("change.grpMap", "input[name=grpMap_rightsType]").on("change.grpMap", "input[name=grpMap_rightsType]", function () {
                self.loadTree();
            });
            $("#grpMap_modal").off("shown.bs.modal.grpMap").on("shown.bs.modal.grpMap", function () {
                ["#grpMap_grid", "#grpMap_users"].forEach(function (id) {
                    try {
                        const g = $(id).dxDataGrid("instance");
                        if (g) g.updateDimensions();
                    } catch (ex) { }
                });
                if (self.rightsTree) self.rightsTree.updateDimensions();
            });
            $("#grpMap_modal").off("hidden.bs.modal.grpMap").on("hidden.bs.modal.grpMap", function () {
                $(document).off(".grpMap");
                if (self._escHandler) {
                    document.removeEventListener("keydown", self._escHandler, true);
                    self._escHandler = null;
                }
            });
            if (self._escHandler)
                document.removeEventListener("keydown", self._escHandler, true);
            self._escHandler = function (e) {
                if (e.key !== "Escape" && e.keyCode !== 27) return;
                if (!$("#grpMap_modal").hasClass("show")) return;
                if (document.querySelector(".cc-overlay") || document.querySelector(".swal2-container:not(.swal2-hidden)")) return;
                e.preventDefault();
                e.stopPropagation();
                if (typeof e.stopImmediatePropagation === "function") e.stopImmediatePropagation();
                $("#grpMap_modal").modal("hide");
            };
            document.addEventListener("keydown", self._escHandler, true);
        },
        loadGroups: function () {
            const self = this;
            $.get("/UserMapping/MappingGroups", function (data) {
                if (data && data.error) {
                    showToast("Error", data.error, false);
                    return;
                }
                $("#grpMap_grid").dxDataGrid({
                    dataSource: data || [],
                    keyExpr: "id",
                    height: "100%",
                    showBorders: true,
                    showRowLines: true,
                    showColumnLines: true,
                    hoverStateEnabled: true,
                    allowColumnResizing: true,
                    columnAutoWidth: true,
                    selection: { mode: "single" },
                    filterRow: { visible: true },
                    headerFilter: { visible: true },
                    paging: { enabled: false },
                    columns: [
                        { dataField: "name", caption: "User Group", alignment: "left" }
                    ],
                    onSelectionChanged: function (e) {
                        const id = rowId((e.selectedRowsData || [])[0]);
                        if (!id) return;
                        self.selectedGroupId = id;
                        self.loadGroupUsers();
                        self.loadTree();
                    }
                });
            });
        },
        renderUsers: function (data) {
            $("#grpMap_users").dxDataGrid({
                dataSource: data || [],
                keyExpr: "id",
                height: "100%",
                showBorders: true,
                showRowLines: true,
                showColumnLines: true,
                hoverStateEnabled: true,
                allowColumnResizing: true,
                columnAutoWidth: true,
                filterRow: { visible: true },
                paging: { enabled: false },
                columns: [
                    { caption: "No", width: 50, alignment: "center", allowFiltering: false, cellTemplate: function (c, o) { c.text(o.rowIndex + 1); } },
                    { dataField: "loginName", caption: "User List", alignment: "left" }
                ]
            });
        },
        loadGroupUsers: function () {
            const self = this;
            if (!self.selectedGroupId) {
                self.renderUsers([]);
                return;
            }
            $.get("/UserMapping/MappingGroupUsers", { groupId: self.selectedGroupId }, function (data) {
                if (data && data.error) {
                    showToast("Error", data.error, false);
                    self.renderUsers([]);
                    return;
                }
                self.renderUsers(data || []);
            }).fail(function () {
                self.renderUsers([]);
            });
        },
        preloadCatalog: function () {
            const self = this;
            ["0", "1"].forEach(function (isData) {
                if (self.catalog[isData]) return;
                $.get("/UserMapping/Catalog", { isDataRight: isData }, function (items) {
                    if (items && items.error) return;
                    self.catalog[isData] = items || [];
                    if (isData === ($('input[name="grpMap_rightsType"]:checked').val() || "0") && self.rightsTree)
                        self.rightsTree.ensure(self.catalog[isData], isData);
                });
            });
        },
        loadTree: function () {
            const self = this;
            if (!self.selectedGroupId) {
                if (self.rightsTree) self.rightsTree.applyGranted([]);
                return;
            }
            const isData = $('input[name="grpMap_rightsType"]:checked').val() || "0";
            const req = ++self.grantReq;
            const ownerId = self.selectedGroupId;
            const paint = function (catalog) {
                if (req !== self.grantReq) return;
                self.rightsTree.ensure(catalog, isData);
                $.get("/UserMapping/GrantedIds", { ownerId: ownerId, isDataRight: isData, isUser: 0 }, function (ids) {
                    if (req !== self.grantReq) return;
                    if (ids && ids.error) {
                        showToast("Error", ids.error, false);
                        return;
                    }
                    self.rightsTree.applyGranted(ids || []);
                });
            };
            if (self.catalog[isData]) {
                paint(self.catalog[isData]);
                return;
            }
            $.get("/UserMapping/Catalog", { isDataRight: isData }, function (items) {
                if (items && items.error) {
                    showToast("Error", items.error, false);
                    return;
                }
                self.catalog[isData] = items || [];
                paint(self.catalog[isData]);
            });
        },
        save: function (closeAfter) {
            const self = this;
            try {
                const grid = $("#grpMap_grid").dxDataGrid("instance");
                const id = rowId((grid.getSelectedRowsData() || [])[0]);
                if (id) self.selectedGroupId = id;
            } catch (ex) { }
            if (!self.selectedGroupId) {
                showToast("Warning", "Select a group.", false);
                return;
            }
            const isData = $('input[name="grpMap_rightsType"]:checked').val();
            if (!self.rightsTree || !self.rightsTree.isReady()) {
                showToast("Warning", "Rights tree is still loading.", false);
                return;
            }
            const ids = self.rightsTree.collect();
            if (ids == null) {
                showToast("Warning", "Rights tree is still loading.", false);
                return;
            }
            $.post("/UserMapping/SaveGroupRights", {
                groupId: self.selectedGroupId,
                isDataRight: isData,
                ids: ids
            }, function (res) {
                if (res.success) {
                    showToast("Success", res.message, true);
                    if (closeAfter) $("#grpMap_modal").modal("hide");
                } else {
                    showToast("Warning", res.message || "Save failed.", false);
                }
            }).fail(function () {
                showToast("Error", "Save failed.", false);
            });
        }
    };

    window.openModalUserMappingByGroup = function () {
        $("#grpMap_modal").modal("show");
        grpMap_Module.init();
    };
})(window, jQuery);
</script>
