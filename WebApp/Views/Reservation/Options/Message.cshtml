<!-- Modal message-->
<div class="modal fade modal-xl" id="modalMessage" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="staticBackdropLabel">Message Information</h5>
                @* <button type="button" class="btn-close" onclick="closeModalMessage()"></button> *@
            </div>
            <div class="modal-body">
                <div class="py-2">
                    <button class="mui-button mui-button-search" onclick="searchMessage();">Search</button>
                    <button type="button" data-bs-dismiss="modal" class="mui-button mui-button-close">Close</button>

                </div>
                <div class="row" style="margin:0 10px;justify-content:space-between">
                    <style>
                        /* Info: 2 cột, mọi ô cùng chiều rộng / chiều cao; Zone hiển thị đủ chữ */
                        #modalMessage .msg-info { display: grid; grid-template-columns: 70px 1fr 70px 1fr; gap: 6px 10px; align-items: center; padding: 4px 6px 8px; }
                        #modalMessage .msg-info > label { margin: 0; min-width: 0; text-align: right; }
                        #modalMessage .msg-info input, #modalMessage .msg-info select { width: 100%; height: 30px; min-width: 0; font-size: 13px; line-height: 1.4; padding: 2px 8px; box-sizing: border-box; }
                        #modalMessage .msg-info select { padding-right: 24px; text-overflow: ellipsis; }
                    </style>
                    <div class="col-md-6 bg-light border rounded">
                        <label style="text-align:left">Info</label>
                        <div class="msg-info">
                            <label for="confirmationNoMessage">Conf.No</label>
                            <input id="confirmationNoMessage" class="form-control form-control-sm">
                            <label for="zoneMessage">Zone</label>
                            <select id="zoneMessage" class="form-select form-select-sm" asp-items="ViewBag.cboZone"></select>

                            <label for="crsNoMessage">CRS No</label>
                            <input id="crsNoMessage" class="form-control form-control-sm">
                            <label for="nameMessage">Name</label>
                            <input id="nameMessage" class="form-control form-control-sm">

                            <label for="roomNoMessage">Room No</label>
                            <input id="roomNoMessage" class="form-control form-control-sm">
                            <label for="holderMessage">R.Holder</label>
                            <input id="holderMessage" class="form-control form-control-sm">
                        </div>
                    </div>
                    <div class="row col-md-2 row bg-light border rounded" >
                        <label style="text-align:left">Message Status</label>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="messageView" value="1">
                            <label class="form-check-label"style="text-align:left">Received</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="messageView" value="0" checked>
                            <label class="form-check-label"  style="text-align:left" >Not Received</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="printMessageView" value="1">
                            <label class="form-check-label"  style="text-align:left">Printed</label>
                        </div>
                    </div>
                    <div class="row col-md-3 row bg-light border rounded">
                        <label style="text-align:left">Status</label>
                        <div style="display:flex;justify-content:space-between">
                            <div>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="statusMessageView" value="0" checked>
                                    <label class="form-check-label"style="text-align:left">Reservation</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="statusMessageView" value="5" checked>
                                    <label class="form-check-label" style="text-align:left">Due In</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="statusMessageView" value="1" checked>
                                    <label class="form-check-label"  style="text-align:left">In House</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="statusMessageView" value="6" checked>
                                    <label class="form-check-label"  style="text-align:left">Due Out</label>
                                </div>
                             </div>
                            <div >
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="statusMessageView" value="2" checked>
                                    <label class="form-check-label"  style="text-align:left">Checked Out</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="statusMessageView" value="4">
                                    <label class="form-check-label"  style="text-align:left">Waitlist</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="statusMessageView" value="7">
                                    <label class="form-check-label"  style="text-align:left">No Show</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="statusMessageView" value="3">
                                    <label class="form-check-label"  style="text-align:left">Cancellations</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <style>
                    /* Thông tin dòng đang chọn (WinForm để dưới lưới, web đưa lên trên) */
                    #modalMessage .msg-detail { display: flex; flex-wrap: wrap; gap: 8px 20px; align-items: center; margin: 10px 10px 0; padding: 8px 10px; background: #f6f7f9; border: 1px solid #dee2e6; border-radius: 6px; }
                    #modalMessage .msg-detail > div { display: flex; align-items: center; gap: 8px; }
                    #modalMessage .msg-detail label { margin: 0; white-space: nowrap; }
                    #modalMessage .msg-detail input { width: 150px; height: 30px; font-size: 13px; padding: 2px 8px; }
                    #modalMessage .msg-detail input#msgDetailStatus { width: 200px; }
                    #modalMessage #gridContainerMessage { height: 360px; }
                    #modalMessage #msgDetailText { width: 100%; height: 60px; resize: vertical; background: #e9ecef; }
                </style>
                <div class="rs-content-box row" style="gap:0;margin:0 10px">
                    <div id="gridContainerMessage" class="mt-2 gridContainer"></div>
                </div>
                <div class="msg-detail">
                    <div><label for="msgDetailArrival">Arrival</label><input id="msgDetailArrival" class="form-control form-control-sm" readonly></div>
                    <div><label for="msgDetailDeparture">Departure</label><input id="msgDetailDeparture" class="form-control form-control-sm" readonly></div>
                    <div><label for="msgDetailRoomNo">Room No</label><input id="msgDetailRoomNo" class="form-control form-control-sm" readonly></div>
                    <div><label for="msgDetailStatus">Status</label><input id="msgDetailStatus" class="form-control form-control-sm" readonly></div>
                </div>
                <div style="margin:8px 10px 0">
                    <textarea id="msgDetailText" class="form-control form-control-sm" readonly></textarea>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    function openModalMessage(){
        searchMessage();
        $('#modalMessage').modal('show');
    }
    function closeModalMessage(){
        $('#modalMessage').modal('hide');
    }
    function getSelectedStatuses() {
        const checkboxes = document.querySelectorAll('input[name="statusMessageView"]:checked');
        const selectedStatuses = Array.from(checkboxes).map(cb => cb.value).join(',');
        return selectedStatuses;
    }
    function searchMessage() {
        // Lấy và xử lý giá trị trước khi gán vào data
        const name = $('#nameMessage').val() ?? '';
        const reservationHolder = $('#holderMessage').val() ?? '';
        const confirmationNo = $('#confirmationNoMessage').val() ?? '';
        const crsNo = $('#crsNoMessage').val() ?? '';
        const roomNo = $('#roomNoMessage').val() ?? '';
        const zone = $('#zoneMessage').val() ?? '';
        // Checkbox "Printed" không có id (name = printMessageView) → trước đây luôn gửi 0
        const checkboxValue = $('input[name="printMessageView"]').is(':checked') ? '1' : '0';

        $.ajax({
            url: '/Reservation/SearchMessage',
            type: 'get',
            dataType: 'json',
            data: {
                Name: name,
                ReservationHolder: reservationHolder,
                ConfirmationNo: confirmationNo,
                CRSNo: crsNo,
                RoomNo: roomNo,
                Zone: zone,
                Status: getSelectedStatuses(),
                Receive: getSelectedCheckboxes('messageView'),
                Print: checkboxValue
            },
            crossDomain: false,
            headers: { "X-CSRF-TOKEN-HEADERNAME": jQuery("input[name='__RequestVerificationToken']").val() },
            success: function (result) {
                initializeDataGridSearchMessage(result);
            },
            error: function (xhr, statusText, err) {
                if (xhr.status == 401) {
                    sessionTimeout();
                } else {
                    console.error('Error:', err);
                }
            }
        });
    }
    function showMessageDetail(row) {
        row = row || {};
        $('#msgDetailArrival').val(row.ArrivalDate || '');
        $('#msgDetailDeparture').val(row.DepartureDate || '');
        $('#msgDetailRoomNo').val(row.RoomNo || '');
        $('#msgDetailStatus').val(row.Status || '');
        $('#msgDetailText').val(row.Message || '');
    }
    function initializeDataGridSearchMessage(data) {
        if (!Array.isArray(data)) data = [];
        showMessageDetail(null);
        $("#gridContainerMessage").dxDataGrid({
            dataSource: data,
            keyExpr: 'ID',
            // Cột theo WinForm Message Search
            columns: [
                { dataField: 'Date', caption: 'Date', width: 105 },
                { dataField: 'CreateTime', caption: 'Time', width: 85 },
                { dataField: 'Nationality', caption: 'Nat', width: 70 },
                { dataField: 'GuestName', caption: 'Name', width: 200 },
                { dataField: 'Received', caption: 'Received', width: 140 },
                { dataField: 'Printed', caption: 'Printed', width: 140 },
                { dataField: 'TextMessage', caption: 'Text Message', width: 140 },
                { dataField: 'Message', caption: 'Message', width: 280 },
                { dataField: 'RoomNo', caption: 'Room', width: 80 },
                { dataField: 'RoomType', caption: 'Ro.Type', width: 90 },
                { dataField: 'ArrivalDate', caption: 'Arr.', width: 105 },
                { dataField: 'DepartureDate', caption: 'Dep', width: 105 },
                { dataField: 'Status', caption: 'Status', width: 100 },
                { dataField: 'GroupCode', caption: 'Group Code', width: 110 },
                { dataField: 'ReservationHolder', caption: 'ReservationHolder', width: 220 },
                { dataField: 'ReceiveBy', caption: 'Receive By', width: 110 },
                { dataField: 'CreateBy', caption: 'Create By', width: 110 },
                { dataField: 'CreateDate', caption: 'Create Date', width: 140 },
                { dataField: 'UpdateBy', caption: 'Update By', width: 110 },
                { dataField: 'UpdateDate', caption: 'Update Date', width: 140 }
            ],
            allowColumnResizing: true,
            onSelectionChanged: function (e) { showMessageDetail(e.selectedRowsData[0]); },
            onContentReady: function (e) {
                if (e.component.getSelectedRowKeys().length === 0 && e.component.totalCount() > 0) e.component.selectRowsByIndexes([0]);
            },
            paging: { pageSize: 15 },
            pager: {
                visible: true,
                allowedPageSizes: [15, 20, 'all'],
                showPageSizeSelector: true,
                showInfo: true,
                showNavigationButtons: true,
            },
            selection: {
                mode: "single"
            },
        });
    }
</script>