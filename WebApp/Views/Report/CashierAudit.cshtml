@using DevExpress.XtraReports.UI
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    ViewBag.Title = ViewBag.ReportHeader;
    var transactionsList = ViewBag.TransactionsList;
    var usersList = ViewBag.UsersList;
}


<style>
    .bold {
        font-weight: bold;
    }

    .filter_wrapper {
        /*     background-color: #ececec; */
        /*   margin: 0px 8px 14px 8px; */
        padding: 18px 0px 0px 14px;
        border-radius: 8px;
    }



    .button_wrapper {
        display: flex;
        column-gap: 12px;
        margin: 0px 8px;
    }

        .button_wrapper .fa-solid {
            margin-right: 5px;
        }

    .selected {
        background-color: #4CAF50; /* Màu xanh */
        color: white;
    }
    .filter-panel {`r`n        font-size: 14px;
    }

    .filter-row {
        display: flex;
        align-items: flex-start;
        margin-bottom: .5rem;
    }

        .filter-row .title {
            width: 80px;
            font-weight: 700;
            line-height: 1.2;
        }

        .filter-row .content {
            display: flex;
            flex-wrap: wrap;
            gap: .5rem 1rem;
        }

    .filter-panel .form-control-sm,
    .filter-panel .form-select-sm,
    .filter-panel .ts-control {
        font-size: 12px;
        padding: .1rem .35rem;
        height: 28px;
    }


    #gridContainer .dx-datagrid-rowsview .dx-row.dx-group-row td,
    #gridContainer .dx-datagrid-rowsview .dx-row.dx-group-row.dx-selection td {
        background: #eeeeee !important;
        font-weight: 600;
        color: #212529 !important;
    }
    #gridContainer .dx-datagrid-rowsview .dx-row.dx-group-row.dx-selection * {
        color: #212529 !important;
    }
    #gridContainer .dx-datagrid-group-footer td {
        font-weight: 600;
        background: #f5f5f5 !important;
        color: #212529 !important;
    }

    .report-bar {
        position: relative;
        margin-bottom: 1rem; /* = mb-3 của bạn */
    }

        /* Tiêu đề ở giữa, full width để text-center hoạt động */
        .report-bar #reportTitle {
            font-size: 20px;
            margin: 0; /* bỏ margin dưới h4/h5 mặc định */
            text-align: center;
        }

        /* Nhóm nút cố định góc phải, canh theo chiều dọc */
        .report-bar .action-buttons {
            position: absolute;
            left: 0;
            top: 50%;
            transform: translateY(-50%);
        }



</style>

<div class="text-center" id="reportTitle" style="font-size: 20px"></div>
<div class="sticky-header bg-white p-2 shadow-sm z-3">
    <div class="d-flex flex-wrap align-items-center gap-2 mb-1" style="border: 1px solid #ced4da; border-radius: 6px; padding: 8px;">
        <!-- From Date -->
        <div class="d-flex flex-column ">

            <div class="d-flex align-items-center">
                <label class="fw-bold me-3">Filter:</label>
                    <div class="d-flex align-items-center me-3">
                        <label class="me-2 mb-0">Date:</label>
                    <div data-date-input business-date data-format="DD/MM/YYYY" data-name="date" style="min-width:140px;">
                        <input type="text" class="date-ui form-control form-control-sm"
                               placeholder="dd/mm/yyyy" autocomplete="off" />
                    </div>
                    </div>
                <div class="d-flex align-items-center me-3" style=" width: 250px; ">
                    <label class="me-2 mb-0">Cashier:</label>
                    <select id="user" name="user" class="form-control form-control-sm report-dd">
                        <option value="">--All--</option>
                            @foreach (var item in usersList)
                            {
                            <option value="@item.ID">@item.LoginName</option>
                            }
                        </select>
                    </div>

                <div class="d-flex align-items-center me-3"style=" width: 250px; ">
                    <label class="me-2 mb-0">TransCode:</label>
                    <select id="transactions" name="transactions" class="form-control form-control-sm report-dd">
                        <option value="">--All--</option>
                            @foreach (var item in transactionsList)
                            {
                            <option value="@item.Code">@item.Code</option>
                            }
                        </select>
                    </div>


                <div class="d-flex align-items-center me-3">
                    <label class="me-2 mb-0">Group By:</label>
                    <select id="groupBy" name="groupBy" class="form-control form-control-sm w-auto">
                            <option value="0">Cashier,Transaction Code</option>
                            <option value="1">Cashier</option>
                            <option value="2">Transaction Code</option>
                        </select>
                    </div>
           </div>
        </div>
    </div>
    <div class="">
        <button  id="btnPrint" class="mui-button mui-button-new">View</button>
        <button  id="btnExportExcel" class="mui-button mui-button-new" type="button">  Excel</button>
        <button  id="btnExportPdf" class="mui-button mui-button-new" type="button"> PDF</button>
        <button  id="btnPrintGrid" class="mui-button mui-button-new" type="button">
            Print
        </button>
    </div>
</div>

<div class="mui-card">
    @*   <div style="font-size: 20px;" class="mt-1" id="reportTitle"></div> *@
    <div id="gridWrapper" class="mt-2" style="max-height: 500px;">
        <div class="gridContainer mt-2" id="gridContainer"></div>
    </div>
</div>
<div id="loadingSpinner" style="display:none; position:fixed; top:50%; left:50%; transform:translate(-50%, -50%); z-index:1000;">
    <i class="fa-solid fa-spinner fa-spin"></i>
</div>
<script>


    $(document).ready(function () {

        document.getElementById("reportTitle").innerText = '@ViewBag.ReportTitle';
        window.initDateInputs();      
    });
          


    $(document).off("click", "#btnPrint").on("click", "#btnPrint", function () {
        $("#loadingSpinner").show();
        $.ajax({
            url: '/Report/CashierAudit',
            type: 'GET',
            data: {
                date: $("#date").val(),
                cashierList: ($("#user").val() || ""),
                transactionCodeList: ($("#transactions").val() || ""),
                type: "0"
            },
            traditional: true,
            crossDomain: false,
            headers: { "X-CSRF-TOKEN-HEADERNAME": jQuery("input[name='__RequestVerificationToken']").val() },
            success: function (result) {
                if (!Array.isArray(result)) {
                    alert((result && result.error) ? result.error : "Không thể tải báo cáo.");
                    $("#loadingSpinner").hide();
                    return;
                }
                initializReveunueByGrid(prepareCashierRows(result), $("#groupBy").val());
                $("#loadingSpinner").hide();
            },
            error: function () {
                alert("Không thể tải báo cáo.");
                $("#loadingSpinner").hide();
            }
        });
    });

    function prepareCashierRows(data) {
        return (data || []).map(function (x) {
            var amt = Number(x.amount);
            if (!isFinite(amt)) amt = 0;
            var code = x.transactionCode || "";
            var desc = x.description || "";
            var cashierNo = x.cashierNo || "";
            var userName = x.userName || "";
            var cashierLabel = cashierNo
                ? ("Cashier: " + cashierNo + (userName ? " - " + userName : ""))
                : ("Cashier: " + (userName || "(none)"));
            return Object.assign({}, x, {
                amount: amt,
                cashierGroup: cashierLabel,
                transGroup: "Transaction Code: " + code + (desc ? " (" + desc + ")" : "")
            });
        });
    }

    function cashierAuditColumns(groupBy, columnWidth) {
        function groupLabelTemplate() {
            return function (container, options) {
                $("<span>").text(options.value ?? "").appendTo(container);
            };
        }
        var cols = [
            { dataField: "account", caption: "Account", width: columnWidth + 20,
                cellTemplate: function (container, options) {
                    container.append($("<div>").text(options.text).css({
                        "white-space": "normal",
                        "word-wrap": "break-word",
                        "line-height": "1.2"
                    }));
                }
            },
            { dataField: "roomNo", caption: "Room No.", width: columnWidth - 50 },
            { dataField: "supplement", caption: "Supplement", width: columnWidth + 50 },
            { dataField: "reference", caption: "Reference", width: columnWidth },
            { dataField: "amount", caption: "Amount", width: columnWidth - 50, dataType: "number", format: "#,##0" },
            { dataField: "currencyID", caption: "Curr.", width: columnWidth - 80 },
            { dataField: "folioID", caption: "Folio No.", width: columnWidth - 50 },
            { dataField: "confirmationNo", caption: "Conf. No", width: columnWidth - 80 },
            { dataField: "transactionDate", caption: "Trans. Date", width: columnWidth - 40, dataType: "date", format: "dd/MM/yyyy HH:mm" },
            { dataField: "userName", caption: "User Name", width: columnWidth - 50 },
            { dataField: "cashierNo", caption: "Cashier No.", width: columnWidth - 70 },
            { dataField: "transactionCode", caption: "Trans. Code", width: columnWidth - 70 }
        ];
        if (groupBy === "1") {
            cols.unshift({ dataField: "cashierGroup", caption: "Cashier", groupIndex: 0, visible: false, groupCellTemplate: groupLabelTemplate() });
        } else if (groupBy === "2") {
            cols.unshift({ dataField: "transGroup", caption: "Transaction Code", groupIndex: 0, visible: false, groupCellTemplate: groupLabelTemplate() });
        } else {
            cols.unshift(
                { dataField: "cashierGroup", caption: "Cashier", groupIndex: 0, visible: false, groupCellTemplate: groupLabelTemplate() },
                { dataField: "transGroup", caption: "Transaction Code", groupIndex: 1, visible: false, groupCellTemplate: groupLabelTemplate() }
            );
        }
        return cols;
    }

    function initializReveunueByGrid(data, groupBy) {
        const columnWidth = 180;
        pmshBindDxReportGrid("#gridContainer", {
            dataSource: Array.isArray(data) ? data : [],
            height: Math.max(360, window.innerHeight - 420),
            allowColumnResizing: true,
            loadPanel: { enabled: false },
            headerFilter: { visible: false },
            grouping: { autoExpandAll: true, allowCollapsing: true, contextMenuEnabled: false },
            groupPanel: { visible: false },
            columns: cashierAuditColumns(groupBy, columnWidth),
            summary: {
                groupItems: [
                    {
                        column: "account",
                        summaryType: "count",
                        displayFormat: "Sub Total =",
                        showInGroupFooter: true,
                        alignByColumn: true
                    },
                    {
                        column: "amount",
                        summaryType: "sum",
                        displayFormat: "{0}",
                        valueFormat: "#,##0",
                        showInGroupFooter: true,
                        alignByColumn: true
                    }
                ],
                totalItems: [
                    {
                        column: "account",
                        summaryType: "count",
                        displayFormat: "Grand Total ="
                    },
                    {
                        column: "amount",
                        summaryType: "sum",
                        displayFormat: "{0}",
                        valueFormat: "#,##0"
                    }
                ]
            },
            paging: { enabled: false },
            pager: { visible: false },
            selection: { mode: "none" },
            focusedRowEnabled: false,
            filterRow: { visible: true, applyFilter: "auto" },
            showBorders: true
        });
    }


    $("#btnExportExcel").click(function () {
                 const grid = $("#gridContainer").dxDataGrid("instance"); var selectedReport2 = '@ViewBag.ReportTitle';
          var selectedReport = '@ViewBag.ReportTitle';
          if (!selectedReport) {
              alert("Vui lòng chọn báo cáo trước khi xuất Excel.");
              return;
          }

          const workbook = new ExcelJS.Workbook();const companyName = localStorage.getItem("CompanyName") || "Tên công ty chưa xác định";
          const worksheet = workbook.addWorksheet("Sheet 1");

          // === Tạo header công ty (dòng 1) ===
         worksheet.addRow([companyName]);
          worksheet.mergeCells('A1:E1');
          worksheet.getRow(1).font = { bold: true };
          worksheet.getRow(1).alignment = { vertical: 'middle', horizontal: 'left' };

          // === Dòng 2: Thời gian xuất (phải) ===
          const now = new Date();
          const exportDate = now.toLocaleString("vi-VN");
          worksheet.addRow(['', '', '', '', ' ' + exportDate]);
          worksheet.mergeCells('E2:H2');
          worksheet.getRow(2).alignment = { vertical: 'middle', horizontal: 'right' };

          // === Dòng 3–4: Trống
          worksheet.addRow([]);
          worksheet.addRow([]);

          // === Dòng 5: Tên báo cáo ở giữa ===
          const reportRow = worksheet.addRow(['', '', selectedReport]);
          worksheet.mergeCells('C5:F5');
          reportRow.font = { bold: true, size: 14 };
          reportRow.alignment = { vertical: 'middle', horizontal: 'center' };

          // === Dòng 6: Trống trước khi xuất dữ liệu
          worksheet.addRow([]);

          // === Export dữ liệu từ DevExtreme (bắt đầu từ dòng 7)
          DevExpress.excelExporter.exportDataGrid({
              component: grid,
              worksheet: worksheet,
              autoFilterEnabled: true,
              topLeftCell: { row: 7, column: 1 } // dữ liệu bắt đầu từ dòng 7
          }).then(function () {
              // Footer
              const lastRow = worksheet.lastRow.number + 2;
              worksheet.mergeCells(`A${lastRow}:F${lastRow}`);
              worksheet.getCell(`A${lastRow}`).alignment = { horizontal: 'center' };
              worksheet.getCell(`A${lastRow}`).font = { italic: true };

              // Ghi file
              let fileName = selectedReport + ".xlsx";
              workbook.xlsx.writeBuffer().then(function (buffer) {
                  saveAs(new Blob([buffer], { type: "application/octet-stream" }), fileName);
              });
          });
      });

      $("#btnExportPdf").click(function () {
        const grid = $("#gridContainer").dxDataGrid("instance");

        // Lấy đối tượng jsPDF từ window
        const { jsPDF } = window.jspdf;
        const doc = new jsPDF({ orientation: "landscape", unit: "pt", format: "A4" });

        const selectedReport = '@ViewBag.ReportTitle';
        const companyName = localStorage.getItem("CompanyName") || "Tên công ty chưa xác định";

        grid.getDataSource().load().then(data => {
            const columns = grid.getVisibleColumns();

            const head = [columns.map(col => col.caption)];
            const body = data.map(row =>
                columns.map(col =>
                    col.calculateCellValue ? col.calculateCellValue(row) : row[col.dataField]
                )
            );

            doc.setFontSize(14);
            doc.setFont("Helvetica", "bold");
            doc.text(companyName, doc.internal.pageSize.getWidth() / 2, 40, { align: "center" });

            doc.setFontSize(12);
            doc.setFont("Helvetica", "normal");
            doc.text(selectedReport, doc.internal.pageSize.getWidth() / 2, 60, { align: "center" });

            // AutoTable
            doc.autoTable({
                startY: 80,
                head: head,
                body: body,
                styles: { fontSize: 9, cellPadding: 4 , lineWidth: 0.5, lineColor: [0, 0, 0]    },
                headStyles: { fillColor: [41, 128, 185], textColor: 255, fontStyle: 'bold' },
                alternateRowStyles: { fillColor: [240, 240, 240] },
                margin: { left: 20, right: 20 }
            });

            doc.save(selectedReport + ".pdf");
        });
    });




    $("#btnPrintGrid").on("click", function () {
               const grid = $("#gridContainer").dxDataGrid("instance"); var selectedReport2 = '@ViewBag.ReportTitle';

        // Lấy toàn bộ data từ dataSource
        grid.getDataSource().load().then(function (data) {
            // Tạo bảng HTML từ dữ liệu
            let tableHTML = '<table border="1" style="border-collapse: collapse; width: 100%;">';

            // Header
            const columns = grid.getVisibleColumns();
            tableHTML += "<thead><tr>";
            columns.forEach(col => {
                tableHTML += `<th style="padding: 5px; text-align: center;">${col.caption}</th>`;
            });
            tableHTML += "</tr></thead>";

            // Body
            tableHTML += "<tbody>";
            data.forEach(row => {
                tableHTML += "<tr>";
                columns.forEach(col => {
                    let value = col.calculateCellValue ? col.calculateCellValue(row) : row[col.dataField];
                    tableHTML += `<td style="padding: 5px;">${value ?? ""}</td>`;
                });
                tableHTML += "</tr>";
            });
            tableHTML += "</tbody></table>";

            // Mở cửa sổ in với nội dung bảng
            const printWindow = window.open('', '', 'height=800,width=1000');
            if (!printWindow) {
                alert("Trình duyệt đang chặn cửa sổ in.");
                return;
            }

            printWindow.document.write('<html><head><title>' + selectedReport2 + '</title>');
            printWindow.document.write('<style>table { font-family: Arial; font-size: 12px; }</style>');
            printWindow.document.write('</head><body>');
            printWindow.document.write(tableHTML);
            printWindow.document.write('</body></html>');
            printWindow.document.close();

            // Chờ nội dung render xong rồi in
            printWindow.onload = function () {
                printWindow.focus();
                printWindow.print();
                printWindow.close();
            };
        });
    });

</script>
