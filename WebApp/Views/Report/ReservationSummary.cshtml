@using DevExpress.XtraReports.UI
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    ViewBag.Title = ViewBag.ReportHeader;
    var zoneList = ViewBag.ZoneList as IEnumerable<dynamic>;
    var rtList = ViewBag.RoomTypeList as IEnumerable<dynamic>;
    var mkList = ViewBag.MarketList as IEnumerable<dynamic>;
    var currList = ViewBag.CurrencyList as IEnumerable<dynamic>;
}


<style>
    .filter_wrapper {
        /*     background-color: #ececec; */
        /*   margin: 0px 8px 14px 8px; */
        padding: 18px 0px 0px 14px;
        border-radius: 8px;
    }
 
    .button_wrapper {
        display: flex;
        column-gap: 12px;
        margin: 0px 8px;
    }

        .button_wrapper .fa-solid {
            margin-right: 5px;
        }

    .selected {
        background-color: #4CAF50; /* Màu xanh */
        color: white;
    }
 

    .sticky-header label,
    .sticky-header .form-control-sm {
        font-size: 14px;
        line-height: 1.2;
    }


    .sticky-header .form-control-sm {
        padding:  2px 8px;
        height: 28px;
    }

    .sticky-header label[class*="me-"] {
        margin-right: .5rem !important;
    }

 

    .sticky-header label,
    .sticky-header .form-control-sm {
        font-size: 14px;
        line-height: 1.2;
    }


    .sticky-header .form-control-sm {
        padding:  2px 8px;
        height: 28px;
    }

    .sticky-header label[class*="me-"] {
        margin-right: .5rem !important;
    }

 

    .sticky-header label { margin-bottom: 0; white-space: nowrap; }
    .nrp-grid {
        display: grid;
        grid-template-columns: max-content max-content 160px max-content 160px;
        column-gap: 6px;
        row-gap: 8px;
        align-items: center;
        width: max-content;
        max-width: 100%;
    }
    .nrp-grid > label { margin: 0; white-space: nowrap; }
    .nrp-grid .pair-gap { margin-left: 10px; }
    .nrp-grid select, .nrp-grid [data-date-input] { width: 160px; min-width: 128px; max-width: 220px; }
</style>
<div class="text-center" id="reportTitle" style="font-size: 20px"></div>
<div class="sticky-header bg-white p-2 shadow-sm z-3">
    <div class="">
        <button id="btnPrint" class="mui-button mui-button-new">View</button>
        <button id="btnExportExcel" class="mui-button mui-button-new" type="button">Excel</button>
        <button id="btnExportPdf" class="mui-button mui-button-new" type="button">PDF</button>
    </div>
    <div class="mb-1" style="border: 1px solid #ced4da; border-radius: 6px; padding: 8px;">
        <div class="nrp-grid">
            <label class="fw-bold">Date Range:</label>
            <label>From Date:</label>
            <div data-date-input business-date data-format="DD/MM/YYYY" data-name="fromDate">
                <input type="text" class="date-ui form-control form-control-sm" placeholder="dd/mm/yyyy" autocomplete="off" />
            </div>
            <label class="pair-gap">To Date:</label>
            <div data-date-input business-date data-format="DD/MM/YYYY" data-name="toDate">
                <input type="text" class="date-ui form-control form-control-sm" placeholder="dd/mm/yyyy" autocomplete="off" />
            </div>
        </div>
        <div class="nrp-grid" style="margin-top: 8px;">
            <label class="fw-bold">Filter:</label>
            <label>Zone:</label>
            <select id="zone" name="zone" class="form-control form-control-sm report-dd">
                <option value="">--All--</option>
                @if (zoneList != null)
                {
                    foreach (var item in zoneList)
                    {
                        <option value="@item.Code">@item.Code</option>
                    }
                }
            </select>
            <label class="pair-gap">Room Type:</label>
            <select id="roomType" name="roomType" class="form-control form-control-sm report-dd">
                <option value="">--All--</option>
                @if (rtList != null)
                {
                    foreach (var item in rtList)
                    {
                        <option value="@item.Code">@item.Code</option>
                    }
                }
            </select>
            <span></span>
            <label>Market:</label>
            <select id="market" name="market" class="form-control form-control-sm report-dd">
                <option value="">--All--</option>
                @if (mkList != null)
                {
                    foreach (var item in mkList)
                    {
                        string marketLabel = item.Description;
                        if (string.IsNullOrWhiteSpace(marketLabel)) marketLabel = item.Name;
                        if (string.IsNullOrWhiteSpace(marketLabel)) { continue; }
                        <option value="@item.Code">@marketLabel</option>
                    }
                }
            </select>
            <label class="pair-gap">Currency:</label>
            <select id="viewBy" name="viewBy" class="form-control form-control-sm report-dd">
                @if (currList != null)
                {
                    foreach (var item in currList)
                    {
                        var cid = (string)item.ID;
                        if (string.Equals(cid, "USD", StringComparison.OrdinalIgnoreCase))
                        {
                            <option value="@cid" selected>@cid</option>
                        }
                        else
                        {
                            <option value="@cid">@cid</option>
                        }
                    }
                }
                else
                {
                    <option value="USD" selected>USD</option>
                    <option value="VND">VND</option>
                }
            </select>
        </div>
    </div>
</div>

<div class="mui-card">
    @* <div style="font-size: 20px;" class="mt-1" id="reportTitle"></div> *@
    <div id="gridWrapper" class="mt-2" style="max-height: 500px;">
        <div class="gridContainer mt-2" id="gridContainer"></div>
    </div>
</div>
<div id="loadingSpinner" style="display:none; position:fixed; top:50%; left:50%; transform:translate(-50%, -50%); z-index:1000;">
    <i class="fa-solid fa-spinner fa-spin"></i>
</div>
<script>
 
    $(document).ready(function () {
         document.getElementById("reportTitle").innerText = '@ViewBag.ReportTitle';
                  window.initDateInputs();


    });
       
    $(document).off("click", "#btnPrint").on("click", "#btnPrint", function () {
        $("#loadingSpinner").show();
        $.ajax({
            url: '/Report/ReservationSummaryData',
            type: 'GET',
            data: {
                fromDate: $("#fromDate").val(),
                toDate: $("#toDate").val(),
                roomType: ($("#roomType").val() || ""),
                zone: ($("#zone").val() || "") ,
                market: ($("#market").val() || "") ,
                viewBy: $("#viewBy").val(),
            },
            traditional: true,
              crossDomain: false,
                headers: { "X-CSRF-TOKEN-HEADERNAME": jQuery("input[name='__RequestVerificationToken']").val() },
            success: function (result) {
                // $("#reportViewerContainer").html(result);
                // $("#loadingSpinner").hide();
                     console.log(result);
    const processedData = prepareReservationSummaryData(result);
                initializReservationSummaryGrid(processedData);
                    $("#loadingSpinner").hide();
            },
            error: function () {
                alert("Không thể tải báo cáo.");
                $("#loadingSpinner").hide();
            }
        });
    });
      function prepareReservationSummaryData(data) {
        const groupedData = {};

        // Group by MonthDisplay
        data.forEach(item => {
            const key = item.monthDisplay;
            if (!groupedData[key]) groupedData[key] = [];
            groupedData[key].push(item);
        });

        const finalData = [];

        Object.entries(groupedData).forEach(([month, records]) => {
             finalData.push({
            rsvSummaryDate: records[0].monthDisplay,
            isTitle: true,
            cssClass: "custom"
        });
            finalData.push(...records);

            const totalRow = {
                rsvSummaryDate: "MONTHLY TOTAL",
                weekDate:"",
                totalOccRms: sum(records, 'totalOccRms'),
                indRms: sum(records, 'indRms'),
                blkRmsPU: sum(records, 'blkRmsPU'),
                blkRmsNotPU: sum(records, 'blkRmsNotPU'),
                   totalAvailable: sum(records, 'totalAvailable'),

                occPer: average(records, 'occPer'),
                roomRevenue: sum(records, 'roomRevenue'),
                grpRevenue: sum(records, 'grpRevenue'),
                indRevenue: sum(records, 'indRevenue'),
                avrRate: average(records, 'avrRate'),

                  arrRms: sum(records, 'arrRms'),
                blkArrRms: sum(records, 'blkArrRms'),
                charrRms: sum(records, 'charrRms'),

                    totalArrRms: sum(records, 'arrRms') + sum(records, 'blkArrRms') + sum(records, 'charrRms'),


                depRms: sum(records, 'depRms'),
                blkDepRms: sum(records, 'blkDepRms'),
                chdepRms: sum(records, 'chdepRms'),

                  totalDepRms: sum(records, 'depRms') + sum(records, 'blkDepRms') + sum(records, 'chdepRms'),

                oOORms: sum(records, 'oOORms'),
                adl: average(records, 'adl'),


                                chl: sum(records, 'chl'),
                chl1: sum(records, 'chl1'),
                chl2: sum(records, 'chl2'),
                totPer: sum(records, 'totPer'),
                arrPrs: sum(records, 'arrPrs'),
                depPrs: sum(records, 'depPrs'),
                isTotal: true ,
                    cssClass: "custom",// Để phân biệt dòng tổng
            };

            finalData.push(totalRow);
        });

        return finalData;
    }
    function num(v) {
        const n = parseFloat(v);
        return isNaN(n) ? 0 : n;
    }

    function sum(arr, field) {
        return arr.reduce((total, item) => total + num(item[field]), 0);
    }

    function average(arr, field) {
        const valid = arr.filter(x => x[field] != null && x[field] !== "");
        if (valid.length === 0) return 0;
        return valid.reduce((s, x) => s + num(x[field]), 0) / valid.length;
    }
      function initializReservationSummaryGrid(data) {
        const columnWidth = 180;

        const numericColumns = [
            "totalOccRms", "indRms", "blkRmsPU", "blkRmsNotPU", "totalAvailable",
            "occPer", "roomRevenue", "grpRevenue", "avrRate",
            "arrRms", "blkArrRms", "charrRms",
            "depRms", "blkDepRms", "chdepRms",
            "oOORms", "adl", "chl", "chl1", "chl2",
            "totPer", "arrPrs", "depPrs"
        ];

        $("#gridContainer").dxDataGrid({
           dataSource: data,         height: 500,
            allowColumnResizing: true,
            columns: [
                {
                    dataField: "rsvSummaryDate", caption: "Date", width: columnWidth - 60,
                    calculateDisplayValue: function (row) {
                        if (!row || row.isTitle || row.isTotal) return row && row.rsvSummaryDate ? row.rsvSummaryDate : "";
                        const v = row.rsvSummaryDate;
                        if (!v) return "";
                        const d = new Date(v);
                        if (isNaN(d.getTime())) return v;
                        const dd = String(d.getDate()).padStart(2, "0");
                        const mm = String(d.getMonth() + 1).padStart(2, "0");
                        const yy = String(d.getFullYear()).slice(-2);
                        return dd + "/" + mm + "/" + yy;
                    }
                },
                { dataField: "totalOccRms", caption: "Total Occ.R", width: columnWidth - 60, dataType: "number", format: "#,##0" },
                    { dataField: "indRms", caption: "Ind Rm", width: columnWidth - 60, dataType: "number", format: "#,##0" },
                    { dataField: "blkRmsPU", caption: "Grp Rm", width: columnWidth - 60, dataType: "number", format: "#,##0" },
                    { dataField: "blkRmsNotPU", caption: "CH Rm", width: columnWidth - 60, dataType: "number", format: "#,##0" },
                    { dataField: "totalAvailable", caption: "Total Avail", width: columnWidth - 60, dataType: "number", format: "#,##0" },
                    { dataField: "occPer", caption: "Occ %", width: columnWidth - 60, dataType: "number", format: "#,##0.00" },
                { dataField: "roomRevenue", caption: "Individual Revenue", width: columnWidth - 30, dataType: "number", format: "#,##0.00" },
                    { dataField: "grpRevenue", caption: "Group Revenue", width: columnWidth - 30, dataType: "number", format: "#,##0.00" },
                    { dataField: "indRevenue", caption: "Total Revenue", width: columnWidth - 30, dataType: "number", format: "#,##0.00" },
                    { dataField: "avrRate", caption: "Avg Rate", width: columnWidth - 60, dataType: "number", format: "#,##0.00" },
                    { dataField: "arrRms", caption: "Ind Arr Rm", width: columnWidth - 60, dataType: "number", format: "#,##0" },
                    { dataField: "blkArrRms", caption: "Grp Arr Rm", width: columnWidth - 60, dataType: "number", format: "#,##0" },
                    { dataField: "charrRms", caption: "C&H Arr Rm", width: columnWidth - 60, dataType: "number", format: "#,##0" },
                {
                    caption: "Total Arr Rm", width: columnWidth - 60, dataType: "number", format: "#,##0",
                    calculateCellValue: function (data) {
                        if (data && data.isTitle) return "";
                        if (data && data.isTotal && data.totalArrRms != null) return data.totalArrRms;
                        return num(data.arrRms) + num(data.blkArrRms) + num(data.charrRms);
                    }
                },
                    { dataField: "depRms", caption: "Ind Dep Rm", width: columnWidth - 60, dataType: "number", format: "#,##0" },
                    { dataField: "blkDepRms", caption: "Grp Dep Rm", width: columnWidth - 60, dataType: "number", format: "#,##0" },
                    { dataField: "chdepRms", caption: "C&H Dep Rm", width: columnWidth - 60, dataType: "number", format: "#,##0" },
                {
                        caption: "Total Dep Rm", width: columnWidth - 60, dataType: "number", format: "#,##0",
                    calculateCellValue: function (data) {
                        if (data && data.isTitle) return "";
                        if (data && data.isTotal && data.totalDepRms != null) return data.totalDepRms;
                        return num(data.depRms) + num(data.blkDepRms) + num(data.chdepRms);
                    }
                },

                { dataField: "oOORms", caption: "OOO Rm", width: columnWidth - 70, dataType: "number", format: "#,##0" },
                { dataField: "adl", caption: "Adl.", width: columnWidth - 70, dataType: "number", format: "#,##0" },
                { dataField: "chl", caption: "C", width: columnWidth - 70, dataType: "number", format: "#,##0" },
                { dataField: "chl1", caption: "C1", width: columnWidth - 70, dataType: "number", format: "#,##0" },
                { dataField: "chl2", caption: "C2", width: columnWidth - 70, dataType: "number", format: "#,##0" },
                { dataField: "totPer", caption: "Total Prs", width: columnWidth - 70, dataType: "number", format: "#,##0" },
                { dataField: "arrPrs", caption: "Arr. Prs", width: columnWidth - 70, dataType: "number", format: "#,##0" },
                { dataField: "depPrs", caption: "Dep. Prs", width: columnWidth - 70, dataType: "number", format: "#,##0" }
            ],
         summary: {
        totalItems: numericColumns.map(field => ({
            name: `${field}Summary`,
            showInColumn: field, // << QUAN TRỌNG
            summaryType: "custom",
            displayFormat: "{0}",
            valueFormat: "#,##0"
        })),
        calculateCustomSummary: function (e) {
            const isCustomRow = row => row?.cssClass === "custom" || row?.isTotal === true;

            if (e.summaryProcess === "start") {
                e.totalValue = 0;
            } else if (e.summaryProcess === "calculate") {
                const row = e.value;
                if (isCustomRow(row)) return;

                const field = e.name.replace("Summary", ""); // Tách tên cột từ name
                const value = parseFloat(row[field]) || 0;
                e.totalValue += value;
            }
        }
    }
,
            paging: { pageSize: 25 },
            scrolling: {
                useNative: true,
                showScrollbar: "always"
            },
            pager: {
                visible: true,
                allowedPageSizes: [25, 50, 'all'],
                showPageSizeSelector: true,
                showInfo: true,
                showNavigationButtons: true
            },
            selection: { mode: "multiple", showCheckBoxesMode: "none" },
            filterRow: { visible: true, applyFilter: "auto" },
            headerFilter: { visible: true },
            showBorders: true,
            onRowPrepared: function (e) {
                if (e.rowType === "data" && e.data?.cssClass) {
                    e.rowElement.addClass(e.data.cssClass);
                }
            }
        });
    }





    $("#btnExportExcel").click(function () {
               const grid = $("#gridContainer").dxDataGrid("instance"); var selectedReport2 = '@ViewBag.ReportTitle';
        var selectedReport = '@ViewBag.ReportTitle';
        if (!selectedReport) {
            alert("Vui lòng chọn báo cáo trước khi xuất Excel.");
            return;
        }

                     const workbook = new ExcelJS.Workbook();const companyName = localStorage.getItem("CompanyName") || "Tên công ty chưa xác định";
        const worksheet = workbook.addWorksheet("Sheet 1");

        // === Tạo header công ty (dòng 1) ===
       worksheet.addRow([companyName]);
        worksheet.mergeCells('A1:E1');
        worksheet.getRow(1).font = { bold: true };
        worksheet.getRow(1).alignment = { vertical: 'middle', horizontal: 'left' };

        // === Dòng 2: Thời gian xuất (phải) ===
        const now = new Date();
        const exportDate = now.toLocaleString("vi-VN");
        worksheet.addRow(['', '', '', '', ' ' + exportDate]);
        worksheet.mergeCells('E2:H2');
        worksheet.getRow(2).alignment = { vertical: 'middle', horizontal: 'right' };

        // === Dòng 3–4: Trống
        worksheet.addRow([]);
        worksheet.addRow([]);

        // === Dòng 5: Tên báo cáo ở giữa ===
        const reportRow = worksheet.addRow(['', '', selectedReport]);
        worksheet.mergeCells('C5:F5');
        reportRow.font = { bold: true, size: 14 };
        reportRow.alignment = { vertical: 'middle', horizontal: 'center' };

        // === Dòng 6: Trống trước khi xuất dữ liệu
        worksheet.addRow([]);

        // === Export dữ liệu từ DevExtreme (bắt đầu từ dòng 7)
        DevExpress.excelExporter.exportDataGrid({
            component: grid,
            worksheet: worksheet,
            autoFilterEnabled: true,
            topLeftCell: { row: 7, column: 1 } // dữ liệu bắt đầu từ dòng 7
        }).then(function () {
            // Footer
            const lastRow = worksheet.lastRow.number + 2;

            worksheet.mergeCells(`A${lastRow}:F${lastRow}`);
            worksheet.getCell(`A${lastRow}`).alignment = { horizontal: 'center' };
            worksheet.getCell(`A${lastRow}`).font = { italic: true };

            // Ghi file
            let fileName = selectedReport + ".xlsx";
            workbook.xlsx.writeBuffer().then(function (buffer) {
                saveAs(new Blob([buffer], { type: "application/octet-stream" }), fileName);
            });
        });
    });


    // Nút xuất PDF
            $("#btnExportPdf").click(function () {
           const grid = $("#gridContainer").dxDataGrid("instance");

           // Lấy đối tượng jsPDF từ window
           const { jsPDF } = window.jspdf;
           const doc = new jsPDF({ orientation: "landscape", unit: "pt", format: "A4" });

           const selectedReport = '@ViewBag.ReportTitle';
           const companyName = localStorage.getItem("CompanyName") || "Tên công ty chưa xác định";

           grid.getDataSource().load().then(data => {
               const columns = grid.getVisibleColumns();

               const head = [columns.map(col => col.caption)];
               const body = data.map(row =>
                   columns.map(col =>
                       col.calculateCellValue ? col.calculateCellValue(row) : row[col.dataField]
                   )
               );

               doc.setFontSize(14);
               doc.setFont("Helvetica", "bold");
               doc.text(companyName, doc.internal.pageSize.getWidth() / 2, 40, { align: "center" });

               doc.setFontSize(12);
               doc.setFont("Helvetica", "normal");
               doc.text(selectedReport, doc.internal.pageSize.getWidth() / 2, 60, { align: "center" });

               // AutoTable
               doc.autoTable({
                   startY: 80,
                   head: head,
                   body: body,
                    styles: { fontSize: 9, cellPadding: 4 , lineWidth: 0.5, lineColor: [0, 0, 0]    },
                   headStyles: { fillColor: [41, 128, 185], textColor: 255, fontStyle: 'bold' },
                   alternateRowStyles: { fillColor: [240, 240, 240] },
                   margin: { left: 20, right: 20 }
               });

               doc.save(selectedReport + ".pdf");
           });
       });
</script>
