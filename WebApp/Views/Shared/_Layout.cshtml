                if (!code || (typeof window.hasFunctionRight === "function" && window.hasFunctionRight(code)))
                    return;
                e.preventDefault();
                e.stopPropagation();
                e.stopImmediatePropagation();
                if (typeof window.showAccessDenied === "function") window.showAccessDenied();
            }, true);
        }

        (function () {
            const params = new URLSearchParams(window.location.search);
            if (params.get("denied") === "1") {
                if (typeof window.showAccessDenied === "function") window.showAccessDenied();
                params.delete("denied");
                const next = window.location.pathname + (params.toString() ? "?" + params.toString() : "") + window.location.hash;
                history.replaceState({}, "", next);
            }

            const pathSegments = window.location.pathname.split("/").filter(Boolean);
            if (pathSegments.length === 0) return;
            const controller = pathSegments[0].toLowerCase();
            const action = (pathSegments[pathSegments.length - 1] || "").toLowerCase();
            if (controller === "home" || action === "index") return;

            const hereUrl = new URL(window.location.href);
            const here = hereUrl.pathname.replace(/\/+$/, "").toLowerCase();
            const hereName = (hereUrl.searchParams.get("name") || "").toLowerCase();
            const matches = Array.from(document.querySelectorAll("a[data-action][href]")).filter(function (a) {
                const href = a.getAttribute("href") || "";
                if (!href || href.toLowerCase().indexOf("javascript:") === 0) return false;
                try {
                    return new URL(href, window.location.origin).pathname.replace(/\/+$/, "").toLowerCase() === here;
                } catch (err) {
                    return false;
                }
            });
            let match = null;
            if (hereName) {
                match = matches.find(function (a) {
                    try {
                        const url = new URL(a.getAttribute("href"), window.location.origin);
                        return (url.searchParams.get("name") || "").toLowerCase() === hereName;
                    } catch (err) {
                        return false;
                    }
                });
            }
            if (!match) match = matches[0];
            if (!match) return;
            const code = match.getAttribute("data-action");
            if (typeof window.hasFunctionRight === "function" && window.hasFunctionRight(code)) return;
            if (typeof window.showAccessDenied === "function") window.showAccessDenied();
            setTimeout(function () { window.location.href = "/Home/Index"; }, 400);
        })();



    });

