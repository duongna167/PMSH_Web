@using BaseBusiness.Model
@{
    var userList = ViewBag.UserList as IEnumerable<UsersModel>;
}

<style>
    #pwdh_modal .pwdh-filter {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 16px;
        margin-top: 8px;
    }
    #pwdh_modal .pwdh-field {
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: 6px;
    }
    #pwdh_modal .pwdh-field label {
        margin: 0;
        white-space: nowrap;
        font-size: 14px;
    }
    #pwdh_modal .pwdh-filter select {
        min-width: 128px;
        max-width: 220px;
        height: 28px;
        font-size: 14px;
        padding: 2px 1.85rem 2px 8px;
        border-radius: 4px;
        border: 1px solid #ced4da;
    }
    #pwdh_modal .mui-card {
        min-height: 0;
    }
    #pwdh_gridContainer {
        flex: 1 1 auto;
        height: 100%;
        min-height: 0;
    }
</style>

<div class="modal fade" id="pwdh_modal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-lg-4by3 modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Password History</h5>
            </div>
            <div class="modal-body">
                <div class="search-filter">
                    <div>
                        <button type="button" id="pwdh_btnSearch" class="mui-button mui-button-view">Search</button>
                        <button type="button" id="pwdh_btnExcel" class="mui-button mui-button-export" disabled>Excel</button>
                        <button type="button" id="pwdh_btnClose" class="mui-button mui-button-new">Close</button>
                    </div>
                    <div class="pwdh-filter">
                        <div class="pwdh-field">
                            <label for="pwdh_user">User</label>
                            <select id="pwdh_user" class="form-control form-control-sm">
                                <option value="0">-- All Users --</option>
                                @if (userList != null)
                                {
                                    foreach (var u in userList)
                                    {
                                        <option value="@u.ID">@u.LoginName</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="pwdh-field">
                            <label for="pwdh_type">Type</label>
                            <select id="pwdh_type" class="form-control form-control-sm">
                                <option value="-1">-- All Types --</option>
                                <option value="0">Change</option>
                                <option value="1">Wrong</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="mui-card">
                    <div id="pwdh_gridContainer" class="gridContainer"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    var pwdh_Module = {
        grid: null,
        request: null,

        init: function () {
            this.initGrid([]);
            this.bindEvents();
            this.loadData();
        },

        bindEvents: function () {
            var self = this;
            $("#pwdh_modal").one("hide.bs.modal.pwdh", function () {
                self.reset();
            }).one("hidden.bs.modal.pwdh", function () {
                $(this).remove();
            });
            $(document).off("click.pwdh", "#pwdh_btnSearch").on("click.pwdh", "#pwdh_btnSearch", function () {
                self.loadData();
            });
            $(document).off("click.pwdh", "#pwdh_btnExcel").on("click.pwdh", "#pwdh_btnExcel", function () {
                self.exportExcel();
            });
            $(document).off("click.pwdh", "#pwdh_btnClose").on("click.pwdh", "#pwdh_btnClose", function () {
                $("#pwdh_modal").modal("hide");
            });
        },

        reset: function () {
            this.request?.abort();
            this.request = null;
            this.grid?.dispose();
            this.grid = null;
            $("#pwdh_user").val("0");
            $("#pwdh_type").val("-1");
            $("#pwdh_btnExcel").prop("disabled", true);
            $(document).off(".pwdh");
        },

        loadData: function () {
            var self = this;
            this.request?.abort();
            $("#pwdh_btnExcel").prop("disabled", true);
            var userId = parseInt($("#pwdh_user").val(), 10) || 0;
            var type = parseInt($("#pwdh_type").val(), 10);
            if (isNaN(type)) type = -1;
            this.grid.option("noDataText", "Loading password history...");
            this.request = $.ajax({
                url: "/PasswordHistory/PasswordHistoryData",
                type: "GET",
                data: { userId: userId, type: type },
                success: function (result) {
                    if (!Array.isArray(result)) {
                        self.showLoadError();
                        return;
                    }
                    self.grid.option({ dataSource: result, noDataText: "No matching password history." });
                    self.grid.updateDimensions();
                    $("#pwdh_btnExcel").prop("disabled", !result.length);
                },
                error: function (_, status) {
                    if (status !== "abort") self.showLoadError();
                }
            });
        },

        showLoadError: function () {
            var message = "Unable to load password history.";
            this.grid.option({ dataSource: [], noDataText: message });
            if (window.showToast) showToast("Error", message, false);
        },

        initGrid: function (data) {
            var self = this;
            $("#pwdh_gridContainer").dxDataGrid({
                dataSource: data,
                noDataText: "Loading password history...",
                height: "100%",
                allowColumnResizing: true,
                columnAutoWidth: true,
                grouping: { autoExpandAll: true },
                groupPanel: { visible: false },
                filterRow: { visible: false },
                headerFilter: { visible: false },
                columns: [
                    {
                        dataField: "username",
                        caption: "Username",
                        groupIndex: 0,
                        visible: false,
                        groupCellTemplate: function (container, options) {
                            $("<div>")
                                .text("Username: " + (options.value || ""))
                                .css({ fontWeight: "600", fontSize: "14px" })
                                .appendTo(container);
                        }
                    },
                    { dataField: "typedPassword", caption: "Typed Password" },
                    { dataField: "type", caption: "Type", width: 110 },
                    { dataField: "computerName", caption: "Computer Name", width: 180 },
                    { dataField: "computerIP", caption: "IP Address", width: 150 },
                    {
                        dataField: "createdDate",
                        caption: "Created Date",
                        dataType: "datetime",
                        format: "dd/MM/yyyy HH:mm",
                        width: 160
                    }
                ],
                paging: { enabled: false },
                pager: { visible: false },
                scrolling: {
                    mode: "standard",
                    rowRenderingMode: "virtual",
                    showScrollbar: "always"
                },
                showBorders: true
            });
            self.grid = $("#pwdh_gridContainer").dxDataGrid("instance");
            if (self.grid) self.grid.updateDimensions();
        },

        exportExcel: function () {
            var grid = this.grid || $("#pwdh_gridContainer").dxDataGrid("instance");
            if (!grid) return;
            var workbook = new ExcelJS.Workbook();
            var companyName = localStorage.getItem("CompanyName") || "";
            var worksheet = workbook.addWorksheet("Password History");
            worksheet.addRow([companyName]);
            worksheet.mergeCells("A1:F1");
            worksheet.getRow(1).font = { bold: true };
            var now = new Date();
            worksheet.addRow(["", "", "", "", "", now.toLocaleString("vi-VN")]);
            worksheet.addRow([]);
            var title = worksheet.addRow(["Password History"]);
            worksheet.mergeCells("A4:F4");
            title.font = { bold: true, size: 14 };
            title.alignment = { horizontal: "center" };
            worksheet.addRow([]);
            DevExpress.excelExporter.exportDataGrid({
                component: grid,
                worksheet: worksheet,
                autoFilterEnabled: true,
                topLeftCell: { row: 6, column: 1 }
            }).then(function () {
                workbook.xlsx.writeBuffer().then(function (buffer) {
                    saveAs(new Blob([buffer], { type: "application/octet-stream" }), "PasswordHistory.xlsx");
                });
            });
        }
    };

    window.openModalPasswordHistory = function () {
        pwdh_Module.init();
    };
    window.pwdh_Module = pwdh_Module;
</script>
