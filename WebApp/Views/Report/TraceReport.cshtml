@using DevExpress.XtraReports.UI
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    ViewBag.Title = ViewBag.ReportHeader;
    var roomClassList = ViewBag.RoomClassList as IEnumerable<dynamic>;
    var departmentList = ViewBag.DepartmentList as IEnumerable<dynamic>;
    var report = ViewBag.ReportName as XtraReport;
}

<style>
    .trace-filter-grid {
        display: grid;
        grid-template-columns: max-content max-content minmax(140px, 1fr) max-content minmax(140px, 1fr) max-content minmax(140px, 1fr);
        column-gap: 8px;
        row-gap: 8px;
        align-items: center;
        width: 100%;
        min-width: 0;
        box-sizing: border-box;
    }

    .trace-filter-grid > label {
        margin-right: 0 !important;
        margin-bottom: 0;
        white-space: nowrap;
    }

    .trace-filter-grid select,
    .trace-filter-grid [data-date-input] {
        width: 100%;
        min-width: 0;
        max-width: 100%;
    }

    .trace-check-grid {
        display: grid;
        grid-template-columns: max-content max-content max-content max-content max-content;
        column-gap: 16px;
        row-gap: 8px;
        align-items: center;
        width: 100%;
    }

    .trace-check-grid > .form-check {
        margin: 0 !important;
    }
</style>
<div class="text-center" id="reportTitle" style="font-size: 20px"></div>
<div class="sticky-header bg-white p-2 shadow-sm z-3">
    <div class="">
        <button id="btnPrint" class="mui-button mui-button-new">View</button>
        <button id="btnExportExcel" class="mui-button mui-button-new" type="button">Excel</button>
        <button id="btnExportPdf" class="mui-button mui-button-new" type="button">PDF</button>
    </div>
    <div class="mb-1" style="border: 1px solid #ced4da; border-radius: 6px; padding: 8px;">
        <div class="trace-filter-grid">
            <label class="fw-bold">Date Range:</label>
            <label>From Date:</label>
            <div data-date-input business-date data-format="DD/MM/YYYY" data-name="fromDate">
                <input type="text" class="date-ui form-control form-control-sm"
                       placeholder="dd/mm/yyyy" autocomplete="off" />
            </div>
            <label>To Date:</label>
            <div data-date-input business-date data-format="DD/MM/YYYY" data-name="toDate">
                <input type="text" class="date-ui form-control form-control-sm"
                       placeholder="dd/mm/yyyy" autocomplete="off" />
            </div>
            <span></span>
            <span></span>

            <label class="fw-bold">Filter:</label>
            <label>Room Class:</label>
            <select class="form-control form-control-sm report-dd" id="roomClass" name="selectType1">
                <option value="0">ALL</option>
                @if (roomClassList != null)
                {
                    foreach (var item in roomClassList)
                    {
                        <option value="@item.ID">@item.Code</option>
                    }
                }
            </select>
            <label>Department:</label>
            <select class="form-control form-control-sm report-dd" id="department" name="selectType2">
                <option value="0">ALL</option>
                @if (departmentList != null)
                {
                    foreach (var item in departmentList)
                    {
                        <option value="@item.ID">@item.Code</option>
                    }
                }
            </select>
            <label>Status:</label>
            <select class="form-control form-control-sm report-dd" id="selectType3" name="selectType3">
                <option value="0">ALL</option>
                <option value="1">UnResolved</option>
                <option value="2">Resolved</option>
            </select>
        </div>

        <div class="trace-check-grid" style="margin-top: 8px;">
            <label class="fw-bold mb-0">Include:</label>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="PseudoRoom" name="includeOptions" checked>
                <label class="form-check-label" for="PseudoRoom">Pseudo Room</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="Reserved" name="includeOptions" checked>
                <label class="form-check-label" for="Reserved">Reserved</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="CheckedIn" name="includeOptions">
                <label class="form-check-label" for="CheckedIn">Checked In</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="Dueout" name="includeOptions" checked>
                <label class="form-check-label" for="Dueout">Due out</label>
            </div>

            <span></span>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="Individual" name="includeOptions" checked>
                <label class="form-check-label" for="Individual">Individual</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="Blockcode" name="includeOptions" checked>
                <label class="form-check-label" for="Blockcode">Blockcode</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="VipOnly" name="includeOptions">
                <label class="form-check-label" for="VipOnly">VipOnly</label>
            </div>
            <span></span>
        </div>

        <div class="d-flex align-items-center" style="margin-top: 8px; gap: 6px;">
            <label class="fw-bold mb-0">Sort:</label>
            <label class="mb-0">Order:</label>
            <select class="form-control form-control-sm report-dd" id="sortOrder" name="sortOrder">
                <option>By Alphabetical</option>
                <option>By Room</option>
                <option>By Vip</option>
            </select>
        </div>
    </div>
</div>

<div class="mui-card">
    <div id="reportViewerContainer" class="gridContainer mt-2"></div>
</div>
<div id="loadingSpinner" style="display:none; position:fixed; top:50%; left:50%; transform:translate(-50%, -50%); z-index:1000;">
    <i class="fa-solid fa-spinner fa-spin"></i>
</div>

<script>
    $(document).ready(function () {
        var titleEl = document.getElementById("reportTitle");
        if (titleEl) titleEl.innerText = '@ViewBag.ReportTitle';
        window.initDateInputs();
    });

    $(document).off("click", "#btnPrint").on("click", "#btnPrint", function () {
        $("#loadingSpinner").show();

        let byAlphabetical = 0;
        let byRoom = 0;
        let byVip = 0;

        let selectedOption = $("#sortOrder").val();

        if (selectedOption === "By Alphabetical") {
            byAlphabetical = 1;
        } else if (selectedOption === "By Room") {
            byRoom = 1;
        } else if (selectedOption === "By Vip") {
            byVip = 1;
        }

        let pseudoRoom = $("#PseudoRoom").is(":checked") ? 1 : 0;
        let reserved = $("#Reserved").is(":checked") ? 1 : 0;
        let checkedIn = $("#CheckedIn").is(":checked") ? 1 : 0;
        let dueout = $("#Dueout").is(":checked") ? 1 : 0;
        let individual = $("#Individual").is(":checked") ? 1 : 0;
        let blockcode = $("#Blockcode").is(":checked") ? 1 : 0;
        let vipOnly = $("#VipOnly").is(":checked") ? 1 : 0;

        $.ajax({
            url: '/Report/TraceReportView',
            type: 'GET',
            data: {
                fromDate: $("#fromDate").val(),
                toDate: $("#toDate").val(),
                roomClass: $("#roomClass").val(),
                department: $("#department").val(),
                status: $("#selectType3").val(),
                byAlphabetical: byAlphabetical,
                byRoom: byRoom,
                byVip: byVip,
                pseudoRoom: pseudoRoom,
                reserved: reserved,
                checkedIn: checkedIn,
                dueout: dueout,
                individual: individual,
                blockcode: blockcode,
                vipOnly: vipOnly
            },
            traditional: true,
            success: function (result) {
                $("#reportViewerContainer").html(result);
                $("#loadingSpinner").hide();
            },
            error: function () {
                alert("Không thể tải báo cáo.");
                $("#loadingSpinner").hide();
            }
        });
    });
</script>
