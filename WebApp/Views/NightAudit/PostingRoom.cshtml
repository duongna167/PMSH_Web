@* Posting Room (Night Audit): đăng tiền phòng, Fixed Charge và Package cho các phòng được chọn theo một ngày.
   Popup theo chuẩn của dự án (ModalManager + mui-button), logic tương ứng màn frmPostingRoom của PMS desktop. *@

<div class="modal fade" id="por_modal" data-bs-backdrop="static" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content modal-full-height">
            <div class="modal-header bg-light py-2">
                <h5 class="modal-title">Posting Room</h5>
            </div>

            <div class="modal-body d-flex flex-column" style="height: calc(100vh - 120px);">
                <div class="py-2">
                    <button id="por_btnSearch" class="mui-button mui-button-view">Search</button>
                    <button id="por_btnCheckAll" class="mui-button mui-button-new">Check All</button>
                    <button id="por_btnPost" class="mui-button mui-button-save" data-action="tool_PostingRoom">Post</button>
                    <button class="mui-button mui-button-close" data-bs-dismiss="modal">Close</button>
                </div>

                <div class="mui-card mb-2 bg-light border-0 d-flex flex-column flex-grow-1 overflow-hidden">
                    <div class="p-2 flex-shrink-0">
                        <div class="row g-2 align-items-center">
                            <div class="col-xl-3 col-lg-4 col-md-6">
                                <div class="d-flex align-items-center gap-2">
                                    <label class="mb-0 fw-semibold text-nowrap">Date:</label>
                                    <div style="width:140px;" data-date-input data-format="DD/MM/YYYY" business-date data-name="por_date">
                                        <input type="text" class="date-ui form-control form-control-sm" placeholder="dd/mm/yyyy" autocomplete="off" />
                                    </div>
                                </div>
                            </div>
                            <div class="col-xl-9 col-lg-8 col-md-6">
                                <span class="text-muted small">Posts room charge, fixed charge and package of every in-house reservation in the checked rooms for the selected date.</span>
                            </div>
                        </div>
                    </div>

                    <div class="gridContainer mt-2 d-flex flex-column flex-grow-1 overflow-auto">
                        <div id="por_grid"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    var por_Module = {
        grid: null,
        allChecked: false,

        init: function () {
            this.initEvents();
            this.initDOMEvents();
        },

        initEvents: function () {
            const self = this;

            window.openModalPostingRoom = function () {
                if (typeof window.hasFunctionRight === "function" && !window.hasFunctionRight("tool_PostingRoom")) {
                    $("#por_btnPost").hide();
                }

                self.renderGrid([]);

                $("#por_modal").on("hidden.bs.modal", function () {
                    if ($("#por_grid").data("dxDataGrid")) $("#por_grid").dxDataGrid("dispose");
                    $("#por_grid").empty();
                    self.grid = null;
                    if (typeof reloadBusinessDate === "function") reloadBusinessDate();
                });
            };
        },

        initDOMEvents: function () {
            const self = this;
            $("#por_btnSearch").on("click", () => self.search());
            $("#por_btnCheckAll").on("click", () => self.toggleCheckAll());
            $("#por_btnPost").on("click", () => self.confirmPost());
        },

        // ---------------------------------------------------------------------------------------
        //  Tìm khách đang ở
        // ---------------------------------------------------------------------------------------
        search: function () {
            const self = this;
            $.ajax({
                url: "/NightAudit/SearchPostingRoom",
                type: "GET",
                loadingGrid: "#por_grid",
                success: function (res) {
                    if (!res.success) {
                        showToast("Error", res.message || "Unable to load data", false);
                        self.renderGrid([]);
                        return;
                    }
                    self.allChecked = false;
                    $("#por_btnCheckAll").text("Check All");
                    self.renderGrid(res.data || []);
                },
                error: function () { showToast("Error", "Unable to load data", false); }
            });
        },

        renderGrid: function (data) {
            const self = this;
            const fmtNum = v => (v === null || v === undefined || v === "") ? "" : Number(v).toLocaleString("en-US");

            if ($("#por_grid").data("dxDataGrid")) $("#por_grid").dxDataGrid("dispose");

            self.grid = $("#por_grid").dxDataGrid({
                dataSource: data,
                keyExpr: "ReservationID",
                height: "100%",
                width: "100%",
                showBorders: true,
                hoverStateEnabled: true,
                wordWrapEnabled: false,
                allowColumnResizing: true,
                columnResizingMode: "widget",
                columnAutoWidth: false,
                selection: { mode: "multiple", showCheckBoxesMode: "always", selectAllMode: "allPages" },
                scrolling: { mode: "standard", showScrollbar: "always", useNative: true },
                paging: { enabled: false },
                columns: [
                    { dataField: "ReservationID", visible: false },
                    { dataField: "Room", caption: "Rm", width: 60 },
                    { dataField: "MainGuest", caption: "MG", width: 40, alignment: "center" },
                    { dataField: "Name", caption: "Name", width: 200 },
                    { dataField: "BalanceUSD", caption: "Balance", width: 85, alignment: "right", customizeText: e => fmtNum(e.value) },
                    { dataField: "BalanceVND", caption: "Balance(VND)", width: 105, alignment: "right", customizeText: e => fmtNum(e.value) },
                    { dataField: "RoomType", caption: "R.Type", width: 65 },
                    { dataField: "Arrival", caption: "Arrival", dataType: "date", format: "dd/MM/yyyy", width: 90 },
                    { dataField: "Departure", caption: "Departure", dataType: "date", format: "dd/MM/yyyy", width: 90 },
                    { dataField: "Adult", caption: "A", width: 40, alignment: "center" },
                    { dataField: "Child", caption: "1", width: 35, alignment: "center" },
                    { dataField: "Child1", caption: "2", width: 35, alignment: "center" },
                    { dataField: "Child2", caption: "3", width: 35, alignment: "center" },
                    { dataField: "Status", caption: "Status", width: 90 },
                    { dataField: "Rate", caption: "Rate", width: 90, alignment: "right", customizeText: e => fmtNum(e.value) },
                    { dataField: "ReservationHolder", caption: "Holder", width: 160 },
                    { dataField: "Group", caption: "Group", width: 100 },
                    { dataField: "ConfirmationNo", caption: "Confirm.No", width: 95 },
                    { dataField: "CRSNo", caption: "CRS.No", width: 80 },
                    { dataField: "Packages", caption: "Pkg", width: 80 },
                    { dataField: "Company", caption: "Company", width: 110 },
                    { dataField: "Agent", caption: "Agent", width: 110 },
                    { dataField: "RateCode", caption: "R.Code", width: 80 },
                    { dataField: "Source", caption: "Source", width: 100 },
                    { dataField: "Market", caption: "Market", width: 100 }
                ]
            }).dxDataGrid("instance");
        },

        toggleCheckAll: function () {
            if (!this.grid) return;
            this.allChecked = !this.allChecked;
            if (this.allChecked) this.grid.selectAll(); else this.grid.clearSelection();
            $("#por_btnCheckAll").text(this.allChecked ? "Un Check" : "Check All");
        },

        // ---------------------------------------------------------------------------------------
        //  Đăng tiền
        // ---------------------------------------------------------------------------------------
        confirmPost: function () {
            const self = this;
            const rows = self.grid ? self.grid.getSelectedRowsData() : [];
            const rooms = Array.from(new Set(rows.map(r => r.Room).filter(r => r)));
            const date = $("#por_date").val() || window.dateSystem;

            if (!date) { showToast("Warning", "Please select a date.", false); return; }
            if (!rooms.length) { showToast("Warning", "Please select at least one room.", false); return; }

            const p = date.split("-");
            const text = "Post room charge, fixed charge and package of " + rooms.length + " room(s) for " + p[2] + "/" + p[1] + "/" + p[0] + "?";

            if (window.Swal) {
                Swal.fire({ title: text, text: "Charges already posted for this date are not checked and may be posted again.", icon: "question",
                    showCancelButton: true, confirmButtonText: "Yes", cancelButtonText: "No" })
                    .then(r => { if (r.isConfirmed) self.post(date, rooms); });
            } else if (confirm(text)) {
                self.post(date, rooms);
            }
        },

        post: function (date, rooms) {
            const self = this;
            $("#por_btnPost").prop("disabled", true);

            $.ajax({
                url: "/NightAudit/PostRooms",
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify({ date: date, rooms: rooms }),
                headers: { "X-CSRF-TOKEN-HEADERNAME": jQuery("input[name='__RequestVerificationToken']").val() },
                success: function (res) {
                    showToast(res.success ? "Success" : "Error", res.message, !!res.success);
                    if (res.success) self.search();
                },
                error: function (xhr) {
                    showToast("Error", xhr.status === 403 ? "Access Denied" : "Server error occurred.", false);
                },
                complete: function () { $("#por_btnPost").prop("disabled", false); }
            });
        }
    };

    $(document).ready(function () {
        por_Module.init();
    });
</script>
