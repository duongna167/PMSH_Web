@{
    ViewBag.Title = ViewBag.ReportHeader;
}
<style>
    .gridContainer { margin: 0px 8px; }
    .sticky-header label, .sticky-header .form-control-sm { font-size: 14px; line-height: 1.2; }
    .sticky-header .form-control-sm { padding: 2px 8px; height: 28px; }
    .sticky-header label { margin-bottom: 0; white-space: nowrap; }
    .nrp-grid {
        display: grid;
        grid-template-columns: max-content max-content 160px;
        column-gap: 6px;
        row-gap: 8px;
        align-items: center;
        width: max-content;
        max-width: 100%;
    }
    .nrp-grid > label { margin: 0; white-space: nowrap; }
    .nrp-grid input { width: 160px; min-width: 128px; max-width: 220px; }
    .gb-foot { font-size: 13px; margin: 8px 12px 0; display: none; }
    .gb-foot div { margin-bottom: 2px; }
    #gridContainer .dx-datagrid-rowsview .dx-selection { background-color: #01579b !important; color: white !important; }
    #gridContainer .dx-datagrid-rowsview .dx-selection * { color: white !important; }
</style>
<div class="text-center" id="reportTitle" style="font-size: 20px"></div>
<div class="sticky-header bg-white p-2 shadow-sm z-3">
    <div class="">
        <button id="btnPrint" class="mui-button mui-button-new">View</button>
        <button id="btnExportExcel" class="mui-button mui-button-new" type="button">Excel</button>
        <button id="btnExportPdf" class="mui-button mui-button-new" type="button">PDF</button>
    </div>
    <div class="mb-1" style="border: 1px solid #ced4da; border-radius: 6px; padding: 8px;">
        <div class="nrp-grid">
            <label class="fw-bold">Filter</label>
            <label>Conf.No:</label>
            <input type="text" id="confirmationNo" class="form-control form-control-sm" />
        </div>
    </div>
</div>
<div class="mui-card">
    <div id="gridWrapper" class="mt-2" style="max-height: 500px;">
        <div class="gridContainer mt-2" id="gridContainer"></div>
    </div>
    <div class="gb-foot" id="gbFoot">
        <div id="gbRooms"></div>
        <div id="gbHolder"></div>
        <div id="gbGroup"></div>
        <div id="gbInHouse"></div>
    </div>
</div>
<div id="loadingSpinner" style="display:none; position:fixed; top:50%; left:50%; transform:translate(-50%, -50%); z-index:1000;">
    <i class="fa-solid fa-spinner fa-spin"></i>
</div>
<script>
    function pick(row, names) {
        for (var i = 0; i < names.length; i++) {
            if (row[names[i]] !== undefined && row[names[i]] !== null && row[names[i]] !== "") return row[names[i]];
        }
        return "";
    }
    function guestMark(r) {
        var name = pick(r, ["Name", "GuestName", "name"]);
        var main = pick(r, ["MainGuest", "mainGuest"]);
        var master = pick(r, ["IsMasterFolio", "isMasterFolio"]);
        if (master === true || master === "true" || master === "1" || master === 1) return "*** " + name;
        if (String(main) === "0") return "* " + name;
        return name;
    }
    $(document).ready(function () {
        document.getElementById("reportTitle").innerText = '@ViewBag.ReportTitle';
        loadSearch();
        $("#confirmationNo").on("keydown", function (e) {
            if (e.key === "Enter") { e.preventDefault(); loadSearch(); }
        });
    });
    function loadSearch() {
        $("#gbFoot").hide();
        $("#loadingSpinner").show();
        $.ajax({
            url: "/Report/GroupBalanceSearch", type: "GET",
            data: { confirmationNo: $("#confirmationNo").val() },
            success: function (result) {
                if (typeof result === "string") { alert(result); $("#loadingSpinner").hide(); return; }
                bindSearch(result);
                $("#loadingSpinner").hide();
            },
            error: function () { alert("Không thể tải báo cáo."); $("#loadingSpinner").hide(); }
        });
    }
    function bindSearch(data) {
        var rows = (Array.isArray(data) ? data : []).map(function (r) {
            return {
                confirmationNo: pick(r, ["ConfirmationNo", "confirmationNo"]),
                groupName: pick(r, ["GroupCode", "GroupName", "groupCode"]),
                holder: pick(r, ["GuestName", "guestName"])
            };
        });
        $("#gridContainer").dxDataGrid({
            dataSource: rows, height: 500, allowColumnResizing: true,
            columns: [
                { dataField: "confirmationNo", caption: "Conf.No", width: 110 },
                { dataField: "groupName", caption: "Group Name", minWidth: 180 },
                { dataField: "holder", caption: "Reservation Holder", minWidth: 220 }
            ],
            paging: { pageSize: 25 },
            scrolling: { useNative: true, showScrollbar: "always" },
            pager: { visible: true, allowedPageSizes: [25, 50, "all"], showPageSizeSelector: true, showInfo: true, showNavigationButtons: true },
            filterRow: { visible: true, applyFilter: "auto" },
            headerFilter: { visible: true },
            showBorders: true,
            onRowClick: function (e) {
                if (e.data && e.data.confirmationNo) $("#confirmationNo").val(e.data.confirmationNo);
            },
            onRowDblClick: function (e) {
                if (e.data && e.data.confirmationNo) {
                    $("#confirmationNo").val(e.data.confirmationNo);
                    loadDetail();
                }
            }
        });
    }
    function bindDetail(payload) {
        var rows = (Array.isArray(payload.rows) ? payload.rows : []).map(function (r) {
            return {
                roomNo: pick(r, ["RoomNo", "roomNo"]),
                folNo: pick(r, ["Fol.No", "FolNo", "folNo"]),
                arrival: pick(r, ["Arrival", "arrival"]),
                departure: pick(r, ["Departure", "departure"]),
                guestName: guestMark(r),
                pck: pick(r, ["Pck", "pck"]),
                nat: pick(r, ["Nat", "nat"]),
                balanceUsd: pick(r, ["BalanceUSD", "balanceUSD"]),
                balanceVnd: pick(r, ["BalanceVND", "balanceVND"])
            };
        });
        $("#gridContainer").dxDataGrid({
            dataSource: rows, height: 500, allowColumnResizing: true,
            columns: [
                { dataField: "roomNo", caption: "Ro No", width: 80 },
                { dataField: "folNo", caption: "Fol.No", width: 90 },
                { dataField: "arrival", caption: "Arrival", dataType: "date", format: "dd/MM/yyyy", width: 100 },
                { dataField: "departure", caption: "Departure", dataType: "date", format: "dd/MM/yyyy", width: 100 },
                { dataField: "guestName", caption: "Guest Name", minWidth: 200 },
                { dataField: "pck", caption: "Pck", width: 80 },
                { dataField: "nat", caption: "Nat", width: 70 },
                { dataField: "balanceUsd", caption: "Balance USD", width: 120, dataType: "number", format: "#,##0.##" },
                { dataField: "balanceVnd", caption: "Balance VND", width: 120, dataType: "number", format: "#,##0.##" }
            ],
            summary: {
                totalItems: [
                    { column: "balanceUsd", summaryType: "sum", valueFormat: "#,##0.##", displayFormat: "Total: {0}" },
                    { column: "balanceVnd", summaryType: "sum", valueFormat: "#,##0.##", displayFormat: "{0}" }
                ]
            },
            paging: { pageSize: 25 },
            scrolling: { useNative: true, showScrollbar: "always" },
            pager: { visible: true, allowedPageSizes: [25, 50, "all"], showPageSizeSelector: true, showInfo: true, showNavigationButtons: true },
            filterRow: { visible: true, applyFilter: "auto" },
            headerFilter: { visible: true },
            showBorders: true
        });
        $("#gbRooms").text("Total Rooms : " + (payload.totalRooms ?? 0));
        $("#gbHolder").text("Res. Holder : " + (payload.holder || ""));
        $("#gbGroup").text("Group Name: " + (payload.groupName || ""));
        $("#gbInHouse").text("Rooms in-house Guests : " + (payload.inHouse ?? 0));
        $("#gbFoot").show();
    }
    function loadDetail() {
        var conf = ($("#confirmationNo").val() || "").trim();
        if (!conf) { loadSearch(); return; }
        $("#loadingSpinner").show();
        $.ajax({
            url: "/Report/GroupBalanceDetail", type: "GET",
            data: { confirmationNo: conf },
            success: function (result) {
                if (typeof result === "string") { alert(result); $("#loadingSpinner").hide(); return; }
                bindDetail(result);
                $("#loadingSpinner").hide();
            },
            error: function () { alert("Không thể tải báo cáo."); $("#loadingSpinner").hide(); }
        });
    }
    $(document).off("click", "#btnPrint").on("click", "#btnPrint", function () {
        var conf = ($("#confirmationNo").val() || "").trim();
        if (conf) loadDetail(); else loadSearch();
    });
    $(document).off("click", "#btnExportExcel").on("click", "#btnExportExcel", function () {
        const grid = $("#gridContainer").dxDataGrid("instance"); if (!grid) return;
        const workbook = new ExcelJS.Workbook(); const worksheet = workbook.addWorksheet("Report");
        const selectedReport = '@ViewBag.ReportTitle';
        worksheet.addRow([localStorage.getItem("CompanyName") || ""]);
        DevExpress.excelExporter.exportDataGrid({ component: grid, worksheet: worksheet, autoFilterEnabled: true, topLeftCell: { row: 3, column: 1 } })
            .then(function () { workbook.xlsx.writeBuffer().then(function (buffer) { saveAs(new Blob([buffer], { type: "application/octet-stream" }), selectedReport + ".xlsx"); }); });
    });
    $(document).off("click", "#btnExportPdf").on("click", "#btnExportPdf", function () {
        const grid = $("#gridContainer").dxDataGrid("instance"); if (!grid) return;
        const { jsPDF } = window.jspdf; const doc = new jsPDF({ orientation: "landscape", unit: "pt", format: "A4" });
        const selectedReport = '@ViewBag.ReportTitle';
        grid.getDataSource().load().then(data => {
            const columns = grid.getVisibleColumns().filter(c => c.dataField);
            doc.text(selectedReport, doc.internal.pageSize.getWidth() / 2, 40, { align: "center" });
            doc.autoTable({ startY: 56, head: [columns.map(c => c.caption)], body: data.map(row => columns.map(c => row[c.dataField] ?? "")), styles: { fontSize: 8 } });
            doc.save(selectedReport + ".pdf");
        });
    });
</script>
