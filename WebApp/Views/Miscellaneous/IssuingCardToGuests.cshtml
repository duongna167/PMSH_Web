@{ ViewData["Title"] = "Issuing Card To Guests"; }
<style>
    #igc_page { width: 100%; margin: 4px 0 12px; font-size: 13px; }
    #igc_page [hidden] { display: none !important; }
    #igc_page .header { justify-content: center; margin-bottom: 6px; }
    #igc_page .mui-card { margin: 0 0 8px; padding: 8px; min-width: 0; }
    #igc_page label { margin: 0; white-space: nowrap; }
    .igc-toolbar { display: flex; gap: 4px; flex-wrap: wrap; align-items: center; }
    .igc-toolbar .mui-button { min-width: 80px; margin: 0; }
    #igc_scan { width: 230px; margin-left: 24px; }
    .igc-top { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 1.6fr) minmax(0, 2.8fr); gap: 8px; margin-bottom: 8px; }
    .igc-top > .mui-card { margin: 0 !important; }
    .igc-title { display: flex; align-items: center; gap: 8px; padding-bottom: 5px; margin-bottom: 8px; border-bottom: 2px solid #ececec; font-size: 14px; font-weight: 600; color: #000; }
    .igc-title i { background: #027C75; color: #fff; padding: 4px; font-size: 12px; }
    .igc-search { display: grid; grid-template-columns: auto minmax(0, 1fr) auto minmax(0, 1.8fr); gap: 4px 8px; align-items: center; }
    .igc-search > label { text-align: right; }
    .igc-line { display: flex; gap: 6px; align-items: center; min-width: 0; }
    #igc_page .igc-check { display: inline-flex; align-items: center; gap: 5px; }
    #igc_page .igc-check input, #igc_page .igc-line > input[type="checkbox"] { flex-shrink: 0; margin: 0; position: static; float: none; }
    #igc_page [data-date-input] { flex: 0 0 125px; width: 125px; }
    /* Chiều cao ô nhập: ô chữ và ngày 28, Search Type 25, riêng Zone 27 */
    #igc_page input.form-control { height: 28px; min-height: 28px; padding-top: 0; padding-bottom: 0; }
    #igc_page select.form-select { height: 25px; min-height: 25px; padding-top: 0; padding-bottom: 0; }
    #igc_page .ts-wrapper .ts-control { height: 27px !important; min-height: 27px !important; max-height: 27px !important; }
    #igc_page .ts-wrapper .ts-control .item { height: 22px !important; }
    .igc-reader { color: #1d4ed8; font-style: italic; }
    .igc-options { display: flex; flex-direction: column; gap: 14px; align-items: flex-start; font-weight: 600; font-size: 14px; }
    .igc-notes { margin: 0; padding-left: 18px; line-height: 2; }
    .igc-notes em { color: #9f1239; }
    #igc_page .dx-datagrid .dx-row > td { padding-left: 6px !important; padding-right: 6px !important; }
    @@media (max-width: 1199.98px) {
        .igc-top { grid-template-columns: minmax(0, 1fr); }
    }
    @@media (max-width: 575.98px) {
        .igc-search { grid-template-columns: auto minmax(0, 1fr); }
        #igc_scan { margin-left: 0; }
    }
</style>
<div id="igc_page">
    <div class="header">
        <h3 id="content-title">Issuing Card To Guests</h3>
    </div>
    @Html.AntiForgeryToken()

    <div class="igc-toolbar mui-card">
        <button type="button" class="mui-button mui-button-search" id="igc_search">Search</button>
        <button type="button" class="mui-button mui-button-view" id="igc_checkAll">Check All</button>
        <button type="button" class="mui-button mui-button-save" id="igc_ok" data-code="misc_LoadCardsforGuestsAddCard">OK</button>
        <button type="button" class="mui-button button-report-delete" id="igc_cancel" data-code="misc_LoadCardsforGuestsCancelCard">Cancel Card</button>
        <input id="igc_scan" class="form-control form-control-sm" maxlength="8" inputmode="numeric" autocomplete="off" placeholder="Scan card here">
    </div>

    <div class="igc-top">
        <div class="mui-card">
            <div class="igc-title"><i class="fa-solid fa-sliders"></i> Info search</div>
            <div class="igc-search">
                <label for="igc_firstName">Fst.Name</label>
                <input id="igc_firstName" class="form-control form-control-sm igc-enter" maxlength="20">
                <label>Arr.From</label>
                <div class="igc-line">
                    <div data-date-input data-format="DD/MM/YYYY" data-name="igc_arrFrom" data-default="@ViewBag.BusinessDate">
                        <input type="text" class="date-ui form-control form-control-sm" autocomplete="off">
                    </div>
                    <input type="checkbox" id="igc_useArrFrom" class="form-check-input" checked aria-label="Use Arr.From">
                    <label>Arr.To</label>
                    <div data-date-input data-format="DD/MM/YYYY" data-name="igc_arrTo" data-default="@ViewBag.BusinessDate">
                        <input type="text" class="date-ui form-control form-control-sm" autocomplete="off">
                    </div>
                    <input type="checkbox" id="igc_useArrTo" class="form-check-input" checked aria-label="Use Arr.To">
                </div>

                <label for="igc_confNo">Conf.No</label>
                <input id="igc_confNo" class="form-control form-control-sm igc-enter" maxlength="10">
                <label for="igc_name">Name</label>
                <div class="igc-line">
                    <input id="igc_name" class="form-control form-control-sm igc-enter" maxlength="100">
                    <label class="igc-check"><input type="checkbox" id="igc_sharer" class="form-check-input" checked> Room Sharer</label>
                </div>

                <label for="igc_crsNo">CRS No/GC</label>
                <input id="igc_crsNo" class="form-control form-control-sm igc-enter" maxlength="25">
                <label for="igc_holder">Resv.Holder</label>
                <input id="igc_holder" class="form-control form-control-sm igc-enter" maxlength="200">

                <label for="igc_roomNo">Room No</label>
                <input id="igc_roomNo" class="form-control form-control-sm igc-enter" maxlength="50">
                <label for="igc_searchType">Search Type</label>
                <select id="igc_searchType" class="form-select form-select-sm">
                    <option value="0">General</option>
                    <option value="1">Guest In House</option>
                    <option value="2">Reservation</option>
                    <option value="3">Due In</option>
                    <option value="4">Checked In</option>
                    <option value="5">Due Out</option>
                    <option value="6">Checked Out</option>
                    <option value="7">Arrival &amp; Checked In Today</option>
                    <option value="8">Check Out Today</option>
                </select>

                <label>Zone</label>
                <div style="min-width:0">
                    <select id="igc_zone" class="tomselect-custom" multiple>
                        @foreach (string code in ViewBag.ZoneCodes)
                        {
                            <option value="@code">@code</option>
                        }
                    </select>
                </div>
                <span></span>
                <label class="igc-check"><input type="checkbox" id="igc_showHasCard" class="form-check-input" checked> Show more guest has card</label>

                <label for="igc_cardId">Card ID</label>
                <input id="igc_cardId" class="form-control form-control-sm igc-enter" maxlength="8" inputmode="numeric">
                <span></span>
                <label class="igc-check igc-reader"><input type="checkbox" id="igc_byReader" class="form-check-input"> Search by card ID from Card reader. Click this checkbox</label>
            </div>
        </div>

        <div class="mui-card">
            <div class="igc-title"><i class="fa-solid fa-gear"></i> Options</div>
            <div class="igc-options">
                <label class="igc-check"><input type="checkbox" id="igc_addCard" class="form-check-input" checked> Add Card</label>
                <label class="igc-check text-muted"><input type="checkbox" class="form-check-input" disabled> Cut Key</label>
                <div>Count: <span id="igc_count">0</span></div>
            </div>
        </div>

        <div class="mui-card">
            <div class="igc-title"><i class="fa-solid fa-circle-info"></i> Notes</div>
            <ol class="igc-notes">
                <li>Select guest list to add card or cutkey</li>
                <li>Insert card to card reader --&gt; Add card for guests</li>
                <li>Options: Choose add card or cutkey or both</li>
                <li>Click OK to confirm --&gt; Add card for guests<br><em>(After issuing, card will be used for meals)</em></li>
            </ol>
        </div>
    </div>

    <div class="mui-card">
        <div id="igc_grid" class="gridContainer"></div>
    </div>
</div>

<script>
    var igc_Module = (function () {
        const root = '#igc_page';
        const CARD_ID_LENGTH = 8;
        let grid, searchRequest, processing = false;
        let rows = [], pending = 0, scanQueue = Promise.resolve();

        const col = (field, caption, width, extra) => Object.assign({ dataField: field, caption: caption, width: width }, extra);
        const date = (field, caption) => col(field, caption, 90, { dataType: 'date', format: 'dd/MM/yy' });
        const value = name => $('#' + name).val();
        const checked = name => $('#' + name).is(':checked');
        const notify = message => showToast('Warning', message, false);
        const errorText = (xhr, fallback) => xhr.responseJSON?.message || xhr.responseJSON?.msg || fallback;
        const ask = title => Swal.fire({ icon: 'question', title: title, showCancelButton: true, confirmButtonText: 'Yes', cancelButtonText: 'No' });

        function post(url, data) {
            data.__RequestVerificationToken = $(root + ' input[name="__RequestVerificationToken"]').val();
            return $.ajax({ url: url, type: 'POST', data: data, traditional: true });
        }

        function setCount(next) {
            pending = next;
            $('#igc_count').text(pending);
        }

        function search() {
            if (searchRequest) searchRequest.abort();
            grid.beginCustomLoading('Loading...');
            searchRequest = $.get('/Miscellaneous/SearchCardGuests', {
                firstName: value('igc_firstName'), confirmationNo: value('igc_confNo'), crsNo: value('igc_crsNo'),
                roomNo: value('igc_roomNo'), zone: ($('#igc_zone').val() || []).join(','), guestName: value('igc_name'),
                rsvHolder: value('igc_holder'), cardID: value('igc_cardId'), roomSharer: checked('igc_sharer'),
                showHasCard: checked('igc_showHasCard'), searchType: value('igc_searchType'),
                arrFrom: checked('igc_useArrFrom') ? value('igc_arrFrom') : '',
                arrTo: checked('igc_useArrTo') ? value('igc_arrTo') : ''
            })
                .done(data => {
                    rows = data;
                    grid.clearSelection();
                    grid.option('dataSource', rows);
                    setCount(0);
                    $('#igc_checkAll').text('Check All');
                })
                .fail((xhr, status) => { if (status !== 'abort') notify(errorText(xhr, 'Cannot search guests.')); })
                .always(() => grid.endCustomLoading());
        }

        // Gán thẻ cho khách đầu tiên được tích mà chưa có thẻ (AddCard bên WinForms)
        function assignCard(cardId) {
            return $.get('/Miscellaneous/CheckGuestCard', { id: cardId })
                .then(res => {
                    if (!res.exists) return notify(cardId + ': This card not already exists on the system.');
                    if (rows.some(x => x.cardid === cardId)) return notify(cardId + ': This card already exists on the grid.');
                    const selected = new Set(grid.getSelectedRowKeys());
                    const guest = rows.find(x => selected.has(x.reservationid) && !x.cardid);
                    if (!guest) return notify('Unable to add card to guests!');
                    guest.cardid = cardId;
                    setCount(pending + 1);
                    grid.refresh();
                })
                .catch(xhr => notify(errorText(xhr, 'Cannot check card.')));
        }

        function receiveCard(code) {
            code = String(code).trim();
            if (checked('igc_byReader')) {
                $('#igc_cardId').val(code);
                search();
                return;
            }
            // Xử lý lần lượt để quét liên tiếp vẫn gán đúng thứ tự
            scanQueue = scanQueue.then(() => assignCard(code));
        }

        function showResult(res, successTitle) {
            const skipped = res.skipped || [];
            return Swal.fire({
                icon: skipped.length ? 'warning' : 'success',
                title: res.processed ? successTitle + ' (' + res.processed + ')' : 'No guest was processed',
                text: skipped.length ? 'These guests were not processed:\n- ' + skipped.join('\n- ') : '',
                didOpen: popup => { const text = popup.querySelector('.swal2-html-container'); if (text) text.style.whiteSpace = 'pre-line'; }
            });
        }

        function send(url, data, successTitle, button) {
            processing = true;
            $(button).prop('disabled', true);
            post(url, data)
                .done(res => {
                    showResult(res, successTitle);
                    $('#igc_cardId').val('');
                    search();
                })
                .fail(xhr => Swal.fire({ icon: 'warning', title: 'Warning', text: errorText(xhr, 'Cannot process card.') }))
                .always(() => { processing = false; $(button).prop('disabled', false); });
        }

        async function addCards() {
            if (processing) return;
            if (!pending) return notify('You must be add card to guests!');
            if (!checked('igc_addCard')) return notify('Please choose options to continue!');
            if (!(await ask('Are you sure you want to create account [card] for all guests you selected?')).isConfirmed) return;

            // Chỉ lưu những thẻ vừa gán, chưa có trong database
            const data = {};
            rows.filter(x => x.cardid && !x.iscard).forEach((x, i) => {
                data['items[' + i + '].reservationId'] = x.reservationid;
                data['items[' + i + '].cardId'] = x.cardid;
            });
            send('/Miscellaneous/AddGuestCards', data, 'Add card Successfully', '#igc_ok');
        }

        async function cancelCards() {
            if (processing) return;
            const guests = grid.getSelectedRowsData().filter(x => x.iscard === 'Y');
            if (!guests.length) return notify('Select guest existing card to cancel!');
            if (!(await ask('Are you sure you want to cancel account [card] for all guests you selected?')).isConfirmed) return;
            send('/Miscellaneous/CancelGuestCards', { reservationIds: guests.map(x => x.reservationid) }, 'Cancel card Successfully', '#igc_cancel');
        }

        function toggleCheckAll() {
            const check = $('#igc_checkAll').text() === 'Check All';
            if (check) grid.selectAll(); else grid.clearSelection();
            $('#igc_checkAll').text(check ? 'Un Check' : 'Check All');
        }

        function toggleDate(name, enabled) {
            $(root + ' [data-name="' + name + '"]').find('input, button').prop('disabled', !enabled);
        }

        function changeSearchType() {
            const index = Number(value('igc_searchType'));
            const useFrom = [0, 2, 6].includes(index), useTo = [0, 2].includes(index);
            $('#igc_useArrFrom').prop('checked', useFrom); toggleDate('igc_arrFrom', useFrom);
            $('#igc_useArrTo').prop('checked', useTo); toggleDate('igc_arrTo', useTo);
            search();
        }

        // Đầu đọc thẻ gắn vào server gửi mã về qua SignalR
        function listenCardReader() {
            const connection = new signalR.HubConnectionBuilder().withUrl('/tagScanHub').build();
            connection.on('ReceiveCode', receiveCard);
            connection.start().catch(err => console.error('Card reader connection failed:', err));
        }

        function init() {
            window.initDateInputs(document.getElementById('igc_page'));
            initTomSelect('#igc_zone');
            grid = $('#igc_grid').dxDataGrid({
                dataSource: [], keyExpr: 'reservationid', height: 420,
                showBorders: true, showRowLines: true, allowColumnResizing: true, columnResizingMode: 'widget',
                paging: { enabled: false }, scrolling: { mode: 'virtual', showScrollbar: 'always' }, noDataText: '',
                filterRow: { visible: true },
                selection: { mode: 'multiple', showCheckBoxesMode: 'always', selectAllMode: 'allPages' },
                columns: [
                    col('cardid', 'Card ID', 100), col('confirmationno', 'Conf. No', 90), col('mainguest', 'M', 40),
                    col('nat', 'Nat', 55), col('title', 'Title', 55), col('account', 'Guest Name', 180),
                    col('dateofbirth', 'Date of Birth', 100), col('passport', 'Passport', 100), col('identitycard', 'Identity Card', 110),
                    col('roomno', 'Ro. No', 80), col('roomtype', 'Ro. Type', 80), date('arrivaldate', 'Arr. Date'),
                    col('noofnight', 'N', 40), date('departuredate', 'Dep. Date'), col('package', 'Package', 80),
                    col('noofadult', 'A', 40), col('noofchild', 'C', 40), col('noofchild1', 'C1', 40), col('noofchild2', 'C2', 40),
                    col('statustext', 'Status', 100), col('reservationholder', 'Reservation Holder', 180), col('address', 'Address', 200)
                ],
                summary: {
                    totalItems: [
                        { column: 'cardid', summaryType: 'count', displayFormat: '{0}' },
                        { column: 'account', summaryType: 'count', displayFormat: '{0}' }
                    ]
                },
                // Chữ đỏ: thẻ vừa gán, chưa lưu
                onRowPrepared: e => { if (e.rowType === 'data' && e.data.cardid && !e.data.iscard) e.rowElement.css('color', 'red'); }
            }).dxDataGrid('instance');

            $('#igc_search').on('click', search);
            $('#igc_checkAll').on('click', toggleCheckAll);
            $('#igc_ok').on('click', addCards);
            $('#igc_cancel').on('click', cancelCards);
            $('#igc_searchType').on('change', changeSearchType);
            $('#igc_useArrFrom').on('change', function () { toggleDate('igc_arrFrom', this.checked); });
            $('#igc_useArrTo').on('change', function () { toggleDate('igc_arrTo', this.checked); });
            $(root + ' .igc-enter').on('keydown', e => { if (e.key === 'Enter') { e.preventDefault(); search(); } });
            // Gõ/quét đủ mã vào ô trên cùng là gán thẻ
            $('#igc_scan').on('input', function () {
                const code = this.value.replace(/\D/g, '');
                this.value = code;
                if (code.length !== CARD_ID_LENGTH) return;
                this.value = '';
                receiveCard(code);
            });

            listenCardReader();
            search();
        }

        return { init: init };
    })();
    // Chạy sau khi layout nạp xong site.js (initDateInputs)
    $(function () { igc_Module.init(); });
</script>
