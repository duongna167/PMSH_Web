<script>
    var pro_ind_Module = {

        init: function () {
            this.initDOMEvents();
            this.initStateControls();
            this._selectsReady = this.initSelects();
        },

        initDOMEvents: function () {
            const self = this;

            $('#ind_btnSearch').off('click').on('click', function() {
                self.openModalSearch();
            });

            $('#ind_btnSave').off('click').on('click', function() {self.saveProfile();});

            $('#ind_btnOptions').off('click').on('click', function() { self.openOptions(); });

            $('#ind_btnClear').off('click').on('click', function() {self.clearForm();});

            $("#modalIndividual").off("hidden.bs.modal.indClear").on("hidden.bs.modal.indClear", function () {
                self.clearForm();
            });

            $('#ind_fileUpload').off('change').on('change', this.handleImage);

            $('#ind_search_name, #ind_search_first').off('keydown').on('keydown', function (e) {

                if (e.key === "Enter") {
                    pro_ind_Module.searchIndividual();
                }

            });

            $('#ind_txtFirstName, #ind_txtMiddleName, #ind_txtLastName').off('input').on('input', function() {
                self.syncFullNameFromParts();
            });

            $("#ind_txtFullName").off("blur").on("blur", function() {
                self.syncPartsFromFullName();
            });

            $("#ind_txtFullName").off("keydown").on("keydown", function(e) {
                if (e.which === 13) {
                    e.preventDefault();
                    self.syncPartsFromFullName();
                    $("#ind_txtFirstName").focus();
                }
            });

            $("#ind_txtTitle").off("change").on("change", function() {
                const lastName = $("#ind_txtLastName").val();
                const titleText = $(this).find("option:selected").text();
                if (lastName && titleText && titleText !== "Enter or select...") {
                    $("#ind_txtSalutation").val("Dear " + titleText + " " + GuestNameEngine.smartCapitalize(lastName));
                }
            });

            $("#ind_txtCountry").off("change.indCity").on("change.indCity", function () {
                if (self._suspendCityReload) return;
                self.loadCities($(this).val());
            });
        },

        handleImage: function (event) {

            const file = event.target.files[0];
            if (!file) return;

            const reader = new FileReader();

            reader.onload = (e) => {
                $('#ind_imgPreview').attr('src', e.target.result);
            };

            reader.readAsDataURL(file);
        },

        fillSelect: function (selector, source, mapFn) {
            const $el = $(selector);
            const apply = function (raw) {
                const prev = $el.val();
                $el.empty().append($("<option>").val("").text("Enter or select..."));
                if (!Array.isArray(raw)) return;
                raw.forEach(function (item) {
                    const mapped = mapFn(item);
                    if (mapped.value == null || mapped.value === "") return;
                    $el.append($("<option>").val(String(mapped.value)).text(mapped.text || ""));
                });
                if (prev) $el.val(prev);
            };
            if (Array.isArray(source)) {
                apply(source);
                return $.Deferred().resolve().promise();
            }
            return $.get(source).then(apply);
        },

        loadCities: function (countryId, cityValue) {
            const $city = $("#ind_txtCity");
            const id = parseInt(countryId, 10) || 0;
            const pickCity = function () {
                if (cityValue == null || cityValue === "" || cityValue === 0 || cityValue === "0" || cityValue === "null") return;
                const v = String(cityValue);
                if ($city.find("option").filter(function () { return this.value === v; }).length) {
                    $city.val(v);
                    return;
                }
                const match = $city.find("option").filter(function () {
                    return $(this).text() === v || $(this).text().indexOf(v + "-") === 0;
                }).first();
                if (match.length) $city.val(match.val());
                else $city.append($("<option>").val(v).text(v)).val(v);
            };
            if (id <= 0) {
                $city.empty().append($("<option>").val("").text("Enter or select..."));
                return $.Deferred().resolve().promise();
            }
            return this.fillSelect("#ind_txtCity", "/Profile/GetAllCity?countryId=" + id, function (item) {
                return {
                    value: item.id || item.ID,
                    text: (item.code || item.Code) + "-" + (item.name || item.Name)
                };
            }).then(pickCity);
        },

        initSelects: function () {
            const self = this;
            const mapCode = function (item) {
                return {
                    value: item.id || item.ID,
                    text: (item.code || item.Code) + "-" + (item.name || item.Name)
                };
            };
            return $.when(
                self.fillSelect("#ind_txtLanguage", "/Profile/GetAllLanguage", mapCode),
                self.fillSelect("#ind_txtTitle", "/Profile/GetAllTitle", function (item) {
                    return { value: item.id || item.ID, text: item.Code || item.code };
                }),
                self.fillSelect("#ind_txtNationality", "/Profile/GetAllNationality", mapCode),
                self.fillSelect("#ind_txtCountry", "/Profile/GetAllCountry", mapCode),
                self.fillSelect("#ind_txtState", "/Profile/GetAllState", function (item) {
                    const zip = item.zipCode || item.ZipCode || "";
                    const name = item.stateName || item.StateName || "";
                    return {
                        value: item.id || item.ID,
                        text: (zip && name) ? (zip + " - " + name) : (zip || name || "Unknown")
                    };
                }),
                self.fillSelect("#ind_txtVIP", "/Profile/GetAllVIP", mapCode)
            );
        },

        initStateControls: function () {
            const self = this;
            const $dobCheckbox = $("#ind_chkActiveDob");
            const $dobWrapper = $('[data-name="ind_txtDob"]');
            const $dobInput = $dobWrapper.find('input.date-ui');

            const $blackCheckbox = $("#ind_chkBlackList");
            const $blackInput = $("#ind_txtBlackListReason");

            function updateDOB() {
                const isChecked = $dobCheckbox.is(":checked");
                $dobInput.prop("disabled", !isChecked);

                if (!isChecked) {
                    $dobWrapper.addClass("opacity-50");
                } else {
                    $dobWrapper.removeClass("opacity-50");
                }
            }

            function updateBlackList() {
                const isChecked = $blackCheckbox.is(":checked");
                if (isChecked) {
                    $blackInput.addClass("black-active").prop("disabled", false).focus();
                } else {
                    $blackInput.removeClass("black-active").prop("disabled", true).val('');
                }
            }

            $dobCheckbox.off("change").on("change", updateDOB);
            $blackCheckbox.off("change").on("change", updateBlackList);

            updateDOB();
            updateBlackList();
        },

        fmtDate: function (v) {
            if (!v) return "";
            const m = moment(v);
            if (!m.isValid() || m.year() <= 1901) return "";
            return m.format("DD/MM/YYYY");
        },

        getFormData: function () {

            const sel = (id) => $(id).val();
            const loginName = (localStorage.getItem("Loginname") || "")
            .trim()
            .replace(/^"(.*)"$/, '$1');
            const loginUser = parseInt(localStorage.getItem("userID")) || 0;
            const defaultDate = "1900-01-01";

            const data = {
                // --- Định danh ---
                ID: parseInt($("#ind_id").val()) || 0,
                Type: 0,

                Code: $("#ind_txtCode").val()?.trim(),
                Account: $("#ind_txtFullName").val()?.trim(),
                Firstname: $("#ind_txtFirstName").val()?.trim(),
                LastName: $("#ind_txtLastName").val()?.trim(),
                MiddleName: $("#ind_txtMiddleName").val()?.trim(),

                LanguageID: parseInt(sel("#ind_txtLanguage"), 10) || 0,
                TitleID: parseInt(sel("#ind_txtTitle"), 10) || 0,
                NationalityID: parseInt(sel("#ind_txtNationality"), 10) || 0,
                City: sel("#ind_txtCity") || "",
                CountryID: parseInt(sel("#ind_txtCountry"), 10) || 0,
                PostalCode: $("#ind_txtPostal").val()?.trim(),
                StateID: parseInt(sel("#ind_txtState"), 10) || 0,
                Religion: $("#ind_txtReligion").val()?.trim(),
                Nation: $("#ind_txtNation").val()?.trim(),
                PurposeOfStay: $("#ind_txtPOS").val()?.trim(),
                Address: $("#ind_txtAddress").val()?.trim(),

                Salutation: $("#ind_txtSalutation").val()?.trim(),
                VIPID: parseInt(sel("#ind_txtVIP"), 10) || 0,
                VIPReason: $("#ind_txtVipReason").val()?.trim(),
                PrefRoom: $("#ind_txtPrefRoom").val()?.trim(),
                Other: $("#ind_txtOther").val()?.trim(),
                PassPort: $("#ind_txtPassport").val()?.trim(),
                IdentityCard: $("#ind_txtIdentityCard").val()?.trim(),

                DateOfBirth: $("#ind_chkActiveDob").is(":checked")
                ? $("input[name='ind_txtDob']").val()
                : defaultDate,

                Active: $("#ind_chkActive").is(":checked"),
                Contact: $("#ind_chkContact").is(":checked"),
                Keyword: $("#ind_txtKeyword").val()?.trim(),
                IsBlackList: $("#ind_chkBlackList").is(":checked"),
                BlackListReason: $("#ind_txtBlackListReason").val()?.trim(),

                // --- Attributes ---
                RateCode: $("#ind_txtRateCode").val()?.trim(),
                ARNo: $("#ind_txtARNo").val()?.trim(),
                MemberNo: $("#ind_txtMemberNo").val()?.trim(),

                // --- Tax & Communications ---
                Company: $("#ind_txtTaxCompany").val()?.trim(),
                TaxCode: $("#ind_txtTaxCode").val()?.trim(),
                HomeAddress: $("#ind_txtTaxBusAddress").val()?.trim(),

                Telephone: $("#ind_txtTelephone").val()?.trim(),
                HandPhone: $("#ind_txtHandPhone").val()?.trim(),
                Fax: $("#ind_txtFax").val()?.trim(),
                Email: $("#ind_txtEmail").val()?.trim(),
                Website: $("#ind_txtWebsite").val()?.trim(),
                BusinessTitle: $("#ind_txtBusinessTitle").val()?.trim(),

                // --- History ---
                LastRoom: $("#ind_txtLastRoom").val(),
                StayNo: parseInt($("#ind_txtStayCount").val()) || 0,

                Lastvisit: defaultDate,
                FirstReservation: defaultDate,
                LastReservation: defaultDate,
                WeddingAnniversary: defaultDate,
                Firstvisit: defaultDate,
                Expiry: defaultDate,
                LastContact: defaultDate,
                SpecialUpdateDate: defaultDate,

                UserInsertID: loginUser,
                UserUpdateID: loginUser
            };


            return data;
        },

        clearForm: function () {
            const self = this;
            const $container = $("#pro_ind_formContainer");

            $container.find('input[type="text"], input[type="hidden"], input[type="email"], input[type="tel"], textarea').val('');

            $("#ind_chkActive").prop("checked", true);
            $("#ind_chkContact").prop("checked", false);
            $("#ind_chkActiveDob").prop("checked", true);
            $("#ind_chkBlackList").prop("checked", false);
            $("#ind_lblCreateBy, #ind_lblCreateOn, #ind_lblUpdateBy, #ind_lblUpdateOn").text("");

            [
                "#ind_txtLanguage", "#ind_txtTitle", "#ind_txtNationality",
                "#ind_txtCountry", "#ind_txtCity", "#ind_txtState", "#ind_txtVIP"
            ].forEach(function (id) { $(id).val(""); });

            $("#ind_imgPreview").attr('src', '/images/uploads/profile.png');

            self.initStateControls();

            if (window.ValidationAdapter) {
                ValidationAdapter.clear("#pro_ind_formContainer");
            }

            UI.setHiddenDate("ind_txtDob",dateSystem);

            $("#ind_txtCode").focus();
        },

        saveProfile: function () {
            const self = this;
            const wasNew = !(parseInt($("#ind_id").val(), 10) > 0);
            const data = self.getFormData();

            $.ajax({
                url: '/Profile/SaveProfile',
                type: 'POST',
                showLoading: true,
                contentType: 'application/json',
                data: JSON.stringify(data),
                success: function (res) {

                    if (res.success) {
                        if (wasNew) self.clearForm();

                        const modalEl = document.getElementById('modalIndividual');
                        if (modalEl) {
                            const modalInstance = bootstrap.Modal.getInstance(modalEl);
                            if (modalInstance) modalInstance.hide();
                        }

                        if ($("#pro_search_btnSearch").length) {
                            $("#pro_search_btnSearch").trigger("click");
                        }

                        if ($("#pro_up_btnView").length) {
                            $("#pro_up_btnView").trigger("click");
                        }
                    } else {
                        if (res.errors && res.errors.length > 0) {
                            ValidationAdapter.apply(res.errors, "#pro_ind_formContainer");

                            showToast("Warning", 'Please check the highlighted fields.', false);
                        } else {
                            showToast("Error",res.message || 'An error occurred', false);
                        }
                    }
                },
                error: function (xhr) {
                    showToast("Error",'Internal Server Error. Please try again.', false);
                    console.error(xhr);
                }
            });
        },

        fillFormData: function (data) {
            if (!data) return;
            const self = this;

            $("#ind_id").val(data.id || 0);
            $("#ind_txtCode").val(data.code || "");
            $("#ind_txtFullName").val(data.account || "");
            $("#ind_txtFirstName").val(data.firstname || "");
            $("#ind_txtLastName").val(data.lastName || "");
            $("#ind_txtMiddleName").val(data.middleName || "");
            $("#ind_txtAddress").val(data.address || "");
            $("#ind_txtPostal").val(data.postalCode || "");
            $("#ind_txtReligion").val(data.religion || "");
            $("#ind_txtNation").val(data.nation || "");
            $("#ind_txtPOS").val(data.purposeOfStay || "");

            $("#ind_txtSalutation").val(data.salutation || "");
            $("#ind_txtVipReason").val(data.vipReason || "");
            $("#ind_txtPrefRoom").val(data.prefRoom || "");
            $("#ind_txtOther").val(data.other || "");
            $("#ind_txtPassport").val(data.passPort || "");
            $("#ind_txtIdentityCard").val(data.identityCard || "");
            $("#ind_txtKeyword").val(data.keyword || "");
            $("#ind_txtBlackListReason").val(data.blackListReason || "");
            $("#ind_txtNote").val(data.description || "");

            $("#ind_txtRateCode").val(data.rateCode || "");
            $("#ind_txtARNo").val(data.arNo || "");
            $("#ind_txtMemberNo").val(data.memberNo || "");
            $("#ind_txtLastRoom").val(data.lastRoom || "");
            $("#ind_txtLastVisit").val(self.fmtDate(data.lastvisit || data.lastVisit));
            $("#ind_txtLastRate").val(data.lastRate || "");
            $("#ind_txtStayCount").val(data.stayNo || "");

            $("#ind_txtTaxCompany").val(data.company || "");
            $("#ind_txtTaxCode").val(data.taxCode || "");
            $("#ind_txtTaxBusAddress").val(data.homeAddress || "");
            $("#ind_txtTelephone").val(data.telephone || "");
            $("#ind_txtHandPhone").val(data.handPhone || "");
            $("#ind_txtFax").val(data.fax || "");
            $("#ind_txtEmail").val(data.email || "");
            $("#ind_txtWebsite").val(data.website || "");
            $("#ind_txtBusinessTitle").val(data.businessTitle || "");

            $("#ind_lblCreateBy").text(data.createdBy || "");
            $("#ind_lblCreateOn").text(self.fmtDate(data.createDate || data.createdDate));
            $("#ind_lblUpdateBy").text(data.updatedBy || "");
            $("#ind_lblUpdateOn").text(self.fmtDate(data.updateDate || data.updatedDate));

            $("#ind_chkActive").prop("checked", data.active === true);
            $("#ind_chkContact").prop("checked", data.contact === true);
            $("#ind_chkBlackList").prop("checked", data.isBlackList === true);

            if (data.dateOfBirth) {
                $("#ind_chkActiveDob").prop("checked", true);
                const dob = moment(data.dateOfBirth).format("DD/MM/YYYY");
                $('[data-name="ind_txtDob"] input.date-ui').val(dob);
                $("#ind_txtDob").val(data.dateOfBirth);
            } else {
                $("#ind_chkActiveDob").prop("checked", false);
            }

            const setSel = function (id, value) {
                const v = (value == null || value === 0) ? "" : String(value);
                $(id).val(v);
            };

            setSel("#ind_txtLanguage", data.languageID);
            setSel("#ind_txtTitle", data.titleID);
            setSel("#ind_txtNationality", data.nationalityID);
            self._suspendCityReload = true;
            setSel("#ind_txtCountry", data.countryID);
            self._suspendCityReload = false;
            self.loadCities(data.countryID, data.city);
            setSel("#ind_txtState", data.stateID);
            setSel("#ind_txtVIP", data.vipID);

            self.initStateControls();

            //làm sau
            if (data.ImagePath) {
                $("#ind_imgPreview").attr('src', data.imagePath);
            } else {
                $("#ind_imgPreview").attr('src', '/images/uploads/profile.png');
            }
        },

        openOptions: function () {
            const self = this;
            const profileID = parseInt($("#ind_id").val(), 10) || 0;
            const profileName = ($("#ind_txtFullName").val() || "").trim();
            ModalManager.load("/Profile/ProfileOption", "modalProfileOption", function () {
                waitForFunction("openModalProfileOption", function () {
                    window.openModalProfileOption({
                        profileID: profileID,
                        profileName: profileName,
                        profileType: 0
                    });
                });
            });
        },

        pickProfileForMerge: function (keepId) {
            this._mergePick = true;
            this._mergeKeepId = parseInt(keepId, 10) || (parseInt($("#ind_id").val(), 10) || 0);
            showToast("Warning", "Select the other profile to merge (this profile will be kept).", false);
            this.openModalSearch();
        },

        completeMergePick: function (otherId) {
            const self = this;
            self._mergePick = false;
            const keepId = self._mergeKeepId || (parseInt($("#ind_id").val(), 10) || 0);
            const sourceId = parseInt(otherId, 10) || 0;
            const searchEl = document.getElementById("pro_search_modalIndividualSearch");
            const searchModal = searchEl ? bootstrap.Modal.getInstance(searchEl) : null;
            if (searchModal) searchModal.hide();
            if (!sourceId || !keepId) {
                showToast("Warning", "Please select a profile to merge.", false);
                return;
            }
            if (sourceId === keepId) {
                showToast("Warning", "Please choose a different profile.", false);
                return;
            }
            ModalManager.load("/Profile/MergeProfile", "modalMergeProfile", function () {
                waitForFunction("openModalMerge", function () {
                    window.openModalMerge(sourceId, keepId, 0);
                });
            });
        },

        openModalSearch: function () {
            const self = this;
            const modalEl = document.getElementById('pro_search_modalIndividualSearch');
            const modal = new bootstrap.Modal(modalEl);
            $(modalEl).off("hidden.bs.modal.mergePick").one("hidden.bs.modal.mergePick", function () {
                self._mergePick = false;
            });
            modal.show();

            self.initSearchGrid();

            $('#pro_search_btnViewIndividual').off('click').on('click', function() {
                self.searchIndividual();
            });
        },

        searchIndividual: function () {
            const self = this;
            const lastName = $('#ind_search_name').val()?.trim() || "";
            const firstName = $('#ind_search_first').val()?.trim() || "";


            $.ajax({
                url: '/Profile/ProfileIndividualSearch',
                type: 'GET',
                loadingGrid: '#pro_individualGrid',
                data: {
                    LastName: lastName,
                    FirstName: firstName
                },
                success: function (res) {
                    if (!res.success) {
                        showToast("Error", res.message, false);
                        return;
                    }

                    self.renderSearchGrid(res.data || []);
                },
                error: function () {
                    showToast("Error", "Cannot fetch search results", false);
                }
            });
        },

        renderSearchGrid: function (data) {

            const self = this;

            $("#pro_individualGrid").dxDataGrid({

                dataSource: data,

                keyExpr: "id",

                columns: [
                    {
                        dataField: "id",
                        visible: false
                    },
                    {
                        dataField: "name",
                        caption: "Name"
                    }
                ],

                selection: {
                    mode: "single"
                },

                hoverStateEnabled: true,

                height: 480,
                scrolling: {
                    mode: "standard",
                    showScrollbar: "always"
                },

                onRowDblClick: function (e) {

                    if (!e.data) return;

                    if (self._mergePick) {
                        self.completeMergePick(e.data.id);
                        return;
                    }

                    self.loadProfileByID(e.data.id);

                }

            });

        },

        initSearchGrid: function() {
            if (!$("#pro_individualGrid").addClass('dx-datagrid').length) {
                 this.renderSearchGrid([]);
            }
        },

        // request: (tùy chọn) jqXHR đã gọi sẵn từ trước (vd. Search Profile > Edit) để không phải chờ modal mở xong
        loadProfileByID: function (id, request) {

            const self = this;

            (request || $.ajax({
                url: '/Profile/GetProfileByID/',
                type: 'GET',
                contentType: "application/json",
                data: {id: id}
            })).then(function (res) {

                    if (res.code !== 0) {
                        showToast("Error", res.msg, false);
                        return;
                    }

                    const apply = function () {
                        self.fillFormData(res.profile);
                        const modal = bootstrap.Modal.getInstance(
                            document.getElementById("pro_search_modalIndividualSearch")
                        );
                        if (modal) modal.hide();
                    };
                    if (self._selectsReady && typeof self._selectsReady.then === "function") {
                        self._selectsReady.then(apply);
                    } else {
                        apply();
                    }

            }, function () {
                showToast("Error", "Cannot load profile", false);
            });

        },

        syncFullNameFromParts: function() {
            const first = $("#ind_txtFirstName").val();
            const middle = $("#ind_txtMiddleName").val();
            const last = $("#ind_txtLastName").val();

            const fullName = GuestNameEngine.buildFullName(first, middle, last);
            $("#ind_txtFullName").val(fullName);

            this.updateSalutation(first, last);
        },

        syncPartsFromFullName: function() {
            const fullName = $("#ind_txtFullName").val();
            if (!fullName) return;

            const p = GuestNameEngine.parseFullName(fullName);

            $("#ind_txtFirstName").val(p.first);
            $("#ind_txtMiddleName").val(p.middle);
            $("#ind_txtLastName").val(p.last);

            this.updateSalutation(p.first, p.last);
        },

        updateSalutation: function(first, last) {
            const salutation = GuestNameEngine.buildSalutation(first, last);
            $("#ind_txtSalutation").val(salutation);
        },
    };

    window.initIndividualModal = function() {
        if (window.pro_ind_Module) {
            window.pro_ind_Module.init();
        }
    };

</script>
