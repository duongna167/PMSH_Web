@using DevExpress.XtraReports.UI
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    ViewBag.Title = ViewBag.ReportHeader;
    var listatt = ViewBag.hkpAttendantList;
}

<style>
    .ttsr_status-color-box {
        display: inline-block;
        width: 18px;
        height: 18px;
        border: 1px solid #ccc;
    }

    .ttsr_color-clean-uncheck {
        background-color: cyan;
    }

    .ttsr_color-dirty {
        background-color: red;
    }

    .ttsr_color-outoforder {
        background-color: lightgray;
    }

    .ttsr_color-pickup {
        background-color: yellow;
    }

    .ttsr_color-clean {
        background-color: lime;
    }

    .ttsr_color-outofservices {
        background-color: lightgray;
    }

    .ttsr_hk-clean-uncheck {
        background-color: cyan;
        color: black;
    }

    .ttsr_hk-dirty {
        background-color: red;
        color: black;
    }

    .ttsr_hk-outoforder {
        background-color: lightgray;
        color: black;
    }

    .ttsr_hk-pickup {
        background-color: yellow;
        color: black;
    }

    .ttsr_hk-clean {
        background-color: lime;
        color: black;
    }

    .ttsr_hk-outofservices {
        background-color: lightgray;
        color: black;
    }

    /* ===== Bố cục như bản WinForms: toolbar 1 hàng + Room Status 3 cột x 2 hàng + Attendant ID ===== */
    #ttsr_modal .ttsr-toolbar {
        display: flex;
        flex-wrap: nowrap;
        gap: 4px;
        padding-bottom: 4px;
    }

    #ttsr_modal .ttsr-toolbar .mui-button {
        flex: 1 1 0;
        min-width: 0;
        margin: 0;
        padding-left: 4px;
        padding-right: 4px;
        white-space: nowrap;
    }

    #ttsr_modal .ttsr-filter {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-start;
        column-gap: 36px;
        row-gap: 8px;
        margin-top: 6px;
    }

    #ttsr_modal .ttsr-roomstatus {
        display: grid;
        grid-auto-flow: column;
        grid-template-rows: repeat(2, 30px);
        column-gap: 24px;
        align-items: center;
    }

    #ttsr_modal .ttsr-item {
        display: flex;
        align-items: center;
        gap: 4px;
        white-space: nowrap;
    }

    #ttsr_modal .ttsr-item label {
        margin: 0;
    }

    #ttsr_modal .ttsr-att {
        display: flex;
        align-items: center;
        gap: 8px;
        height: 30px;
    }

    #ttsr_modal .ttsr-att label {
        margin: 0;
        white-space: nowrap;
    }

    #ttsr_modal .ttsr-att .ttsr-att-ctrl {
        width: 230px;
        min-width: 0;
    }

    #ttsr_modal .ttsr-att .ts-wrapper {
        width: 100% !important;
        min-width: 0 !important;
    }

    #ttsr_modal .ttsr-att .ts-control {
        flex-wrap: nowrap !important;
        overflow: hidden !important;
    }

    #ttsr_modal .ttsr-att .ts-control input {
        flex: 1 1 20px !important;
        min-width: 20px !important;
    }

    #ttsr_modal .modal-body {
        display: flex;
        flex-direction: column;
    }

    #ttsr_gridContainer {
        height: calc(90vh - 250px);
        min-height: 240px;
        width: 100%;
    }

    #ttsr_moveModal .ttsr-move-grid {
        display: grid;
        grid-template-columns: auto 1fr;
        column-gap: 10px;
        row-gap: 8px;
        align-items: center;
    }

    #ttsr_moveModal .ttsr-move-grid > label {
        margin: 0;
        text-align: right;
        white-space: nowrap;
    }
</style>

<!-- =========================
     MAIN VIEW AS BS5 MODAL
     ========================= -->
<div class="modal fade" id="ttsr_modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-4by3">
        <div class="modal-content">

            <div class="modal-header py-2">
                <h5 class="modal-title mb-0">Turndown Tasksheet</h5>
            </div>

            <div class="modal-body pt-2">

                <div class="search-filter">

                    <!-- TOOLBAR (cùng 1 hàng, thứ tự như WinForms) -->
                    <div class="ttsr-toolbar">
                        <button id="ttsr_btnPrint" class="mui-button mui-button-new" type="button">View</button>
                        <button id="ttsr_btnCheckAll" class="mui-button mui-button-advance" type="button">Check All</button>
                        <button id="ttsr_btnChange" class="mui-button mui-button-edit" type="button" disabled
                                title="Chưa triển khai: cần tài liệu WinForms của nút Change">Change</button>
                        <button id="ttsr_btnMove" class="mui-button mui-button-option" type="button">Move</button>
                        <button id="ttsr_btnAdd" class="mui-button mui-button-new" type="button" disabled
                                title="Chưa triển khai: cần tài liệu WinForms của nút Add">Add</button>
                        <button id="ttsr_btnResv" class="mui-button mui-button-search" type="button">Resv</button>
                        <button id="ttsr_btnDetail" class="mui-button mui-button-card" type="button">Detail</button>
                        <button id="ttsr_btnDailytasksheet" class="mui-button mui-button-profile" type="button">Daily</button>
                        <button id="ttsr_btnReport" class="mui-button mui-button-export" type="button">Report</button>
                        <button id="ttsr_btnExportExcel" class="mui-button mui-button-new" type="button">Excel</button>
                        <button class="mui-button mui-button-edit" type="button" data-bs-dismiss="modal" aria-label="Close">Close</button>
                    </div>

                    <div class="ttsr-filter">

                        <!-- Room Status: 3 cột x 2 hàng như Win -->
                        <div>
                            <div class="ttsr-roomstatus">
                                <div class="ttsr-item">
                                    <span class="ttsr_status-color-box ttsr_color-clean-uncheck"></span>
                                    <input type="checkbox" id="ttsr_cleanUncheck" name="ttsr_includeOptions" value="1" checked>
                                    <label for="ttsr_cleanUncheck">Clean Non - Checked</label>
                                </div>
                                <div class="ttsr-item">
                                    <span class="ttsr_status-color-box ttsr_color-dirty"></span>
                                    <input type="checkbox" id="ttsr_dirty" name="ttsr_includeOptions" value="2" checked>
                                    <label for="ttsr_dirty">Dirty</label>
                                </div>
                                <div class="ttsr-item">
                                    <span class="ttsr_status-color-box ttsr_color-pickup"></span>
                                    <input type="checkbox" id="ttsr_pickup" name="ttsr_includeOptions" value="3" checked>
                                    <label for="ttsr_pickup">Pickup</label>
                                </div>
                                <div class="ttsr-item">
                                    <span class="ttsr_status-color-box ttsr_color-clean"></span>
                                    <input type="checkbox" id="ttsr_clean" name="ttsr_includeOptions" value="4" checked>
                                    <label for="ttsr_clean">Clean</label>
                                </div>
                                <div class="ttsr-item">
                                    <span class="ttsr_status-color-box ttsr_color-outoforder"></span>
                                    <input type="checkbox" id="ttsr_outofOrder" name="ttsr_includeOptions" value="5" checked>
                                    <label for="ttsr_outofOrder">Out of Order</label>
                                </div>
                                <div class="ttsr-item">
                                    <span class="ttsr_status-color-box ttsr_color-outofservices"></span>
                                    <input type="checkbox" id="ttsr_outofServices" name="ttsr_includeOptions" value="6" checked>
                                    <label for="ttsr_outofServices">Out of Service</label>
                                </div>
                            </div>
                        </div>

                        <!-- Attendant ID -->
                        <div class="ttsr-att">
                            <label>Attendant ID</label>
                            <div class="ttsr-att-ctrl">
                                <select id="ttsr_attendant" name="ttsr_attendant" class="tomselect-custom" multiple>
                                    @foreach (var item in listatt)
                                    {
                                        <option value="@item.ID">@item.Name</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <input type="date" id="ttsr_fromDate" name="ttsr_fromDate" style="display:none" />
                    </div>

                </div>

                <div class="mui-card mt-2">
                    <div id="ttsr_gridContainer" class="gridContainer"></div>
                </div>

                <div id="ttsr_loadingSpinner" style="display:none; position:absolute; inset:0; z-index:999;
                     background: rgba(255,255,255,0.55); align-items:center; justify-content:center;">
                    <div class="spinner-border text-primary"></div>
                </div>

            </div>

        </div>
    </div>
</div>

<!-- =========================
     MOVE: chuyển phòng sang tasksheet khác
     ========================= -->
<div class="modal fade" id="ttsr_moveModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width:520px;">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title">Move Rooms to Task Sheet</h6>
            </div>
            <div class="modal-body">
                <div class="d-flex gap-2 mb-3">
                    <button id="ttsr_btnMoveOk" class="mui-button mui-button-new" type="button" style="flex:0 0 110px;">OK</button>
                    <button class="mui-button mui-button-edit" type="button" data-bs-dismiss="modal" style="flex:0 0 110px;">Close</button>
                </div>
                <div class="ttsr-move-grid">
                    <label>Rooms</label>
                    <div id="ttsr_moveRooms" class="fw-semibold"></div>
                    <label>Task Sheet</label>
                    <select id="ttsr_moveTarget" class="form-select form-select-sm"></select>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- =========================
     DETAIL: chi tiết tasksheet theo phòng (frmTurndownTasksheetDetail)
     ========================= -->
<div class="modal fade" id="ttsr_detailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-4by3">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title">Tasksheet Detail</h6>
            </div>
            <div class="modal-body">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <label class="mb-0 text-nowrap">Room No:</label>
                    <input type="text" id="ttsr_detailRoomNo" class="form-control form-control-sm" style="max-width:300px;" />
                    <button id="ttsr_detailSearch" class="mui-button mui-button-new" type="button" style="flex:0 0 100px;">Search</button>
                    <button id="ttsr_detailExcel" class="mui-button mui-button-new" type="button" style="flex:0 0 100px;">Excel</button>
                    <button id="ttsr_detailDelete" class="mui-button mui-button-delete" type="button" style="flex:0 0 100px;">Delete</button>
                    <button class="mui-button mui-button-edit" type="button" data-bs-dismiss="modal" style="flex:0 0 100px;">Close</button>
                </div>
                <div id="ttsr_detailGrid" class="gridContainer" style="height: calc(90vh - 190px); min-height: 240px;"></div>
            </div>
        </div>
    </div>
</div>

<!-- =========================
     POPUP GRID AS BS5 MODAL (Report)
     ========================= -->
<div class="modal fade" id="ttsr_popupNewGridModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-fullscreen">
        <div class="modal-content">

            <div class="modal-header py-2">
                <h5 id="ttsr_attendantPointTitle" class="modal-title mb-0">Turndown Tasksheet</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body pt-2">

                <div class="d-flex justify-content-start mb-3 gap-2">
                    <button id="ttsr_btnExportpopExcel" class="mui-button mui-button-new" type="button">Excel</button>
                    <button id="ttsr_btnClosePopup" class="mui-button mui-button-edit" type="button">Close</button>
                </div>

                <div id="ttsr_logGridContainer" class="gridContainer mt-2"></div>

            </div>

        </div>
    </div>
</div>

<!-- RESERVATION MODAL (mở từ nút Resv) -->
<div class="modal fade" id="newReservationModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title">Reservation</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body"></div>
        </div>
    </div>
</div>

<script>
    var ttsr_Module = {

        tsAttendant: null,

        gridMain: null,
        gridPopup: null,

        parsedBusinessDate: null,
        toggleSelectAll: false,

        selectedRows: [],   // các dòng được tick
        focusedRow: null,   // dòng vừa bấm (dùng cho Resv)
        lastData: [],

        init: function () {
            const self = this;
            // Chỉ khởi tạo ô của màn này; lỗi ở đây không được chặn việc tải dữ liệu
            try { initTomSelect(["#ttsr_attendant"]); } catch (e) { console.error("TTSR initTomSelect error:", e); }
            self.getBusinessDate();
            try { self.bindEvents(); } catch (e) { console.error("TTSR bindEvents error:", e); }
            self.bindModalLifecycle();
        },

        // ===== Mở reservation (nút Resv) =====
        openReservation: function (resvId) {
            if (!resvId) { showToast("Warning", "Reservation ID not found.", false); return; }

            const modal = $("#newReservationModal");
            modal.find(".modal-body").html('<div class="text-center py-5"><div class="spinner-border"></div><p class="mt-3">Loading reservation...</p></div>');
            modal.modal("show");

            $.ajax({ url: "/Reservation/EncryptId", type: "POST", data: { id: resvId } })
                .done(function (response) {
                    if (!response || !response.success) { modal.modal("hide"); alert("EncryptId failed."); return; }
                    $.ajax({ url: "/Reservation/NewReservation", type: "GET", data: { key: response.encryptedId }, cache: false })
                        .done(function (html) { modal.find(".modal-body").html(html); })
                        .fail(function () {
                            modal.find(".modal-body").html('<div class="alert alert-danger m-4"><strong>Error!</strong> Cannot load reservation.</div>');
                        });
                })
                .fail(function () { modal.modal("hide"); alert("Server connection error."); });
        },

        // ===== Detail: chi tiết tasksheet theo phòng =====
        detailRow: null, // dòng đang chọn trong lưới Detail (dùng cho nút Delete)

        loadDetail: function () {
            const self = this;
            self.detailRow = null;
            const roomNo = ($("#ttsr_detailRoomNo").val() || "").trim();
            $.ajax({
                url: "/HouseKeeping/TasksheetDetailByRoom",
                type: "GET",
                data: { roomNo: roomNo },
                success: function (data) {
                    if (data && data.error) { alert(data.error); return; }
                    $("#ttsr_detailGrid").dxDataGrid({
                        dataSource: data || [],
                        allowColumnResizing: true,
                        columnAutoWidth: true,
                        height: "100%",
                        showBorders: true,
                        filterRow: { visible: true },
                        noDataText: "No tasksheet found for this room on the current business date",
                        columns: [
                            { dataField: "taskDate", caption: "Task Date", dataType: "date", format: "dd/MM/yyyy" },
                            { dataField: "roomNo", caption: "Room No" },
                            { dataField: "roomType", caption: "Room Type" },
                            { dataField: "credits", caption: "Credits" },
                            { dataField: "facilityTask", caption: "Facility Task" },
                            { dataField: "tasksheetNo", caption: "Tasksheet No" },
                            { dataField: "attendant", caption: "Attendant" },
                            { dataField: "facility", caption: "Facility" },
                            { dataField: "quantity", caption: "Quantity" },
                            { dataField: "description", caption: "Description" },
                            { dataField: "createdBy", caption: "Created By" },
                            { dataField: "createdDate", caption: "Created Date", dataType: "date", format: "dd/MM/yyyy" },
                            { dataField: "updatedBy", caption: "Updated By" },
                            { dataField: "updatedDate", caption: "Updated Date", dataType: "date", format: "dd/MM/yyyy" },
                            { dataField: "timeIn", caption: "Time In" },
                            { dataField: "timeOut", caption: "Time Out" }
                        ],
                        scrolling: { useNative: true, showScrollbar: "always" },
                        paging: { pageSize: 25 },
                        selection: { mode: "single" },
                        hoverStateEnabled: true,
                        onRowClick: function (e) {
                            if (e.rowType === "data") self.detailRow = e.data;
                        }
                    });
                },
                error: function () { alert("Unable to load data."); }
            });
        },

        // ===== Time In/Out: nếu là datetime thì chỉ hiện giờ =====
        formatTime: function (cellInfo) {
            const v = cellInfo.value;
            if (!v) return "";
            if (/^\d{1,2}:\d{2}/.test(v)) return v;
            const d = new Date(v);
            if (isNaN(d.getTime())) return v;
            const p = (n) => String(n).padStart(2, "0");
            return p(d.getHours()) + ":" + p(d.getMinutes()) + ":" + p(d.getSeconds());
        },

        // ===== Xuất Excel dùng chung =====
        exportGrid: function (grid, reportName) {
            if (!grid) { showToast("Error", "The data is not yet available.", false); return; }
            const workbook = new ExcelJS.Workbook();
            const worksheet = workbook.addWorksheet("Sheet 1");

            worksheet.addRow(["Công ty Cổ phần Giải pháp Công nghệ CS-Solution"]);
            worksheet.mergeCells("A1:E1");
            worksheet.getRow(1).font = { bold: true };
            worksheet.addRow(["", "", "", "", " " + new Date().toLocaleString("vi-VN")]);
            worksheet.mergeCells("E2:H2");
            worksheet.getRow(2).alignment = { vertical: "middle", horizontal: "right" };
            worksheet.addRow([]);
            worksheet.addRow([]);
            const reportRow = worksheet.addRow(["", "", reportName]);
            worksheet.mergeCells("C5:F5");
            reportRow.font = { bold: true, size: 14 };
            reportRow.alignment = { horizontal: "center" };
            worksheet.addRow([]);

            DevExpress.excelExporter.exportDataGrid({
                component: grid,
                worksheet: worksheet,
                autoFilterEnabled: true,
                topLeftCell: { row: 7, column: 1 }
            }).then(function () {
                const lastRow = worksheet.lastRow.number + 2;
                worksheet.getCell("A" + lastRow).value = "--- END ---";
                worksheet.mergeCells("A" + lastRow + ":F" + lastRow);
                worksheet.getCell("A" + lastRow).alignment = { horizontal: "center" };
                worksheet.getCell("A" + lastRow).font = { italic: true };
                workbook.xlsx.writeBuffer().then(function (buffer) {
                    saveAs(new Blob([buffer], { type: "application/octet-stream" }), reportName + ".xlsx");
                });
            });
        },

        bindModalLifecycle: function () {
            const self = this;

            // MAIN GRID must init in shown.bs.modal (height != 0)
            $("#ttsr_modal").off("shown.bs.modal.ttsr").on("shown.bs.modal.ttsr", function () {
                // original logic: after business date success => trigger print
                // here we do nothing, because the AJAX call is already triggered in getBusinessDate()
                // and will render the grid only after data returns.
            });

            // POPUP GRID must init in shown.bs.modal too
            $("#ttsr_popupNewGridModal").off("shown.bs.modal.ttsr").on("shown.bs.modal.ttsr", function () {
                // no automatic render here (original code only shows modal)
            });
        },

        destroy: function () {

            if (this.tsAttendant) {
                this.tsAttendant.destroy();
                this.tsAttendant = null;
            }

            if (this.gridMain) {
                this.gridMain.dispose();
                this.gridMain = null;
            }

            if (this.gridPopup) {
                this.gridPopup.dispose();
                this.gridPopup = null;
            }

            $("#ttsr_gridContainer").empty();
            $("#ttsr_logGridContainer").empty();

            this.parsedBusinessDate = null;
            this.toggleSelectAll = false;
        },

        formatDate: function (date) {
            let year = date.getFullYear();
            let month = (date.getMonth() + 1).toString().padStart(2, '0');
            let day = date.getDate().toString().padStart(2, '0');
            return `${year}-${month}-${day}`;
        },

        getBusinessDate: function () {
            const self = this;

            return $.ajax({
                url: '/Reservation/GetBusinessDate',
                type: 'get',
                dataType: 'json',
                crossDomain: false,
                headers: { "X-CSRF-TOKEN-HEADERNAME": jQuery("input[name='__RequestVerificationToken']").val() },
                success: function (result) {

                    const fromDateStr = result.split('T')[0];
                    $('#ttsr_fromDate').val(fromDateStr);
                    $("#ttsr_btnPrint").trigger("click");

                },
                error: function (xhr, statusText, err) {
                    if (xhr.status == 401) {
                        sessionTimeout();
                    }
                }
            });
        },

        initializeTomSelects: function () {
            const self = this;

            const selectors = ["#ttsr_attendant"];

            for (const id of selectors) {
                const el = document.querySelector(id);
                if (!el) continue;

                if (el.tomselect) el.tomselect.destroy();

                const ts = new TomSelect(el, {
                    plugins: ['remove_button'],
                    create: false,
                    maxItems: null,
                    allowEmptyOption: true,
                    placeholder: '',
                    persist: false,
                    render: {
                        option: function (data, escape) {
                            return `<div>${escape(data.text)}</div>`;
                        }
                    }
                });

                self.tsAttendant = ts;
            }
        },

        bindEvents: function () {
            const self = this;

            $(document).off("click", "#ttsr_btnPrint").on("click", "#ttsr_btnPrint", function () {
                $("#ttsr_loadingSpinner").css("display", "flex");

                var selectedStatuses = $("input[name='ttsr_includeOptions']:checked")
                    .map(function () {
                        return this.value;
                    }).get().join(",");

                $.ajax({
                    url: '/HouseKeeping/TurndownTasksheetData',
                    type: 'GET',
                    data: {
                        fromDate: $("#ttsr_fromDate").val(),
                        attendant: $("#ttsr_attendant").val().join(","),
                        IsDueOut: $("#ttsr_dirty").prop("checked") ? "1" : "",
                        roomStatus: selectedStatuses,
                    },
                    traditional: true,
                    crossDomain: false,
                    headers: { "X-CSRF-TOKEN-HEADERNAME": jQuery("input[name='__RequestVerificationToken']").val() },
                    success: function (data) {

                        console.log(data);

                        // Only render if response is valid array
                        if (!Array.isArray(data)) {
                            $("#ttsr_loadingSpinner").hide();
                            return;
                        }

                        // Main grid must be rendered only when modal is shown (height != 0)
                        if (!$("#ttsr_modal").hasClass("show")) {
                            $("#ttsr_loadingSpinner").hide();
                            return;
                        }

                        self.lastData = data;
                        self.selectedRows = [];
                        self.focusedRow = null;
                        self.toggleSelectAll = false;
                        $("#ttsr_btnCheckAll").text("Check All");

                        self.initializeTurndownTasksheetDataGrid(data);

                        $("#ttsr_loadingSpinner").hide();
                    },
                    error: function () {
                        alert("Cannot load data.");
                        $("#ttsr_loadingSpinner").hide();
                    }
                });
            });

            $(document).off("click", "#ttsr_btnCheckAll").on("click", "#ttsr_btnCheckAll", function () {
                let grid = null;
                try { grid = $("#ttsr_gridContainer").dxDataGrid("instance"); } catch (e) { }
                if (!grid) return;

                if (!self.toggleSelectAll) {
                    grid.selectAll();
                    self.toggleSelectAll = true;
                    $(this).html('Uncheck All');
                } else {
                    grid.deselectAll();
                    self.toggleSelectAll = false;
                    $(this).html('Check All');
                }
            });

            $(document).off("click", "#ttsr_btnDailytasksheet").on("click", "#ttsr_btnDailytasksheet", function () {
                $("#ttsr_loadingSpinner").css("display", "flex");
                const modalEl = document.getElementById("ttsr_modal");
                const modal = bootstrap.Modal.getOrCreateInstance(modalEl);

                modal.hide(); // đóng modal trước

                // chờ bootstrap remove backdrop xong rồi mới open
                $(modalEl).one("hidden.bs.modal", function () {
                    window.openRoomAttendentDailyWorksheet();
                });
            });

            $(document).off("click", "#ttsr_btnExportExcel").on("click", "#ttsr_btnExportExcel", function () {
                const grid = $("#ttsr_gridContainer").dxDataGrid("instance");
                var selectedReport = 'Room Attendent Daily Worksheet';
                if (!selectedReport) {
                    alert("Vui lòng ch?n báo cáo tru?c khi xu?t Excel.");
                    return;
                }

                const workbook = new ExcelJS.Workbook(); const companyName = localStorage.getItem("CompanyName") || "Tên công ty chưa xác định";
                const worksheet = workbook.addWorksheet("Sheet 1");

                worksheet.addRow(['Công ty C? ph?n Gi?i pháp Công ngh? CS-Solution']);
                worksheet.mergeCells('A1:E1');
                worksheet.getRow(1).font = { bold: true };
                worksheet.getRow(1).alignment = { vertical: 'middle', horizontal: 'left' };

                const now = new Date();
                const exportDate = now.toLocaleString("vi-VN");
                worksheet.addRow(['', '', '', '', ' ' + exportDate]);
                worksheet.mergeCells('E2:H2');
                worksheet.getRow(2).alignment = { vertical: 'middle', horizontal: 'right' };

                worksheet.addRow([]);
                worksheet.addRow([]);

                const reportRow = worksheet.addRow(['', '', selectedReport]);
                worksheet.mergeCells('C5:F5');
                reportRow.font = { bold: true, size: 14 };
                reportRow.alignment = { vertical: 'middle', horizontal: 'center' };

                worksheet.addRow([]);

                DevExpress.excelExporter.exportDataGrid({
                    component: grid,
                    worksheet: worksheet,
                    autoFilterEnabled: true,
                    topLeftCell: { row: 7, column: 1 }
                }).then(function () {
                    const lastRow = worksheet.lastRow.number + 2;
                    worksheet.getCell(`A${lastRow}`).value = "--- END  ---";
                    worksheet.mergeCells(`A${lastRow}:F${lastRow}`);
                    worksheet.getCell(`A${lastRow}`).alignment = { horizontal: 'center' };
                    worksheet.getCell(`A${lastRow}`).font = { italic: true };

                    let fileName = selectedReport + ".xlsx";
                    workbook.xlsx.writeBuffer().then(function (buffer) {
                        saveAs(new Blob([buffer], { type: "application/octet-stream" }), fileName);
                    });
                });
            });

            $(document).off("click", "#ttsr_btnExportpopExcel").on("click", "#ttsr_btnExportpopExcel", function () {
                const grid = $("#ttsr_logGridContainer").dxDataGrid("instance");
                var selectedReport = 'Turndown Tasksheet Report';
                if (!selectedReport) {
                    alert("Vui lòng ch?n báo cáo tru?c khi xu?t Excel.");
                    return;
                }

                const workbook = new ExcelJS.Workbook(); const companyName = localStorage.getItem("CompanyName") || "Tên công ty chưa xác định";
                const worksheet = workbook.addWorksheet("Sheet 1");

                worksheet.addRow(['Công ty C? ph?n Gi?i pháp Công ngh? CS-Solution']);
                worksheet.mergeCells('A1:E1');
                worksheet.getRow(1).font = { bold: true };
                worksheet.getRow(1).alignment = { vertical: 'middle', horizontal: 'left' };

                const now = new Date();
                const exportDate = now.toLocaleString("vi-VN");
                worksheet.addRow(['', '', '', '', ' ' + exportDate]);
                worksheet.mergeCells('E2:H2');
                worksheet.getRow(2).alignment = { vertical: 'middle', horizontal: 'right' };

                worksheet.addRow([]);
                worksheet.addRow([]);

                const reportRow = worksheet.addRow(['', '', selectedReport]);
                worksheet.mergeCells('C5:F5');
                reportRow.font = { bold: true, size: 14 };
                reportRow.alignment = { vertical: 'middle', horizontal: 'center' };

                worksheet.addRow([]);

                DevExpress.excelExporter.exportDataGrid({
                    component: grid,
                    worksheet: worksheet,
                    autoFilterEnabled: true,
                    topLeftCell: { row: 7, column: 1 }
                }).then(function () {
                    const lastRow = worksheet.lastRow.number + 2;
                    worksheet.getCell(`A${lastRow}`).value = "--- END  ---";
                    worksheet.mergeCells(`A${lastRow}:F${lastRow}`);
                    worksheet.getCell(`A${lastRow}`).alignment = { horizontal: 'center' };
                    worksheet.getCell(`A${lastRow}`).font = { italic: true };

                    let fileName = selectedReport + ".xlsx";
                    workbook.xlsx.writeBuffer().then(function (buffer) {
                        saveAs(new Blob([buffer], { type: "application/octet-stream" }), fileName);
                    });
                });
            });

            $(document).off("click", "#ttsr_btnClosePopup").on("click", "#ttsr_btnClosePopup", function () {
                var modalEl = document.getElementById("ttsr_popupNewGridModal");
                var modal = bootstrap.Modal.getOrCreateInstance(modalEl);
                modal.hide();
            });

            // ===== Resv: reservation của dòng đang đứng (vừa bấm), chưa bấm thì lấy dòng tick đầu tiên =====
            $(document).off("click", "#ttsr_btnResv").on("click", "#ttsr_btnResv", function () {
                const row = self.focusedRow || self.selectedRows[0];
                if (!row || !row.reservationID) {
                    showToast("Warning", "Please select a row first!", false);
                    return;
                }
                self.openReservation(row.reservationID);
            });

            // ===== Detail: chi tiết tasksheet theo phòng đã chọn =====
            $(document).off("click", "#ttsr_btnDetail").on("click", "#ttsr_btnDetail", function () {
                let rooms = self.selectedRows.map(r => r.roomNo);
                if (!rooms.length && self.focusedRow) rooms = [self.focusedRow.roomNo];
                if (!rooms.length) {
                    showToast("Warning", "Please select a row first!", false);
                    return;
                }
                $("#ttsr_detailRoomNo").val(rooms.join(","));
                bootstrap.Modal.getOrCreateInstance(document.getElementById("ttsr_detailModal"), { backdrop: "static" }).show();
                self.loadDetail();
            });
            $(document).off("click", "#ttsr_detailSearch").on("click", "#ttsr_detailSearch", function () { self.loadDetail(); });
            // Delete: xóa facility của dòng đang chọn (giống frmTurndownTasksheetDetail)
            $(document).off("click", "#ttsr_detailDelete").on("click", "#ttsr_detailDelete", function () {
                const row = self.detailRow;
                if (!row || !(Number(row.id) > 0)) {
                    showToast("Warning", "Please select a row first!", false);
                    return;
                }
                const doDelete = function () {
                    $.ajax({
                        url: "/HouseKeeping/DeleteTasksheetFacility",
                        type: "POST",
                        data: { id: row.id },
                        headers: { "X-CSRF-TOKEN-HEADERNAME": jQuery("input[name='__RequestVerificationToken']").val() }
                    }).done(function (res) {
                        if (res && res.success) { showToast("Success", res.message, true); self.loadDetail(); }
                        else showToast("Error", (res && res.message) ? res.message : "Cannot delete.", false);
                    }).fail(function (xhr) {
                        if (xhr && xhr.status === 401) { sessionTimeout(); return; }
                        showToast("Error", "Cannot delete.", false);
                    });
                };
                if (window.Swal) {
                    Swal.fire({ title: "Are you sure you want to delete this facility code?", icon: "question", showCancelButton: true, confirmButtonText: "Yes", cancelButtonText: "No" })
                        .then(function (r) { if (r.isConfirmed) doDelete(); });
                } else if (confirm("Are you sure you want to delete this facility code?")) {
                    doDelete();
                }
            });

            $(document).off("click", "#ttsr_detailExcel").on("click", "#ttsr_detailExcel", function () {
                let grid = null;
                try { grid = $("#ttsr_detailGrid").dxDataGrid("instance"); } catch (e) { }
                self.exportGrid(grid, "Tasksheet Detail");
            });

            // ===== Report: danh sách turndown tasksheet (spRptTurndownTasksheet) =====
            $(document).off("click", "#ttsr_btnReport").on("click", "#ttsr_btnReport", function () {
                $("#ttsr_loadingSpinner").css("display", "flex");
                const selectedStatuses = $("input[name='ttsr_includeOptions']:checked").map(function () { return this.value; }).get().join(",");
                $.ajax({
                    url: "/HouseKeeping/TurndownTasksheetReportData",
                    type: "GET",
                    traditional: true,
                    data: {
                        fromDate: $("#ttsr_fromDate").val(),
                        attendant: ($("#ttsr_attendant").val() || []).join(","),
                        roomStatus: selectedStatuses
                    }
                })
                    .done(function (data) {
                        $("#ttsr_loadingSpinner").hide();
                        if (!Array.isArray(data)) { alert("Cannot load report: " + (typeof data === "string" ? data : "invalid response.")); return; }
                        const modalEl = document.getElementById("ttsr_popupNewGridModal");
                        $(modalEl).off("shown.bs.modal.ttsrreport").one("shown.bs.modal.ttsrreport", function () {
                            self.initializeTurndownTasksheetGrid(data);
                        });
                        bootstrap.Modal.getOrCreateInstance(modalEl, { backdrop: "static" }).show();
                    })
                    .fail(function (xhr) {
                        $("#ttsr_loadingSpinner").hide();
                        if (xhr && xhr.status === 401) { sessionTimeout(); return; }
                        alert("Cannot load report: " + ((xhr && xhr.responseText) ? xhr.responseText : "server error."));
                    });
            });

            // ===== Move: chuyển các phòng đã tick sang tasksheet khác =====
            $(document).off("click", "#ttsr_btnMove").on("click", "#ttsr_btnMove", function () {
                if (!self.selectedRows.length) {
                    showToast("Warning", "Please select a row first!", false);
                    return;
                }
                // Danh sách tasksheet có trong lưới (loại tasksheet hiện tại của các phòng đã chọn)
                const currentIds = new Set(self.selectedRows.map(r => String(r.tasksheetID)));
                const sheets = new Map();
                (self.lastData || []).forEach(function (r) {
                    if (r.tasksheetID && !currentIds.has(String(r.tasksheetID)) && !sheets.has(r.tasksheetID)) {
                        sheets.set(r.tasksheetID, "Sheet " + r.tasksheetNo + " - " + (r.attendant || ""));
                    }
                });
                if (!sheets.size) {
                    showToast("Warning", "There is no other task sheet to move to.", false);
                    return;
                }
                const $sel = $("#ttsr_moveTarget").empty();
                sheets.forEach(function (label, id) { $sel.append($("<option>").val(id).text(label)); });
                $("#ttsr_moveRooms").text(self.selectedRows.map(r => r.roomNo).join(", "));
                bootstrap.Modal.getOrCreateInstance(document.getElementById("ttsr_moveModal"), { backdrop: "static" }).show();
            });

            $(document).off("click", "#ttsr_btnMoveOk").on("click", "#ttsr_btnMoveOk", function () {
                const target = $("#ttsr_moveTarget").val();
                const ids = self.selectedRows.map(r => r.tasksheetDetailID).filter(x => x).join(",");
                if (!target || !ids) { showToast("Warning", "Please select a row first!", false); return; }

                $.ajax({
                    url: "/HouseKeeping/MoveTaskSheetDetails",
                    type: "POST",
                    data: { selectedRows: ids, targetTaskSheetData: target },
                    headers: { "X-CSRF-TOKEN-HEADERNAME": jQuery("input[name='__RequestVerificationToken']").val() }
                })
                    .done(function (result) {
                        showToast("Success", (result && result.message) ? result.message : "Moved successfully", true);
                        bootstrap.Modal.getOrCreateInstance(document.getElementById("ttsr_moveModal")).hide();
                        $("#ttsr_btnPrint").trigger("click");
                    })
                    .fail(function (xhr) {
                        if (xhr && xhr.status === 401) { sessionTimeout(); return; }
                        showToast("Error", (xhr.responseJSON && xhr.responseJSON.error) ? xhr.responseJSON.error : "Cannot move rooms.", false);
                    });
            });
        },

        initializeTurndownTasksheetDataGrid: function (data) {
            const self = this;

            // Dispose old
            if (self.gridMain) {
                self.gridMain.dispose();
                self.gridMain = null;
            }
            $("#ttsr_gridContainer").empty();


            self.gridMain = $("#ttsr_gridContainer").dxDataGrid({
                dataSource: data,
                allowColumnResizing: true,
                columnAutoWidth: true,
                width: "100%",
                height: "100%",
                noDataText: "No data",
                columns: [
                    {
                        dataField: "hkstatusID_color",
                        caption: "C",
                        width: 40,
                        allowFiltering: false,
                        cellTemplate: function (container, options) {
                            $("<div>")
                                .addClass("ttsr_status-color-box " + self.colorClass(options.value))
                                .appendTo(container);
                        }
                    },
                    { dataField: "tasksheetNo", caption: "Sheet No" },
                    { dataField: "roomNo", caption: "Room No" },
                    { dataField: "attendant", caption: "Attendant", groupIndex: 0, visible: false },
                    { dataField: "roomType", caption: "Room Type" },
                    { dataField: "credits", caption: "Credits", dataType: "number", format: "#,##0" },
                    { dataField: "facilityTask", caption: "Facility Task" },
                    { dataField: "hkstatusID_color", caption: "Room Status", name: "roomStatusText" },
                    { dataField: "foStatus", caption: "FO Status" },
                    { dataField: "timeIn", caption: "Time In", customizeText: self.formatTime },
                    { dataField: "timeOut", caption: "Time Out", customizeText: self.formatTime },
                    { dataField: "description", caption: "Description" }
                ],

                paging: { pageSize: 20 },
                scrolling: {
                    useNative: true,
                    showScrollbar: "always"
                },
                pager: {
                    visible: true,
                    allowedPageSizes: [20, 50, 'all'],
                    showPageSizeSelector: true,
                    showInfo: true,
                    showNavigationButtons: true
                },
                filterRow: { visible: true, applyFilter: "auto" },
                headerFilter: { visible: true },
                selection: { mode: "multiple", showCheckBoxesMode: "always" },
                grouping: { autoExpandAll: true },
                showBorders: true,

                onCellPrepared: function (e) {
                    // Cột Room Status tô màu kín ô
                    if (e.rowType === "data" && e.column && e.column.name === "roomStatusText") {
                        const cls = self.hkClass(e.value);
                        if (cls) e.cellElement.addClass(cls).css("text-align", "center");
                    }
                },
                onSelectionChanged: function (e) {
                    self.selectedRows = e.selectedRowsData || [];
                },
                onRowClick: function (e) {
                    if (e.rowType === "data") self.focusedRow = e.data;
                }
            }).dxDataGrid("instance");
        },

        colorClass: function (statusName) {
            switch ((statusName || "").trim().toLowerCase()) {
                case "clean non-checked": return "ttsr_color-clean-uncheck";
                case "dirty": return "ttsr_color-dirty";
                case "pickup": return "ttsr_color-pickup";
                case "clean": return "ttsr_color-clean";
                case "out of order": return "ttsr_color-outoforder";
                case "out of services":
                case "out of service": return "ttsr_color-outofservices";
                default: return "";
            }
        },

        hkClass: function (statusName) {
            switch ((statusName || "").trim().toLowerCase()) {
                case "clean non-checked": return "ttsr_hk-clean-uncheck";
                case "dirty": return "ttsr_hk-dirty";
                case "pickup": return "ttsr_hk-pickup";
                case "clean": return "ttsr_hk-clean";
                case "out of order": return "ttsr_hk-outoforder";
                case "out of services":
                case "out of service": return "ttsr_hk-outofservices";
                default: return "";
            }
        },

        initializeTurndownTasksheetGrid: function (data) {
            const self = this;

            // Dispose old
            if (self.gridPopup) {
                self.gridPopup.dispose();
                self.gridPopup = null;
            }
            $("#ttsr_logGridContainer").empty();

            const columnWidth = 120;
            const gridHeight = 600;

            self.gridPopup = $("#ttsr_logGridContainer").dxDataGrid({
                dataSource: data,
                allowColumnResizing: true,
                columnAutoWidth: true,
                height: gridHeight,
                columns: [
                    { dataField: "roomNo", caption: "RoomNo", width: columnWidth },
                    { dataField: "hkStatusID", caption: "Room Status", width: columnWidth + 20 },
                    { dataField: "foStatus", caption: "FOStatus", width: columnWidth },
                    {
                        dataField: "attendant",
                        caption: "Attendant",
                        width: columnWidth,
                        groupIndex: 0,
                        visible: false,
                        groupCellTemplate: function (cellElement, cellInfo) {
                            const groupAttendant = cellInfo.value;
                            const groupData = cellInfo.data.items || [];

                            if (groupData.length > 0) {
                                const firstItem = groupData[0];
                                const taskDate = firstItem.taskDate ? DevExpress.localization.formatDate(new Date(firstItem.taskDate), "dd/MM/yyyy") : "";
                                const taskSheetNo = firstItem.taskSheetNo || "";

                                const html = `
                            <div><strong>Task Date:</strong> ${taskDate}</div>
                            <div><strong>Attendant ID and Name:</strong> ${groupAttendant}</div>
                            <div><strong>Task Sheet No.:</strong> ${taskSheetNo}</div>
                        `;
                                cellElement.html(html);
                            } else {
                                cellElement.text(groupAttendant);
                            }
                        }
                    },
                    { dataField: "credits", caption: "Credits", width: columnWidth, dataType: "number", format: "#,##0" },
                    { dataField: "section", caption: "Section", width: columnWidth },
                    { dataField: "status", caption: "Status", width: columnWidth },
                    { dataField: "turndownStatus", caption: "Turndown Status", width: columnWidth + 30 },
                    { dataField: "lastName", caption: "Name", width: columnWidth + 40 },
                    { dataField: "arrivalDate", caption: "Arr.", width: columnWidth, dataType: "date", format: "dd/MM/yyyy" },
                    { dataField: "arrivalTime", caption: "Arrival Time", width: columnWidth },
                    { dataField: "departureDate", caption: "Dep.", width: columnWidth, dataType: "date", format: "dd/MM/yyyy" },
                    { dataField: "vip", caption: "VIP", width: columnWidth },
                    { dataField: "adult", caption: "A", width: columnWidth, dataType: "number", format: "#,##0" },
                    { dataField: "child", caption: "C", width: columnWidth, dataType: "number", format: "#,##0" },
                    { dataField: "specials", caption: "Specials", width: columnWidth },
                    { dataField: "facilityTask", caption: "Facility Task", width: columnWidth },
                ],
                grouping: { autoExpandAll: true },
                groupPanel: { visible: false },
                paging: { pageSize: 25 },
                scrolling: { useNative: true, showScrollbar: "always" },
                pager: {
                    visible: true,
                    allowedPageSizes: [25, 50, 'all'],
                    showPageSizeSelector: true,
                    showInfo: true,
                    showNavigationButtons: true
                },
                filterRow: { visible: true, applyFilter: "auto" },
                headerFilter: { visible: true },
                selection: { mode: "multiple", showCheckBoxesMode: "none" },
                showBorders: true,
                summary: {
                    groupItems: [
                        { column: "roomNo", summaryType: "count", displayFormat: "Total Room :{0}", showInGroupFooter: true },
                        { column: "adult", summaryType: "sum", displayFormat: "{0}", showInGroupFooter: true },
                        { column: "child", summaryType: "sum", displayFormat: "{0}", showInGroupFooter: true },
                        { column: "credits", summaryType: "sum", displayFormat: "{0}", showInGroupFooter: true }
                    ]
                }
            }).dxDataGrid("instance");
        }
    };

    // Global entry points
    window.openModalTTSR = function () {
        ttsr_Module.init();
        var modalEl = document.getElementById("ttsr_modal");
        var modal = bootstrap.Modal.getOrCreateInstance(modalEl);
        modal.show();
    };

    // Dọn dẹp khi đóng màn chính
    $("#ttsr_modal").on("hidden.bs.modal", function () {
        try { ttsr_Module.destroy(); } catch (e) { }
    });

</script>
