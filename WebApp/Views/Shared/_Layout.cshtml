<!-- Script để load modal -->
<script>
      var ModalManager = {

          init: function () {
              const self = this;

              this.initGlobalEvents()
          },

          initGlobalEvents: function() {

              function modalZ(el) {
                  if (!el) return 0;
                  const inline = parseInt(el.style.zIndex, 10);
                  if (!isNaN(inline) && inline > 0) return inline;
                  return parseInt(getComputedStyle(el).zIndex, 10) || 0;
              }

              function shownModals() {
                  return Array.from(document.querySelectorAll(".modal.show"));
              }

              function stackedModals() {
                  return shownModals().sort(function (a, b) {
                      const d = modalZ(a) - modalZ(b);
                      return d !== 0 ? d : 0;
                  });
              }

              function restoreAfterChildClose(parent) {
                  document.body.classList.add("modal-open");
                  if (!parent || !parent.classList.contains("show")) return;
                  $(parent).find(".modal-content").removeClass("modal-blur");
                  parent.focus({ preventScroll: true });
              }

              // Focus can still be on the parent when a child is opened programmatically.
              // Handle the stack before Bootstrap handles Escape on the focused modal.
              let handledStackEscape = false;
              let closingStackModal = null;
              document.addEventListener("keydown", function (event) {
                  if (event.key !== "Escape" || event.isComposing) return;
                  if (closingStackModal || (event.repeat && handledStackEscape)) {
                      event.preventDefault();
                      event.stopPropagation();
                      event.stopImmediatePropagation();
                      return;
                  }
                  handledStackEscape = false;
                  if ($(".cc-overlay:visible, .swal2-container:visible, .pmsh-select-menu:visible").length) return;
                  if ($(event.target).closest(".dx-overlay-content, .ts-dropdown, .ts-wrapper.dropdown-active").length) return;

                  const modals = stackedModals();
                  if (!modals.length) return;

                  const top = modals[modals.length - 1];
                  const instance = bootstrap.Modal.getInstance(top) || bootstrap.Modal.getOrCreateInstance(top, { backdrop: "static", keyboard: false });
                  if (!instance) return;

                  event.preventDefault();
                  event.stopPropagation();
                  event.stopImmediatePropagation();
                  handledStackEscape = true;

                  const parent = modals.length >= 2 ? modals[modals.length - 2] : null;
                  if (parent) {
                      closingStackModal = top;
                      $(top).off("hidden.bs.modal.stackEscape").one("hidden.bs.modal.stackEscape", function () {
                          closingStackModal = null;
                          restoreAfterChildClose(parent);
                      });
                  }
                  instance.hide();
              }, true);

              // Never hide a parent while a higher child dialog is still shown.
              $(document).on("hide.bs.modal", ".modal", function (e) {
                  const el = this;
                  const higher = shownModals().filter(function (m) {
                      return m !== el && modalZ(m) > modalZ(el);
                  });
                  if (!higher.length) return;
                  e.preventDefault();
                  const top = higher.sort(function (a, b) { return modalZ(a) - modalZ(b); }).pop();
                  const inst = bootstrap.Modal.getInstance(top);
                  if (inst && top !== closingStackModal) inst.hide();
              });

              $(document).on("input change", ".is-invalid, .tomselect-custom, [data-date-input] input", function () {
                  if (window.ValidationAdapter) window.ValidationAdapter.clearField(this);
              });

              // Set z-index at show START (before animation) so modals never appear behind each other during fade-in
              $(document).on("show.bs.modal", ".modal", function () {

                  // CSS filter:blur() on a parent creates a new containing block for position:fixed children.
                  // Move any modal that is not a direct child of <body> to <body> so it is never
                  // affected by a blurred ancestor (e.g. a sub-modal inside #newReservationModal).
                  if (this.parentElement && this.parentElement !== document.body) {
                      document.body.appendChild(this);
                  }

                  const $currentlyShown = $('.modal.show'); // already visible modals

                  $currentlyShown.each(function (index) {
                      $(this).css('z-index', 1050 + (10 * index));
                  });
                  // This modal (not yet in .show) gets the highest z-index
                  $(this).css('z-index', 1050 + (10 * $currentlyShown.length));

                  // Backdrop is created by Bootstrap just after this event; update in next tick
                  const zBase = 1049 + (10 * $currentlyShown.length);
                  setTimeout(function () {
                      $('.modal-backdrop').last().css('z-index', zBase);
                  }, 0);

              });

              // Blur effect + re-verify z-index after animation completes (managed modals only for blur)
              $(document).on("shown.bs.modal", ".modal.managed-modal", function () {

                  $('.modal.show .modal-content').removeClass('modal-blur');
                  $('.modal.show').not(this).find('.modal-content').addClass('modal-blur');

              });

              $(document).on("hidden.bs.modal", ".modal", function () {
                  const rest = stackedModals();
                  const backs = Array.from(document.querySelectorAll(".modal-backdrop"));
                  backs.slice(rest.length).forEach(function (b) { b.remove(); });
                  if (!rest.length) return;
                  document.body.classList.add("modal-open");
                  const top = rest[rest.length - 1];
                  rest.forEach(function (m, i) {
                      $(m).css("z-index", 1050 + (10 * i));
                      $(m).find(".modal-content").toggleClass("modal-blur", m !== top);
                  });
                  document.querySelectorAll(".modal-backdrop").forEach(function (b, i) {
                      b.style.zIndex = String(1049 + (10 * i));
                  });
                  top.focus({ preventScroll: true });
              });

              $(document).on("hide.bs.modal", ".modal.managed-modal", function () {

                  if (document.activeElement) {
                      document.activeElement.blur();
                  }

              });

          },

          getOrCreateContainer: function (modalId) {
              let containerId = "container_" + modalId;
              let $container = $("#" + containerId);
              if ($container.length === 0) {
                  $("body").append(`<div id="${containerId}"></div>`);
                  $container = $("#" + containerId);
              }
              return $container;
          },

          load: function (url, modalId, callback, showModal = true) {

              // Dọn modal cũ còn sót (đã bị chuyển ra <body> ở show.bs.modal) để tránh trùng id:
              // nếu không, getElementById / $("#...") sẽ lấy lại modal + grid cũ (giữ nguyên dòng đã chọn).
              $('[id="' + modalId + '"]').not('.show').each(function () {
                  bootstrap.Modal.getInstance(this)?.dispose();
                  $(this).remove();
              });

              const $container = this.getOrCreateContainer(modalId);

              $container.empty();

              $container.load(url, (response, status, xhr) => {

                  if (status === "error") {
                      if (xhr && (xhr.status === 403 || xhr.status === 401))
                          $container.empty();
                      return;
                  }

                  const modalEl = document.getElementById(modalId);
                  // Tất cả modal (kể cả modal con) thuộc lần load này, để xóa khi đóng
                  const $ownedModals = $container.find('.modal');

                  if (modalEl) {

                      // FIX accessibility
                      if (document.activeElement) {
                          document.activeElement.blur();
                      }

                      $(modalEl).addClass('managed-modal');

                      if (typeof initDateInputs === "function") initDateInputs(modalEl);

                      const invokeModalCallback = function () {
                          if (typeof callback === "string") {
                              waitForFunction(callback, () => {
                                  window[callback]();
                              });
                          } else if (typeof callback === "function") {
                              callback();
                          }
                      };

                      if (showModal) {

                          const modal = bootstrap.Modal.getOrCreateInstance(modalEl,{
                              backdrop:'static',
                              keyboard:false
                          });

                          const hostedModals = $container.find(".modal").get();

                          $(modalEl).one("hidden.bs.modal", () => {

                              modal.dispose();
                              // Modal đã bị chuyển ra <body> nên phải xóa riêng, không chỉ xóa container
                              $ownedModals.each(function () {
                                  if (this !== modalEl) bootstrap.Modal.getInstance(this)?.dispose();
                                  if (this.parentNode) this.remove();
                              });
                              hostedModals.forEach(function (el) {
                                  const inst = bootstrap.Modal.getInstance(el);
                                  if (inst) inst.dispose();
                                  if (el.parentNode) el.remove();
                              });
                              if (modalEl.parentNode) modalEl.remove();
                              $container.remove();

                              if ($('.modal.show').length > 0)
                                  $('body').addClass('modal-open');

                          });

                          // Register before show() so shown.bs.modal is never missed (partial init / grid load).
                          $(modalEl).one("shown.bs.modal", function () {
                              invokeModalCallback();
                          });

                          modal.show();
                      } else {
                          invokeModalCallback();
                      }

                  }
              });
          }
      };


      function waitForFunction(objName, callback, maxAttempts = 10) {
          let attempts = 0;

          const interval = setInterval(() => {
              attempts++;
                if (typeof window[objName] !== "undefined") {
                    clearInterval(interval);
                    callback();
                }
                else if (attempts >= maxAttempts) {
                    clearInterval(interval);
                    console.warn(`Polling: Chờ ${objName} thất bại sau ${maxAttempts} lần thử.`);
                }
            }, 50);
      }

