@using DevExpress.XtraReports.UI
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    ViewBag.Title = ViewBag.ReportHeader;
    var zoneList = ViewBag.ZoneList;
}


<style>
    .filter_wrapper {
        /*     background-color: #ececec; */
        /*   margin: 0px 8px 14px 8px; */
        padding: 18px 0px 0px 14px;
        border-radius: 8px;
    }

    .gridContainer {
        margin: 0px 8px;
    }

    .button_wrapper {
        display: flex;
        column-gap: 12px;
        margin: 0px 8px;
    }

        .button_wrapper .fa-solid {
            margin-right: 5px;
        }

    .selected {
        background-color: #4CAF50; /* Màu xanh */
        color: white;
    }



    .header-row {
        font-weight: bold;
        background-color: #f1f1f1; /* Có thể thay đổi màu nền */
    }

    .sticky-header label,
    .sticky-header .form-control-sm {
        font-size: 14px;
        line-height: 1.2;
    }


    .sticky-header .form-control-sm {
        padding:  2px 8px;
        height: 28px;
    }

    .sticky-header label[class*="me-"] {
        margin-right: .5rem !important;
    }
 
 

</style>
<div class="text-center" id="reportTitle" style="font-size: 20px">NationalStatistics</div>
<div class="sticky-header bg-white p-2 shadow-sm z-3">
    <div class="d-flex flex-wrap align-items-center gap-2 mb-1" style="border: 1px solid #ced4da; border-radius: 6px; padding: 8px;">
        <!-- From Date -->
        <div class="d-flex align-items-center me-3">
            <label class="me-2 mb-0">From Date:</label>
            <div data-date-input business-date data-format="DD/MM/YYYY" data-name="fromDate" style="min-width:140px;">
                <input type="text" class="date-ui form-control form-control-sm"
                       placeholder="dd/mm/yyyy" autocomplete="off" />
            </div>
        </div>

        <!-- To Date -->
        <div class="d-flex align-items-center me-3">
            <label class="me-2 mb-0">To Date:</label>
            <div data-date-input business-date data-format="DD/MM/YYYY" data-name="toDate" style="min-width:140px;">
                <input type="text" class="date-ui form-control form-control-sm"
                       placeholder="dd/mm/yyyy" autocomplete="off" />
            </div>
        </div>
        <div class="d-flex align-items-center me-3">
            <label class="me-2 mb-0">Zone:</label>
            <select id="zone" name="zone" class="form-control form-control-sm report-dd">
                <option value="0">--All--</option>
                @foreach (var item in zoneList)
                {
                    <option value="@item.ID">@item.Name</option>
                }
            </select>
        </div>


        <div class="d-flex align-items-center me-3">
            <label class="me-2 mb-0">View by:</label>
            <select id="sortOrder" name="sortOrder" class="form-control form-control-sm w-auto" style="padding-right: 1.75rem;">
                <option value="0">Stayover by Person</option>
                <option value="1">Stayover by Room</option>
                <option value="2">Arrival by Room</option>
                <option value="3">Arrival by Person</option>
            </select>
        </div>
    </div>
    <div class="">
        <button  id="btnPrint" class="mui-button mui-button-new">View</button>
        <button  id="btnExportExcel" class="mui-button mui-button-new" type="button">  Excel</button>
        <button  id="btnExportPdf" class="mui-button mui-button-new" type="button"> PDF</button>
    </div>
</div>

<div class="mui-card">
@*     <div style="font-size: 20px;" class="mt-1" id="reportTitle"></div> *@
    <div id="gridWrapper" class="mt-2" style="max-height: 500px;">
        <div class="gridContainer mt-2" id="gridContainer"></div>
    </div>
</div>
<div id="loadingSpinner" style="display:none; position:fixed; top:50%; left:50%; transform:translate(-50%, -50%); z-index:1000;">
    <i class="fa-solid fa-spinner fa-spin"></i>
</div>
<script>
    function localTodayIso() {
        const n = new Date();
        const p = (v) => String(v).padStart(2, '0');
        return n.getFullYear() + '-' + p(n.getMonth() + 1) + '-' + p(n.getDate());
    }

    function reportDateScope() {
        const $box = $('#reportContainer');
        return $box.find('[data-name="fromDate"]').length ? $box : $(document);
    }

    function setReportDate(name, iso) {
        const $wrap = reportDateScope().find('[data-date-input][data-name="' + name + '"]');
        const inst = $wrap.data('dateInput');
        if (inst && typeof inst.setISO === 'function') inst.setISO(iso);
    }

    function readReportDate(name) {
        const text = (reportDateScope().find('[data-date-input][data-name="' + name + '"] .date-ui').val() || '').trim();
        const m = text.match(/^(\d{1,2})\/(\d{1,2})\/(\d{2}|\d{4})$/);
        if (!m) return '';
        let year = parseInt(m[3], 10);
        if (year < 100) year += 2000;
        return year + '-' + String(m[2]).padStart(2, '0') + '-' + String(m[1]).padStart(2, '0');
    }

    $(document).ready(async function () {
        const title = document.getElementById("reportTitle");
        if (title) title.innerText = '@ViewBag.ReportTitle';
        if (window.businessDateReady) {
            try { await window.businessDateReady; } catch (e) { }
        }
        window.initDateInputs(reportDateScope()[0]);
    });
   
    $(document).off("click", "#btnPrint").on("click", "#btnPrint", function () {
        const fromDate = readReportDate('fromDate');
        const toDate = readReportDate('toDate');
        if (!fromDate || !toDate) {
            showToast('Warning', 'Nhập From Date và To Date đúng dạng DD/MM/YYYY.', false);
            return;
        }
        if (fromDate > toDate) {
            showToast('Warning', 'From Date phải nhỏ hơn hoặc bằng To Date.', false);
            return;
        }
        $("#loadingSpinner").show();
        $.ajax({
            url: '/Report/NationalStatisticsData',
            type: 'GET',
            data: {
                fromDate: fromDate,
                toDate: toDate,
                   zone: $("#zone").val(),
                   viewby: $("#sortOrder").val(),
            },
            traditional: true,
              crossDomain: false,
                headers: { "X-CSRF-TOKEN-HEADERNAME": jQuery("input[name='__RequestVerificationToken']").val() },
            success: function (result) {
                // $("#reportViewerContainer").html(result);
                // $("#loadingSpinner").hide();
                     console.log(result);
    const processedData = prepareNationalStatistics(result);
    initializeRoomOccupancyGrid(processedData);

                    $("#loadingSpinner").hide();
            },
            error: function () {
                alert("Không thể tải báo cáo.");
                $("#loadingSpinner").hide();
            }
        });
    });
       function prepareNationalStatistics(data) {
        const groupedData = {};

        // Gộp dữ liệu theo MonthArrival và YearArrival
        data.forEach(item => {
            const key = `${item.monthArrival}_${item.yearArrival}`;
            if (!groupedData[key]) groupedData[key] = [];
            groupedData[key].push(item);
        });

        const finalData = [];

        Object.entries(groupedData).forEach(([key, records]) => {
            const [month, year] = key.split("_");

            // Thêm dòng tiêu đề cho từng nhóm
            finalData.push({
                national: `Stayover for Month: ${month}/${year}`,
                 isTitle: true ,
    cssClass: "custom"
            });

            // Thêm các dòng chi tiết
            finalData.push(...records);

            // Thêm dòng tổng
            const totalRow = {
                national: "TOTAL",
                monthArrival: month,
                yearArrival: year,
                cssClass: "custom",
            };

            for (let i = 1; i <= 31; i++) {
                const zoneKey = `zone${i}`;
                totalRow[zoneKey] = sum(records, zoneKey);
            }
                totalRow.sum1 = sum(records, "sum1");

    // 👉 Trung bình percentage
           totalRow.percentage = sum(records, "percentage");
            totalRow.isTotal = true;
            finalData.push(totalRow);
        });

        return finalData;
    }


    // Helper functions
    function sum(arr, field) {
        return arr.reduce((total, item) => total + Number(item[field] || 0), 0);
    }

    function average(arr, field) {
        const valid = arr.filter(x => x[field] != null);
        if (valid.length === 0) return 0;
        return valid.reduce((sum, x) => sum + x[field], 0) / valid.length;
    }

      function initializeRoomOccupancyGrid(data) {
        const columnWidth = 180;

        const numericZoneColumns = Array.from({ length: 31 }, (_, i) => `zone${i + 1}`);
        const numericSummaryColumns = [...numericZoneColumns, "sum1"];

        $("#gridContainer").dxDataGrid({
           dataSource: data,        height: 500,
            allowColumnResizing: true,
            columns: [
                { dataField: "national", caption: "National", width: columnWidth },
                ...numericZoneColumns.map(zone => ({
                    dataField: zone,
                    caption: zone.replace("zone", ""),
                    width: columnWidth - 100,
                    dataType: "number",
                    format: "#,##0"
                })),
                { dataField: "sum1", caption: "Sum", width: columnWidth - 100, dataType: "number", format: "#,##0" },
                { dataField: "percentage", caption: "%", width: columnWidth - 100, dataType: "number", format: "#,##0" }
            ],
            summary: {
                totalItems: [
                    {
                        name: "labelSummary",
                        showInColumn: "national",
                        summaryType: "custom",
                        displayFormat: "Total"
                    },
                    ...numericSummaryColumns.map(field => ({
                        name: `${field}Summary`,
                        showInColumn: field,
                        summaryType: "custom",
                        displayFormat: "{0}",
                        valueFormat: "#,##0"
                    }))
                ],
                calculateCustomSummary: function (e) {
                    const isCustomRow = row => row?.cssClass === "custom" || row?.isTotal === true;

                    if (e.summaryProcess === "start") {
                        e.totalValue = 0;
                    } else if (e.summaryProcess === "calculate") {
                        const row = e.value;
                        if (!isCustomRow(row)) return;

                        const field = e.name.replace("Summary", "");
                        const value = parseFloat(row[field]) || 0;
                        e.totalValue += value;
                    }
                }
            },
            paging: { pageSize: 25 },
            scrolling: {
                useNative: true,
                showScrollbar: "always"
            },
            pager: {
                visible: true,
                allowedPageSizes: [25, 50, 'all'],
                showPageSizeSelector: true,
                showInfo: true,
                showNavigationButtons: true
            },
            filterRow: {
                visible: true,
                applyFilter: "auto"
            },
            headerFilter: {
                visible: true
            },
            selection: {
                mode: "multiple",
                showCheckBoxesMode: "none"
            },
            showBorders: true,
            onRowPrepared: function (e) {
                if (e.rowType === "data" && e.data?.cssClass) {
                    e.rowElement.addClass(e.data.cssClass);
                }
            }
        });
    }





    $("#btnExportExcel").click(function () {
               const grid = $("#gridContainer").dxDataGrid("instance"); var selectedReport2 = '@ViewBag.ReportTitle';
        var selectedReport = '@ViewBag.ReportTitle';
        if (!selectedReport) {
            alert("Vui lòng chọn báo cáo trước khi xuất Excel.");
            return;
        }

                     const workbook = new ExcelJS.Workbook();const companyName = localStorage.getItem("CompanyName") || "Tên công ty chưa xác định";
        const worksheet = workbook.addWorksheet("Sheet 1");

        // === Tạo header công ty (dòng 1) ===
       worksheet.addRow([companyName]);
        worksheet.mergeCells('A1:E1');
        worksheet.getRow(1).font = { bold: true };
        worksheet.getRow(1).alignment = { vertical: 'middle', horizontal: 'left' };

        // === Dòng 2: Thời gian xuất (phải) ===
        const now = new Date();
        const exportDate = now.toLocaleString("vi-VN");
        worksheet.addRow(['', '', '', '', ' ' + exportDate]);
        worksheet.mergeCells('E2:H2');
        worksheet.getRow(2).alignment = { vertical: 'middle', horizontal: 'right' };

        // === Dòng 3–4: Trống
        worksheet.addRow([]);
        worksheet.addRow([]);

        // === Dòng 5: Tên báo cáo ở giữa ===
        const reportRow = worksheet.addRow(['', '', selectedReport]);
        worksheet.mergeCells('C5:F5');
        reportRow.font = { bold: true, size: 14 };
        reportRow.alignment = { vertical: 'middle', horizontal: 'center' };

        // === Dòng 6: Trống trước khi xuất dữ liệu
        worksheet.addRow([]);

        // === Export dữ liệu từ DevExtreme (bắt đầu từ dòng 7)
        DevExpress.excelExporter.exportDataGrid({
            component: grid,
            worksheet: worksheet,
            autoFilterEnabled: true,
            topLeftCell: { row: 7, column: 1 } // dữ liệu bắt đầu từ dòng 7
        }).then(function () {
            // Footer
            const lastRow = worksheet.lastRow.number + 2;
     
            worksheet.mergeCells(`A${lastRow}:F${lastRow}`);
            worksheet.getCell(`A${lastRow}`).alignment = { horizontal: 'center' };
            worksheet.getCell(`A${lastRow}`).font = { italic: true };

            // Ghi file
            let fileName = selectedReport + ".xlsx";
            workbook.xlsx.writeBuffer().then(function (buffer) {
                saveAs(new Blob([buffer], { type: "application/octet-stream" }), fileName);
            });
        });
    });


    // Nút xuất PDF
           $("#btnExportPdf").click(function () {
        const grid = $("#gridContainer").dxDataGrid("instance");

        // Lấy đối tượng jsPDF từ window
        const { jsPDF } = window.jspdf;
        const doc = new jsPDF({ orientation: "landscape", unit: "pt", format: "A4" });

        const selectedReport = '@ViewBag.ReportTitle';
        const companyName = localStorage.getItem("CompanyName") || "Tên công ty chưa xác định";

        grid.getDataSource().load().then(data => {
            const columns = grid.getVisibleColumns();

            const head = [columns.map(col => col.caption)];
            const body = data.map(row =>
                columns.map(col =>
                    col.calculateCellValue ? col.calculateCellValue(row) : row[col.dataField]
                )
            );

            doc.setFontSize(14);
            doc.setFont("Helvetica", "bold");
            doc.text(companyName, doc.internal.pageSize.getWidth() / 2, 40, { align: "center" });

            doc.setFontSize(12);
            doc.setFont("Helvetica", "normal");
            doc.text(selectedReport, doc.internal.pageSize.getWidth() / 2, 60, { align: "center" });

            // AutoTable
            doc.autoTable({
                startY: 80,
                head: head,
                body: body,
                 styles: { fontSize: 9, cellPadding: 4 , lineWidth: 0.5, lineColor: [0, 0, 0]    },
                headStyles: { fillColor: [41, 128, 185], textColor: 255, fontStyle: 'bold' },
                alternateRowStyles: { fillColor: [240, 240, 240] },
                margin: { left: 20, right: 20 }
            });

            doc.save(selectedReport + ".pdf");
        });
    });
</script>
