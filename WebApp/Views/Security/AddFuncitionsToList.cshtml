<script>
    window.openShortcutModal = function () {
        $("#shortcutModal").modal("show");
        shortcut_Module.init();
    };

    $("#shortcutModal").on("hidden.bs.modal", function () {
        shortcut_Module.destroy && shortcut_Module.destroy();
    });

    var shortcut_Module = {
        selectedRowData: null,
        groupRows: [],
        selectedGroup: null,

        init: function () {
            const self = this;
            self.resetState();
            $("#codetag, #namerights").val("");
            $("#functionsRights").prop("checked", true);
            self.loadData();
            self.bindEvents();
            document.addEventListener("keydown", self.handleChildEscape, true);
            if (window.applyPopupRights) {
                window.applyPopupRights("usr_Functions", {
                    new: "#btnNewTheKeyboard",
                    edit: "#btnEditAppoin",
                    delete: "#btnDeleteAppoin",
                    save: "#btnSaveAtt"
                });
            }
        },

        resetState: function () {
            this.selectedRowData = null;
            this.selectedGroup = null;
            this.groupRows = [];
            this.clearForm();
            const $grid = $("#gridContainerAddfu");
            if ($grid.data("dxTreeList")) {
                try { $grid.dxTreeList("instance").clearSelection(); } catch (e) { }
            }
        },

        destroy: function () {
            this.resetState();
            $("#codetag, #namerights").val("");
            $("#functionsRights").prop("checked", true);
            $(document).off(".aff");
            document.removeEventListener("keydown", this.handleChildEscape, true);
            $("#fnGrp_itemModal, #fnGrp_modal, #popupNewGrid").each(function () {
                bootstrap.Modal.getInstance(this)?.dispose();
            }).remove();
        },

        handleChildEscape: function (event) {
            if (event.key !== "Escape" || event.isComposing || event.defaultPrevented) return;
            if ($(".cc-overlay, .swal2-container:visible").length) return;

            const topModal = Array.from(document.querySelectorAll(".modal.show")).reduce((top, modal) => {
                return !top || Number(getComputedStyle(modal).zIndex) >= Number(getComputedStyle(top).zIndex)
                    ? modal : top;
            }, null);
            if (!topModal) return;
            const isChild = topModal.matches("#fnGrp_itemModal, #fnGrp_modal, #popupNewGrid");
            if (!isChild && !(event.repeat && topModal.id === "shortcutModal")) return;

            event.preventDefault();
            event.stopImmediatePropagation();
            if (event.repeat) return;

            bootstrap.Modal.getInstance(topModal)?.hide();
        },

        rightsType: function () {
            return $('input[name="rightsType"]:checked').val() === "1" ? 1 : 0;
        },

        isLeafRow: function (row) {
            return row && parseInt(row.id, 10) > 0;
        },

        bindEvents: function () {
            const self = this;

            $(document).off("click.aff", "#btnPrint").on("click.aff", "#btnPrint", function () {
                self.loadData();
            });

            $(document).off("click.aff", "#btnClose").on("click.aff", "#btnClose", function () {
                $("#shortcutModal").modal("hide");
            });

            $(document).off("click.aff", "#btnGroupFn").on("click.aff", "#btnGroupFn", function () {
                self.openGroupModal();
            });

            $("#btnNewTheKeyboard").off("click").on("click", function () {
                self.openNew();
            });

            $("#btnEditAppoin").off("click").on("click", function () {
                self.editSelected();
            });

            $("#btnDeleteAppoin").off("click").on("click", function () {
                self.deleteSelected();
            });

            $("#btnSaveAtt").off("click").on("click", function () {
                self.saveForm();
            });

            $("#btnExportExcel").off("click").on("click", function () {
                self.exportToExcel();
            });

            $(document).off("change.aff", "input[name=rightsType]").on("change.aff", "input[name=rightsType]", function () {
                self.loadData();
            });

            $("#popupNewGrid").off("hidden.bs.modal.aff").on("hidden.bs.modal.aff", function () {
                self.clearForm();
                self.restoreParentModal("#shortcutModal");
            });

            $(document).off("click.aff", "#fnGrp_btnSearch").on("click.aff", "#fnGrp_btnSearch", function () {
                self.loadGroupGrid();
            });
            $(document).off("click.aff", "#fnGrp_btnNew").on("click.aff", "#fnGrp_btnNew", function () {
                self.openGroupItem(true);
            });
            $(document).off("click.aff", "#fnGrp_btnEdit").on("click.aff", "#fnGrp_btnEdit", function () {
                self.openGroupItem(false);
            });
            $(document).off("click.aff", "#fnGrp_btnDelete").on("click.aff", "#fnGrp_btnDelete", function () {
                self.deleteGroup();
            });
            $(document).off("click.aff", "#fnGrp_btnClose").on("click.aff", "#fnGrp_btnClose", function () {
                $("#fnGrp_modal").modal("hide");
            });
            $(document).off("click.aff", "#fnGrp_btnSave").on("click.aff", "#fnGrp_btnSave", function () {
                self.saveGroup();
            });
            $("#fnGrp_name, #fnGrp_code, #fnGrp_desc").off("keydown.aff").on("keydown.aff", function (e) {
                if (e.key === "Enter") { e.preventDefault(); self.loadGroupGrid(); }
            });
            $("#fnGrp_modal").off("hidden.bs.modal.aff").on("hidden.bs.modal.aff", function () {
                self.selectedGroup = null;
                self.restoreParentModal("#shortcutModal");
            });
            $("#fnGrp_itemModal").off("hidden.bs.modal.aff").on("hidden.bs.modal.aff", function () {
                $("#fnGrp_id").val(0);
                $("#fnGrp_codeNew, #fnGrp_nameNew, #fnGrp_descNew").val("");
                $("#fnGrp_hideNew").prop("checked", true);
                self.restoreParentModal("#fnGrp_modal");
            });
        },
        restoreParentModal: function (selector) {
            const parent = document.querySelector(selector + ".show");
            if (!parent) return;
            document.body.classList.add("modal-open");
            parent.focus();
        },
        selectTreeKey: function (tree, key) {
            if (!tree || key == null) return;
            const node = tree.getNodeByKey(key);
            if (!node || !node.data) return;
            this.selectedRowData = node.data;
            tree.option("focusedRowKey", key);
            tree.selectRows([key], false);
        },

        groupIdFromTreeRow: function (row) {
            if (!row) return 0;
            const raw = parseInt(row.id, 10);
            if (!raw) return 0;
            return Math.abs(raw);
        },

        rowParentId: function (row, node) {
            if (node && node.level > 0 && node.parent && node.parent.data)
                return parseInt(node.parent.data.id, 10) || 0;
            return parseInt(row && (row.parentID ?? row.parentId), 10) || 0;
        },

        rowGroupParentId: function (row) {
            if (!row) return 0;
            return parseInt(row.parentID ?? row.parentId ?? row.ParentID, 10) || 0;
        },

        normalizeTreeRows: function (data) {
            return (data || []).map(function (r) {
                var id = r.id != null ? r.id : r.ID;
                var parentID = r.parentID != null ? r.parentID : (r.ParentID != null ? r.ParentID : (r.parentId != null ? r.parentId : 0));
                return {
                    id: id,
                    parentID: parentID,
                    name: r.name != null ? r.name : (r.Name || ""),
                    code: r.code != null ? r.code : (r.Code || ""),
                    isHide: r.isHide != null ? r.isHide : r.IsHide,
                    createdBy: r.createdBy != null ? r.createdBy : r.CreatedBy,
                    createdDate: r.createdDate != null ? r.createdDate : r.CreatedDate,
                    updatedBy: r.updatedBy != null ? r.updatedBy : r.UpdatedBy,
                    updatedDate: r.updatedDate != null ? r.updatedDate : r.UpdatedDate
                };
            });
        },

        /** Nhóm gắn function: level > 0 (vd Profile Config), không phải module gốc (Profile, System). */
        isFunctionGroupTarget: function (groupRow, groupNode) {
            if (groupNode && typeof groupNode.level === "number")
                return groupNode.level > 0;
            return groupRow && this.rowGroupParentId(groupRow) !== 0;
        },

        resolveSelectedGroup: function (row) {
            if (!row) return null;
            const tree = $("#gridContainerAddfu").dxTreeList("instance");
            const node = tree ? tree.getNodeByKey(row.id) : null;
            const isLeaf = this.isLeafRow(row) && !(node && node.hasChildren);

            let groupRow = row;
            let groupNode = node;
            if (isLeaf) {
                if (node && node.parent && node.parent.data) {
                    groupRow = node.parent.data;
                    groupNode = node.parent;
                } else {
                    const pid = this.rowParentId(row, node);
                    if (!pid) return null;
                    const parentNode = tree ? tree.getNodeByKey(pid) : null;
                    groupRow = (parentNode && parentNode.data) || null;
                    groupNode = parentNode;
                    if (!groupRow) return null;
                }
            }

            const id = this.groupIdFromTreeRow(groupRow);
            if (!id) return null;
            if (!this.isFunctionGroupTarget(groupRow, groupNode)) return null;
            const gname = groupRow.name != null ? groupRow.name : (groupRow.Name || "");
            return { id: id, name: gname };
        },

        openNew: function () {
            const group = this.resolveSelectedGroup(this.selectedRowData);
            if (!group) {
                showToast("Warning", "Please select a function.", false);
                return;
            }
            this.clearForm();
            $("#groupnew").val(group.id);
            $("#groupnewName").val(group.name);
            $("#chkDisplay").prop("checked", true);
            $("#popupNewGrid").modal("show");
        },

        setGroupDisplay: function (groupId, groupName) {
            $("#groupnew").val(groupId || "");
            $("#groupnewName").val(groupName || "");
        },
        loadData: function () {
            const self = this;
            $("#loadingSpinner").show();
            const rightsType = $('input[name="rightsType"]:checked').val();

            $.ajax({
                url: '/FormAndFunction/AddFuncitionsToListData',
                type: 'GET',
                data: {
                    codetag: $("#codetag").val(),
                    namerights: $("#namerights").val(),
                    isDataRight: rightsType,
                },
                traditional: true,
                headers: { "X-CSRF-TOKEN-HEADERNAME": jQuery("input[name='__RequestVerificationToken']").val() },
                success: function (result) {
                    self.initializeGrid(result);
                    $("#loadingSpinner").hide();
                },
                error: function () {
                    alert("Không thể tải dữ liệu.");
                    $("#loadingSpinner").hide();
                }
            });
        },
        initializeGrid: function (data) {
            const self = this;
            self.selectedRowData = null;
            const rows = self.normalizeTreeRows(data);
            $("#gridContainerAddfu").dxTreeList({
                dataSource: rows,
                keyExpr: "id",
                parentIdExpr: "parentID",
                rootValue: 0,
                height: 500,
                showBorders: true,
                columnAutoWidth: true,
                autoExpandAll: false,
                columns: [
                    { dataField: "name", caption: "Function", width: "28%" },
                    { dataField: "code", caption: "Code Tag", width: "18%" },
                    booleanColumn("isHide", "Display", 95, true),
                    { dataField: "createdBy", caption: "Created By", width: 110 },
                    { dataField: "createdDate", caption: "Cre.Date", width: 118, dataType: "date", format: "dd/MM/yyyy" },
                    { dataField: "updatedBy", caption: "Updated By", width: 110 },
                    { dataField: "updatedDate", caption: "Upd.Date", width: 118, dataType: "date", format: "dd/MM/yyyy" }
                ],
                selection: { mode: "single" },
                focusedRowEnabled: true,
                autoNavigateToFocusedRow: true,
                keyboardNavigation: { enabled: true },
                filterRow: { visible: true },
                headerFilter: { visible: true },
                paging: { enabled: false },
                scrolling: { mode: "standard" },
                onRowClick: function (e) {
                    self.selectedRowData = e.data || null;
                },
                onFocusedRowChanged: function (e) {
                    const key = e.component.option("focusedRowKey");
                    const data = e.row && e.row.data;
                    if (!data || key == null) return;
                    self.selectedRowData = data;
                    e.component.selectRows([key], false);
                },
                onRowExpanding: function (e) {
                    self.selectTreeKey(e.component, e.key);
                },
                onRowCollapsing: function (e) {
                    self.selectTreeKey(e.component, e.key);
                },
                onSelectionChanged: function (e) {
                    self.selectedRowData = (e.selectedRowsData && e.selectedRowsData[0]) || null;
                },
                onRowPrepared: function (e) {
                    if (e.rowType === "data" && e.node.hasChildren) {
                        e.rowElement.css("background-color", "#f8f9fa");
                        e.rowElement.children("td").first().css("font-weight", "bold");
                    }
                }
            });
        },

        editSelected: function () {
            const self = this;
            if (!self.selectedRowData) {
                showToast('Warning', 'Please select a function.', false);
                return;
            }
            if (!self.isLeafRow(self.selectedRowData)) {
                showToast('Warning', 'Please select a function.', false);
                return;
            }

            const rightsType = $('input[name="rightsType"]:checked').val();
            $("#loadingSpinner").show();

            $.ajax({
                url: '/FormAndFunction/AddFuncitionsToListDetail',
                type: 'GET',
                data: {
                    id: self.selectedRowData.id,
                    isDataRight: rightsType,
                },
                traditional: true,
                headers: { "X-CSRF-TOKEN-HEADERNAME": jQuery("input[name='__RequestVerificationToken']").val() },
                success: function (res) {
                    const result = res[0] || {};
                    self.populateForm(result, rightsType);
                    $("#popupNewGrid").modal("show");
                    $("#loadingSpinner").hide();
                },
                error: function () {
                    alert("Không thể tải chi tiết.");
                    $("#loadingSpinner").hide();
                }
            });
        },

        formatAuditDate: function (v) {
            if (!v) return "";
            const d = new Date(v);
            if (isNaN(d)) return "";
            const dd = String(d.getDate()).padStart(2, "0");
            const mm = String(d.getMonth() + 1).padStart(2, "0");
            return dd + "/" + mm + "/" + d.getFullYear();
        },

        populateForm: function (data, rightsType) {
            $("#txtid").val(data.id || "");
            $("#codetagnew").val(data.code || "");
            $("#namerightnew").val(data.name || "");
            $("#descriptionnew").val(data.description || data.name || "");
            $("#chkDisplay").prop("checked", !data.isHide);

            const groupId = rightsType == "1" ? (data.formAndFunctionDataGroupID || "") : (data.formAndFunctionGroupID || "");
            let groupName = "";
            const tree = $("#gridContainerAddfu").dxTreeList("instance");
            if (tree && this.selectedRowData) {
                const node = tree.getNodeByKey(this.selectedRowData.id);
                if (node && node.parent && node.parent.data)
                    groupName = node.parent.data.name || "";
            }
            this.setGroupDisplay(groupId, groupName);
        },

        clearForm: function () {
            $("#txtid").val("");
            $("#codetagnew").val("");
            $("#namerightnew").val("");
            $("#descriptionnew").val("");
            this.setGroupDisplay("", "");
            $("#chkDisplay").prop("checked", true);
        },

        saveForm: function () {
            const self = this;
            const rightsType = $('input[name="rightsType"]:checked').val();
            if (!$("#txtid").val() && !$("#groupnew").val()) {
                showToast("Warning", "Please select a function.", false);
                return;
            }

            const data = {
                ID: $("#txtid").val(),
                codetagnew: $("#codetagnew").val(),
                namerightnew: $("#namerightnew").val(),
                descriptionnew: $("#descriptionnew").val(),
                mappingLinkWeb: "",
                groupnew: $("#groupnew").val(),
                isHide: $('#chkDisplay').is(':checked') ? 0 : 1,
                isShift: 0,
                isCtrl: 0,
                isAlt: 0,
                functionkeynew: "",
                _IsDataRight: rightsType,
                userName: JSON.parse(localStorage.getItem("Loginname")),
                userID: JSON.parse(localStorage.getItem("userID"))
            };

            $.ajax({
                url: '/FormAndFunction/UpdateFormAndFunction',
                type: 'POST',
                data: data,
                traditional: true,
                headers: { "X-CSRF-TOKEN-HEADERNAME": jQuery("input[name='__RequestVerificationToken']").val() },
                success: function (response) {
                    if (response.success) {
                        $("#popupNewGrid").modal("hide");
                        self.loadData();
                        self.clearForm();
                    } else {
                        showToast('Warning', response.message, false);
                    }
                },
                error: function () {
                    showToast('Error', 'Không thể lưu dữ liệu.', false);
                }
            });
        },

        openGroupModal: function () {
            const nameCap = this.rightsType() === 1 ? "Data" : "Function";
            $("#fnGrp_title").text(this.rightsType() === 1 ? "Data Group" : "Function Group");
            $("#fnGrp_nameLabel, #fnGrp_nameNewLabel").text(nameCap);
            $("#fnGrp_name, #fnGrp_code, #fnGrp_desc").val("");
            this.selectedGroup = null;
            $("#fnGrp_modal").modal("show");
            this.loadGroupGrid();
        },

        syncMainGroupOptions: function () { },

        fillParentSelect: function ($sel, selectedId, placeholder = "All", skipId = 0) {
            const rows = [{ id: 0, name: placeholder }, ...this.groupRows];
            $sel.empty();
            rows.forEach(function (group) {
                if (skipId && Number(group.id) === Number(skipId)) return;
                $sel.append(new Option(group.name || "", group.id));
            });
            $sel.val(String(selectedId));
            if ($sel.val() === null) $sel.val("0");
        },

        applyGroupFilter: function (rows) {
            const name = ($("#fnGrp_name").val() || "").trim().toLowerCase();
            const code = ($("#fnGrp_code").val() || "").trim().toLowerCase();
            const desc = ($("#fnGrp_desc").val() || "").trim().toLowerCase();
            const parent = parseInt($("#fnGrp_parent").val(), 10) || 0;
            return (rows || []).filter(function (r) {
                if (name && !(r.name || "").toLowerCase().includes(name)) return false;
                if (code && !(r.code || "").toLowerCase().includes(code)) return false;
                if (desc && !(r.description || "").toLowerCase().includes(desc)) return false;
                if (parent && r.parentId !== parent && r.id !== parent) return false;
                return true;
            });
        },

        loadGroupGrid: function () {
            const self = this;
            $.ajax({
                url: "/FormAndFunction/FunctionGroupTree",
                type: "GET",
                data: { isDataRight: self.rightsType() },
                success: function (data) {
                    if (data && data.code === -1) {
                        showToast("Error", data.msg, false);
                        return;
                    }
                    self.groupRows = data || [];
                    self.fillParentSelect($("#fnGrp_parent"), parseInt($("#fnGrp_parent").val(), 10) || 0);
                    self.syncMainGroupOptions();
                    self.renderGroupGrid(self.applyGroupFilter(self.groupRows));
                },
                error: function () {
                    showToast("Error", "Unable to load groups.", false);
                }
            });
        },

        renderGroupGrid: function (data) {
            const self = this;
            const $el = $("#fnGrp_grid");
            const nameCap = this.rightsType() === 1 ? "Data" : "Function";
            const cols = [
                { dataField: "name", caption: nameCap, width: 240 },
                { dataField: "code", caption: "Code", width: 140 },
                { dataField: "description", caption: "Description", minWidth: 180 },
                { dataField: "createdBy", caption: "Created By", width: 90 },
                { dataField: "createdDate", caption: "Cre.Date", width: 90, dataType: "date", format: "dd/MM/yyyy" },
                { dataField: "updatedBy", caption: "Updated By", width: 90 },
                { dataField: "updatedDate", caption: "Upd.Date", width: 90, dataType: "date", format: "dd/MM/yyyy" }
            ];
            if ($el.data("dxTreeList")) {
                const live = $el.dxTreeList("instance");
                live.columnOption("name", "caption", nameCap);
                live.option("dataSource", data || []);
                live.clearSelection();
                self.selectedGroup = null;
                return;
            }
            $el.dxTreeList({
                dataSource: data || [],
                keyExpr: "id",
                parentIdExpr: "parentId",
                rootValue: 0,
                height: 420,
                showBorders: true,
                columnAutoWidth: true,
                autoExpandAll: false,
                selection: { mode: "single" },
                paging: { enabled: false },
                columns: cols,
                onRowClick: function (e) { self.selectedGroup = e.data; },
                onSelectionChanged: function (e) { self.selectedGroup = e.selectedRowsData[0] || null; }
            });
        },

        openGroupItem: function (isNew) {
            const self = this;
            const skip = isNew ? 0 : (self.selectedGroup ? self.selectedGroup.id : 0);
            if (isNew) {
                $("#fnGrp_id").val(0);
                $("#fnGrp_codeNew, #fnGrp_nameNew, #fnGrp_descNew").val("");
                $("#fnGrp_hideNew").prop("checked", true);
                self.fillParentSelect($("#fnGrp_parentNew"), self.selectedGroup ? self.selectedGroup.id : 0, "None");
                $("#fnGrp_itemTitle").text("New Group");
                $("#fnGrp_itemModal").modal("show");
                return;
            }
            if (!self.selectedGroup) {
                showToast("Warning", "Please select a group to edit.", false);
                return;
            }
            $.get("/FormAndFunction/FunctionGroupDetail", { id: self.selectedGroup.id, isDataRight: self.rightsType() }, function (item) {
                if (!item || item.code === -1) {
                    showToast("Warning", (item && item.msg) || "Group not found.", false);
                    return;
                }
                $("#fnGrp_id").val(item.id);
                $("#fnGrp_codeNew").val(item.code || "");
                $("#fnGrp_nameNew").val(item.name || "");
                $("#fnGrp_descNew").val(item.description || "");
                $("#fnGrp_hideNew").prop("checked", !item.isHide);
                self.fillParentSelect($("#fnGrp_parentNew"), item.parentId || 0, "None", item.id);
                $("#fnGrp_itemTitle").text("Edit Group");
                $("#fnGrp_itemModal").modal("show");
            }).fail(function () {
                showToast("Error", "Unable to load group.", false);
            });
        },

        saveGroup: function () {
            const self = this;
            $.ajax({
                url: "/FormAndFunction/FunctionGroupSave",
                type: "POST",
                data: {
                    id: $("#fnGrp_id").val() || 0,
                    code: $("#fnGrp_codeNew").val(),
                    name: $("#fnGrp_nameNew").val(),
                    description: $("#fnGrp_descNew").val(),
                    parentId: $("#fnGrp_parentNew").val() || 0,
                    isHide: $("#fnGrp_hideNew").is(":checked") ? 0 : 1,
                    isDataRight: self.rightsType()
                },
                success: function (res) {
                    if (res.success) {
                        $("#fnGrp_itemModal").modal("hide");
                        self.loadGroupGrid();
                        self.loadData();
                    } else {
                        showToast("Warning", res.message, false);
                    }
                },
                error: function () {
                    showToast("Error", "Unable to save group.", false);
                }
            });
        },

        deleteGroup: function () {
            const self = this;
            if (!self.selectedGroup) {
                showToast("Warning", "Please select a group to delete.", false);
                return;
            }
            if (!confirm("Delete this group?")) return;
            $.ajax({
                url: "/FormAndFunction/FunctionGroupDelete",
                type: "POST",
                data: { id: self.selectedGroup.id, isDataRight: self.rightsType() },
                success: function (res) {
                    if (res.success) {
                        showToast("Success", res.message, true);
                        self.selectedGroup = null;
                        self.loadGroupGrid();
                        self.loadData();
                    } else {
                        showToast("Warning", res.message, false);
                    }
                },
                error: function () {
                    showToast("Error", "Unable to delete group.", false);
                }
            });
        },

        deleteSelected: function () {
            const self = this;
            if (!self.selectedRowData) {
                showToast('Warning', 'Please select a function.', false);
                return;
            }
            if (!self.isLeafRow(self.selectedRowData)) {
                showToast('Warning', 'Please select a function.', false);
                return;
            }

            if (!confirm("Bạn chắc chắn muốn xóa mục này?")) return;

            $.ajax({
                url: '/FormAndFunction/DeleteFormAndFunction',
                type: 'POST',
                data: {
                    ID: self.selectedRowData.id,
                    isDataRight: $('input[name="rightsType"]:checked').val()
                },
                traditional: true,
                headers: { "X-CSRF-TOKEN-HEADERNAME": jQuery("input[name='__RequestVerificationToken']").val() },
                success: function (response) {
                    if (response.success) {
                        showToast('Success', response.message, true);
                        self.loadData();
                        self.selectedRowData = null;
                    } else {
                        showToast('Warning', response.message, false);
                    }
                },
                error: function () {
                    showToast('Error', 'Không thể xóa.', false);
                }
            });
        },

        exportToExcel: function () {
            const grid = $("#gridContainerAddfu").dxTreeList("instance");
            const selectedReport = 'AddFuncitionsToList';
            const workbook = new ExcelJS.Workbook();
            const worksheet = workbook.addWorksheet("Sheet 1");

            worksheet.addRow(['Công ty Cổ phần Giải pháp Công nghệ CS-Solution']);
            worksheet.mergeCells('A1:E1');
            worksheet.getRow(1).font = { bold: true };
            worksheet.getRow(1).alignment = { vertical: 'middle', horizontal: 'left' };

            const now = new Date();
            worksheet.addRow(['', '', '', '', ' ' + now.toLocaleString("vi-VN")]);
            worksheet.mergeCells('E2:H2');
            worksheet.getRow(2).alignment = { vertical: 'middle', horizontal: 'right' };

            worksheet.addRow([]);
            worksheet.addRow([]);

            const reportRow = worksheet.addRow(['', '', selectedReport]);
            worksheet.mergeCells('C5:F5');
            reportRow.font = { bold: true, size: 14 };
            reportRow.alignment = { vertical: 'middle', horizontal: 'center' };

            worksheet.addRow([]);

            DevExpress.excelExporter.exportDataGrid({
                component: grid,
                worksheet: worksheet,
                autoFilterEnabled: true,
                topLeftCell: { row: 7, column: 1 }
            }).then(function () {
                const lastRow = worksheet.lastRow.number + 2;
                worksheet.getCell(`A${lastRow}`).value = "--- END ---";
                worksheet.mergeCells(`A${lastRow}:F${lastRow}`);
                worksheet.getCell(`A${lastRow}`).alignment = { horizontal: 'center' };
                worksheet.getCell(`A${lastRow}`).font = { italic: true };

                let fileName = selectedReport + ".xlsx";
                workbook.xlsx.writeBuffer().then(function (buffer) {
                    saveAs(new Blob([buffer], { type: "application/octet-stream" }), fileName);
                });
            });
        }
    }

    function booleanColumn(field, caption, width, invert) {
        return {
            dataField: field,
            caption: caption,
            width: width || "6%",
            alignment: "center",
            cellTemplate: function (container, options) {
                $("<div>")
                    .dxCheckBox({
                        value: invert ? !options.value : !!options.value,
                        readOnly: true
                    })
                    .css({
                        transform: "scale(0.85)",
                        margin: "0 auto"
                    })
                    .appendTo(container);
            }
        };
    }
</script>
