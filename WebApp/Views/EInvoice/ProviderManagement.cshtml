<div class="modal fade" id="eop_mapModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header"><h6 class="modal-title" id="eop_mapTitle">Mapping</h6></div>
            <div class="modal-body">
                <div class="search-filter mb-2">
                    <button type="button" id="eop_mapSave" class="mui-button mui-button-save">Save</button>
                    <button type="button" data-bs-dismiss="modal" class="mui-button mui-button-close">Close</button>
                </div>
                <form id="eop_mapForm" novalidate>
                    <input type="hidden" name="id" value="0" />
                    <div class="row g-2">
                        <div class="col-12 col-lg-3"><div class="row g-1 align-items-center">
                            <label class="col-md-5 col-form-label col-form-label-sm text-md-end">Location <span class="text-danger">*</span></label>
                            <div class="col-md-7"><select name="mappingLocation" class="form-select form-select-sm"><option>BODY</option><option>HEADER</option><option>QUERY</option><option>PATH</option><option>FORM</option><option>RESPONSE</option></select><div class="invalid-feedback"></div></div>
                        </div></div>
                        <div class="col-12 col-lg-9"><div class="row g-1 align-items-center">
                            <label class="col-md-2 col-form-label col-form-label-sm text-md-end">Target Path <span class="text-danger">*</span></label>
                            <div class="col-md-10"><input type="text" name="targetPath" class="form-control form-control-sm" maxlength="500" /><div class="invalid-feedback"></div></div>
                        </div></div>

                        <div class="col-12 col-lg-3"><div class="row g-1 align-items-center">
                            <label class="col-md-5 col-form-label col-form-label-sm text-md-end">Source Type <span class="text-danger">*</span></label>
                            <div class="col-md-7"><select name="sourceType" class="form-select form-select-sm">
                                <option>INVOICE</option><option>INVOICEDETAIL</option><option>CONFIG</option><option>STATIC</option><option>CONSTANT</option><option>SYSTEM</option>
                                <option>RESPONSE</option><option>COLLECTION</option><option>DOCUMENT</option><option>CUSTOM</option><option>PROPERTY</option><option>SESSION</option>
