                        </div></div>
                        <div class="col-12 col-lg-4"><div class="row g-1 align-items-center">
                            <label class="col-md-6 col-form-label col-form-label-sm text-md-end">Action Code (SOAP)</label>
                            <div class="col-md-6"><input type="text" name="actionCode" class="form-control form-control-sm" maxlength="50" /><div class="invalid-feedback"></div></div>
                        </div></div>
                        <div class="col-12 col-lg-4"><div class="row g-1 align-items-center">
                            <label class="col-md-6 col-form-label col-form-label-sm text-md-end">Display Order</label>
                            <div class="col-md-6"><input type="number" name="displayOrder" class="form-control form-control-sm" value="0" /></div>
                        </div></div>

                        <div class="col-12"><div class="row g-1 align-items-start">
                            <label class="col-md-2 col-form-label col-form-label-sm text-md-end">Description</label>
                            <div class="col-md-10"><textarea name="description" class="form-control form-control-sm" rows="2" maxlength="500"></textarea><div class="invalid-feedback"></div></div>
                        </div></div>

                        <div class="col-12"><div class="row g-1">
                            <div class="col-md-10 offset-md-2"><label class="mb-0 text-danger"><input type="checkbox" name="inactive" /> Inactive</label></div>
                        </div></div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

