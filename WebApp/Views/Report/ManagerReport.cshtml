@using DevExpress.XtraReports.UI
@{
    ViewBag.Title = ViewBag.ReportHeader;
    var report = ViewBag.ReportName as XtraReport;
    var currencyList = ViewBag.CurrencyList as IEnumerable<BaseBusiness.Model.CurrencyModel>;
}

<style>
    .filter_wrapper {
        padding: 18px 0px 0px 14px;
        border-radius: 8px;
    }

    .gridContainer {
        margin: 0px 8px;
    }

    .button_wrapper {
        display: flex;
        column-gap: 12px;
        margin: 0px 8px;
    }

        .button_wrapper .fa-solid {
            margin-right: 5px;
        }

    .selected {
        background-color: #4CAF50;
        color: white;
    }

 

    .sticky-header label,
    .sticky-header .form-control-sm {
        font-size: 14px;
        line-height: 1.2;
    }


    .sticky-header .form-control-sm {
        padding:  2px 8px;
        height: 28px;
    }

    .sticky-header label[class*="me-"] {
        margin-right: .5rem !important;
    }
 

    .report-bar {
        position: relative;
        margin-bottom: 1rem; /* = mb-3 của bạn */
    }

        /* Tiêu đề ở giữa, full width để text-center hoạt động */
        .report-bar #reportTitle {
            font-size: 20px;
            margin: 0; /* bỏ margin dưới h4/h5 mặc định */
            text-align: center;
        }

        /* Nhóm nút cố định góc phải, canh theo chiều dọc */
        .report-bar .action-buttons {
            position: absolute;
            left: 0;
            top: 50%;
            transform: translateY(-50%);
        }

    .tomselect-custom {
        width: 300px;
        min-height: 30px; /* hoặc tùy theo chiều cao bạn muốn */
        font-size: 0.65rem;
    }
    .mgr-grid {
        display: grid;
        grid-template-columns: 92px max-content 140px auto;
        column-gap: 6px;
        row-gap: 8px;
        align-items: center;
    }
    .mgr-section {
        font-weight: 700;
        white-space: nowrap;
        margin: 0;
    }
    .mgr-grid > label {
        margin: 0;
        white-space: nowrap;
        justify-self: end;
    }
    .mgr-ctl,
    .mgr-grid [data-date-input],
    .mgr-grid select.form-control-sm {
        width: 140px;
        min-width: 140px;
        max-width: 140px;
        height: 28px;
    }
    .mgr-include {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 6px 10px;
        margin-left: 8px;
    }
    .mgr-check {
        display: flex;
        align-items: center;
    }
    .mgr-check .form-check-input {
        margin: 0;
    }
    .mgr-check .form-check-label {
        margin-left: 6px;
        white-space: nowrap;
    }
</style>
<div class="text-center" id="reportTitle" style="font-size: 20px">@ViewBag.ReportTitle</div>

<div class="sticky-header bg-white p-2 shadow-sm z-3">
    <div class="mgr-grid" style="border: 1px solid #ced4da; border-radius: 6px; padding: 8px;">
        <span class="mgr-section">Date Range</span>
        <label>Date:</label>
        <div class="mgr-ctl" data-date-input business-date data-format="DD/MM/YYYY" data-name="businessDate">
            <input type="text" class="date-ui form-control form-control-sm"
                   placeholder="dd/mm/yyyy" autocomplete="off" />
        </div>
        <span></span>

        <span class="mgr-section">Filter</span>
        <label>View By:</label>
        <select id="currency" name="currency" class="form-control form-control-sm">
            @if (currencyList != null)
            {
                foreach (var item in currencyList)
                {
                    if (string.Equals(item.ID, "VND", StringComparison.OrdinalIgnoreCase))
                    {
                        <option value="@item.ID" selected>@item.ID</option>
                    }
                    else
                    {
                        <option value="@item.ID">@item.ID</option>
                    }
                }
            }
            else
            {
                <option value="VND" selected>VND</option>
            }
        </select>
        <div class="mgr-include">
            <span class="mgr-section">Include</span>
            <div class="mgr-check">
                <input class="form-check-input" type="checkbox" id="includeTax" checked>
                <label class="form-check-label" for="includeTax">Tax</label>
            </div>
            <div class="mgr-check">
                <input class="form-check-input" type="checkbox" id="includeLastYear">
                <label class="form-check-label" for="includeLastYear">Last Year</label>
            </div>
            <div class="mgr-check">
                <input class="form-check-input" type="checkbox" id="includeForecast">
                <label class="form-check-label" for="includeForecast">Forecast</label>
            </div>
            <label style="margin: 0 6px 0 0; white-space: nowrap;">No.OfDays</label>
            <input id="noOfDays" type="number" min="1" max="31" class="form-control form-control-sm" style="width:72px; height:28px;" disabled>
        </div>
    </div>
  
    <div class="">
        <button  id="btnPrint" class="mui-button mui-button-new">View</button>
        <button  id="btnExportExcel" class="mui-button mui-button-new" type="button">  Excel</button>
        <button  id="btnExportPdf" class="mui-button mui-button-new" type="button"> PDF</button>
        <button  id="btnPrintGrid" class="mui-button mui-button-new" type="button">
            Print
        </button>
    </div>
</div>
<div class="mui-card">
    <div id="gridWrapper" class="mt-2">
        <div class="gridContainer mt-2" id="gridContainer"></div>
    </div>
</div>

<div id="loadingSpinner" style="display:none; position:fixed; top:50%; left:50%; transform:translate(-50%, -50%); z-index:1000; text-align:center;">
    <i class="fa-solid fa-spinner fa-spin"></i>
    <div id="loadingSpinnerText" style="margin-top:8px; font-size:13px;">Đang tải…</div>
</div>

<script>
 

    $(document).ready(function () {
        window.initDateInputs();
        document.getElementById("reportTitle").innerText = '@ViewBag.ReportTitle';
        $("#includeForecast").on("change", function () {
            var on = $(this).is(":checked");
            $("#noOfDays").prop("disabled", !on);
            if (on && !$("#noOfDays").val()) $("#noOfDays").val(5);
            if (!on) $("#noOfDays").val("");
        });
    });

    function managerDate() {
        return $("#businessDate").val() || $("[data-name='businessDate'] .date-ui").val() || "";
    }
    function managerParams(recalc) {
        return {
            businessDate: managerDate(),
            currency: $("#currency").val() || "VND",
            recalc: recalc ? 1 : 0
        };
    }
    function fetchManagerReport(recalc) {
        return $.ajax({
            url: "/Report/ManagerReport",
            type: "GET",
            timeout: recalc ? 360000 : 30000,
            headers: { "X-CSRF-TOKEN-HEADERNAME": $('input[name="__RequestVerificationToken"]').val() },
            data: managerParams(recalc)
        });
    }
    $(document).off("click", "#btnPrint").on("click", "#btnPrint", function () {
        $("#loadingSpinnerText").text("Đang tải…");
        $("#loadingSpinner").show();
        fetchManagerReport(false)
            .then(function (preview) {
                if (Array.isArray(preview) && preview.length) initializeDataGrid(preview);
                $("#loadingSpinnerText").text("Đang tính theo ngày / View By đã chọn…");
                return fetchManagerReport(true);
            })
            .then(function (result) {
                if (!Array.isArray(result)) {
                    alert((result && result.error) ? result.error : "Không thể tải báo cáo.");
                    return;
                }
                initializeDataGrid(result);
            })
            .fail(function () {
                alert("Không thể tải báo cáo.");
            })
            .always(function () {
                $("#loadingSpinner").hide();
            });
    });

    function managerGridHeight() {
        var el = document.getElementById("gridContainer");
        var top = el ? el.getBoundingClientRect().top : 260;
        return Math.max(480, Math.floor(window.innerHeight - top - 12));
    }
    function initializeDataGrid(data) {
        const money = { dataType: "number", format: "#,##0.00", width: 120 };
        pmshBindDxReportGrid("#gridContainer", {
            dataSource: Array.isArray(data) ? data : [],
            height: managerGridHeight(),
            allowColumnResizing: true,
            loadPanel: { enabled: false },
            headerFilter: { visible: false },
            columns: [
                { dataField: "code", caption: "", visible: false },
                { dataField: "itemName", caption: "Name", minWidth: 280 },
                Object.assign({ dataField: "currentDay", caption: "Curr. Day" }, money),
                Object.assign({ dataField: "currentMonth", caption: "Curr. Month" }, money),
                Object.assign({ dataField: "currentYear", caption: "Curr. Year" }, money),
                Object.assign({ dataField: "lastDay", caption: "Last Day" }, money),
                Object.assign({ dataField: "lastMonth", caption: "Last Month" }, money),
                Object.assign({ dataField: "lastYear", caption: "Last Year" }, money)
            ],
            paging: { enabled: false },
            pager: { visible: false },
            selection: { mode: "none" },
            filterRow: { visible: true, applyFilter: "auto" },
            showBorders: true
        });
    }
    $(window).off("resize.managerReport").on("resize.managerReport", function () {
        var grid = $("#gridContainer").data("dxDataGrid");
        if (grid) grid.option("height", managerGridHeight());
    });



    $("#btnExportExcel").click(function () {
               const grid = $("#gridContainer").dxDataGrid("instance"); var selectedReport2 = '@ViewBag.ReportTitle';
        var selectedReport = '@ViewBag.ReportTitle';
        if (!selectedReport) {
            alert("Vui lòng chọn báo cáo trước khi xuất Excel.");
            return;
        }

                     const workbook = new ExcelJS.Workbook();const companyName = localStorage.getItem("CompanyName") || "Tên công ty chưa xác định";
        const worksheet = workbook.addWorksheet("Sheet 1");

        // === Tạo header công ty (dòng 1) ===
       worksheet.addRow([companyName]);
        worksheet.mergeCells('A1:E1');
        worksheet.getRow(1).font = { bold: true };
        worksheet.getRow(1).alignment = { vertical: 'middle', horizontal: 'left' };

        // === Dòng 2: Thời gian xuất (phải) ===
        const now = new Date();
        const exportDate = now.toLocaleString("vi-VN");
        worksheet.addRow(['', '', '', '', ' ' + exportDate]);
        worksheet.mergeCells('E2:H2');
        worksheet.getRow(2).alignment = { vertical: 'middle', horizontal: 'right' };

        // === Dòng 3–4: Trống
        worksheet.addRow([]);
        worksheet.addRow([]);

        // === Dòng 5: Tên báo cáo ở giữa ===
        const reportRow = worksheet.addRow(['', '', selectedReport]);
        worksheet.mergeCells('C5:F5');
        reportRow.font = { bold: true, size: 14 };
        reportRow.alignment = { vertical: 'middle', horizontal: 'center' };

        // === Dòng 6: Trống trước khi xuất dữ liệu
        worksheet.addRow([]);

        // === Export dữ liệu từ DevExtreme (bắt đầu từ dòng 7)
        DevExpress.excelExporter.exportDataGrid({
            component: grid,
            worksheet: worksheet,
            autoFilterEnabled: true,
            topLeftCell: { row: 7, column: 1 } // dữ liệu bắt đầu từ dòng 7
        }).then(function () {
            // Footer
            const lastRow = worksheet.lastRow.number + 2;

            worksheet.mergeCells(`A${lastRow}:F${lastRow}`);
            worksheet.getCell(`A${lastRow}`).alignment = { horizontal: 'center' };
            worksheet.getCell(`A${lastRow}`).font = { italic: true };

            // Ghi file
            let fileName = selectedReport + ".xlsx";
            workbook.xlsx.writeBuffer().then(function (buffer) {
                saveAs(new Blob([buffer], { type: "application/octet-stream" }), fileName);
            });
        });
    });

       $("#btnExportPdf").click(function () {
        const grid = $("#gridContainer").dxDataGrid("instance");

        // Lấy đối tượng jsPDF từ window
        const { jsPDF } = window.jspdf;
        const doc = new jsPDF({ orientation: "landscape", unit: "pt", format: "A4" });

        const selectedReport = '@ViewBag.ReportTitle';
        const companyName = localStorage.getItem("CompanyName") || "Tên công ty chưa xác định";

        grid.getDataSource().load().then(data => {
            const columns = grid.getVisibleColumns();

            const head = [columns.map(col => col.caption)];
            const body = data.map(row =>
                columns.map(col =>
                    col.calculateCellValue ? col.calculateCellValue(row) : row[col.dataField]
                )
            );

            doc.setFontSize(14);
            doc.setFont("Helvetica", "bold");
            doc.text(companyName, doc.internal.pageSize.getWidth() / 2, 40, { align: "center" });

            doc.setFontSize(12);
            doc.setFont("Helvetica", "normal");
            doc.text(selectedReport, doc.internal.pageSize.getWidth() / 2, 60, { align: "center" });

            // AutoTable
            doc.autoTable({
                startY: 80,
                head: head,
                body: body,
                 styles: { fontSize: 9, cellPadding: 4 , lineWidth: 0.5, lineColor: [0, 0, 0]    },
                headStyles: { fillColor: [41, 128, 185], textColor: 255, fontStyle: 'bold' },
                alternateRowStyles: { fillColor: [240, 240, 240] },
                margin: { left: 20, right: 20 }
            });

            doc.save(selectedReport + ".pdf");
        });
    });
            $("#btnPrintGrid").on("click", function () {
               const grid = $("#gridContainer").dxDataGrid("instance"); var selectedReport2 = '@ViewBag.ReportTitle';

        // Lấy toàn bộ data từ dataSource
        grid.getDataSource().load().then(function (data) {
            // Tạo bảng HTML từ dữ liệu
            let tableHTML = '<table border="1" style="border-collapse: collapse; width: 100%;">';

            // Header
            const columns = grid.getVisibleColumns();
            tableHTML += "<thead><tr>";
            columns.forEach(col => {
                tableHTML += `<th style="padding: 5px; text-align: center;">${col.caption}</th>`;
            });
            tableHTML += "</tr></thead>";

            // Body
            tableHTML += "<tbody>";
            data.forEach(row => {
                tableHTML += "<tr>";
                columns.forEach(col => {
                    let value = col.calculateCellValue ? col.calculateCellValue(row) : row[col.dataField];
                    tableHTML += `<td style="padding: 5px;">${value ?? ""}</td>`;
                });
                tableHTML += "</tr>";
            });
            tableHTML += "</tbody></table>";

            // Mở cửa sổ in với nội dung bảng
            const printWindow = window.open('', '', 'height=800,width=1000');
            if (!printWindow) {
                alert("Trình duyệt đang chặn cửa sổ in.");
                return;
            }

           printWindow.document.write('<html><head><title>' + selectedReport2 + '</title>');
            printWindow.document.write('<style>table { font-family: Arial; font-size: 12px; }</style>');
            printWindow.document.write('</head><body>');
            printWindow.document.write(tableHTML);
            printWindow.document.write('</body></html>');
            printWindow.document.close();

            // Chờ nội dung render xong rồi in
            printWindow.onload = function () {
                printWindow.focus();
                printWindow.print();
                printWindow.close();
            };
        });
    });
</script>
