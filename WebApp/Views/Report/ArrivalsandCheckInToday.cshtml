@using DevExpress.XtraReports.UI
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    ViewBag.Title = ViewBag.ReportHeader;
    var roomclassList = ViewBag.RoomClassList;
    var rtList = ViewBag.RoomTypeList;
    var arList = ViewBag.ARPaymentList;
    var vipList = ViewBag.VIPList;
}


<style>
    .filter_wrapper {
        /*     background-color: #ececec; */
        /*   margin: 0px 8px 14px 8px; */
        padding: 18px 0px 0px 14px;
        border-radius: 8px;
    }

    .gridContainer {
        margin: 0px 8px;
    }

    .button_wrapper {
        display: flex;
        column-gap: 12px;
        margin: 0px 8px;
    }

    .button_wrapper .fa-solid {
        margin-right: 5px;
    }

    .selected {
        background-color: #4CAF50;
        /* Màu xanh */
        color: white;
    }

    #gridContainer .dx-datagrid-total-footer td {
        overflow: visible !important;
    }
    #gridContainer .dx-datagrid-total-footer .dx-datagrid-summary-item {
        white-space: nowrap !important;
        overflow: visible !important;
        text-overflow: clip !important;
    }

    #gridContainer .dx-datagrid-rowsview .dx-selection {
        background-color: #01579b !important;
        /* màu xanh ngọc */
        color: white !important;
        /* chữ trắng */
    }

    #gridContainer .dx-datagrid-rowsview .dx-selection * {
        color: white !important;
    }

    .sticky-header .form-control-sm {
        padding:  2px 8px;
        height: 28px;
    }

    .sticky-header label[class*="me-"] {
        margin-right: .5rem !important;
    }

    #gridContainer .dx-datagrid-headers .dx-header-row>td {
        padding: 5px !important;
        height: 24px !important;
        font-size: 12px !important;
        line-height: 1.1 !important;
    }

    .sticky-header input[type="date"].form-control-sm {
        font-size: 12px !important;
        /* đúng 12 px */
        height: 28px;
        /* giữ cùng chiều cao */
    }

    .sticky-header label {
        font-size: 12px !important;
        line-height: 1.2;
    }

    .tomselect-custom {
        width: 250px;
        min-height: 30px;
        /* hoặc tùy theo chiều cao bạn muốn */
        font-size: 0.65rem;
    }

    .sort-select {
        max-width: 130px;
        /* hoặc 100px nếu muốn nhỏ hơn */
        font-size: 12px;
        padding: 0.15rem 0.5rem;
    }

    .sort-select {
        -webkit-appearance: none;
        -moz-appearance: none;
        appearance: none;
        background-image: none !important;
        padding-right: 10px !important;
    }

    .tomselect-custom .ts-control {
        padding-left: 8px !important;
        /* hoặc bất kỳ giá trị nào bạn muốn */
    }

    .act-filter-grid {
        display: grid;
        grid-template-columns: max-content minmax(140px, 1fr) max-content minmax(140px, 1fr) max-content minmax(140px, 1fr);
        column-gap: 8px;
        row-gap: 8px;
        align-items: center;
        width: 100%;
        min-width: 0;
        box-sizing: border-box;
    }
    .act-filter-grid > label {
        margin-right: 0 !important;
        margin-bottom: 0;
        white-space: nowrap;
    }
    .act-filter-grid select,
    .act-filter-grid [data-date-input] {
        width: 100%;
        min-width: 0;
        max-width: 100%;
    }
    .act-filter-grid .span-checks {
        grid-column: 2 / -1;
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        column-gap: 12px;
        align-items: center;
        min-width: 0;
    }
    #reportContainer .act-filter-grid .form-check,
    .act-filter-grid .form-check {
        padding-left: 0 !important;
        margin: 0 !important;
        min-height: 0;
        min-width: 0;
        white-space: nowrap;
        display: flex !important;
        align-items: center;
        gap: 6px;
    }
    #reportContainer .act-filter-grid .span-checks > .form-check:first-child,
    .act-filter-grid .span-checks > .form-check:first-child {
        margin-left: 0 !important;
    }
    #reportContainer .act-filter-grid .form-check-input,
    .act-filter-grid .form-check-input {
        margin: 0 !important;
        float: none !important;
        position: static !important;
    }
    .act-filter-grid .form-check-label {
        margin-left: 0 !important;
        padding-left: 0 !important;
    }
</style>
<div class="text-center" id="reportTitle" style="font-size: 20px"></div>
<div class="sticky-header bg-white p-2 shadow-sm z-3">
    <div class="mb-1" style="border: 1px solid #ced4da; border-radius: 6px; padding: 8px;">
        <div class="act-filter-grid">
            <label>Room Class:</label>
            <select id="roomClass" name="roomClass" class="form-control form-control-sm report-dd">
                <option value="">--All--</option>
                @foreach (var item in roomclassList)
                {
                    <option value="@item.Code">@item.Code</option>
                }
            </select>
            <label>Room Type:</label>
            <select id="roomtype" name="roomtype" class="form-control form-control-sm report-dd">
                <option value="">--All--</option>
                @foreach (var item in rtList)
                {
                    <option value="@item.Code">@item.Code</option>
                }
            </select>
            <label>Pay Method:</label>
            <select id="paymethod" name="paymethod" class="form-control form-control-sm report-dd">
                <option value="">--All--</option>
                @foreach (var item in arList)
                {
                    <option value="@item.TransactionCode">@item.Description</option>
                }
            </select>

            <label class="fw-bold">Include:</label>
            <div class="span-checks">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="pseudo" name="includeOptions" value="1">
                    <label class="form-check-label" for="pseudo">Pseudo Rooms</label>
                </div>
                <div class="form-check" id="vipContainer">
                    <input class="form-check-input include-option" type="checkbox" id="viponlycheck" name="viponlycheck">
                    <label class="form-check-label" for="viponlycheck">Vip Only</label>
                    <select id="vip" name="vip" class="form-control form-control-sm" style="width: 100px; display: none;">
                        <option value=""></option>
                        @foreach (var item in vipList)
                        {
                            <option value="@item.Code">@item.Description</option>
                        }
                    </select>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="sharenames" name="includeOptions" value="1">
                    <label class="form-check-label" for="sharenames">Share Names</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="accompanying" name="includeOptions" value="1">
                    <label class="form-check-label" for="accompanying">Accompanying Names</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="disRoomSharer" name="includeOptions" value="1" checked>
                    <label class="form-check-label" for="disRoomSharer">Display Room Sharer</label>
                </div>
            </div>

            <label class="fw-bold">Display:</label>
            <div class="span-checks">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="printpate" name="includeOptions" checked>
                    <label class="form-check-label" for="printpate">Print Rate</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="nopost" name="includeOptions">
                    <label class="form-check-label" for="nopost">No Post</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="commnets" name="includeOptions">
                    <label class="form-check-label" for="commnets">Comments</label>
                </div>
            </div>

            <label class="fw-bold">Sort Order:</label>
            <select id="viewBy" name="viewBy" class="form-control form-control-sm report-dd">
                <option value="0">Alphabetical</option>
                <option value="1">Room No</option>
                <option value="2">Reservation Status</option>
                <option value="3">VIP code</option>
                <option value="4">Departure Time</option>
            </select>
        </div>
    </div>
    <div class="">
        <button id="btnPrint" class="mui-button mui-button-new">View</button>
        <button id="btnExportExcel" class="mui-button mui-button-new" type="button">   Excel</button>
        <button id="btnExportPdf" class="mui-button mui-button-new" type="button">
            PDF</button>
    </div>

</div>

<div class="mui-card">
    @*     <div style="font-size: 20px;" class="mt-1" id="reportTitle"></div> *@
    <div id="gridWrapper" class="mt-2" style="max-height: 500px;">
        <div class="gridContainer mt-2" id="gridContainer"></div>
    </div>
</div>
<div id="loadingSpinner"
    style="display:none; position:fixed; top:50%; left:50%; transform:translate(-50%, -50%); z-index:1000;">
    <i class="fa-solid fa-spinner fa-spin"></i>
</div>
<script>
    function formatDate(date) {
        let year = date.getFullYear();
        let month = (date.getMonth() + 1).toString().padStart(2, '0'); // Đảm bảo có 2 chữ số
        let day = date.getDate().toString().padStart(2, '0'); // Đảm bảo có 2 chữ số
        return `${year}-${month}-${day}`;
    }

    $(document).ready(function () {

        $('#viponlycheck').on('change', function () {
            if ($(this).is(':checked')) {
                $('#vip').show();
            } else {
                $('#vip').hide();
                $('#vip').val('');
            }
        });

        document.getElementById("reportTitle").innerText = '@ViewBag.ReportTitle';
        const today = new Date();

        const firstDayOfMonth = new Date(today.getFullYear(), today.getMonth(), 1);
        // Lấy ngày cuối cùng của tháng
        const lastDayOfMonth = new Date(today.getFullYear(), today.getMonth() + 1, 0);

        // Định dạng theo local time
        const formattedFirstDay = formatDate(firstDayOfMonth);
        const formattedLastDay = formatDate(lastDayOfMonth);

        console.log(formattedFirstDay); // Kiểm tra giá trị đúng chưa
        console.log(formattedLastDay); // Kiểm tra giá trị đúng chưa
        // Gán giá trị cho input date
        // document.getElementById('fromDate').value = formattedFirstDay;
        // document.getElementById('toDate').value = formattedLastDay;


    });
    function initializeTomSelects() {
        const selectors = ["#roomClass", "#roomtype", "#paymethod"];

        for (const id of selectors) {
            const el = document.querySelector(id);
            if (!el) continue;

            // Nếu đã khởi tạo rồi thì destroy
            if (el.tomselect) el.tomselect.destroy();

            const ts = new TomSelect(el, {
                plugins: ['remove_button'],
                create: false,
                maxItems: null,
                allowEmptyOption: true,
                placeholder: '',
                persist: false,
                render: {
                    option: function (data, escape) {
                        return `<div>${escape(data.text)}</div>`;
                    }
                }
            });

        }
    }
    $(document).off("click", "#btnPrint").on("click", "#btnPrint", function () {
        $("#loadingSpinner").show();
        $.ajax({
            url: '/Report/ArrivalsandCheckInTodayData',
            type: 'GET',
            data: {
                roomClass: ($("#roomClass").val() || ""),
                roomtype: ($("#roomtype").val() || ""),
                paymethod: ($("#paymethod").val() || ""),
                vip: $("#vip").val(),
                viewBy: $("#viewBy").val(),
                pseudo: $("#pseudo").is(":checked") ? "1" : "",
                viponlycheck: $("#viponlycheck").is(":checked") ? "1" : "",
                disRoomSharer: $("#disRoomSharer").is(":checked") ? "1" : 0,
                nopost: $('#nopost').is(':checked') ? "1" : ""
            },
            traditional: true,
            crossDomain: false,
            headers: { "X-CSRF-TOKEN-HEADERNAME": jQuery("input[name='__RequestVerificationToken']").val() },
            success: function (result) {
                // $("#reportViewerContainer").html(result);
                // $("#loadingSpinner").hide();
                initializArrivalsandCheckInTodayGrid(result);
                $("#loadingSpinner").hide();
            },
            error: function () {
                alert("Không thể tải báo cáo.");
                $("#loadingSpinner").hide();
            }
        });
    });



    function initializArrivalsandCheckInTodayGrid(data) {

        const columnWidth = 180;

        pmshBindDxReportGrid("#gridContainer", {
            dataSource: data,
            height: 500,
            allowColumnResizing: true,

            columns: [
                { dataField: "roomNo", caption: "Room No", width: columnWidth - 70 },
                { dataField: "name", caption: "Name", width: columnWidth },
                { dataField: "roomClassCode", caption: "Room Class", dataType: "number", format: "#,##0" },

                {
                    caption: "Stay On",
                    width: columnWidth + 50,
                    cssClass: "wrap-cell",
                    cellTemplate: function (container, options) {

                        const itemInventory = options.data.itemInventory;
                        const specials = options.data.specials;
                        const roomClassCode = options.data.roomClassCode ?? "";
                        const comments = options.data.comment;
                        const showComments = $("#commnets").is(":checked");

                        let topLineParts = [];
                        if (itemInventory) topLineParts.push(`<b>ItemInventory:</b> ${itemInventory}`);
                        if (specials) topLineParts.push(`<b>Specials:</b> ${specials}`);

                        const topLine = topLineParts.length
                            ? `<div>${topLineParts.join(" | ")}</div>`
                            : "";

                        const roomClassLine = `<div>${roomClassCode}</div>`;

                        let commentsLine = "";
                        if (showComments && comments) {
                            commentsLine = `<div><b>Res.Comments:</b> ${comments}</div>`;
                        }

                        container.html(`${topLine}${roomClassLine}${commentsLine}`);
                    }
                },

                { dataField: "reservationStatus", caption: "Status", width: columnWidth - 70 },
                { dataField: "vIP", caption: "VIP", width: columnWidth - 80 },
                { dataField: "agent", caption: "Reservation Holder", width: columnWidth },
                { dataField: "businessBlockCode", caption: "BlockCode", width: columnWidth - 70 },
                { dataField: "arrivalDate", caption: "Arr.Date", width: columnWidth - 60, dataType: "date", format: "dd/MM/yyyy" },
                { dataField: "eta", caption: "ETA", width: columnWidth - 70 },
                { dataField: "departureDate", caption: "Dep.Date", width: columnWidth - 60, dataType: "date", format: "dd/MM/yyyy" },
                { dataField: "etd", caption: "ETD", width: columnWidth - 70 },
                { dataField: "roomType", caption: "Ro.Type", width: columnWidth - 70 },

                { dataField: "noOfAdult", caption: "A.", width: columnWidth - 80, dataType: "number", format: "#,##0" },
                { dataField: "noOfChild", caption: "C.", width: columnWidth - 80, dataType: "number", format: "#,##0" },
                { dataField: "noOfChild1", caption: "C1.", width: columnWidth - 80, dataType: "number", format: "#,##0" },
                { dataField: "noOfChild2", caption: "C2.", width: columnWidth - 80, dataType: "number", format: "#,##0" },
                { dataField: "noOfRoom", caption: "Rms", width: columnWidth - 80, dataType: "number", format: "#,##0" },

                { dataField: "paymentMethod", caption: "Pay mth", width: columnWidth - 70 },
                { dataField: "rateCode", caption: "Rate Code", width: columnWidth - 70 },
                { dataField: "rate", caption: "Rate Amount", width: columnWidth - 70, dataType: "number", format: "#,##0" },
                { dataField: "currencyID", caption: "Curr.", width: columnWidth - 70 }
            ],

            paging: { enabled: false },
            pager: { visible: false },

            filterRow: {
                visible: true,
                applyFilter: "auto"
            },

            selection: {
                mode: "multiple",
                showCheckBoxesMode: "none"
            },

            summary: {
                totalItems: [
                    {
                        column: "roomNo",
                        summaryType: "custom",
                        name: "roomNo",
                        showInColumn: "name",
                        displayFormat: "Total Arrived Room: {0}"
                    },
                    { column: "roomType", summaryType: "custom", displayFormat: "Total" },
                    { column: "noOfAdult", summaryType: "sum", valueFormat: "#,##0" },
                    { column: "noOfChild", summaryType: "sum", valueFormat: "#,##0" },
                    { column: "noOfChild1", summaryType: "sum", valueFormat: "#,##0" },
                    { column: "noOfChild2", summaryType: "sum", valueFormat: "#,##0" },
                    { column: "noOfRoom", summaryType: "sum", valueFormat: "#,##0" }
                ],

                calculateCustomSummary: function (e) {

                    // ✅ chỉ xử lý summary ArrivedRoom
                    if (e.name !== "roomNo") return;

                    // 🔹 khởi tạo
                    if (e.summaryProcess === "start") {
                        e.totalValue = new Set();
                    }

                    // 🔹 mỗi dòng data
                    if (e.summaryProcess === "calculate") {
                        console.log(e.value);
                        const roomNo = e.value;
                        if (roomNo !== null && roomNo !== undefined && roomNo !== "") {
                            e.totalValue.add(String(roomNo).trim());
                        }
                    }

                    // 🔹 kết quả cuối
                    if (e.summaryProcess === "finalize") {
                        e.totalValue = e.totalValue.size;
                    }
                }
            }
            ,


            showBorders: true,

            onRowPrepared: function (e) {
                if (e.rowType === "data" && e.data?.cssClass) {
                    e.rowElement.addClass(e.data.cssClass);
                }
            }
        });
    }




    $("#btnExportExcel").click(function () {
        const grid = $("#gridContainer").dxDataGrid("instance"); var selectedReport2 = '@ViewBag.ReportTitle';
        var selectedReport = '@ViewBag.ReportTitle';
        if (!selectedReport) {
            alert("Vui lòng chọn báo cáo trước khi xuất Excel.");
            return;
        }

        const workbook = new ExcelJS.Workbook(); const companyName = localStorage.getItem("CompanyName") || "Tên công ty chưa xác định";
        const worksheet = workbook.addWorksheet("Sheet 1");

        // === Tạo header công ty (dòng 1) ===
        worksheet.addRow([companyName]);
        worksheet.mergeCells('A1:E1');
        worksheet.getRow(1).font = { bold: true };
        worksheet.getRow(1).alignment = { vertical: 'middle', horizontal: 'left' };

        // === Dòng 2: Thời gian xuất (phải) ===
        const now = new Date();
        const exportDate = now.toLocaleString("vi-VN");
        worksheet.addRow(['', '', '', '', ' ' + exportDate]);
        worksheet.mergeCells('E2:H2');
        worksheet.getRow(2).alignment = { vertical: 'middle', horizontal: 'right' };

        // === Dòng 3–4: Trống
        worksheet.addRow([]);
        worksheet.addRow([]);

        // === Dòng 5: Tên báo cáo ở giữa ===
        const reportRow = worksheet.addRow(['', '', selectedReport]);
        worksheet.mergeCells('C5:F5');
        reportRow.font = { bold: true, size: 14 };
        reportRow.alignment = { vertical: 'middle', horizontal: 'center' };

        // === Dòng 6: Trống trước khi xuất dữ liệu
        worksheet.addRow([]);

        // === Export dữ liệu từ DevExtreme (bắt đầu từ dòng 7)
        DevExpress.excelExporter.exportDataGrid({
            component: grid,
            worksheet: worksheet,
            autoFilterEnabled: true,
            topLeftCell: { row: 7, column: 1 } // dữ liệu bắt đầu từ dòng 7
        }).then(function () {
            // Footer
            const lastRow = worksheet.lastRow.number + 2;
            worksheet.mergeCells(`A${lastRow}:F${lastRow}`);
            worksheet.getCell(`A${lastRow}`).alignment = { horizontal: 'center' };
            worksheet.getCell(`A${lastRow}`).font = { italic: true };

            // Ghi file
            let fileName = selectedReport + ".xlsx";
            workbook.xlsx.writeBuffer().then(function (buffer) {
                saveAs(new Blob([buffer], { type: "application/octet-stream" }), fileName);
            });
        });
    });



    $("#btnExportPdf").click(function () {
        const grid = $("#gridContainer").dxDataGrid("instance");

        // Lấy đối tượng jsPDF từ window
        const { jsPDF } = window.jspdf;
        const doc = new jsPDF({ orientation: "landscape", unit: "pt", format: "A4" });

        const selectedReport = '@ViewBag.ReportTitle';
        const companyName = localStorage.getItem("CompanyName") || "Tên công ty chưa xác định";

        grid.getDataSource().load().then(data => {
            const columns = grid.getVisibleColumns();

            const head = [columns.map(col => col.caption)];
            const body = data.map(row =>
                columns.map(col =>
                    col.calculateCellValue ? col.calculateCellValue(row) : row[col.dataField]
                )
            );

            doc.setFontSize(14);
            doc.setFont("Helvetica", "bold");
            doc.text(companyName, doc.internal.pageSize.getWidth() / 2, 40, { align: "center" });

            doc.setFontSize(12);
            doc.setFont("Helvetica", "normal");
            doc.text(selectedReport, doc.internal.pageSize.getWidth() / 2, 60, { align: "center" });

            // AutoTable
            doc.autoTable({
                startY: 80,
                head: head,
                body: body,
                styles: { fontSize: 9, cellPadding: 4, lineWidth: 0.5, lineColor: [0, 0, 0] },
                headStyles: { fillColor: [41, 128, 185], textColor: 255, fontStyle: 'bold' },
                alternateRowStyles: { fillColor: [240, 240, 240] },
                margin: { left: 20, right: 20 }
            });

            doc.save(selectedReport + ".pdf");
        });
    });
</script>
