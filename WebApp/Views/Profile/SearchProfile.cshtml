        // ===== History > Resv. (WinForm: mở frmReservation của dòng đang chọn) =====
        openHistoryReservation: function () {
            const rid = this.histReservationID;
            if (!rid) {
                showToast("Warning", "Please select a reservation", false);
                return;
            }

            const modal = $('#newReservationModal');
            modal.find('.modal-body').html('<div class="text-center py-5"><div class="spinner-border text-primary" role="status"></div><p class="mt-3">Loading reservation...</p></div>');
            modal.modal('show');

            $.ajax({
                url: '/Reservation/EncryptId', type: 'POST', data: { id: rid },
                success: function (response) {
                    if (!response || !response.success) {
                        modal.modal('hide');
                        showToast('Error', 'Cannot open reservation.', false);
                        return;
                    }
                    $.ajax({
                        url: '/Reservation/NewReservation', type: 'GET', data: { key: response.encryptedId }, cache: false,
                        success: function (html) {
                            modal.find('.modal-body').html(html);
                            if (typeof window.focusNewReservationFirstField === 'function') window.focusNewReservationFirstField();
                        },
                        error: function () {
                            modal.find('.modal-body').html('<div class="alert alert-danger m-4">Unable to load reservation details.</div>');
                        }
                    });
                },
                error: function () {
                    modal.modal('hide');
                    showToast('Error', 'Server connection error.', false);
                }
            });
        },

        // ===== History > View Folio (WinForm: frmCshBillingManagement của dòng đang chọn) =====
        // Dùng lại popup Billing của Search Reservation (nạp từ /Reservation/ReservationOptionsHost),
        // giống cách màn Guest In House (Cashiering) đang làm.
        ensureReservationHost: function () {
            const self = this;
            if (self._rvhReady) return self._rvhReady;

            self._rvhReady = new Promise(function (resolve, reject) {
                // Trang hiện tại đã có sẵn popup Billing (vd. Search Reservation) thì dùng lại
                if ($('#modalBilling').length) { resolve(); return; }

                // Nạp 1 lần cho cả trang, đặt ngoài modal Search Profile để không bị xóa khi đóng
                let $host = $('#pro_search_rvhHost');
                if (!$host.length) $host = $('<div id="pro_search_rvhHost"></div>').appendTo('body');

                $host.load('/Reservation/ReservationOptionsHost', function (resp, st, xhr) {
                    if (st === 'error') {
                        self._rvhReady = null;
                        showToast('Error', xhr.status === 403 ? 'Access Denied' : 'Unable to load billing.', false);
                        reject();
                    } else {
                        resolve();
                    }
                });
            });
            return self._rvhReady;
        },

        openHistoryFolio: function () {
            const self = this;
            const rid = self.histReservationID;
            if (!rid) {
                showToast("Warning", "Please select a reservation", false);
                return;
            }

            $.ajax({
                url: '/Reservation/GetReservationByID', type: 'GET', dataType: 'json', data: { ID: rid },
                success: function (res) {
                    if (!res || typeof res !== 'object') {
                        showToast('Error', 'Cannot load reservation.', false);
                        return;
                    }
                    self.ensureReservationHost().then(function () {
                        const statusText = ['RESVED', 'CHECKED IN', 'CHECKED OUT', 'CANCEL', 'WAIT LIST',
                            'DUE IN', 'DUE OUT', 'NO SHOW', 'DAY USE'][res.status] || '';
                        const arrival = res.arrivalDate || '';
                        const departure = res.departureDate || '';
                        const guestName = res.lastName || '';
                        const row = {
                            ID: rid,
                            ReservationStatus: res.status,
                            Status: statusText,
                            ConfirmationNo: res.confirmationNo,
                            Arrival: arrival,
                            Departure: departure,
                            GuestName: guestName,
                            LastName: guestName,
                            RoomNo: res.roomNo,
                            RoomID: res.roomId,
                            RoomType: res.roomType,
                            ProfileIndividualID: res.profileIndividualId,
                            PriceNet: res.rate,
                            NoOfNight: res.noOfNight,
                            GroupName: res.groupName,
                            CompanyName: res.companyName
                        };

                        // Biến trang mà popup Billing đọc (giống khi chọn 1 dòng ở Search Reservation)
                        window.idReservation = rid;
                        window.statusID = res.status;
                        window.reservationStatus = res.status;
                        window.roomID = res.roomId;
                        window.status = statusText;
                        window.roomStatus = '';
                        window.roomType = res.roomType;
                        window.roomNo = res.roomNo;
                        window.arivalDate = arrival;
                        window.departureDate = departure;
                        window.confirmationNo = res.confirmationNo;
                        window.lastname = guestName;
                        window.profileID = res.profileIndividualId;
                        window.rateAmount = res.rate;
                        window.night = res.noOfNight;
                        window._currentReservationData = row;
                        window.listReservationByConfirmationNo = [row];

                        $('#rsvStatusBilling').text(statusText);
                        $('#conNoBilling').text(res.confirmationNo || '');
                        $('#arivalBilling').text(arrival ? String(arrival).split('T')[0] : '');
                        $('#departureBilling').text(departure ? String(departure).split('T')[0] : '');
                        if (typeof window.setBillingHeaderInfo === 'function') window.setBillingHeaderInfo(row);
                        if (typeof window.GetBalanceVND === 'function') window.GetBalanceVND(rid);

                        if (typeof window.openModalBilling !== 'function') {
                            showToast('Warning', 'This function is not available.', false);
                            return;
                        }
                        window.openModalBilling();
                    }).catch(function () { });
                },
                error: function () {
                    showToast('Error', 'Cannot load reservation.', false);
                }
            });
        },

        openConfirmMerge: function () {
            const selectedRows = pro_search_Module.gridInstance.getSelectedRowsData();

            if ($("#pro_search_txtType").val() == "") {
                showToast("Warning","Chooise view by profile type (Not view all) to merge, please!",false);
                return;
            }

            if (selectedRows.length !== 2) {
                showToast("Warning", "Please select exactly 2 profiles to merge", false);
                return;
            }

            ModalManager.load('/Profile/MergeProfile', 'modalMergeProfile', function() {
                waitForFunction("openModalMerge", () => {
                    window.openModalMerge(selectedRows[0].id, selectedRows[1].id, selectedRows[0].type);
                });
            });
        },

        exportToExcelHistory: function () {
            const grid = $("#pro_search_gridContainerHistory").dxDataGrid("instance");
            if (!grid) {
                showToast("Warning", "No data to export!", false);
                return;
            }
            const workbook = new ExcelJS.Workbook();
            const worksheet = workbook.addWorksheet("Sheet 1");

            // PRO014: không xuất tên công ty / ngày xuất - chỉ tiêu đề + dữ liệu
            // === Dòng 1: Tiêu đề báo cáo ===
            const reportRow = worksheet.addRow(['Profile History']);
            worksheet.mergeCells('A1:I1');
            reportRow.font = { bold: true, size: 14 };
            reportRow.alignment = { vertical: 'middle', horizontal: 'center' };

            // === Dòng 2: trống
            worksheet.addRow([]);

            // === Xuất dữ liệu grid bắt đầu từ dòng 3 ===
            DevExpress.excelExporter.exportDataGrid({
                component: grid,
                worksheet: worksheet,
                autoFilterEnabled: true,
                topLeftCell: { row: 3, column: 1 }
            }).then(function () {
                // Ghi file
                let fileName = "ProfileHistory.xlsx";
                workbook.xlsx.writeBuffer().then(function (buffer) {
                    saveAs(new Blob([buffer], { type: "application/octet-stream" }), fileName);
                });
            });
        },
    };


