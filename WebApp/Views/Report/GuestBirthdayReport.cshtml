@using DevExpress.XtraReports.UI
@{
    ViewBag.Title = ViewBag.ReportHeader;
}
<style>
    .filter_wrapper { padding: 18px 0px 0px 14px !important; border-radius: 8px; }
    .gridContainer { margin: 0px 8px; }
    .sticky-header label, .sticky-header .form-control-sm { font-size: 14px; line-height: 1.2; }
    .sticky-header .form-control-sm { padding: 2px 8px; height: 28px; }
    .sticky-header label { margin-bottom: 0; white-space: nowrap; }
    .nrp-grid {
        display: grid;
        grid-template-columns: max-content max-content 160px max-content 160px;
        column-gap: 6px;
        row-gap: 8px;
        align-items: center;
        width: max-content;
        max-width: 100%;
    }
    .nrp-grid > label { margin: 0; white-space: nowrap; }
    .nrp-grid .pair-gap { margin-left: 10px; }
    .nrp-grid select, .nrp-grid [data-date-input] { width: 160px; min-width: 128px; max-width: 220px; }
    .nrp-check {
        display: grid;
        grid-template-columns: max-content max-content max-content max-content;
        column-gap: 16px;
        row-gap: 8px;
        align-items: center;
        width: max-content;
        margin-top: 8px;
    }
    .nrp-check > .fw-bold { margin: 0 10px 0 0; }
    .nrp-check .form-check { margin: 0 !important; display: flex; align-items: center; gap: 6px; }
    .nrp-check .form-check-label { white-space: nowrap; }
    #gridContainer .dx-datagrid-rowsview .dx-selection { background-color: #01579b !important; color: white !important; }
    #gridContainer .dx-datagrid-rowsview .dx-selection * { color: white !important; }
</style>
<div class="text-center" id="reportTitle" style="font-size: 20px"></div>
<div class="sticky-header bg-white p-2 shadow-sm z-3">
    <div class="">
        <button id="btnPrint" class="mui-button mui-button-new">View</button>
        <button id="btnExportExcel" class="mui-button mui-button-new" type="button">Excel</button>
        <button id="btnExportPdf" class="mui-button mui-button-new" type="button">PDF</button>
    </div>
    <div class="mb-1" style="border: 1px solid #ced4da; border-radius: 6px; padding: 8px;">
        <div class="nrp-grid">
            <label class="fw-bold">Date Range:</label>
            <label>From Date:</label>
            <div data-date-input business-date data-format="DD/MM/YYYY" data-name="fromDate">
                <input type="text" class="date-ui form-control form-control-sm" placeholder="dd/mm/yyyy" autocomplete="off" />
            </div>
            <label class="pair-gap">To Date:</label>
            <div data-date-input business-date data-format="DD/MM/YYYY" data-name="toDate">
                <input type="text" class="date-ui form-control form-control-sm" placeholder="dd/mm/yyyy" autocomplete="off" />
            </div>
        </div>
        <div class="nrp-check">
            <label class="fw-bold">Reservation Status</label>
            <div class="form-check"><input class="form-check-input st" type="checkbox" value="0" id="stRes" /><label class="form-check-label" for="stRes">Reservation</label></div>
            <div class="form-check"><input class="form-check-input st" type="checkbox" value="7" id="stNs" /><label class="form-check-label" for="stNs">No Show</label></div>
            <div class="form-check"><input class="form-check-input st" type="checkbox" value="1" id="stCi" checked /><label class="form-check-label" for="stCi">Checked In</label></div>
            <span></span>
            <div class="form-check"><input class="form-check-input st" type="checkbox" value="5" id="stDi" /><label class="form-check-label" for="stDi">Due In</label></div>
            <div class="form-check"><input class="form-check-input st" type="checkbox" value="2" id="stCo" /><label class="form-check-label" for="stCo">Check Out</label></div>
            <div class="form-check"><input class="form-check-input st" type="checkbox" value="6" id="stDo" /><label class="form-check-label" for="stDo">Due Out</label></div>
        </div>
        <div class="nrp-check">
            <label class="fw-bold">Display</label>
            <div class="form-check"><input class="form-check-input" type="checkbox" id="chkAge" checked /><label class="form-check-label" for="chkAge">Age</label></div>
        </div>
        <div class="nrp-grid">
            <label class="fw-bold">Sort Order</label>
            <label>Sort Order:</label>
            <select id="orderBy" class="form-control form-control-sm">
                <option value="a.RoomNo">Room No</option>
                <option value="h.Account">Name</option>
                <option value="a.ArrivalDate">Arrival</option>
                <option value="h.DateOfBirth">Date of Birth</option>
                <option value="a.VIP">VIP</option>
            </select>
        </div>
    </div>
</div>
<div class="mui-card">
    <div id="gridWrapper" class="mt-2" style="max-height: 500px;">
        <div class="gridContainer mt-2" id="gridContainer"></div>
    </div>
</div>
<div id="loadingSpinner" style="display:none; position:fixed; top:50%; left:50%; transform:translate(-50%, -50%); z-index:1000;">
    <i class="fa-solid fa-spinner fa-spin"></i>
</div>
<script>
    function pick(row, names) {
        for (var i = 0; i < names.length; i++) {
            var n = names[i];
            if (row[n] !== undefined && row[n] !== null && row[n] !== "") return row[n];
        }
        return "";
    }
    function statusText(v) {
        var m = { "0": "RESERVATION", "1": "CHECKED IN", "2": "CHECKED OUT", "5": "DUE IN", "6": "DUE OUT", "7": "NO SHOW" };
        return m[String(v)] || v;
    }
    $(document).ready(function () {
        document.getElementById("reportTitle").innerText = '@ViewBag.ReportTitle';
        if (typeof window.initDateInputs === "function") window.initDateInputs();
    });
    function bindGrid(data) {
        var showAge = $("#chkAge").is(":checked");
        var rows = (Array.isArray(data) ? data : []).map(function (r) {
            var co = [pick(r, ["Company", "company"]), pick(r, ["Agent", "agent"]), pick(r, ["Source", "source"])].filter(Boolean).join(" / ");
            return {
                roomNo: pick(r, ["RoomNo", "roomNo"]),
                name: pick(r, ["LastName", "lastName", "Name", "name"]),
                companyTaSource: co,
                arrival: pick(r, ["ArrivalDate", "arrivalDate"]),
                departure: pick(r, ["DepartureDate", "departureDate"]),
                nts: pick(r, ["NoOfNight", "noOfNight"]),
                rateCode: pick(r, ["RateCode", "rateCode"]),
                status: statusText(pick(r, ["Status", "status"])),
                dob: pick(r, ["DateOfBirth", "dateOfBirth"]),
                age: pick(r, ["Age", "age"]),
                vip: pick(r, ["VIP", "vip"])
            };
        });
        $("#gridContainer").dxDataGrid({
            dataSource: rows, height: 500, allowColumnResizing: true,
            columns: [
                { dataField: "roomNo", caption: "Room No", width: 90 },
                { dataField: "name", caption: "Name", minWidth: 160 },
                { dataField: "companyTaSource", caption: "Company, TA, Source", minWidth: 220 },
                { dataField: "arrival", caption: "Arrival", dataType: "date", format: "dd/MM/yyyy", width: 100 },
                { dataField: "departure", caption: "Departure", dataType: "date", format: "dd/MM/yyyy", width: 100 },
                { dataField: "nts", caption: "Nts", width: 60 },
                { dataField: "rateCode", caption: "RateCode", width: 90 },
                { dataField: "status", caption: "Status", width: 110 },
                { dataField: "dob", caption: "Date of Birth", width: 110 },
                { dataField: "age", caption: "Age", width: 60, visible: showAge },
                { dataField: "vip", caption: "VIP", width: 70 }
            ],
            paging: { pageSize: 25 },
            scrolling: { useNative: true, showScrollbar: "always" },
            pager: { visible: true, allowedPageSizes: [25, 50, "all"], showPageSizeSelector: true, showInfo: true, showNavigationButtons: true },
            filterRow: { visible: true, applyFilter: "auto" },
            headerFilter: { visible: true },
            showBorders: true
        });
    }
    $(document).off("click", "#btnPrint").on("click", "#btnPrint", function () {
        var st = $(".st:checked").map(function () { return "(" + this.value + ")"; }).get().join(",");
        if (!st) st = "(1)";
        $("#loadingSpinner").show();
        $.ajax({
            url: "/Report/GuestBirthdayReportData", type: "GET",
            data: { fromDate: $("#fromDate").val(), toDate: $("#toDate").val(), reservationStatus: st, orderBy: $("#orderBy").val() },
            success: function (result) {
                if (typeof result === "string") { alert(result); $("#loadingSpinner").hide(); return; }
                bindGrid(result); $("#loadingSpinner").hide();
            },
            error: function () { alert("Không thể tải báo cáo."); $("#loadingSpinner").hide(); }
        });
    });
    $(document).off("click", "#btnExportExcel").on("click", "#btnExportExcel", function () {
        const grid = $("#gridContainer").dxDataGrid("instance"); if (!grid) return;
        const workbook = new ExcelJS.Workbook(); const worksheet = workbook.addWorksheet("Report");
        const selectedReport = '@ViewBag.ReportTitle';
        worksheet.addRow([localStorage.getItem("CompanyName") || ""]);
        DevExpress.excelExporter.exportDataGrid({ component: grid, worksheet: worksheet, autoFilterEnabled: true, topLeftCell: { row: 3, column: 1 } })
            .then(function () { workbook.xlsx.writeBuffer().then(function (buffer) { saveAs(new Blob([buffer], { type: "application/octet-stream" }), selectedReport + ".xlsx"); }); });
    });
    $(document).off("click", "#btnExportPdf").on("click", "#btnExportPdf", function () {
        const grid = $("#gridContainer").dxDataGrid("instance"); if (!grid) return;
        const { jsPDF } = window.jspdf; const doc = new jsPDF({ orientation: "landscape", unit: "pt", format: "A4" });
        const selectedReport = '@ViewBag.ReportTitle';
        grid.getDataSource().load().then(data => {
            const columns = grid.getVisibleColumns().filter(c => c.dataField);
            doc.text(selectedReport, doc.internal.pageSize.getWidth() / 2, 40, { align: "center" });
            doc.autoTable({ startY: 56, head: [columns.map(c => c.caption)], body: data.map(row => columns.map(c => row[c.dataField] ?? "")), styles: { fontSize: 8 } });
            doc.save(selectedReport + ".pdf");
        });
    });
</script>
