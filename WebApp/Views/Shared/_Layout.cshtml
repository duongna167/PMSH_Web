@using Microsoft.Extensions.Options
@using static BaseBusiness.Global
@inject IOptions<ContactInfo> ContactConfig
@inject IConfiguration Configuration
@{
    var propertyAllowedLoginNames = Configuration
        .GetSection("PropertyAccess:AllowedLoginNames")
        .Get<string[]>() ?? Array.Empty<string>();
    var currentLoginName = Context.Session.GetString("LoginName");
    var canAccessProperty = !string.IsNullOrWhiteSpace(currentLoginName)
        && propertyAllowedLoginNames.Any(loginName =>
            string.Equals(loginName?.Trim(), currentLoginName.Trim(), StringComparison.OrdinalIgnoreCase));
}

