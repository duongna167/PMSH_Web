@using BaseBusiness.Model
@using System.Linq
@{
    ViewBag.Title = ViewBag.ReportHeader;
    var cashiers = (ViewBag.CashierUserList as List<CashierUserModel>) ?? new List<CashierUserModel>();
}


<style>
    .filter_wrapper {
        /*     background-color: #ececec; */
        /*   margin: 0px 8px 14px 8px; */
        padding: 18px 0px 0px 14px;
        border-radius: 8px;
    }

    .gridContainer {
        margin: 0px 8px;
    }

    .button_wrapper {
        display: flex;
        column-gap: 12px;
        margin: 0px 8px;
    }

        .button_wrapper .fa-solid {
            margin-right: 5px;
        }

    .selected {
        background-color: #4CAF50; /* Màu xanh */
        color: white;
    }

    
    .sticky-header {
        overflow: visible;
        font-size: 14px;
    }
    .sticky-header label, .sticky-header .form-control-sm {
        font-size: 14px;
        line-height: 1.2;
    }
    .sticky-header .form-control-sm {
        padding: 2px 8px;
        height: 28px;
    }
    .sticky-header label {
        margin-bottom: 0;
        white-space: nowrap;
    }
    .tar-filter {
        border: 1px solid #ced4da;
        border-radius: 6px;
        padding: 8px;
        overflow: visible;
    }
    .tar-row {
        display: flex;
        flex-wrap: nowrap;
        align-items: center;
        column-gap: 8px;
        min-height: 28px;
    }
    .tar-row + .tar-row { margin-top: 8px; }
    .sticky-header .tar-row > .fw-bold {
        margin: 0 !important;
        min-width: 88px;
        white-space: nowrap;
    }
    .tar-pair {
        display: flex;
        align-items: center;
        gap: 6px;
    }
    .tar-pair > label {
        margin: 0 !important;
        white-space: nowrap;
    }
    .sticky-header .tar-row [data-date-input] {
        width: 160px;
        min-width: 128px;
        max-width: 220px;
    }
    .sticky-header #cashier {
        width: auto;
        min-width: 128px;
        max-width: 220px;
        height: 28px;
        font-size: 14px;
        padding: 2px 1.85rem 2px 8px;
        box-sizing: border-box;
    }

</style>
<div class="text-center" id="reportTitle" style="font-size: 20px"></div>
<div class="filter-panel">
<div class="sticky-header bg-white p-2 shadow-sm z-3">
    <div>
        <button id="btnPrint" class="mui-button mui-button-new">View</button>
        <button id="btnExportExcel" class="mui-button mui-button-new" type="button">Excel</button>
        <button id="btnExportPdf" class="mui-button mui-button-new" type="button">PDF</button>
        <button id="btnPrintGrid" class="mui-button mui-button-new" type="button">Print</button>
    </div>
    <div class="tar-filter mb-1">
        <div class="tar-row">
            <label class="fw-bold">Date Range:</label>
            <div class="tar-pair">
                <label>Date:</label>
                <div data-date-input business-date data-format="DD/MM/YYYY" data-name="fromDate">
                    <input type="text" class="date-ui form-control form-control-sm" placeholder="dd/mm/yyyy" autocomplete="off" />
                </div>
            </div>
        </div>
        <div class="tar-row">
            <label class="fw-bold">Filter:</label>
            <div class="tar-pair">
                <label for="cashier">Cashier:</label>
                <select id="cashier" class="form-control form-control-sm pmsh-select-menu" data-pmsh-select-down>
                    <option value="">All</option>
                    @foreach (var item in cashiers.GroupBy(x => x.UserName).Select(g => g.First()).OrderBy(x => x.CashierNo))
                    {
                        <option value="@item.UserName">@(string.IsNullOrWhiteSpace(item.CashierNo) ? item.UserName : item.CashierNo + " - " + item.UserName)</option>
                    }
                </select>
            </div>
        </div>
    </div>
</div>
</div>
<div class="mui-card">
    <div id="gridWrapper" class="mt-2" style="max-height: 500px;">
        <div class="gridContainer mt-2" id="gridContainer"></div>
    </div>
</div>
<div id="loadingSpinner" style="display:none; position:fixed; top:50%; left:50%; transform:translate(-50%, -50%); z-index:1000;">
    <i class="fa-solid fa-spinner fa-spin"></i>
</div>
<script>
    function formatDate(date) {
        let year = date.getFullYear();
        let month = (date.getMonth() + 1).toString().padStart(2, '0'); // Đảm bảo có 2 chữ số
        let day = date.getDate().toString().padStart(2, '0'); // Đảm bảo có 2 chữ số
        return `${year}-${month}-${day}`;
    }

    $(document).ready(function () {
         document.getElementById("reportTitle").innerText = '@ViewBag.ReportTitle';
           window.initDateInputs();



    });
    $(document).off("click", "#btnPrint").on("click", "#btnPrint", function () {
        $("#loadingSpinner").show();
        $.ajax({
            url: '/Report/TransferARReportsData',
            type: 'GET',
            data: {
                fromDate: $("#fromDate").val(),
      
            },
            traditional: true,
              crossDomain: false,
                headers: { "X-CSRF-TOKEN-HEADERNAME": jQuery("input[name='__RequestVerificationToken']").val() },
            success: function (result) {
                if (typeof result === "string") { alert(result); $("#loadingSpinner").hide(); return; }
                const cashier = ($("#cashier").val() || "").toLowerCase();
                const rows = Array.isArray(result) ? result : [];
                const filtered = cashier
                    ? rows.filter(function (r) { return String(r.userName || "").toLowerCase() === cashier; })
                    : rows;
                initializeTransferARReportsDataGrid(prepareTransferARData(filtered));
                $("#loadingSpinner").hide();
            },
            error: function () {
                alert("Không thể tải báo cáo.");
                $("#loadingSpinner").hide();
            }
        });
    });
        function prepareTransferARData(data) {
        const groupedData = {};
        const finalData = [];

        // Gom nhóm theo acc
        data.forEach(item => {
            const key = item.acc || "NO-ACC";
            if (!groupedData[key]) groupedData[key] = [];
            groupedData[key].push(item);
        });

        // Duyệt từng nhóm để thêm Subtotal
        Object.entries(groupedData).forEach(([key, records]) => {
            finalData.push(...records);

            const subtotal = {
                acc: key,
                companyOrName: "SUB TOTAL",
                amount: sum(records, 'amount'),
                cssClass: "custom",
                isTotal: true
            };

            finalData.push(subtotal);
        });

        // Dòng tổng cuối
        const totalAmount = sum(data, 'amount');

        const totalRow = {
            acc: "",
            companyOrName: "TOTAL",
            amount: totalAmount,
            cssClass: "custom",
            isTotal: true
        };

        finalData.push(totalRow);

        // ✅ Gán tổng tiền vào finalData.totalAmount để truyền cho summary
        finalData.totalAmount = totalAmount;

        return finalData;
    }


    function sum(arr, field) {
        return arr.reduce((t, x) => t + (parseFloat(x[field]) || 0), 0);
    }


      function initializeTransferARReportsDataGrid(data) {
        const columnWidth = 180;
        const totalAmount = data.totalAmount || 0;

        $("#gridContainer").dxDataGrid({
           dataSource: data,         height: 500,
            allowColumnResizing: true,
            columns: [
                { dataField: "acc", caption: "ACC", width: columnWidth - 80 },
                { dataField: "companyOrName", caption: "Company/Name", width: columnWidth + 20 },
                { dataField: "account", caption: "Account", width: columnWidth + 20 },
                { dataField: "roomNo", caption: "Ro.No", width: columnWidth - 80 },
                { dataField: "folioNo", caption: "FolioNo", width: columnWidth - 60 },
                {
                    dataField: "amount", caption: "Amount", width: columnWidth - 40,
                    dataType: "number", format: "#,##0"
                },
                { dataField: "currencyID", caption: "Curr", width: columnWidth - 40 },
                { dataField: "userName", caption: "User", width: columnWidth - 80 },
            ],
            summary: {
                totalItems: [
                    {
                        column: "companyOrName",
                        summaryType: "custom",
                        displayFormat: "GRAND TOTAL"
                    },
                    {
                        column: "amount",
                        summaryType: "custom",
                        customizeText: function () {
                            return totalAmount.toLocaleString();  // định dạng với dấu phẩy
                        }
                    }
                ]
            },
            rowPrepared: function (info) {
                if (info.data && info.data.isTotal) {
                    $(info.rowElement).css("font-weight", "bold").css("background-color", "#f3f3f3");
                }
            },
            paging: { pageSize: 25 },
            scrolling: {
                
                useNative: false,
                showScrollbar: "always"
            },
            pager: {
                visible: true,
                allowedPageSizes: [25, 50, 'all'],
                showPageSizeSelector: true,
                showInfo: true,
                showNavigationButtons: true
            },
            filterRow: {
                visible: true,
                applyFilter: "auto"
            },
              onRowPrepared: function (e) {
                if (e.rowType === "data" && e.data?.cssClass) {
                    e.rowElement.addClass(e.data.cssClass);
                }
            },
            headerFilter: {
                visible: true
            },
            selection: {
                mode: "multiple",
                showCheckBoxesMode: "none"
            },
            showBorders: true
        });
    }




    $("#btnExportExcel").click(function () {
               const grid = $("#gridContainer").dxDataGrid("instance"); var selectedReport2 = '@ViewBag.ReportTitle';
        var selectedReport = '@ViewBag.ReportTitle';
        if (!selectedReport) {
            alert("Vui lòng chọn báo cáo trước khi xuất Excel.");
            return;
        }

                     const workbook = new ExcelJS.Workbook();const companyName = localStorage.getItem("CompanyName") || "Tên công ty chưa xác định";
        const worksheet = workbook.addWorksheet("Sheet 1");

        // === Tạo header công ty (dòng 1) ===
       worksheet.addRow([companyName]);
        worksheet.mergeCells('A1:E1');
        worksheet.getRow(1).font = { bold: true };
        worksheet.getRow(1).alignment = { vertical: 'middle', horizontal: 'left' };

        // === Dòng 2: Thời gian xuất (phải) ===
        const now = new Date();
        const exportDate = now.toLocaleString("vi-VN");
        worksheet.addRow(['', '', '', '', ' ' + exportDate]);
        worksheet.mergeCells('E2:H2');
        worksheet.getRow(2).alignment = { vertical: 'middle', horizontal: 'right' };

        // === Dòng 3–4: Trống
        worksheet.addRow([]);
        worksheet.addRow([]);

        // === Dòng 5: Tên báo cáo ở giữa ===
        const reportRow = worksheet.addRow(['', '', selectedReport]);
        worksheet.mergeCells('C5:F5');
        reportRow.font = { bold: true, size: 14 };
        reportRow.alignment = { vertical: 'middle', horizontal: 'center' };

        // === Dòng 6: Trống trước khi xuất dữ liệu
        worksheet.addRow([]);

        // === Export dữ liệu từ DevExtreme (bắt đầu từ dòng 7)
        DevExpress.excelExporter.exportDataGrid({
            component: grid,
            worksheet: worksheet,
            autoFilterEnabled: true,
            topLeftCell: { row: 7, column: 1 } // dữ liệu bắt đầu từ dòng 7
        }).then(function () {
            // Footer
            const lastRow = worksheet.lastRow.number + 2;
     
            worksheet.mergeCells(`A${lastRow}:F${lastRow}`);
            worksheet.getCell(`A${lastRow}`).alignment = { horizontal: 'center' };
            worksheet.getCell(`A${lastRow}`).font = { italic: true };

            // Ghi file
            let fileName = selectedReport + ".xlsx";
            workbook.xlsx.writeBuffer().then(function (buffer) {
                saveAs(new Blob([buffer], { type: "application/octet-stream" }), fileName);
            });
        });
    });


    // Nút xuất PDF
          $("#btnExportPdf").click(function () {
        const grid = $("#gridContainer").dxDataGrid("instance");

        // Lấy đối tượng jsPDF từ window
        const { jsPDF } = window.jspdf;
        const doc = new jsPDF({ orientation: "landscape", unit: "pt", format: "A4" });

        const selectedReport = '@ViewBag.ReportTitle';
        const companyName = localStorage.getItem("CompanyName") || "Tên công ty chưa xác định";

        grid.getDataSource().load().then(data => {
            const columns = grid.getVisibleColumns();

            const head = [columns.map(col => col.caption)];
            const body = data.map(row =>
                columns.map(col =>
                    col.calculateCellValue ? col.calculateCellValue(row) : row[col.dataField]
                )
            );

            doc.setFontSize(14);
            doc.setFont("Helvetica", "bold");
            doc.text(companyName, doc.internal.pageSize.getWidth() / 2, 40, { align: "center" });

            doc.setFontSize(12);
            doc.setFont("Helvetica", "normal");
            doc.text(selectedReport, doc.internal.pageSize.getWidth() / 2, 60, { align: "center" });

            // AutoTable
            doc.autoTable({
                startY: 80,
                head: head,
                body: body,
                 styles: { fontSize: 9, cellPadding: 4 , lineWidth: 0.5, lineColor: [0, 0, 0]    },
                headStyles: { fillColor: [41, 128, 185], textColor: 255, fontStyle: 'bold' },
                alternateRowStyles: { fillColor: [240, 240, 240] },
                margin: { left: 20, right: 20 }
            });

            doc.save(selectedReport + ".pdf");
        });
    });

            $("#btnPrintGrid").on("click", function () {
               const grid = $("#gridContainer").dxDataGrid("instance"); var selectedReport2 = '@ViewBag.ReportTitle';

        // Lấy toàn bộ data từ dataSource
        grid.getDataSource().load().then(function (data) {
            // Tạo bảng HTML từ dữ liệu
            let tableHTML = '<table border="1" style="border-collapse: collapse; width: 100%;">';

            // Header
            const columns = grid.getVisibleColumns();
            tableHTML += "<thead><tr>";
            columns.forEach(col => {
                tableHTML += `<th style="padding: 5px; text-align: center;">${col.caption}</th>`;
            });
            tableHTML += "</tr></thead>";

            // Body
            tableHTML += "<tbody>";
            data.forEach(row => {
                tableHTML += "<tr>";
                columns.forEach(col => {
                    let value = col.calculateCellValue ? col.calculateCellValue(row) : row[col.dataField];
                    tableHTML += `<td style="padding: 5px;">${value ?? ""}</td>`;
                });
                tableHTML += "</tr>";
            });
            tableHTML += "</tbody></table>";

            // Mở cửa sổ in với nội dung bảng
            const printWindow = window.open('', '', 'height=800,width=1000');
            if (!printWindow) {
                alert("Trình duyệt đang chặn cửa sổ in.");
                return;
            }

           printWindow.document.write('<html><head><title>' + selectedReport2 + '</title>');
            printWindow.document.write('<style>table { font-family: Arial; font-size: 12px; }</style>');
            printWindow.document.write('</head><body>');
            printWindow.document.write(tableHTML);
            printWindow.document.write('</body></html>');
            printWindow.document.close();

            // Chờ nội dung render xong rồi in
            printWindow.onload = function () {
                printWindow.focus();
                printWindow.print();
                printWindow.close();
            };
        });
    });
</script>
