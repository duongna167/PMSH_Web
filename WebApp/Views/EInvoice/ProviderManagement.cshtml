@* Provider Management - trang đầy đủ: nhà cung cấp hóa đơn điện tử, field cấu hình, option của field.
   Giao diện theo màn ProviderManagement của PMSH_Web; dữ liệu qua EInvoiceProviderController (module EInvoice). *@
@{
    ViewData["Title"] = "Provider Management";
}

<div class="provider-page">
    <div class="row g-3 provider-top-row">

        <!-- E-Invoice Providers -->
        <div class="col-xl-4 col-lg-12 col-md-12">
            <div class="card provider-card h-100">
                <div class="card-header provider-card-header">
                    <div>
                        <div class="provider-card-title">E-Invoice Providers</div>
                        <div class="provider-card-subtitle">Select a provider to view configuration fields</div>
                    </div>
                    <div class="provider-header-actions">
                        <button type="button" id="eip_btnProviderNew" class="btn btn-success btn-sm"><i class="fa fa-plus me-1"></i>New</button>
                        <button type="button" id="eip_btnProviderRefresh" class="btn btn-light btn-sm"><i class="fa fa-refresh me-1"></i>Refresh</button>
                    </div>
                </div>
                <div class="card-body p-0"><div id="eip_gridProvider"></div></div>
            </div>
        </div>

        <!-- Provider Configuration Fields -->
        <div class="col-xl-5 col-lg-7 col-md-12">
            <div class="card provider-card h-100">
                <div class="card-header provider-card-header">
                    <div>
                        <div class="provider-card-title">Provider Configuration Fields</div>
                        <div class="provider-card-subtitle">Selected provider: <strong id="eip_lblProvider">None</strong></div>
                    </div>
                    <div class="provider-header-actions">
                        <button type="button" id="eip_btnFieldNew" class="btn btn-success btn-sm" disabled><i class="fa fa-plus me-1"></i>New Field</button>
                        <button type="button" id="eip_btnFieldRefresh" class="btn btn-light btn-sm" disabled><i class="fa fa-refresh me-1"></i>Refresh</button>
                    </div>
                </div>
                <div class="card-body p-0"><div id="eip_gridField"></div></div>
            </div>
        </div>

        <!-- Field Options -->
        <div class="col-xl-3 col-lg-5 col-md-12">
            <div class="card provider-card h-100">
                <div class="card-header provider-card-header">
                    <div>
                        <div class="provider-card-title">Field Options</div>
                        <div class="provider-card-subtitle">Selected field: <strong id="eip_lblField">None</strong></div>
                    </div>
                    <div class="provider-header-actions">
                        <button type="button" id="eip_btnOptionNew" class="btn btn-success btn-sm" disabled><i class="fa fa-plus me-1"></i>New</button>
                        <button type="button" id="eip_btnOptionRefresh" class="btn btn-light btn-sm" disabled><i class="fa fa-refresh me-1"></i>Refresh</button>
                    </div>
                </div>
                <div class="card-body p-0"><div id="eip_gridOption"></div></div>
            </div>
        </div>

    </div>

    <!-- API Management và API Parameter Mapping của nhà cung cấp đang chọn -->
    <div class="row g-3 mt-1">

        <!-- API Management -->
        <div class="col-xl-5 col-lg-12 col-md-12">
            <div class="provider-operation-section h-100">
                <div class="provider-operation-header">
                    <div>
                        <h5 class="mb-1">API Management</h5>
                        <div class="text-muted provider-operation-subtitle">Cấu hình endpoint và phương thức gọi API cho nhà cung cấp đang chọn: <strong id="eop_lblProvider">None</strong></div>
                    </div>
                    <div class="provider-operation-actions">
                        <button type="button" id="eop_btnOpRefresh" class="btn btn-outline-secondary btn-sm"><i class="fa fa-refresh me-1"></i>Refresh</button>
                        <button type="button" id="eop_btnOpNew" class="btn btn-primary btn-sm"><i class="fa fa-plus me-1"></i>Thêm API</button>
                    </div>
                </div>
                <div id="eop_gridOp"></div>
            </div>
        </div>

        <!-- API Parameter Mapping -->
        <div class="col-xl-7 col-lg-12 col-md-12">
            <div class="provider-mapping-section">
                <div class="provider-mapping-header">
                    <div>
                        <h5 class="mb-1">API Parameter Mapping</h5>
                        <div class="text-muted provider-mapping-subtitle">Selected operation: <strong id="eop_lblOp">None</strong></div>
                    </div>
                    <div class="provider-mapping-actions">
                        <select id="eop_mapLocFilter" class="form-select form-select-sm" style="width:140px;">
                            <option value="">All locations</option>
                            <option>BODY</option><option>HEADER</option><option>QUERY</option><option>PATH</option><option>FORM</option><option>RESPONSE</option>
                        </select>
                        <button type="button" id="eop_btnMapRefresh" class="btn btn-outline-secondary btn-sm" disabled><i class="fa fa-refresh me-1"></i>Refresh</button>
                        <button type="button" id="eop_btnMapNew" class="btn btn-primary btn-sm" disabled><i class="fa fa-plus me-1"></i>New Mapping</button>
                    </div>
                </div>
                <div id="eop_gridMap"></div>
            </div>
        </div>

    </div>
</div>

<style>
    /* Dòng đang được chọn: nền xanh nhạt để người dùng nhận biết */
    .dx-datagrid-rowsview .dx-row.dx-selection > td,
    .dx-datagrid-rowsview .dx-row.dx-selection:hover > td,
    .dx-datagrid-rowsview .dx-row.dx-selection.dx-row-alt > td { background-color: rgba(120, 120, 120, 0.15) !important; color: inherit !important; }

    .provider-card { border: 1px solid #d8e2dc; border-radius: 8px; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04); overflow: hidden; }
    .provider-top-row { margin-top: 8px; }
    .provider-card-header { min-height: 62px; padding: 8px 12px; background: #f8fbf9; border-bottom: 1px solid #d8e2dc; display: flex; align-items: center; justify-content: space-between; gap: 8px; flex-wrap: nowrap; }
    .provider-card-header > div:first-child { min-width: 0; flex: 1 1 auto; }
    .provider-header-actions { display: flex; gap: 6px; flex: 0 0 auto; }
    .provider-card-title { font-size: 15px; font-weight: 600; color: #263238; }
    .provider-card-subtitle { margin-top: 2px; font-size: 11px; color: #6c757d; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

    #eip_gridProvider, #eip_gridField, #eip_gridOption { height: 420px; min-height: 420px; }

    /* Thu gọn chiều cao các ô của ba bảng */
    #eip_gridProvider .dx-datagrid-rowsview .dx-data-row > td,
    #eip_gridField .dx-datagrid-rowsview .dx-data-row > td,
    #eip_gridOption .dx-datagrid-rowsview .dx-data-row > td { height: 26px; padding-top: 3px; padding-bottom: 3px; line-height: 17px; box-sizing: border-box; }
    #eip_gridProvider .dx-datagrid-headers .dx-header-row > td,
    #eip_gridField .dx-datagrid-headers .dx-header-row > td,
    #eip_gridOption .dx-datagrid-headers .dx-header-row > td { height: 27px; padding-top: 4px; padding-bottom: 4px; line-height: 17px; box-sizing: border-box; }
    .provider-operation-section, .provider-mapping-section { background: #fff; border: 1px solid #d9dee5; border-radius: 8px; padding: 16px; }
    .provider-operation-header, .provider-mapping-header { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 14px; }
    .provider-operation-header h5, .provider-mapping-header h5 { font-size: 18px; font-weight: 600; }
    .provider-operation-subtitle, .provider-mapping-subtitle { font-size: 13px; }
    .provider-operation-actions, .provider-mapping-actions { display: flex; align-items: center; gap: 8px; }
    .provider-operation-actions .btn, .provider-mapping-actions .btn { min-height: 36px; padding-left: 14px; padding-right: 14px; }


    /* Dòng/cell gọn, vừa với nội dung */
    #eop_gridOp .dx-row > td, #eop_gridMap .dx-row > td { padding-top: 5px; padding-bottom: 5px; line-height: 18px; }
    #eop_gridOp .dx-header-row > td, #eop_gridMap .dx-header-row > td { padding-top: 7px; padding-bottom: 7px; }

    #eop_gridOp, #eop_gridMap { height: 460px; min-height: 460px; }
</style>

<!-- ===== PROVIDER FORM ===== -->
<div class="modal fade" id="eip_providerModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header"><h6 class="modal-title" id="eip_providerTitle">Provider</h6></div>
            <div class="modal-body">
                <div class="search-filter mb-2">
                    <button type="button" id="eip_providerSave" class="mui-button mui-button-save">Save</button>
                    <button type="button" data-bs-dismiss="modal" class="mui-button mui-button-close">Close</button>
                </div>
                <form id="eip_providerForm" novalidate>
                    <input type="hidden" name="id" value="0" />
                    <div class="row g-2">
                        <div class="col-12"><div class="row g-1 align-items-center">
                            <label class="col-md-3 col-form-label col-form-label-sm text-md-end">Code <span class="text-danger">*</span></label>
                            <div class="col-md-9"><input type="text" name="code" class="form-control form-control-sm" maxlength="50" /><div class="invalid-feedback"></div></div>
                        </div></div>
                        <div class="col-12"><div class="row g-1 align-items-center">
                            <label class="col-md-3 col-form-label col-form-label-sm text-md-end">Name <span class="text-danger">*</span></label>
                            <div class="col-md-9"><input type="text" name="name" class="form-control form-control-sm" maxlength="150" /><div class="invalid-feedback"></div></div>
                        </div></div>
                        <div class="col-12"><div class="row g-1 align-items-start">
                            <label class="col-md-3 col-form-label col-form-label-sm text-md-end">Description</label>
                            <div class="col-md-9"><textarea name="description" class="form-control form-control-sm" rows="3" maxlength="500"></textarea><div class="invalid-feedback"></div></div>
                        </div></div>
                        <div class="col-12"><div class="row g-1 align-items-center">
                            <label class="col-md-3 col-form-label col-form-label-sm text-md-end">Logo Path</label>
                            <div class="col-md-9"><input type="text" name="logoPath" class="form-control form-control-sm" maxlength="500" /><div class="invalid-feedback"></div></div>
                        </div></div>
                        <div class="col-12"><div class="row g-1 align-items-center">
                            <label class="col-md-3 col-form-label col-form-label-sm text-md-end">Inactive</label>
                            <div class="col-md-9"><input type="checkbox" name="inactive" /></div>
                        </div></div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- ===== FIELD FORM ===== -->
<div class="modal fade" id="eip_fieldModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header"><h6 class="modal-title" id="eip_fieldTitle">Provider Field</h6></div>
            <div class="modal-body">
                <div class="search-filter mb-2">
                    <button type="button" id="eip_fieldSave" class="mui-button mui-button-save">Save</button>
                    <button type="button" data-bs-dismiss="modal" class="mui-button mui-button-close">Close</button>
                </div>
                <form id="eip_fieldForm" novalidate>
                    <input type="hidden" name="id" value="0" />
                    <div class="row g-2">

                        <div class="col-12 col-lg-6"><div class="row g-1 align-items-center">
                            <label class="col-md-4 col-form-label col-form-label-sm text-md-end">Field Code <span class="text-danger">*</span></label>
                            <div class="col-md-8"><input type="text" name="fieldCode" class="form-control form-control-sm" maxlength="100" /><div class="invalid-feedback"></div></div>
                        </div></div>
                        <div class="col-12 col-lg-6"><div class="row g-1 align-items-center">
                            <label class="col-md-4 col-form-label col-form-label-sm text-md-end">Display Name <span class="text-danger">*</span></label>
                            <div class="col-md-8"><input type="text" name="displayName" class="form-control form-control-sm" maxlength="200" /><div class="invalid-feedback"></div></div>
                        </div></div>

                        <div class="col-12 col-lg-6"><div class="row g-1 align-items-center">
                            <label class="col-md-4 col-form-label col-form-label-sm text-md-end">Group Name</label>
                            <div class="col-md-8"><input type="text" name="groupName" class="form-control form-control-sm" maxlength="150" placeholder="CONNECTION / AUTHENTICATION / INVOICE" /><div class="invalid-feedback"></div></div>
                        </div></div>
                        <div class="col-12 col-lg-3"><div class="row g-1 align-items-center">
                            <label class="col-md-6 col-form-label col-form-label-sm text-md-end">Display Order</label>
                            <div class="col-md-6"><input type="number" name="displayOrder" class="form-control form-control-sm" value="0" /><div class="invalid-feedback"></div></div>
                        </div></div>
                        <div class="col-12 col-lg-3"><div class="row g-1 align-items-center">
                            <label class="col-md-6 col-form-label col-form-label-sm text-md-end">Column Width</label>
                            <div class="col-md-6"><select name="columnWidth" class="form-select form-select-sm"><option value="4">4</option><option value="6" selected>6</option><option value="12">12</option></select><div class="invalid-feedback"></div></div>
                        </div></div>

                        <div class="col-12 col-lg-6"><div class="row g-1 align-items-center">
                            <label class="col-md-4 col-form-label col-form-label-sm text-md-end">Data Type <span class="text-danger">*</span></label>
                            <div class="col-md-8"><select name="dataType" class="form-select form-select-sm">
                                <option>String</option><option>Integer</option><option>Decimal</option><option>Boolean</option><option>Date</option><option>DateTime</option>
                            </select><div class="invalid-feedback"></div></div>
                        </div></div>
                        <div class="col-12 col-lg-6"><div class="row g-1 align-items-center">
                            <label class="col-md-4 col-form-label col-form-label-sm text-md-end">Control Type <span class="text-danger">*</span></label>
                            <div class="col-md-8"><select name="controlType" class="form-select form-select-sm">
                                <option>Text</option><option>Password</option><option>Select</option><option>Checkbox</option><option>Textarea</option><option>Number</option><option>Date</option>
                            </select><div class="invalid-feedback"></div></div>
                        </div></div>

                        <div class="col-12 col-lg-6"><div class="row g-1 align-items-center">
                            <label class="col-md-4 col-form-label col-form-label-sm text-md-end">Default Value</label>
                            <div class="col-md-8"><input type="text" name="defaultValue" class="form-control form-control-sm" /><div class="invalid-feedback"></div></div>
                        </div></div>
                        <div class="col-12 col-lg-6"><div class="row g-1 align-items-center">
                            <label class="col-md-4 col-form-label col-form-label-sm text-md-end">Placeholder</label>
                            <div class="col-md-8"><input type="text" name="placeholder" class="form-control form-control-sm" maxlength="300" /><div class="invalid-feedback"></div></div>
                        </div></div>

                        <div class="col-12 col-lg-6"><div class="row g-1 align-items-center">
                            <label class="col-md-4 col-form-label col-form-label-sm text-md-end">Max Length</label>
                            <div class="col-md-8"><input type="number" name="maxLength" class="form-control form-control-sm" min="1" /><div class="invalid-feedback"></div></div>
                        </div></div>
                        <div class="col-12 col-lg-6"><div class="row g-1 align-items-center">
                            <label class="col-md-4 col-form-label col-form-label-sm text-md-end">Regex Pattern</label>
                            <div class="col-md-8"><input type="text" name="regexPattern" class="form-control form-control-sm" maxlength="500" /><div class="invalid-feedback"></div></div>
                        </div></div>

                        <div class="col-12"><div class="row g-1 align-items-start">
                            <label class="col-md-2 col-form-label col-form-label-sm text-md-end">Description</label>
                            <div class="col-md-10"><textarea name="description" class="form-control form-control-sm" rows="2" maxlength="500"></textarea><div class="invalid-feedback"></div></div>
                        </div></div>

                        <div class="col-12 col-lg-4"><div class="row g-1 align-items-center">
                            <label class="col-md-5 col-form-label col-form-label-sm text-md-end">Visible When Field</label>
                            <div class="col-md-7"><input type="text" name="visibleWhenFieldCode" class="form-control form-control-sm" maxlength="100" /></div>
                        </div></div>
                        <div class="col-12 col-lg-4"><div class="row g-1 align-items-center">
                            <label class="col-md-5 col-form-label col-form-label-sm text-md-end">Operator</label>
                            <div class="col-md-7"><select name="visibleWhenOperator" class="form-select form-select-sm"><option value=""></option><option value="EQUALS">EQUALS</option><option value="IN">IN (comma list)</option></select></div>
                        </div></div>
                        <div class="col-12 col-lg-4"><div class="row g-1 align-items-center">
                            <label class="col-md-5 col-form-label col-form-label-sm text-md-end">Value</label>
                            <div class="col-md-7"><input type="text" name="visibleWhenValue" class="form-control form-control-sm" maxlength="200" /></div>
                        </div></div>

                        <div class="col-12"><div class="row g-1 align-items-center">
                            <div class="col-md-10 offset-md-2 d-flex flex-wrap gap-4">
                                <label class="mb-0"><input type="checkbox" name="isRequired" /> Required</label>
                                <label class="mb-0"><input type="checkbox" name="isEncrypted" /> Encrypted</label>
                                <label class="mb-0"><input type="checkbox" name="isReadOnly" /> Read Only</label>
                                <label class="mb-0 text-danger"><input type="checkbox" name="inactive" /> Inactive</label>
                            </div>
                            <div class="col-md-10 offset-md-2"><div class="text-danger small invalid-feedback d-block" data-for="isEncrypted"></div></div>
                        </div></div>

                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- ===== OPTION FORM ===== -->
<div class="modal fade" id="eip_optionModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header"><h6 class="modal-title" id="eip_optionTitle">Field Option</h6></div>
            <div class="modal-body">
                <div class="search-filter mb-2">
                    <button type="button" id="eip_optionSave" class="mui-button mui-button-save">Save</button>
                    <button type="button" data-bs-dismiss="modal" class="mui-button mui-button-close">Close</button>
                </div>
                <form id="eip_optionForm" novalidate>
                    <input type="hidden" name="id" value="0" />
                    <div class="row g-2">
                        <div class="col-12"><div class="row g-1 align-items-center">
                            <label class="col-md-4 col-form-label col-form-label-sm text-md-end">Value <span class="text-danger">*</span></label>
                            <div class="col-md-8"><input type="text" name="optionValue" class="form-control form-control-sm" maxlength="150" /><div class="invalid-feedback"></div></div>
                        </div></div>
                        <div class="col-12"><div class="row g-1 align-items-center">
                            <label class="col-md-4 col-form-label col-form-label-sm text-md-end">Display Text <span class="text-danger">*</span></label>
                            <div class="col-md-8"><input type="text" name="optionText" class="form-control form-control-sm" maxlength="250" /><div class="invalid-feedback"></div></div>
                        </div></div>
                        <div class="col-12"><div class="row g-1 align-items-center">
                            <label class="col-md-4 col-form-label col-form-label-sm text-md-end">Order</label>
                            <div class="col-md-8"><input type="number" name="displayOrder" class="form-control form-control-sm" value="0" /></div>
                        </div></div>
                        <div class="col-12"><div class="row g-1 align-items-center">
                            <div class="col-md-8 offset-md-4 d-flex gap-4">
                                <label class="mb-0"><input type="checkbox" name="isDefault" /> Default</label>
                                <label class="mb-0 text-danger"><input type="checkbox" name="inactive" /> Inactive</label>
                            </div>
                        </div></div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- ===== OPERATION FORM ===== -->
<div class="modal fade" id="eop_opModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header"><h6 class="modal-title" id="eop_opTitle">Operation</h6></div>
            <div class="modal-body">
                <div class="search-filter mb-2">
                    <button type="button" id="eop_opSave" class="mui-button mui-button-save">Save</button>
                    <button type="button" data-bs-dismiss="modal" class="mui-button mui-button-close">Close</button>
                </div>
                <form id="eop_opForm" novalidate>
                    <input type="hidden" name="id" value="0" />
                    <div class="row g-2">
                        <div class="col-12 col-lg-6"><div class="row g-1 align-items-center">
                            <label class="col-md-4 col-form-label col-form-label-sm text-md-end">Operation Code <span class="text-danger">*</span></label>
                            <div class="col-md-8"><input type="text" name="operationCode" class="form-control form-control-sm" maxlength="50" /><div class="invalid-feedback"></div></div>
                        </div></div>
                        <div class="col-12 col-lg-6"><div class="row g-1 align-items-center">
                            <label class="col-md-4 col-form-label col-form-label-sm text-md-end">Operation Name <span class="text-danger">*</span></label>
                            <div class="col-md-8"><input type="text" name="operationName" class="form-control form-control-sm" maxlength="150" /><div class="invalid-feedback"></div></div>
                        </div></div>

                        <div class="col-12 col-lg-6"><div class="row g-1 align-items-center">
                            <label class="col-md-4 col-form-label col-form-label-sm text-md-end">Business Action</label>
                            <div class="col-md-8">
                                <input type="text" name="businessActionCode" list="eop_actions" class="form-control form-control-sm" maxlength="50" />
                                <datalist id="eop_actions">
                                    <option>AUTH_LOGIN</option><option>ISSUE_INVOICE</option><option>UPLOAD_INVOICE</option><option>PUBLISH_INVOICE</option>
                                    <option>GET_UPLOAD_STATUS</option><option>GET_PUBLISH_STATUS</option><option>SEARCH_INVOICE</option><option>PREVIEW_INVOICE</option>
                                    <option>DOWNLOAD_INVOICE_PDF</option><option>GET_INVOICE_FILE</option><option>SEND_INVOICE_EMAIL</option>
                                    <option>ADJUST_INVOICE</option><option>CANCEL_INVOICE</option>
                                </datalist>
                                <div class="invalid-feedback"></div>
                            </div>
                        </div></div>
                        <div class="col-12 col-lg-3"><div class="row g-1 align-items-center">
                            <label class="col-md-6 col-form-label col-form-label-sm text-md-end">HTTP Method</label>
                            <div class="col-md-6"><select name="httpMethod" class="form-select form-select-sm"><option>POST</option><option>GET</option><option>PUT</option><option>PATCH</option><option>DELETE</option><option>HEAD</option></select><div class="invalid-feedback"></div></div>
                        </div></div>
                        <div class="col-12 col-lg-3"><div class="row g-1 align-items-center">
                            <label class="col-md-6 col-form-label col-form-label-sm text-md-end">Body Type</label>
                            <div class="col-md-6"><select name="bodyType" class="form-select form-select-sm"><option>JSON</option><option>FORM_URLENCODED</option><option>MULTIPART_FORM_DATA</option><option>SOAP11</option><option>SOAP12</option><option>NONE</option></select><div class="invalid-feedback"></div></div>
                        </div></div>

                        <div class="col-12"><div class="row g-1 align-items-center">
                            <label class="col-md-2 col-form-label col-form-label-sm text-md-end">Endpoint Path <span class="text-danger">*</span></label>
                            <div class="col-md-10"><input type="text" name="endpointPath" class="form-control form-control-sm" maxlength="500" placeholder="/auth/login" /><div class="invalid-feedback"></div></div>
                        </div></div>

                        <div class="col-12 col-lg-6"><div class="row g-1 align-items-center">
                            <label class="col-md-4 col-form-label col-form-label-sm text-md-end">Content Type</label>
                            <div class="col-md-8">
                                <input type="text" name="contentType" list="eop_ctypes" class="form-control form-control-sm" maxlength="100" value="application/json" />
                                <datalist id="eop_ctypes"><option>application/json</option><option>application/x-www-form-urlencoded</option><option>text/xml; charset=utf-8</option><option>text/plain</option></datalist>
                                <div class="invalid-feedback"></div>
                            </div>
                        </div></div>
                        <div class="col-12 col-lg-3"><div class="row g-1 align-items-center">
                            <label class="col-md-6 col-form-label col-form-label-sm text-md-end">Timeout (s)</label>
                            <div class="col-md-6"><input type="number" name="timeoutSeconds" class="form-control form-control-sm" value="60" min="1" max="600" /><div class="invalid-feedback"></div></div>
                        </div></div>
                        <div class="col-12 col-lg-3"><div class="row g-1 align-items-center">
                            <label class="col-md-6 col-form-label col-form-label-sm text-md-end">Success Codes</label>
