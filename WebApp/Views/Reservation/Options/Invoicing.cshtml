<!-- Modal invoicing-->
<div class="modal fade modal-xl" id="modalInvoicing" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabelBilling" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" >Invoicing</h5>
            </div>
            <div class="modal-body">
                <div class="d-flex justify-content-between align-items-center mb-2 border-bottom">
                    <div class="action-buttons py-2">
                        <button class="mui-button mui-button-search" onclick="searchFolioInvoicing();">View</button>
                        <button class="mui-button mui-button-view" onclick="openBillingFromInvoicing(true);">Billing</button>
                        <button class="mui-button mui-button-view" onclick="openFolioOptionFromInvoicing();">Folio</button>
                        <button class="mui-button mui-button-export" onclick="exportInvoicing();">Excel</button>
                        <button data-bs-dismiss="modal" class="mui-button mui-button-close">Close</button>

                    </div>
                </div>

                <div class="card inv-filter mb-2">
                    <div class="row g-2">
                        <div class="col-md-3">
                            <div class="input-group input-group-sm">
                                <span class="input-group-text justify-content-center" style="width: 90px;">Folio. No</span>
                                <input type="text" id="folioNoInvoicing" class="form-control">
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="input-group input-group-sm">
                                <span class="input-group-text justify-content-center" style="width: 90px;">Conf. No</span>
                                <input type="text" id="confirmationNoInvoicing" class="form-control">
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="input-group input-group-sm">
                                <span class="input-group-text justify-content-center" style="width: 90px;">Room</span>
                                <input type="text" id="roomInvoicing" class="form-control">
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="input-group input-group-sm">
                                <span class="input-group-text justify-content-center" style="width: 90px;">Name</span>
                                <input type="text" id="nameInvoicing" class="form-control">
                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="input-group input-group-sm">
                                <span class="input-group-text justify-content-center" style="width: 90px;">G. Status</span>
                                <select id="guestStatusInvoicing" class="form-select">
                                    <option value="0">All</option>
                                    <option value="1">In House</option>
                                    <option value="2">Checked Out</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="input-group input-group-sm">
                                <span class="input-group-text justify-content-center" style="width: 90px;">F. Status</span>
                                <select id="folioStatusInvoicing" class="form-select">
                                    <option value="0">All</option>
                                    <option value="1">Opened</option>
                                    <option value="2">Closed</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="input-group input-group-sm">
                                <span class="input-group-text justify-content-center" style="width: 90px;">F. Type</span>
                                <select id="folioTyoeInvoicing" class="form-select">
                                    <option value="0">All</option>
                                    <option value="1">Guest Folio</option>
                                    <option value="2">Master Folio</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="input-group input-group-sm">
                                <span class="input-group-text justify-content-center" style="width: 90px;">
                                    <input class="form-check-input mt-0" type="checkbox" id="checkBoxInvoicing">
