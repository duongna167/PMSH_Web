@* Item List (Room Management): danh sách Item, thêm / sửa / xóa Item, mở Item Daily Inventory.
   Popup theo chuẩn của dự án (ModalManager + mui-button), logic tương ứng màn frmItemList / frmItemManagement của PMS desktop. *@

<div class="modal fade" id="ils_modal" data-bs-backdrop="static" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content modal-full-height">
            <div class="modal-header bg-light py-2">
                <h5 class="modal-title">Item List</h5>
            </div>

            <div class="modal-body d-flex flex-column" style="height: calc(100vh - 120px);">
                <div class="py-2">
                    <button id="ils_btnSearch" class="mui-button mui-button-view" data-action="rmg_ItemListView">Search</button>
                    <button id="ils_btnNew" class="mui-button mui-button-new" data-action="rmg_ItemListNew">New</button>
                    <button id="ils_btnEdit" class="mui-button mui-button-edit" data-action="rmg_ItemListEdit">Edit</button>
                    <button id="ils_btnDelete" class="mui-button mui-button-delete" data-action="rmg_ItemListDelete">Delete</button>
                    <button id="ils_btnDailyInv" class="mui-button mui-button-new" data-action="rmg_ItemListDailyInv">Daily Inv</button>
                    <button class="mui-button mui-button-close" data-bs-dismiss="modal">Close</button>
                </div>

                <div class="mui-card mb-2 bg-light border-0 d-flex flex-column flex-grow-1 overflow-hidden">
                    <div class="p-2 flex-shrink-0">
                        <div class="row g-2 align-items-center">
                            <div class="col-xl-3 col-lg-4 col-md-6">
                                <div class="d-flex align-items-center gap-2">
                                    <label class="mb-0 fw-semibold text-nowrap">Item Group:</label>
                                    <select id="ils_group" class="form-select form-select-sm flex-grow-1">
                                        <option value="0">--All--</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-xl-3 col-lg-4 col-md-6">
                                <div class="d-flex align-items-center gap-2">
                                    <label class="mb-0 fw-semibold text-nowrap">Item Name:</label>
                                    <input type="text" id="ils_itemNameFilter" class="form-control form-control-sm flex-grow-1" autocomplete="off" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="gridContainer mt-2 d-flex flex-column flex-grow-1 overflow-auto">
                        <div id="ils_grid"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ===== Form thêm / sửa Item ===== -->
<div class="modal fade" id="ils_itemModal" data-bs-backdrop="static" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="ils_itemModalLabel">Item Management</h5>
            </div>

            <div class="modal-body">
                <div class="py-2 d-flex gap-2">
                    <button type="button" id="ils_btnSave" class="mui-button mui-button-save">Save</button>
                    <button type="button" class="mui-button mui-button-close" data-bs-dismiss="modal">Close</button>
                </div>

                <form id="ils_form" novalidate autocomplete="off">
                    <input type="hidden" id="ils_id" value="0" />
                    <div class="container-fluid px-2">
                        <div class="row g-4">

                            <!-- Trái: thông tin chung -->
                            <div class="col-12 col-lg-6">
                                <div class="row mb-3 align-items-center">
                                    <label class="col-12 col-md-4 fw-bold">Group <span class="text-danger">*</span></label>
                                    <div class="col-12 col-md-8">
                                        <select id="ils_formGroup" name="group" class="tomselect-custom w-100"></select>
                                        <div class="invalid-feedback"></div>
                                    </div>
                                </div>
                                <div class="row mb-3 align-items-center">
                                    <label class="col-12 col-md-4 fw-bold">Code</label>
                                    <div class="col-12 col-md-8">
                                        <input type="text" id="ils_code" name="code" class="form-control form-control-sm" maxlength="200" />
                                        <div class="invalid-feedback"></div>
                                    </div>
                                </div>
                                <div class="row mb-3 align-items-center">
                                    <label class="col-12 col-md-4 fw-bold">Name <span class="text-danger">*</span></label>
                                    <div class="col-12 col-md-8">
                                        <input type="text" id="ils_name" name="name" class="form-control form-control-sm" maxlength="200" />
                                        <div class="invalid-feedback"></div>
                                    </div>
                                </div>
                                <div class="row mb-3 align-items-center">
                                    <label class="col-12 col-md-4 fw-bold">Description</label>
                                    <div class="col-12 col-md-8">
                                        <input type="text" id="ils_description" name="description" class="form-control form-control-sm" maxlength="200" />
                                        <div class="invalid-feedback"></div>
                                    </div>
                                </div>
                                <div class="row mb-3 align-items-center">
                                    <label class="col-12 col-md-4 fw-bold">Department</label>
                                    <div class="col-12 col-md-8">
                                        <select id="ils_department" name="department" class="tomselect-custom w-100"></select>
                                        <div class="invalid-feedback"></div>
                                    </div>
                                </div>
                                <div class="row mb-3 align-items-center">
                                    <label class="col-12 col-md-4 fw-bold">Transaction Code</label>
                                    <div class="col-12 col-md-8">
                                        <select id="ils_transactionCode" name="transactionCode" class="tomselect-custom w-100" multiple></select>
                                        <div class="invalid-feedback"></div>
                                    </div>
                                </div>
                            </div>

                            <!-- Phải: số lượng và thời gian -->
                            <div class="col-12 col-lg-6">
                                <div class="row mb-3 align-items-center">
                                    <label class="col-12 col-md-5 fw-bold">Quantity in Stock <span class="text-danger">*</span></label>
                                    <div class="col-12 col-md-7">
                                        <input type="number" id="ils_quantityStock" name="quantityStock" class="form-control form-control-sm" min="0" step="1" />
                                        <div class="invalid-feedback"></div>
                                    </div>
                                </div>
                                <div class="row mb-3 align-items-center">
                                    <label class="col-12 col-md-5 fw-bold">Default Quantity</label>
                                    <div class="col-12 col-md-7">
                                        <input type="number" id="ils_quantityDefault" name="quantityDefault" class="form-control form-control-sm" min="0" step="1" />
                                        <div class="invalid-feedback"></div>
                                    </div>
                                </div>
                                <div class="row mb-3 align-items-center">
                                    <label class="col-12 col-md-5 fw-bold">Available From</label>
                                    <div class="col-12 col-md-7">
                                        <input type="text" id="ils_availableFrom" name="availableFrom" class="form-control form-control-sm" maxlength="100" />
                                        <div class="invalid-feedback"></div>
                                    </div>
                                </div>
                                <div class="row mb-3 align-items-center">
                                    <label class="col-12 col-md-5 fw-bold">Available To</label>
                                    <div class="col-12 col-md-7">
                                        <input type="text" id="ils_availableTo" name="availableTo" class="form-control form-control-sm" maxlength="100" />
                                        <div class="invalid-feedback"></div>
                                    </div>
                                </div>
                                <div class="row mb-3 align-items-center">
                                    <label class="col-12 col-md-5 fw-bold">Setup Time</label>
                                    <div class="col-12 col-md-7">
                                        <input type="text" id="ils_setupTime" name="setupTime" class="form-control form-control-sm" maxlength="100" />
                                        <div class="invalid-feedback"></div>
                                    </div>
                                </div>
                                <div class="row mb-3 align-items-center">
                                    <label class="col-12 col-md-5 fw-bold">Setdown Time</label>
                                    <div class="col-12 col-md-7">
                                        <input type="text" id="ils_setdownTime" name="setdownTime" class="form-control form-control-sm" maxlength="100" />
                                        <div class="invalid-feedback"></div>
                                    </div>
                                </div>
                            </div>

                            <!-- Dưới: ghi chú -->
                            <div class="col-12">
                                <div class="row align-items-start">
                                    <label class="col-12 col-md-2 fw-bold">Trace Text</label>
                                    <div class="col-12 col-md-10">
                                        <textarea id="ils_traces" name="traces" class="form-control form-control-sm" rows="3" maxlength="510"></textarea>
                                        <div class="invalid-feedback"></div>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    var ils_Module = {
        selectedRowData: null,
        lookups: { groups: [], departments: [], transactions: [] },

        baseGridOptions: {
            height: "100%",
            width: "100%",
            showBorders: true,
            hoverStateEnabled: true,
            wordWrapEnabled: true,
            allowColumnResizing: true,
            columnResizingMode: "widget",
            columnAutoWidth: true,
            selection: { mode: "single" },
            scrolling: { mode: "standard", showScrollbar: "always", useNative: true },
            paging: { pageSize: 20 },
            pager: { visible: true, allowedPageSizes: [20, 50, 100], showPageSizeSelector: true, showInfo: true, showNavigationButtons: true },
            filterRow: { visible: true, applyFilter: "auto" }
        },

        init: function () {
            this.initEvents();
            this.initDOMEvents();
        },

        initEvents: function () {
            const self = this;

            window.openModalItemList = function () {
                // Ẩn nút nghiệp vụ nếu người dùng không có quyền (server vẫn kiểm tra lại)
                if (typeof window.hasFunctionRight === "function") {
                    $("#ils_modal [data-action]").each(function () {
                        if (!window.hasFunctionRight($(this).data("action"))) $(this).hide();
                    });
                }

                self.loadLookups().always(function () { self.reloadGrid(); });

                $("#ils_modal").on("hidden.bs.modal", function () {
                    self.disposeGrid("#ils_grid");
                    self.selectedRowData = null;
                });

                $("#ils_itemModal").on("hidden.bs.modal", function () {
                    ValidationAdapter.clear("#ils_form");
                });
            };
        },

        initDOMEvents: function () {
            const self = this;
            $("#ils_btnSearch").on("click", () => self.reloadGrid());
            $("#ils_itemNameFilter").on("keydown", function (e) { if (e.key === "Enter") self.reloadGrid(); });
            $("#ils_btnNew").on("click", () => self.openNew());
            $("#ils_btnEdit").on("click", () => self.openEdit());
            $("#ils_btnDelete").on("click", () => self.confirmDelete());
            $("#ils_btnSave").on("click", () => self.save());
            $("#ils_btnDailyInv").on("click", function () {
                ModalManager.load("/RoomManagement/ItemDailyInventory", "idi_modal", "openModalItemDailyInv");
            });
        },

        // ---------------------------------------------------------------------------------------
        //  Dữ liệu tham chiếu (nhóm, phòng ban, mã giao dịch)
        // ---------------------------------------------------------------------------------------
        loadLookups: function () {
            const self = this;
            return $.ajax({ url: "/RoomManagement/ItemLookups", type: "GET" }).done(function (res) {
                if (!res || res.success === false) {
                    showToast("Error", (res && res.message) || "Unable to load lookups.", false);
                    return;
                }
                self.lookups = res;

                // Ô lọc theo nhóm
                const $g = $("#ils_group").empty().append('<option value="0">--All--</option>');
                (res.groups || []).forEach(g => $g.append($("<option>").val(g.ID).text(g.Code)));

                // Các ô chọn trong form
                const fill = (sel, rows, valueKey, textFn, blank) => {
                    const $s = $(sel).empty();
                    if (blank !== undefined) $s.append($("<option>").val("").text(blank));
                    rows.forEach(r => $s.append($("<option>").val(r[valueKey]).text(textFn(r))));
                };
                fill("#ils_formGroup", res.groups || [], "ID", g => g.Code, "--Choose One--");
                fill("#ils_department", res.departments || [], "ID", d => d.Code + " - " + d.Name, "");
                fill("#ils_transactionCode", res.transactions || [], "Code", t => t.Code + " - " + (t.Description || ""));
                initTomSelect(["#ils_formGroup", "#ils_department", "#ils_transactionCode"]);
            }).fail(function () { showToast("Error", "Unable to load lookups.", false); });
        },

        // ---------------------------------------------------------------------------------------
        //  Lưới
        // ---------------------------------------------------------------------------------------
        reloadGrid: function () {
            const self = this;
            self.selectedRowData = null;
            $.ajax({
                url: "/RoomManagement/GetItemSearch",
                type: "GET",
                loadingGrid: "#ils_grid",
                data: { groupID: $("#ils_group").val() || "0", name: $("#ils_itemNameFilter").val() || "" },
                success: function (data) {
                    // Server trả chuỗi khi lỗi
                    if (!Array.isArray(data)) {
                        showToast("Error", typeof data === "string" ? data : "Unable to load data", false);
                        data = [];
                    }
                    self.renderGrid(data);
                },
                error: function () { showToast("Error", "Unable to load data", false); }
            });
        },

        renderGrid: function (data) {
            const self = this;
            $("#ils_grid").dxDataGrid($.extend(true, {}, self.baseGridOptions, {
                dataSource: data,
                keyExpr: "id",
                columns: [
                    { dataField: "id", visible: false },
                    { dataField: "group", caption: "Group", width: 100 },
                    { dataField: "code", caption: "Code", width: 90 },
                    { dataField: "name", caption: "Name", width: 150 },
                    { dataField: "description", caption: "Description", minWidth: 150 },
                    { dataField: "transactionCode", caption: "Transaction Code", width: 200 },
                    { dataField: "department", caption: "Department", width: 100 },
                    { dataField: "qinStock", caption: "Q in Stock", width: 75, alignment: "right" },
                    { dataField: "defaultQ", caption: "Default", width: 65, alignment: "right" },
                    { dataField: "setupTime", caption: "Setup Time", width: 85 },
                    { dataField: "setdownTime", caption: "Setdown Time", width: 95 },
                    { dataField: "availFrom", caption: "Avail From", width: 85 },
                    { dataField: "availTo", caption: "Avail To", width: 85 },
                    { dataField: "traces", caption: "Traces", width: 150 }
                ],
                onSelectionChanged: function (e) { self.selectedRowData = e.selectedRowsData[0] || null; },
                onRowDblClick: function (e) { self.selectedRowData = e.data; self.openEdit(); }
            }));
        },

        disposeGrid: function (sel) {
            if ($(sel).data("dxDataGrid")) {
                $(sel).dxDataGrid("dispose");
                $(sel).empty();
            }
        },

        // ---------------------------------------------------------------------------------------
        //  Form thêm / sửa
        // ---------------------------------------------------------------------------------------
        resetForm: function () {
            $("#ils_id").val(0);
            $("#ils_form").find("input[type=text], input[type=number], textarea").val("");
            ["#ils_formGroup", "#ils_department", "#ils_transactionCode"].forEach(function (s) {
                const ts = document.querySelector(s).tomselect;
                if (ts) ts.clear();
            });
            ValidationAdapter.clear("#ils_form");
        },

        openNew: function () {
            this.resetForm();
            $("#ils_itemModalLabel").text("New Item");
            $("#ils_itemModal").modal("show");
        },

        openEdit: function () {
            const self = this;
            if (!self.selectedRowData) {
                showToast("Warning", "Please select a row first!", false);
                return;
            }

            // Lấy bản ghi đầy đủ theo ID (lưới chỉ có mã nhóm/phòng ban dạng chữ)
            $.get("/RoomManagement/ItemGet", { id: self.selectedRowData.id }).done(function (res) {
                if (!res.success) { showToast("Error", res.message, false); return; }

                const d = res.data;
                self.resetForm();
                $("#ils_id").val(d.ID);
                $("#ils_code").val(d.Code || "");
                $("#ils_name").val(d.Name || "");
                $("#ils_description").val(d.Description || "");
                $("#ils_quantityStock").val(d.QuantityStock);
                $("#ils_quantityDefault").val(d.QuantityDefault);
                $("#ils_availableFrom").val(d.AvailableFrom || "");
                $("#ils_availableTo").val(d.AvailableTo || "");
                $("#ils_setupTime").val(d.SetupTime || "");
                $("#ils_setdownTime").val(d.SetDownTime || "");
                $("#ils_traces").val(d.Traces || "");
                setTomSelectValue("#ils_formGroup", d.ItemGroupID ? String(d.ItemGroupID) : "");
                setTomSelectValue("#ils_department", d.DepartmentID ? String(d.DepartmentID) : "");
                setTomSelectValueMulti("#ils_transactionCode", d.TransactionCode || "");

                $("#ils_itemModalLabel").text("Edit Item");
                $("#ils_itemModal").modal("show");
            }).fail(function () { showToast("Error", "Unable to load item.", false); });
        },

        save: function () {
            const self = this;
            const num = sel => { const v = $(sel).val(); return v === "" ? null : parseInt(v, 10); };

            const payload = {
                id: parseInt($("#ils_id").val(), 10) || 0,
                itemGroupID: parseInt($("#ils_formGroup").val(), 10) || 0,
                code: $("#ils_code").val(),
                name: $("#ils_name").val(),
                description: $("#ils_description").val(),
                transactionCode: ($("#ils_transactionCode").val() || []).join(","),
                departmentID: parseInt($("#ils_department").val(), 10) || 0,
                quantityStock: num("#ils_quantityStock"),
                quantityDefault: num("#ils_quantityDefault"),
                availableFrom: $("#ils_availableFrom").val(),
                availableTo: $("#ils_availableTo").val(),
                setupTime: $("#ils_setupTime").val(),
                setDownTime: $("#ils_setdownTime").val(),
                traces: $("#ils_traces").val()
            };

            $.ajax({
                url: "/RoomManagement/ItemSave",
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify(payload),
                headers: { "X-CSRF-TOKEN-HEADERNAME": jQuery("input[name='__RequestVerificationToken']").val() },
                success: function (res) {
                    if (res.success) {
                        showToast("Success", res.message, true);
                        $("#ils_itemModal").modal("hide");
                        self.reloadGrid();
                    } else if (res.errors && res.errors.length) {
                        ValidationAdapter.apply(res.errors, "#ils_form");
                        showToast("Warning", "Check for incorrect input fields.", false);
                    } else {
                        showToast("Error", res.message || "Something went wrong.", false);
                    }
                },
                error: function (xhr) {
                    showToast("Error", xhr.status === 403 ? "Access Denied" : "Server error occurred.", false);
                }
            });
        },

        // ---------------------------------------------------------------------------------------
        //  Xóa
        // ---------------------------------------------------------------------------------------
        confirmDelete: function () {
            const self = this;
            if (!self.selectedRowData) {
                showToast("Warning", "Please select a row first!", false);
                return;
            }

            const run = function () {
                $.ajax({
                    url: "/RoomManagement/ItemDelete?id=" + self.selectedRowData.id,
                    type: "POST",
                    headers: { "X-CSRF-TOKEN-HEADERNAME": jQuery("input[name='__RequestVerificationToken']").val() },
                    success: function (res) {
                        showToast(res.success ? "Success" : "Error", res.message, !!res.success);
                        if (res.success) self.reloadGrid();
                    },
                    error: function () { showToast("Error", "Delete failed!", false); }
                });
            };

            if (window.Swal) {
                Swal.fire({ title: "Are you sure to delete?", icon: "question", showCancelButton: true, confirmButtonText: "Yes", cancelButtonText: "No" })
                    .then(r => { if (r.isConfirmed) run(); });
            } else if (confirm("Are you sure to delete?")) run();
        }
    };

    $(document).ready(function () {
        ils_Module.init();
    });
</script>
