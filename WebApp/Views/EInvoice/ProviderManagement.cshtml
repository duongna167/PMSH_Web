                            <div class="col-md-10"><textarea name="sourceValue" class="form-control form-control-sm" rows="3"></textarea><div class="invalid-feedback"></div></div>
                        </div></div>

                        <div class="col-12 col-lg-3"><div class="row g-1 align-items-center">
                            <label class="col-md-5 col-form-label col-form-label-sm text-md-end">Data Type</label>
                            <div class="col-md-7"><select name="dataType" class="form-select form-select-sm">
                                <option>STRING</option><option>INT</option><option>INTEGER</option><option>DECIMAL</option><option>BOOLEAN</option><option>BOOL</option>
                                <option>DATE</option><option>DATETIME</option><option>ARRAY</option><option>OBJECT</option><option>UNIX_MILLISECONDS</option>
                            </select><div class="invalid-feedback"></div></div>
                        </div></div>
                        <div class="col-12 col-lg-9"><div class="row g-1 align-items-center">
                            <label class="col-md-2 col-form-label col-form-label-sm text-md-end">Default Value</label>
                            <div class="col-md-10"><input type="text" name="defaultValue" class="form-control form-control-sm" /><div class="invalid-feedback"></div></div>
                        </div></div>

                        <div class="col-12 col-lg-4"><div class="row g-1 align-items-center">
                            <label class="col-md-5 col-form-label col-form-label-sm text-md-end">Format String</label>
                            <div class="col-md-7"><input type="text" name="formatString" class="form-control form-control-sm" maxlength="100" /><div class="invalid-feedback"></div></div>
                        </div></div>
                        <div class="col-12 col-lg-4"><div class="row g-1 align-items-center">
                            <label class="col-md-5 col-form-label col-form-label-sm text-md-end">Prefix</label>
