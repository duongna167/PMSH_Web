@{ ViewData["Title"] = "Card Management"; }
<style>
    #card_page { width: 100%; margin: 4px 0 12px; font-size: 13px; }
    #card_page [hidden] { display: none !important; }
    #card_page .header { justify-content: center; margin-bottom: 6px; }
    #card_page .mui-card { margin: 0 0 8px; padding: 8px; min-width: 0; }
    #card_page label { margin: 0; white-space: nowrap; }
    .card-toolbar { display: flex; gap: 4px; flex-wrap: wrap; }
    .card-toolbar .mui-button { min-width: 80px; margin: 0; }
    .card-title-bar { display: flex; align-items: center; gap: 8px; padding-bottom: 5px; margin-bottom: 8px; border-bottom: 2px solid #ececec; font-size: 14px; font-weight: 600; color: #000; }
    .card-title-bar i { background: #027C75; color: #fff; padding: 4px; font-size: 12px; }
    .card-form { display: flex; align-items: center; flex-wrap: wrap; gap: 8px 24px; }
    .card-field { display: flex; align-items: center; gap: 8px; }
    #card_id { width: 140px; }
    .card-field select { width: 140px; }
</style>
<div id="card_page">
    <div class="header">
        <h3 id="content-title">Card Management</h3>
    </div>
    @Html.AntiForgeryToken()
    <div class="card-toolbar mui-card">
        <button type="button" class="mui-button mui-button-new" id="card_new">New</button>
        <button type="button" class="mui-button mui-button-edit" id="card_edit">Edit</button>
        <button type="button" class="mui-button button-report-delete" id="card_delete">Delete</button>
        <button type="button" class="mui-button mui-button-save" id="card_save" hidden>Save</button>
        <button type="button" class="mui-button mui-button-cancel" id="card_cancel" hidden>Cancel</button>
    </div>

    <div class="mui-card">
        <div class="card-title-bar"><i class="fa-solid fa-id-card"></i> Card info</div>
        <div class="card-form">
            <div class="card-field">
                <label for="card_id">Card ID</label>
                <input id="card_id" class="form-control form-control-sm" maxlength="8" inputmode="numeric" autocomplete="off" disabled>
            </div>
            <div class="card-field">
                <label for="card_type">Card Type</label>
                <select id="card_type" class="form-select form-select-sm" disabled>
                    <option value="0">Card Hotel</option>
                </select>
            </div>
            <div class="card-field">
                <label for="card_status">Status</label>
                <select id="card_status" class="form-select form-select-sm" disabled>
                    <option value="0">Inactive</option>
                    <option value="1" selected>Active</option>
                    <option value="2">Other</option>
                </select>
            </div>
            <div class="card-field" id="card_counter" hidden>
                <span>Count: <strong id="card_count">0</strong></span>
                <button type="button" class="btn btn-sm btn-light" id="card_resetCount" title="Reset counter">
                    <i class="fa-solid fa-rotate-right"></i>
                </button>
            </div>
        </div>
    </div>

    <div class="mui-card">
        <div id="card_grid" class="gridContainer"></div>
    </div>
</div>

<script>
    var card_Module = (function () {
        const CARD_ID_LENGTH = 8;
        let mode = "view"; // view | new | edit
        let rows = [];
        let count = 0;
        let grid;

        function toast(message, ok) {
            showToast(ok ? "Success" : "Warning", message, ok);
        }

        function errorText(xhr) {
            return (xhr.responseJSON && (xhr.responseJSON.message || xhr.responseJSON.msg)) || "Cannot process card.";
        }

        function post(url, data) {
            data.__RequestVerificationToken = $('#card_page input[name="__RequestVerificationToken"]').val();
            return $.post(url, data);
        }

        function selected() {
            return grid.getSelectedRowsData()[0];
        }

        function setMode(next) {
            mode = next;
            const editing = mode !== "view";
            $("#card_new, #card_edit, #card_delete").prop("hidden", editing);
            $("#card_cancel").prop("hidden", !editing);
            $("#card_save").prop("hidden", mode !== "edit");
            $("#card_counter").prop("hidden", mode !== "new");
            $("#card_id").prop("disabled", !editing).prop("readonly", mode === "edit").val("");
            $("#card_type, #card_status").prop("disabled", !editing);
            $("#card_type").val("0");
            $("#card_status").val("1");
        }

        function setCount(value) {
            count = value;
            $("#card_count").text(count.toLocaleString("en-US"));
        }

        function load() {
            grid.beginCustomLoading("Loading...");
            $.getJSON("/Miscellaneous/GetCardManagement")
                .done(function (data) {
                    rows = data;
                    grid.option("dataSource", rows);
                })
                .fail(function (xhr) { toast(errorText(xhr), false); })
                .always(function () { grid.endCustomLoading(); });
        }

        function putRow(row) {
            const index = rows.findIndex(r => r.id === row.id);
            if (index < 0) rows.unshift(row);
            else rows[index] = row;
            grid.refresh();
        }

        // Chế độ New: đủ mã là tự lưu và chờ thẻ tiếp theo, giống bản WinForms
        function addCard(id) {
            $("#card_id").val("").focus();
            post("/Miscellaneous/SaveCard", { id: id, cardTypeId: $("#card_type").val(), status: $("#card_status").val(), isNew: true })
                .done(function (res) {
                    putRow(res.data);
                    setCount(count + 1);
                })
                .fail(function (xhr) { toast(id + ": " + errorText(xhr), false); });
        }

        function startNew() {
            grid.clearSelection();
            setMode("new");
            setCount(0);
            $("#card_id").focus();
        }

        function startEdit() {
            const row = selected();
            if (!row) return toast("Please select a line to edit.", false);
            setMode("edit");
            $("#card_id").val(row.id);
            $("#card_type").val(String(row.cardTypeID));
            $("#card_status").val(String(row.status));
        }

        function save() {
            post("/Miscellaneous/SaveCard", { id: $("#card_id").val(), cardTypeId: $("#card_type").val(), status: $("#card_status").val(), isNew: false })
                .done(function (res) {
                    putRow(res.data);
                    setMode("view");
                    toast("Updated successfully!", true);
                })
                .fail(function (xhr) { toast(errorText(xhr), false); });
        }

        function remove() {
            const row = selected();
            if (!row) return toast("Please select a line to delete.", false);

            Swal.fire({
                title: "Are you sure you want to delete?",
                text: "Card ID: " + row.id,
                icon: "question",
                showCancelButton: true,
                confirmButtonText: "Yes",
                cancelButtonText: "No"
            }).then(function (answer) {
                if (!answer.isConfirmed) return;
                post("/Miscellaneous/DeleteCard", { id: row.id })
                    .done(function () {
                        rows.splice(rows.findIndex(r => r.id === row.id), 1);
                        grid.clearSelection();
                        grid.refresh();
                        toast("Deleted successfully!", true);
                    })
                    .fail(function (xhr) { toast(errorText(xhr), false); });
            });
        }

        // Đầu đọc thẻ gắn vào server gửi mã về qua SignalR
        function listenCardReader() {
            const connection = new signalR.HubConnectionBuilder().withUrl("/tagScanHub").build();
            connection.on("ReceiveCode", function (code) {
                if (mode === "new") addCard(code);
            });
            connection.start().catch(function (err) { console.error("Card reader connection failed:", err); });
        }

        function init() {
            grid = $("#card_grid").dxDataGrid({
                dataSource: [],
                keyExpr: "id",
                height: 500,
                showBorders: true,
                columnAutoWidth: true,
                allowColumnResizing: true,
                columnResizingMode: "widget",
                selection: { mode: "single" },
                filterRow: { visible: true },
                paging: { pageSize: 20 },
                pager: { visible: true, allowedPageSizes: [20, 50, 100], showPageSizeSelector: true, showInfo: true, showNavigationButtons: true },
                columns: [
                    { dataField: "id", caption: "ID" },
                    { dataField: "cardType", caption: "Card Type" },
                    { dataField: "statusText", caption: "Status" },
                    { dataField: "createdBy", caption: "Created By" },
                    { dataField: "createdDate", caption: "Created Date", dataType: "date", format: "dd/MM/yyyy HH:mm" },
                    { dataField: "updatedBy", caption: "Updated By" },
                    { dataField: "updatedDate", caption: "Updated Date", dataType: "date", format: "dd/MM/yyyy HH:mm" }
                ],
                onSelectionChanged: function () {
                    // Đang sửa mà chọn dòng khác thì hủy sửa để không lưu nhầm thẻ
                    if (mode === "edit" && selected()?.id !== $("#card_id").val()) setMode("view");
                },
                onRowDblClick: function () {
                    if (mode === "view") startEdit();
                }
            }).dxDataGrid("instance");

            $("#card_new").on("click", startNew);
            $("#card_edit").on("click", startEdit);
            $("#card_delete").on("click", remove);
            $("#card_save").on("click", save);
            $("#card_cancel").on("click", function () { setMode("view"); });
            $("#card_resetCount").on("click", function () { setCount(0); $("#card_id").focus(); });
            $("#card_id").on("input", function () {
                const id = this.value.replace(/\D/g, "");
                this.value = id;
                if (mode === "new" && id.length === CARD_ID_LENGTH) addCard(id);
            });

            setMode("view");
            listenCardReader();
            load();
        }

        return { init: init };
    })();

    $(function () { card_Module.init(); });
</script>
