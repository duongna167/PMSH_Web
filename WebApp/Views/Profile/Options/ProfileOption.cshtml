<style>
    #modalProfileOption .modal-dialog {
        max-width: 560px;
        width: 560px;
    }
    #modalProfileOption .modal-content {
        overflow: visible;
        min-height: 280px;
    }
    #modalProfileOption .modal-body {
        padding: 16px 24px 36px !important;
    }
    #modalProfileOption .opt-toolbar {
        margin-bottom: 16px;
    }
    #modalProfileOption .opt-grid {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 12px;
        padding-bottom: 4px;
    }
    #modalProfileOption .opt-grid .mui-button {
        width: 100%;
        min-width: 0;
        height: 36px;
        white-space: nowrap;
    }
</style>

<div class="modal fade" id="modalProfileOption" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h5 class="modal-title">CPMS - Profile Option</h5>
            </div>
            <div class="modal-body">
                <div class="opt-toolbar">
                    <button type="button" class="mui-button mui-button-new" data-bs-dismiss="modal">Close</button>
                </div>
                <div class="opt-grid">
                    <button type="button" class="mui-button mui-button-new" id="ind_opt_btnChanges">Changes</button>
                    <button type="button" class="mui-button mui-button-new" id="ind_opt_btnDelete">Delete</button>
                    <button type="button" class="mui-button mui-button-new" id="ind_opt_btnFuture">Future</button>
                    <button type="button" class="mui-button mui-button-new" id="ind_opt_btnHistory">History</button>
                    <button type="button" class="mui-button mui-button-new" id="ind_opt_btnMembership">Memberships</button>
                    <button type="button" class="mui-button mui-button-new" id="ind_opt_btnMerge">Merge</button>
                    <button type="button" class="mui-button mui-button-new" id="ind_opt_btnNegRate">Neg.Rates</button>
                    <button type="button" class="mui-button mui-button-new" id="ind_opt_btnProfileUpdate">Profile Update</button>
                    <button type="button" class="mui-button mui-button-new" id="ind_opt_btnRelationships">Relationships</button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="ind_opt_modalHistory" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content modal-full-height">
            <div class="modal-header py-2">
                <h5 class="modal-title">History</h5>
            </div>
            <div class="modal-body d-flex flex-column" style="height: calc(100vh - 120px);">
                <div class="py-2">
                    <button type="button" class="mui-button mui-button-new" data-bs-dismiss="modal">Close</button>
                </div>
                <div class="gridContainer mt-2 flex-grow-1 d-flex flex-column position-relative" style="min-height: 0;">
                    <div id="ind_opt_gridHistory"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    var ind_opt_Module = {
        profileID: 0,
        profileName: "",
        profileType: 0,

        init: function (ctx) {
            ctx = ctx || {};
            this.profileID = parseInt(ctx.profileID, 10) || 0;
            this.profileName = ctx.profileName || "";
            this.profileType = ctx.profileType || 0;
            this.bindEvents();
        },

        requireProfile: function () {
            if (this.profileID > 0) return true;
            showToast("Warning", "Please save the profile first.", false);
            return false;
        },

        bindEvents: function () {
            const self = this;
            $("#ind_opt_btnChanges").off("click").on("click", function () { self.openChanges(); });
            $("#ind_opt_btnDelete").off("click").on("click", function () { self.deleteProfile(); });
            $("#ind_opt_btnFuture").off("click").on("click", function () { self.openFuture(); });
            $("#ind_opt_btnHistory").off("click").on("click", function () { self.openHistory(); });
            $("#ind_opt_btnMembership").off("click").on("click", function () { self.openMembership(); });
            $("#ind_opt_btnMerge").off("click").on("click", function () { self.openMerge(); });
            $("#ind_opt_btnNegRate").off("click").on("click", function () { self.openNegRates(); });
            $("#ind_opt_btnProfileUpdate").off("click").on("click", function () { self.openProfileUpdate(); });
            $("#ind_opt_btnRelationships").off("click").on("click", function () {
                showToast("Warning", "Relationships is not available yet.", false);
            });
        },

        openChanges: function () {
            const self = this;
            if (!self.requireProfile()) return;
            ModalManager.load("/Profile/Changes", "op_changes_modal", function () {
                waitForFunction("openOpChangesModal", function () {
                    window.openOpChangesModal(self.profileID);
                });
            });
        },

        openFuture: function () {
            const self = this;
            if (!self.requireProfile()) return;
            ModalManager.load("/Profile/Future", "modalFuture", function () {
                waitForFunction("openModalFuture", function () {
                    window.openModalFuture(self.profileID, self.profileType);
                });
            });
        },

        openMembership: function () {
            const self = this;
            if (!self.requireProfile()) return;
            ModalManager.load("/Profile/Membership", "modalMembership", function () {
                waitForFunction("openModalMembership", function () {
                    window.openModalMembership(self.profileID, self.profileName);
                });
            });
        },

        openNegRates: function () {
            const self = this;
            if (!self.requireProfile()) return;
            ModalManager.load("/Profile/RateCodeNegotiated", "modalRateCodeNegotiated", function () {
                waitForFunction("openModalRateCodeNegotiated", function () {
                    window.openModalRateCodeNegotiated(self.profileID, self.profileName);
                });
            });
        },

        openProfileUpdate: function () {
            ModalManager.load("/Profile/ProfileUpdate", "modalProfileUpdate", function () {
                waitForFunction("openModalProfileUpdate", function () {
                    window.openModalProfileUpdate();
                });
            });
        },

        openMerge: function () {
            if (!this.requireProfile()) return;
            if (window.pro_ind_Module && typeof window.pro_ind_Module.pickProfileForMerge === "function") {
                window.pro_ind_Module.pickProfileForMerge(this.profileID);
                return;
            }
            showToast("Warning", "Please select exactly 2 profiles on Search Profile to merge.", false);
        },

        deleteProfile: function () {
            const self = this;
            if (!self.requireProfile()) return;
            if (!confirm("Are you sure you want to delete this profile?")) return;
            $.ajax({
                url: "/Profile/DeleteProfile",
                type: "POST",
                data: { profileID: self.profileID },
                success: function (res) {
                    if (res.success) {
                        showToast("Success", res.message, true);
                        const opt = bootstrap.Modal.getInstance(document.getElementById("modalProfileOption"));
                        if (opt) opt.hide();
                        const ind = bootstrap.Modal.getInstance(document.getElementById("modalIndividual"));
                        if (ind) ind.hide();
                        if ($("#pro_search_btnSearch").length) $("#pro_search_btnSearch").trigger("click");
                        if ($("#pro_up_btnView").length) $("#pro_up_btnView").trigger("click");
                    } else {
                        showToast("Error", res.message, false);
                    }
                }
            });
        },

        openHistory: function () {
            const self = this;
            if (!self.requireProfile()) return;
            const el = document.getElementById("ind_opt_modalHistory");
            if (!el) return;
            const modal = bootstrap.Modal.getOrCreateInstance(el, { backdrop: "static", keyboard: true });
            modal.show();
            $.ajax({
                url: "/Profile/SearchProfileHistory",
                data: { profileID: self.profileID, type: self.profileType, confirmationNo: "" },
                loadingGrid: "#ind_opt_gridHistory",
                success: function (result) {
                    self.renderHistory(result);
                }
            });
        },

        renderHistory: function (data) {
            $("#ind_opt_gridHistory").dxDataGrid({
                dataSource: data,
                height: "100%",
                allowColumnResizing: true,
                showBorders: false,
                paging: { pageSize: 15 },
                pager: {
                    visible: true,
                    allowedPageSizes: [15, 20, "all"],
                    showPageSizeSelector: true,
                    showInfo: true,
                    showNavigationButtons: true
                },
                scrolling: { mode: "standard", showScrollbar: "always" },
                columns: [
                    { dataField: "ConfirmationNo", caption: "Conf.No", width: 80, alignment: "center" },
                    { dataField: "CRSNo", caption: "CRS.No", width: 80, alignment: "center" },
                    { dataField: "ArrivalDate", caption: "Arrival", width: 90, dataType: "date", format: "dd/MM/yyyy" },
                    { dataField: "DepartureDate", caption: "Departure", width: 90, dataType: "date", format: "dd/MM/yyyy" },
                    { dataField: "RoomNo", caption: "Room", width: 70, alignment: "center" },
                    { dataField: "RoomType", caption: "Room Type", width: 90 },
                    { dataField: "Rate", caption: "Rate", width: 100, format: { type: "fixedPoint", precision: 2 }, alignment: "right" },
                    { dataField: "CurrencyID", caption: "Curr", width: 50, alignment: "center" },
                    { dataField: "RateCode", caption: "Rate Code", width: 90 },
                    { dataField: "NoOfAdult", caption: "A", width: 35, alignment: "center" },
                    { dataField: "NoOfChild", caption: "C", width: 35, alignment: "center" },
                    { dataField: "LastName", caption: "Guest Name", width: 150 },
                    { dataField: "Status", caption: "Status", width: 85, alignment: "center" },
                    { dataField: "TotalRevenue", caption: "Total Rev", width: 100, format: { type: "fixedPoint", precision: 2 }, alignment: "right" }
                ]
            });
        }
    };

    window.openModalProfileOption = function (ctx) {
        if (window.ind_opt_Module) window.ind_opt_Module.init(ctx);
    };
</script>
