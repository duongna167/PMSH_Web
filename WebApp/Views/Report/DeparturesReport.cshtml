@using DevExpress.XtraReports.UI
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    ViewBag.Title = ViewBag.ReportHeader;
    var roomclassList = ViewBag.RoomClassList;
    var rtList = ViewBag.RoomTypeList;
    var listzo = ViewBag.ZoneList;
    var vipList = ViewBag.VIPList;
    var listrc = ViewBag.RateCodeList;
    var listpmtr = ViewBag.TransactionsList;
    var listbnbl = ViewBag.BusinessBlockList;
}


<style>
    .filter_wrapper {
        /*     background-color: #ececec; */
        /*   margin: 0px 8px 14px 8px; */
        padding: 18px 0px 0px 14px;
        border-radius: 8px;
    }

    .gridContainer {
        margin: 0px 8px;
    }

    .button_wrapper {
        display: flex;
        column-gap: 12px;
        margin: 0px 8px;
    }

        .button_wrapper .fa-solid {
            margin-right: 5px;
        }

    .selected {
        background-color: #4CAF50; /* Màu xanh */
        color: white;
    }
 
        #gridContainer .dx-datagrid-rowsview .dx-selection * {
            color: white !important;
        }

    #gridContainer .dx-datagrid-headers .dx-header-row > td {
        padding: 5px !important;
        height: 24px !important;
        font-size: 12px !important;
        line-height: 1.1 !important;
    }

    #gridContainer .dx-datagrid-rowsview .dx-row > td,
    #gridContainer .dx-datagrid .dx-summary-row > td,
    #gridContainer .dx-datagrid .dx-total-footer td,
    #gridContainer .dx-datagrid .dx-footer-row td {
        font-size: 11px !important;
    }

    .sticky-header .form-control-sm {
        padding:  2px 8px;
        height: 28px;
    }

    .sticky-header label[class*="me-"] {
        margin-right: .5rem !important;
    }
    .filter-panel {`r`n        font-size: 14px;
    }

    .filter-row {
        display: flex;
        align-items: flex-start;
        margin-bottom: .5rem;
    }

        .filter-row .title {
            width: 80px;
            font-weight: 700;
            line-height: 1.2;
        }

        .filter-row .content {
            display: flex;
            flex-wrap: wrap;
            gap: .5rem 1rem;
        }

    .filter-panel .form-control-sm,
    .filter-panel .form-select-sm,
    .filter-panel .ts-control {
        font-size: 12px;
        padding: .1rem .35rem;
        height: 28px;
    }

 

 

    .report-bar {
        position: relative;
        margin-bottom: 1rem; /* = mb-3 của bạn */
    }

        /* Tiêu đề ở giữa, full width để text-center hoạt động */
        .report-bar #reportTitle {
            font-size: 20px;
            margin: 0; /* bỏ margin dưới h4/h5 mặc định */
            text-align: center;
        }

        /* Nhóm nút cố định góc phải, canh theo chiều dọc */
        .report-bar .action-buttons {
            position: absolute;
            left: 0;
            top: 50%;
            transform: translateY(-50%);
        }

    .depr-filter-grid {
        display: grid;
        grid-template-columns: max-content max-content minmax(140px, 1fr) max-content minmax(140px, 1fr) max-content minmax(140px, 1fr);
        column-gap: 8px;
        row-gap: 8px;
        align-items: center;
        width: 100%;
        min-width: 0;
        box-sizing: border-box;
    }

    .depr-filter-grid > label {
        margin-right: 0 !important;
        margin-bottom: 0;
        white-space: nowrap;
    }

    .depr-filter-grid select,
    .depr-filter-grid [data-date-input] {
        width: 100%;
        min-width: 0;
        max-width: 100%;
    }

    .depr-filter-grid .span-2 {
        grid-column: span 2;
        display: flex;
        align-items: center;
        gap: 12px;
        min-width: 0;
    }

    .depr-check-grid {
        display: grid;
        grid-template-columns: 110px repeat(5, minmax(0, 1fr));
        column-gap: 16px;
        row-gap: 8px;
        align-items: center;
        width: 100%;
        margin-top: 8px;
    }

    .depr-check-grid > label {
        margin: 0;
        white-space: nowrap;
    }

    .depr-check-grid > .form-check {
        margin: 0 !important;
        min-width: 0;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .depr-check-grid .form-check-label {
        white-space: nowrap;
    }

</style>
<div class="text-center" id="reportTitle" style="font-size: 20px"></div>
<div class="sticky-header bg-white p-2 shadow-sm z-3">
    <div class="">
        <button id="btnPrint" class="mui-button mui-button-new">View</button>
        <button id="btnExportExcel" class="mui-button mui-button-new" type="button">Excel</button>
        <button id="btnExportPdf" class="mui-button mui-button-new" type="button">PDF</button>
    </div>
    <div class="mb-1" style="border: 1px solid #ced4da; border-radius: 6px; padding: 8px;">
        <div class="depr-filter-grid">
            <label class="fw-bold">Departure Date Range:</label>
            <label>From Date:</label>
            <div data-date-input business-date data-format="DD/MM/YYYY" data-name="fromDate">
                <input type="text" class="date-ui form-control form-control-sm" placeholder="dd/mm/yyyy" autocomplete="off" />
            </div>
            <label>To Date:</label>
            <div data-date-input business-date data-format="DD/MM/YYYY" data-name="toDate">
                <input type="text" class="date-ui form-control form-control-sm" placeholder="dd/mm/yyyy" autocomplete="off" />
            </div>
            <span></span>
            <span></span>
            <label class="fw-bold">Filter:</label>
            <label>Room Class:</label>
            <select id="roomClass" name="roomClass" class="form-control form-control-sm report-dd">
                <option value="">--All--</option>
                @if (roomclassList != null)
                {
                    foreach (var item in roomclassList)
                    {
                        <option value="@item.Code">@item.Code-@item.Description</option>
                    }
                }
            </select>
            <label>Room Type:</label>
            <select id="roomtype" name="roomtype" class="form-control form-control-sm report-dd">
                <option value="">--All--</option>
                @if (rtList != null)
                {
                    foreach (var item in rtList)
                    {
                        <option value="@item.Code">@item.Code-@item.Description</option>
                    }
                }
            </select>
            <label>Pay Method:</label>
            <select id="paymethod" name="paymethod" class="form-control form-control-sm report-dd">
                <option value="">--All--</option>
                @if (listpmtr != null)
                {
                    foreach (var item in listpmtr)
                    {
                        <option value="@item.Code">@item.Code-@item.Description</option>
                    }
                }
            </select>
            <span></span>
            <label>Block:</label>
            <select id="block" name="block" class="form-control form-control-sm report-dd">
                <option value="">--All--</option>
                @if (listbnbl != null)
                {
                    foreach (var item in listbnbl)
                    {
                        <option value="@item.Code">@item.Code-@item.Name</option>
                    }
                }
            </select>
            <label>Rate Code:</label>
            <select id="rateCode" name="rateCode" class="form-control form-control-sm report-dd">
                <option value="">--All--</option>
                @if (listrc != null)
                {
                    foreach (var item in listrc)
                    {
                        <option value="@item.RateCode">@item.RateCode-@item.Descripton</option>
                    }
                }
            </select>
            <label>Zone:</label>
            <select id="zone" name="zone" class="form-control form-control-sm report-dd">
                <option value="">--All--</option>
                @if (listzo != null)
                {
                    foreach (var item in listzo)
                    {
                        <option value="@item.Code">@item.Code-@item.Description</option>
                    }
                }
            </select>
        </div>
        <div class="depr-check-grid">
            <label class="fw-bold mb-0">Check Only:</label>
            <div class="form-check">
                <input class="form-check-input include-option" type="checkbox" id="latecheckoutonly" name="checkeOptions" value="1">
                <label class="form-check-label" for="latecheckoutonly">Late Cheked Out Only</label>
            </div>
            <div class="form-check">
                <input class="form-check-input include-option" type="checkbox" id="earlydepartureonly" name="checkeOptions" value="1">
                <label class="form-check-label" for="earlydepartureonly">Early Departure Rooms Only</label>
            </div>
            <span></span>
            <span></span>
            <span></span>

            <label class="fw-bold mb-0">Profile Type:</label>
            <div class="form-check">
                <input class="form-check-input include-option" type="checkbox" id="travelagents" name="profiletypeOptions" value="111">
                <label class="form-check-label" for="travelagents">Travel Agents</label>
            </div>
            <div class="form-check">
                <input class="form-check-input include-option" type="checkbox" id="company" name="profiletypeOptions" value="111">
                <label class="form-check-label" for="company">Company</label>
            </div>
            <div class="form-check">
                <input class="form-check-input include-option" type="checkbox" id="source" name="profiletypeOptions" value="111">
                <label class="form-check-label" for="source">Source</label>
            </div>
            <div class="form-check">
                <input class="form-check-input include-option" type="checkbox" id="individuals" name="profiletypeOptions" value="111">
                <label class="form-check-label" for="individuals">Individuals</label>
            </div>
            <div class="form-check">
                <input class="form-check-input include-option" type="checkbox" id="group" name="profiletypeOptions" value="111">
                <label class="form-check-label" for="group">Group</label>
            </div>

            <label class="fw-bold mb-0">Include:</label>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="pseudo" name="includeOptions" value="1">
                <label class="form-check-label" for="pseudo">Pseudo Rooms</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="dueout" name="includeOptions" value="1">
                <label id="dateInfoText" class="form-check-label" for="dueout">Due Out</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="checkout" name="includeOptions" value="1">
                <label class="form-check-label" for="checkout">Checked Out</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="specials" name="includeOptions" value="1">
                <label class="form-check-label" for="specials">Specials</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="sharesnames" name="includeOptions" value="1">
                <label class="form-check-label" for="sharesnames">Shares names</label>
            </div>

            <span></span>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="disRoomSharer" name="includeOptions" value="1" checked>
                <label class="form-check-label" for="disRoomSharer">Display Room Sharer</label>
            </div>
            <div class="form-check" id="vipContainer">
                <input class="form-check-input" type="checkbox" id="viponlycheck" name="viponlycheck">
                <label class="form-check-label" for="viponlycheck">Vip Only</label>
                <select id="vip" name="vip" class="form-control form-control-sm report-dd" style="width: 100px; display: none;">
                    @if (vipList != null)
                    {
                        foreach (var item in vipList)
                        {
                            <option value="@item.Code">@item.Description</option>
                        }
                    }
                </select>
            </div>
            <span></span>
            <span></span>
            <span></span>
        </div>
        <div class="d-flex align-items-center" style="margin-top: 8px; gap: 6px;">
            <label class="fw-bold mb-0">Sort:</label>
            <label class="mb-0">Order:</label>
            <select id="viewBy" name="viewBy" class="form-control form-control-sm report-dd">
                <option value="0">Alphabetical</option>
                <option value="1">Room No</option>
                <option value="2">VIP</option>
                <option value="3">Company Name</option>
                <option value="4">Agent Name</option>
                <option value="5">Source Name</option>
                <option value="6">Group Name</option>
            </select>
        </div>
    </div>
</div>

<div class="mui-card">
    @*     <div style="font-size: 20px;" class="mt-1" id="reportTitle"></div> *@
    <div id="gridWrapper" class="mt-2" style="max-height: 500px;">
        <div class="gridContainer mt-2" id="gridContainer"></div>
    </div>
</div>
<div id="loadingSpinner" style="display:none; position:fixed; top:50%; left:50%; transform:translate(-50%, -50%); z-index:1000;">
    <i class="fa-solid fa-spinner fa-spin"></i>
</div>
<script>
 

    $(document).ready(function () {
    

         $('#viponlycheck').on('change', function () {
            if ($(this).is(':checked')) {
                $('#vip').show();
            } else {
                $('#vip').hide();
                $('#vip').val(''); 
            }
        });

         document.getElementById("reportTitle").innerText = '@ViewBag.ReportTitle';
         window.initDateInputs();


    });
 
    $(document).off("click", "#btnPrint").on("click", "#btnPrint", function () {
        $("#loadingSpinner").show();
        $.ajax({
            url: '/Report/DepartureReportsData',
            type: 'GET',
            data: {
                    fromDate: $("#fromDate").val(),
                    toDate: $("#toDate").val(),
                    roomClass: ($("#roomClass").val() || ""),
                    roomtype: ($("#roomtype").val() || ""),
                    paymethod: ($("#paymethod").val() || ""),
                    rateCode: ($("#rateCode").val() || ""),
                    block: ($("#block").val() || ""),     
                    zone: ($("#zone").val() || ""),           
                    vip: $("#vip").val(),
                    viponlycheck: $("#viponlycheck").is(":checked") ? "1" : "",
                    sortOrder: $("#viewBy").val(),
                    lateCheckOut: $("#latecheckoutonly").is(":checked") ? "1" : "",
                    earlyDep: $("#earlydepartureonly").is(":checked") ? "1" : "",
                    agents: $("#travelagents").is(":checked") ? "1" : "",
                    company: $("#company").is(":checked") ? "1" : "",
                    source: $("#source").is(":checked") ? "1" : "",
                    individuals: $("#individuals").is(":checked") ? "1" : "",
                    group: $("#group").is(":checked") ? "1" : "",
                    pseudo: $("#pseudo").is(":checked") ? "111" : "",
                    dueout: $("#dueout").is(":checked") ? "111" : "",
                    checkout: $("#checkout").is(":checked") ? "111" : "",
                    disRoomSharer: $("#disRoomSharer").is(":checked") ? "1" : "",
                    specials: $("#specials").is(":checked") ? "1" : "",


            },
            traditional: true,
              crossDomain: false,
                headers: { "X-CSRF-TOKEN-HEADERNAME": jQuery("input[name='__RequestVerificationToken']").val() },
            success: function (result) {
                // $("#reportViewerContainer").html(result);
                // $("#loadingSpinner").hide();
                     console.log(result);
              const processed = prepareDepartureReportsData(result);
    initializDepartureReportsGrid(processed);
                    $("#loadingSpinner").hide();
            },
            error: function () {
                alert("Không thể tải báo cáo.");
                $("#loadingSpinner").hide();
            }
        });
    });


        function prepareDepartureReportsData(data) {
        const groupedData = {};
        const finalData = [];

        // Gom nhóm theo arrivalDate
        data.forEach(item => {
            const key = item.departureDate || "";
            if (!groupedData[key]) groupedData[key] = [];
            groupedData[key].push(item);
        });

        // Sắp xếp key theo thứ tự ngày tăng dần
        const sortedKeys = Object.keys(groupedData).sort((a, b) => {
            // Chuyển string về Date để so sánh
            const dateA = new Date(a);
            const dateB = new Date(b);
            return dateA - dateB;
        });

        // Duyệt theo key đã sắp xếp
        sortedKeys.forEach(departureDate => {
            const records = groupedData[departureDate];
            const formattedDate = new Date(departureDate).toLocaleDateString('vi-VN');
            // Thêm dòng tiêu đề nhóm
             finalData.push({
                roomNo: `Departure`, 
                 name: formattedDate,
                isTitle: true,
                cssClass: "custom"
            });
            // Thêm các dòng chi tiết
            finalData.push(...records);

            const totalRow = {
                vIP: "Sub total",  // Đặt tên hiển thị

        noOfAdult: sum(records, 'noOfAdult'),
        noOfChild: sum(records, 'noOfChild'),
        noOfChild1: sum(records, 'noOfChild1'),
        noOfChild2: sum(records, 'noOfChild2'),
        prs: sum(records, 'prs'),
             noOfRoom: sum(records, 'noOfRoom'),
               cssClass: "custom",
        isTotal: true // Cờ dòng tổng
            };

            finalData.push(totalRow);
        });

        return finalData;
    }
             function sum(arr, field) {
        return arr.reduce((total, item) => {
            const value = parseFloat(item[field]);
            return total + (isNaN(value) ? 0 : value);
        }, 0);
    }




    function initializDepartureReportsGrid(data) {
        const columnWidth = 180;
        $("#gridContainer").dxDataGrid({
    dataSource: data,         height: 500, allowColumnResizing: true,
            columns: [
               { dataField: "roomNo", caption: "Room No", width: columnWidth-50},
            { dataField: "name", caption: "Name", width: columnWidth},
             { dataField: "reservationHolder", caption: "Resv.Holder", width: columnWidth  },

            { dataField: "vIP", caption: "VIP", width: columnWidth-80 },

                               { dataField: "arrivalDate", caption: "Arr.Date", width: columnWidth-60,  dataType: "date", format: "dd/MM/yyyy"},

            { dataField: "departureDate", caption: "Dep.Date",width: columnWidth-60,  dataType: "date", format: "dd/MM/yyyy"},
      
            { dataField: "noOfAdult", caption: "A.",width: columnWidth-80 ,dataType: "number", format: "#,##0" },
            { dataField: "noOfChild", caption: "C.", width: columnWidth-80 ,dataType: "number", format: "#,##0" },
              { dataField: "noOfChild1", caption: "C1.", width: columnWidth-80 ,dataType: "number", format: "#,##0" },
                { dataField: "noOfChild2", caption: "C2.", width:columnWidth-80  ,dataType: "number", format: "#,##0" },
                                { dataField: "prs", caption: "Prs.", width:columnWidth-80  ,dataType: "number", format: "#,##0" },
                       { dataField: "noOfRoom", caption: "Rms.", width:columnWidth-80 ,dataType: "number", format: "#,##0" },
                           { dataField: "noOfNight", caption: "Nst.", width:columnWidth-80 ,dataType: "number", format: "#,##0" },
                           { dataField: "roomType", caption: "Ro.Type", width:columnWidth-70 },


               { dataField: "rateCode", caption: "Rate Code", width:columnWidth-70 },
                   { dataField: "status", caption: "Status", width: columnWidth-70},
                                  { dataField: "etd", caption: "DEP.Time", width: columnWidth-70 },
            { dataField: "confirmationNo", caption: "Conf.No", width: columnWidth  },
            { dataField: "balance", caption: "Balance",  width:columnWidth-70,dataType: "number", format: "#,##0" },

            ],
            paging: { pageSize: 25 },
      scrolling:  {
         
        useNative: true,
       showScrollbar: "always"
    },
            pager: {
                visible: true,
                allowedPageSizes: [25, 50, 'all'],
                showPageSizeSelector: true,
                showInfo: true,
                showNavigationButtons: true,
            },
            selection: { mode: "multiple", showCheckBoxesMode: "none" },

                filterRow: {
         visible: true,
        applyFilter: "auto"
    },
    headerFilter: {
        visible: true
    },
            showBorders: true,
                            onRowPrepared: function (e) {
        if (e.rowType === "data" && e.data?.cssClass) {
            e.rowElement.addClass(e.data.cssClass);
        }
    }

        });
    }




    $("#btnExportExcel").click(function () {
               const grid = $("#gridContainer").dxDataGrid("instance"); var selectedReport2 = '@ViewBag.ReportTitle';
        var selectedReport = '@ViewBag.ReportTitle';
        if (!selectedReport) {
            alert("Vui lòng chọn báo cáo trước khi xuất Excel.");
            return;
        }

                     const workbook = new ExcelJS.Workbook();const companyName = localStorage.getItem("CompanyName") || "Tên công ty chưa xác định";
        const worksheet = workbook.addWorksheet("Sheet 1");

        // === Tạo header công ty (dòng 1) ===
       worksheet.addRow([companyName]);
        worksheet.mergeCells('A1:E1');
        worksheet.getRow(1).font = { bold: true };
        worksheet.getRow(1).alignment = { vertical: 'middle', horizontal: 'left' };

        // === Dòng 2: Thời gian xuất (phải) ===
        const now = new Date();
        const exportDate = now.toLocaleString("vi-VN");
        worksheet.addRow(['', '', '', '', ' ' + exportDate]);
        worksheet.mergeCells('E2:H2');
        worksheet.getRow(2).alignment = { vertical: 'middle', horizontal: 'right' };

        // === Dòng 3–4: Trống
        worksheet.addRow([]);
        worksheet.addRow([]);

        // === Dòng 5: Tên báo cáo ở giữa ===
        const reportRow = worksheet.addRow(['', '', selectedReport]);
        worksheet.mergeCells('C5:F5');
        reportRow.font = { bold: true, size: 14 };
        reportRow.alignment = { vertical: 'middle', horizontal: 'center' };

        // === Dòng 6: Trống trước khi xuất dữ liệu
        worksheet.addRow([]);

        // === Export dữ liệu từ DevExtreme (bắt đầu từ dòng 7)
        DevExpress.excelExporter.exportDataGrid({
            component: grid,
            worksheet: worksheet,
            autoFilterEnabled: true,
            topLeftCell: { row: 7, column: 1 } // dữ liệu bắt đầu từ dòng 7
        }).then(function () {
            // Footer
            const lastRow = worksheet.lastRow.number + 2;
         
            worksheet.mergeCells(`A${lastRow}:F${lastRow}`);
            worksheet.getCell(`A${lastRow}`).alignment = { horizontal: 'center' };
            worksheet.getCell(`A${lastRow}`).font = { italic: true };

            // Ghi file
            let fileName = selectedReport + ".xlsx";
            workbook.xlsx.writeBuffer().then(function (buffer) {
                saveAs(new Blob([buffer], { type: "application/octet-stream" }), fileName);
            });
        });
    });

    // Nút xuất PDF
          $("#btnExportPdf").click(function () {
        const grid = $("#gridContainer").dxDataGrid("instance");

        // Lấy đối tượng jsPDF từ window
        const { jsPDF } = window.jspdf;
        const doc = new jsPDF({ orientation: "landscape", unit: "pt", format: "A4" });

        const selectedReport = '@ViewBag.ReportTitle';
        const companyName = localStorage.getItem("CompanyName") || "Tên công ty chưa xác định";

        grid.getDataSource().load().then(data => {
            const columns = grid.getVisibleColumns();

            const head = [columns.map(col => col.caption)];
            const body = data.map(row =>
                columns.map(col =>
                    col.calculateCellValue ? col.calculateCellValue(row) : row[col.dataField]
                )
            );

            doc.setFontSize(14);
            doc.setFont("Helvetica", "bold");
            doc.text(companyName, doc.internal.pageSize.getWidth() / 2, 40, { align: "center" });

            doc.setFontSize(12);
            doc.setFont("Helvetica", "normal");
            doc.text(selectedReport, doc.internal.pageSize.getWidth() / 2, 60, { align: "center" });

            // AutoTable
            doc.autoTable({
                startY: 80,
                head: head,
                body: body,
                 styles: { fontSize: 9, cellPadding: 4 , lineWidth: 0.5, lineColor: [0, 0, 0]    },
                headStyles: { fillColor: [41, 128, 185], textColor: 255, fontStyle: 'bold' },
                alternateRowStyles: { fillColor: [240, 240, 240] },
                margin: { left: 20, right: 20 }
            });

            doc.save(selectedReport + ".pdf");
        });
    });
</script>
