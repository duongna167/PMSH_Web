@{
    ViewBag.Title = ViewBag.ReportHeader;
}
<style>
    .gridContainer { margin: 0px 8px; }
    .sticky-header label, .sticky-header .form-control-sm { font-size: 14px; line-height: 1.2; }
    .sticky-header .form-control-sm { padding: 2px 8px; height: 28px; }
    .sticky-header label { margin-bottom: 0; white-space: nowrap; }
    .nrp-grid {
        display: grid;
        grid-template-columns: max-content max-content 160px max-content 160px;
        column-gap: 6px;
        row-gap: 8px;
        align-items: center;
        width: max-content;
        max-width: 100%;
    }
    .nrp-grid > label { margin: 0; white-space: nowrap; }
    .nrp-grid .pair-gap { margin-left: 10px; }
    .nrp-grid select, .nrp-grid [data-date-input] { width: 160px; min-width: 128px; max-width: 220px; }
    #gridContainer .dx-datagrid-rowsview .dx-selection { background-color: #e8e8e8 !important; color: inherit !important; }
    #gridContainer .dx-datagrid-rowsview .dx-selection * { color: inherit !important; }
    #gridContainer .rc-share-room { background: #c8c8c8 !important; }
</style>
<div class="text-center" id="reportTitle" style="font-size: 20px"></div>
<div class="sticky-header bg-white p-2 shadow-sm z-3">
    <div>
        <button id="btnPrint" class="mui-button mui-button-new">View</button>
        <button id="btnResv" class="mui-button mui-button-new" type="button">Resv</button>
        <button id="btnExportExcel" class="mui-button mui-button-new" type="button">Excel</button>
        <button id="btnExportPdf" class="mui-button mui-button-new" type="button">PDF</button>
    </div>
    <div class="mb-1" style="border: 1px solid #ced4da; border-radius: 6px; padding: 8px;">
        <div class="nrp-grid">
            <label class="fw-bold">Date Range:</label>
            <label>From Date:</label>
            <div data-date-input business-date data-format="DD/MM/YYYY" data-name="fromDate">
                <input type="text" class="date-ui form-control form-control-sm" placeholder="dd/mm/yyyy" autocomplete="off" />
            </div>
            <label class="pair-gap">To Date:</label>
            <div data-date-input business-date data-format="DD/MM/YYYY" data-name="toDate">
                <input type="text" class="date-ui form-control form-control-sm" placeholder="dd/mm/yyyy" autocomplete="off" />
            </div>
            <label class="fw-bold">Filter</label>
            <label>View by:</label>
            <select id="rcViewBy" class="form-control form-control-sm">
                <option value="0">Arrival Date</option>
                <option value="1" selected>Departure Date</option>
                <option value="2">Stay</option>
            </select>
            <label class="pair-gap">Status:</label>
            <select id="rcStatus" class="form-control form-control-sm">
                <option value="0" selected>All</option>
                <option value="1">Reservation</option>
                <option value="2">In-House</option>
                <option value="3">Checked-out</option>
            </select>
        </div>
    </div>
</div>
<div class="mui-card">
    <div id="gridWrapper" class="mt-2" style="max-height: 500px;">
        <div class="gridContainer mt-2" id="gridContainer"></div>
    </div>
</div>
<div id="loadingSpinner" style="display:none; position:fixed; top:50%; left:50%; transform:translate(-50%, -50%); z-index:1000;">
    <i class="fa-solid fa-spinner fa-spin"></i>
</div>
<script>
    (function () {
        var selectedId = 0;
        function pick(row, names) {
            for (var i = 0; i < names.length; i++) {
                if (row[names[i]] !== undefined && row[names[i]] !== null && row[names[i]] !== "") return row[names[i]];
            }
            return "";
        }
        function isMainGuest(v) {
            return v === true || v === "true" || v === "True" || v === 1 || v === "1";
        }
        function bindGrid(data) {
            selectedId = 0;
            var rows = (Array.isArray(data) ? data : []).map(function (r) {
                var main = isMainGuest(pick(r, ["MainGuest", "mainGuest"]));
                return {
                    confirmationNo: pick(r, ["ConfirmationNo", "confirmationNo"]),
                    roomNo: pick(r, ["RoomNo", "roomNo"]),
                    rm: pick(r, ["Rm", "RM", "RoomType", "roomType"]),
                    m: main ? "X" : "",
                    mainGuest: main,
                    guestName: pick(r, ["GuestName", "guestName"]),
                    adult: pick(r, ["NoOfAdult", "noOfAdult"]),
                    child: pick(r, ["NoOfChild", "noOfChild"]),
                    child1: pick(r, ["NoOfChild1", "noOfChild1"]),
                    child2: pick(r, ["NoOfChild2", "noOfChild2"]),
                    arrival: pick(r, ["ArrivalDate", "arrivalDate"]),
                    departure: pick(r, ["DepartureDate", "departureDate"]),
                    comments: pick(r, ["Comments", "comments", "Comment"]),
                    id: pick(r, ["ID", "id"])
                };
            });
            $("#gridContainer").dxDataGrid({
                dataSource: rows, height: 500, allowColumnResizing: true, wordWrapEnabled: true,
                columns: [
                    { dataField: "confirmationNo", caption: "Conf.", width: 90 },
                    { dataField: "roomNo", caption: "Ro.No", width: 80 },
                    { dataField: "rm", caption: "Rm", width: 70 },
                    { dataField: "m", caption: "M", width: 40 },
                    { dataField: "guestName", caption: "Guest Name", minWidth: 160 },
                    { dataField: "adult", caption: "A", width: 45 },
                    { dataField: "child", caption: "C", width: 45 },
                    { dataField: "child1", caption: "C1", width: 45 },
                    { dataField: "child2", caption: "C2", width: 45 },
                    { dataField: "arrival", caption: "Arr.", dataType: "date", format: "dd/MM/yyyy", width: 100 },
                    { dataField: "departure", caption: "Dep.", dataType: "date", format: "dd/MM/yyyy", width: 100 },
                    { dataField: "comments", caption: "Comments", minWidth: 280 },
                    { dataField: "id", visible: false },
                    { dataField: "mainGuest", visible: false }
                ],
                paging: { pageSize: 25 },
                scrolling: { useNative: true, showScrollbar: "always" },
                pager: { visible: true, allowedPageSizes: [25, 50, "all"], showPageSizeSelector: true, showInfo: true, showNavigationButtons: true },
                filterRow: { visible: true, applyFilter: "auto" },
                headerFilter: { visible: true },
                showBorders: true,
                selection: { mode: "single" },
                onCellPrepared: function (e) {
                    if (e.rowType === "data" && e.column.dataField === "roomNo" && e.data && !e.data.mainGuest) {
                        e.cellElement.addClass("rc-share-room");
                    }
                },
                onRowClick: function (e) { selectedId = parseInt(e.data && e.data.id, 10) || 0; },
                onRowDblClick: function (e) {
                    selectedId = parseInt(e.data && e.data.id, 10) || 0;
                    openResv();
                }
            });
        }
        function loadData() {
            $("#loadingSpinner").show();
            $.ajax({
                url: "/Report/ReservationCommentsData", type: "GET",
                data: {
                    fromDate: $("#fromDate").val(),
                    toDate: $("#toDate").val(),
                    status: $("#rcStatus").val(),
                    viewBy: $("#rcViewBy").val()
                },
                success: function (result) {
                    if (typeof result === "string") { alert(result); $("#loadingSpinner").hide(); return; }
                    bindGrid(result);
                    $("#loadingSpinner").hide();
                },
                error: function (xhr) {
                    var msg = xhr.status === 403 ? "Bạn không có quyền xem báo cáo này." : "Không thể tải báo cáo.";
                    alert(msg);
                    $("#loadingSpinner").hide();
                }
            });
        }
        function openResv() {
            if (!selectedId) {
                if (window.showToast) showToast("Warning", "Please select a row again to edit.", false);
                else alert("Please select a row again to edit.");
                return;
            }
            var modal = $("#newReservationModal");
            var body = modal.find("#newReservationModalBody");
            if (!body.length) body = modal.find(".modal-body");
            body.html('<div class="text-center py-5"><div class="spinner-border text-primary" role="status"></div><p class="mt-3">Loading reservation...</p></div>');
            modal.modal("show");
            $.ajax({
                url: "/Reservation/EncryptId", type: "POST", data: { id: selectedId },
                success: function (response) {
                    if (!response || !response.success) { alert("Failed to encrypt ID."); return; }
                    $.ajax({
                        url: "/Reservation/NewReservation", type: "GET",
                        data: { key: response.encryptedId }, cache: false,
                        success: function (html) {
                            body.html(html);
                            if (typeof window.focusNewReservationFirstField === "function") window.focusNewReservationFirstField();
                        },
                        error: function () {
                            body.html('<div class="alert alert-danger m-4"><strong>Error</strong> Unable to load reservation details.</div>');
                        }
                    });
                },
                error: function () { alert("Encryption API request failed."); }
            });
        }
        $(document).ready(function () {
            document.getElementById("reportTitle").innerText = '@ViewBag.ReportTitle';
            if (typeof window.initDateInputs === "function") window.initDateInputs();
        });
        $(document).off("click", "#btnPrint").on("click", "#btnPrint", loadData);
        $(document).off("click", "#btnResv").on("click", "#btnResv", openResv);
        $(document).off("click", "#btnExportExcel").on("click", "#btnExportExcel", function () {
            const grid = $("#gridContainer").dxDataGrid("instance"); if (!grid) return;
            const workbook = new ExcelJS.Workbook(); const worksheet = workbook.addWorksheet("Report");
            const selectedReport = '@ViewBag.ReportTitle';
            worksheet.addRow([localStorage.getItem("CompanyName") || ""]);
            DevExpress.excelExporter.exportDataGrid({ component: grid, worksheet: worksheet, autoFilterEnabled: true, topLeftCell: { row: 3, column: 1 } })
                .then(function () { workbook.xlsx.writeBuffer().then(function (buffer) { saveAs(new Blob([buffer], { type: "application/octet-stream" }), selectedReport + ".xlsx"); }); });
        });
        $(document).off("click", "#btnExportPdf").on("click", "#btnExportPdf", function () {
            const grid = $("#gridContainer").dxDataGrid("instance"); if (!grid) return;
            const { jsPDF } = window.jspdf; const doc = new jsPDF({ orientation: "landscape", unit: "pt", format: "A4" });
            const selectedReport = '@ViewBag.ReportTitle';
            grid.getDataSource().load().then(function (data) {
                const columns = grid.getVisibleColumns().filter(c => c.dataField);
                doc.text(selectedReport, doc.internal.pageSize.getWidth() / 2, 40, { align: "center" });
                doc.autoTable({ startY: 56, head: [columns.map(c => c.caption)], body: data.map(row => columns.map(c => row[c.dataField] ?? "")), styles: { fontSize: 8 } });
                doc.save(selectedReport + ".pdf");
            });
        });
    })();
</script>
