@using DevExpress.XtraReports.UI
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    ViewBag.Title = ViewBag.ReportHeader;
    var rtList = ViewBag.RoomClassList;
    var statuses = new[] { "Reserved", "Checked In", "Checked Out", "Cancel Rsv", "Wait list", "Due In", "Due Out", "No Show", "Day Use" };
}

<style>
    
    

    .bold {
        font-weight: bold !important;
    }

    .rrc-status-field {
        flex: 0 0 260px;
        width: 260px;
        min-width: 220px;
        max-width: 280px;
        margin-left: 8px;
        overflow: visible;
        position: relative;
        z-index: 5;
    }

    .rrc-status-field .ts-wrapper {
        overflow: visible !important;
        width: 100% !important;
    }

    .rrc-status-field .ts-control {
        flex-wrap: nowrap !important;
        overflow: hidden !important;
    }

    .rrc-status-field .ts-control .item {
        flex: 1 1 0 !important;
        min-width: 0 !important;
        max-width: none !important;
        width: auto !important;
        padding: 0 2px 0 4px !important;
        margin-right: 2px !important;
    }

    .rrc-status-field .ts-control .item > div,
    .rrc-status-field .ts-control .item .ts-item-text,
    .rrc-status-field .ts-control .item > span {
        min-width: 0 !important;
        max-width: 100% !important;
        overflow: hidden !important;
        text-overflow: ellipsis !important;
        white-space: nowrap !important;
        display: block !important;
    }

    .rrc-status-field .ts-control .item .remove {
        opacity: 1 !important;
        visibility: visible !important;
        margin-left: 2px !important;
        flex-shrink: 0 !important;
    }

    .rrc-status-field .ts-wrapper.has-items .ts-control input {
        flex: 0 0 8px !important;
        width: 8px !important;
        min-width: 8px !important;
        max-width: 8px !important;
    }

    body > .ts-dropdown {
        position: fixed !important;
        min-width: 0 !important;
        width: var(--rrc-dd-w, 280px) !important;
        max-width: var(--rrc-dd-w, 280px) !important;
        left: var(--rrc-dd-x, 0px) !important;
        top: var(--rrc-dd-y, 0px) !important;
        right: auto !important;
        z-index: 5000 !important;
    }

    .rrc-check-grid {
        display: grid;
        grid-template-columns: max-content max-content max-content max-content max-content;
        column-gap: 16px;
        row-gap: 8px;
        align-items: center;
        width: 100%;
    }

    .rrc-check-grid > .form-check {
        margin: 0 !important;
    }

 
</style>
<div class="text-center" id="reportTitle" style="font-size: 20px"></div>
<div class="sticky-header bg-white p-2 shadow-sm z-3">
    <div class="d-flex flex-column mb-1" style="border: 1px solid #ced4da; border-radius: 6px; padding: 8px; gap: 8px;">

        <div class="d-flex flex-wrap align-items-center" style="gap: 8px 16px;">
            <div class="d-flex align-items-center">
                <label class="fw-bold mb-0">Date:</label>
                <label class="mb-0">Stay Date:</label>
                <div data-date-input business-date data-format="DD/MM/YYYY" data-name="date">
                    <input type="text" class="date-ui form-control form-control-sm"
                           placeholder="dd/mm/yyyy" autocomplete="off" />
                </div>
            </div>
            <div class="d-flex align-items-center">
                <label class="fw-bold mb-0">Filter:</label>
                <label for="reservationStatusBox" class="mb-0">Reservation Status:</label>
                <div class="rrc-status-field">
                    <select id="reservationStatusBox" class="tomselect-custom" data-report-keep-tomselect multiple>
                        @for (var index = 0; index < statuses.Length; index++)
                        {
                            <option value="@index">@statuses[index]</option>
                        }
                    </select>
                </div>
            </div>
        </div>

        <div class="rrc-check-grid">
            <label class="fw-bold mb-0">Include:</label>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="ind" checked>
                <label class="form-check-label" for="ind">Individuals</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="pseudo">
                <label class="form-check-label" for="pseudo">Pseudo Rooms</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="variance">
                <label class="form-check-label" for="variance">With a Variance Only</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="fixRate">
                <label class="form-check-label" for="fixRate">Fixed Rate Only</label>
            </div>

            <label class="fw-bold mb-0">Display:</label>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="package" checked>
                <label class="form-check-label" for="package">Packages</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="fixCharge">
                <label class="form-check-label" for="fixCharge">Fixed Charges</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="dcReason" checked>
                <label class="form-check-label" for="dcReason">Discount Reasons</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="alerts">
                <label class="form-check-label" for="alerts">Alerts</label>
            </div>
        </div>
        <div class="d-flex align-items-center">
            <label class="fw-bold mb-0">Sort:</label>
            <label class="mb-0">Order:</label>
            <select id="sort" class="form-control form-control-sm report-dd sort-select">
                <option value="Room No.">Room No.</option>
                <option value="Name">Name</option>
            </select>
        </div>
    </div>



<div class="">
    <button  id="btnPrint" class="mui-button mui-button-new">View</button>
    <button  id="btnExportExcel" class="mui-button mui-button-new" type="button">  Excel</button>
    <button  id="btnExportPdf" class="mui-button mui-button-new" type="button"> PDF</button>
</div>
</div>

<div class="mui-card">
    <div id="gridWrapper" class="mt-2" style="max-height: 500px;">
        <div class="gridContainer mt-2" id="gridContainer"></div>
    </div>
</div>
<div id="loadingSpinner" style="display:none; position:fixed; top:50%; left:50%; transform:translate(-50%, -50%); z-index:1000;">
    <i class="fa-solid fa-spinner fa-spin"></i>
</div>
<script>
 

       $(document).ready(function () {        
        const today = new Date();
        const formattedToday = formatDate(today);
        const firstDayOfMonth = new Date(today.getFullYear(), today.getMonth(), 1);
        window.initDateInputs();
        document.getElementById("reportTitle").innerText = '@ViewBag.ReportTitle';
        var statusEl = document.getElementById("reservationStatusBox");
        if (statusEl && statusEl.tomselect) {
            try { statusEl.tomselect.destroy(); } catch (e) { }
        }
        initTomSelect("#reservationStatusBox", {
            placeholder: "Select...",
            dropdownParent: "body",
            hidePlaceholder: false
        });
        var ts = statusEl && statusEl.tomselect;
        if (ts) {
            ts.clear(true);
            ts.on("dropdown_open", function () {
                var box = ts.control.getBoundingClientRect();
                var root = document.documentElement;
                root.style.setProperty("--rrc-dd-w", Math.round(box.width) + "px");
                root.style.setProperty("--rrc-dd-x", Math.round(box.left) + "px");
                root.style.setProperty("--rrc-dd-y", Math.round(box.bottom + 1) + "px");
            });
        }
    });
    $(document).off("click", "#btnPrint").on("click", "#btnPrint", function () {
        const raw = $("#reservationStatusBox").val();
        const status = Array.isArray(raw) && raw.length
            ? raw.join(",")
            : "0,1,2,3,4,5,6,7,8";
        $("#loadingSpinner").show();


        $.ajax({
            url: '/Report/ReservationRateCheck',
            type: 'GET',
            data: {
                date: $('#date').val(),
                status: status,
                ind: $('#ind').is(":checked") ? 1 : 0,
                pseudo: $('#pseudo').is(":checked") ? 1 : 0,
                variance: $('#variance').is(":checked") ? 1 : 0,
                fixRate: $('#fixRate').is(":checked") ? 1 : 0,
                package: $('#package').is(":checked") ? 1 : 0,
                fixCharge: $('#fixCharge').is(":checked") ? 1 : 0,
                dcReason: $('#dcReason').is(":checked") ? 1 : 0,
                alerts: $('#alerts').is(":checked") ? 1 : 0,
                sort: $('#sort').val(),
                showFixCharge: $('#fixCharge').is(":checked") ? 1 : 0,
                showAlerts: $('#alerts').is(":checked") ? 1 : 0
            },
            traditional: true,
              crossDomain: false,
                headers: { "X-CSRF-TOKEN-HEADERNAME": jQuery("input[name='__RequestVerificationToken']").val() },
            success: function (result) {
                // $("#reportViewerContainer").html(result);
                // $("#loadingSpinner").hide();
                     console.log(result);
                    initializeNoShowReportDataGrid(result);

                    $("#loadingSpinner").hide();
            },
            error: function () {
                alert("Không thể tải báo cáo.");
                $("#loadingSpinner").hide();
            }
        });
    });


    function initializeNoShowReportDataGrid(data) {
        
        $("#gridContainer").dxDataGrid({
    dataSource: data,         height: 500, allowColumnResizing: true,
            columns: [
                         
                { dataField: "confirmationNo", caption: "Conf. No.", width: 110 },
                { dataField: "name", caption: "Name", width: 200},
                { dataField: "arrival", caption: "Arrival", width: 110, dataType: "date", format: "yyyy-MM-dd" },
                { dataField: "departure", caption: "Departure", width: 110, dataType: "date", format: "yyyy-MM-dd" },
                { dataField: "nts", caption: "Nts.", dataType: "number", width: 90 },
                { dataField: "adl", caption: "Adl.", dataType: "number", width: 90 },
                { dataField: "chl", caption: "Chl.", dataType: "number", width: 90 },
                { dataField: "roomType", caption: "Room Type", width: 120 },
                { dataField: "rateCode", caption: "Rate Code", width: 120 },
                { dataField: "rateCodeAmt", caption: "Rate Code Amt.", width: 130, dataType: "number", format: "#,##0.00" },
                { dataField: "rateAmt", caption: "Rate Amt.", width: 130, dataType: "number", format: "#,##0.00" },
                { dataField: "variance", caption: "Variance", width: 130 , dataType: "number", format: "#,##0.00"  },
                { dataField: "payMth", caption: "Pay Mth.", width: 130 },
                { dataField: "resvStatus", caption: "Resv. Status", width: 130 },
                { dataField: "fixedRate", caption: "Fixed Rate", width: 120 },
                { dataField: "roomNo", caption: "Room No.", width: 130 },
                { dataField: "holder", caption: "Holder", width: 200,
                        cellTemplate: function (container, options) {
                            container.append($("<div>").text(options.text).css({
                            "white-space": "normal",
                            "word-wrap": "break-word",
                            "line-height": "1.2"
                    }));
                }},                           
                { dataField: "marketCode", caption: "Market Code", width: 130 },
                { dataField: "cur", caption: "Cur.", width: 80 },
                { dataField: "reservationPackages", caption: "Reservation Packages", width: 170 }
            ],

            paging: { pageSize: 25 },
             // scrolling:  {
             //       
             //   useNative: true,
             //   showScrollbar: "always"
             //   },
            pager: {
                visible: true,
                allowedPageSizes: [25, 50, 'all'],
                showPageSizeSelector: true,
                showInfo: true,
                showNavigationButtons: true,
            },
             filterRow: {
                 visible: true,
                 applyFilter: "auto"
              },
               headerFilter: {
                  visible: true
              },
            selection: { mode: "multiple", showCheckBoxesMode: "none" },
            showBorders: true

        });
    }




    $("#btnExportExcel").click(function () {
               const grid = $("#gridContainer").dxDataGrid("instance"); var selectedReport2 = '@ViewBag.ReportTitle';
        var selectedReport = '@ViewBag.ReportTitle';
        if (!selectedReport) {
            alert("Vui lòng chọn báo cáo trước khi xuất Excel.");
            return;
        }

                     const workbook = new ExcelJS.Workbook();const companyName = localStorage.getItem("CompanyName") || "Tên công ty chưa xác định";
        const worksheet = workbook.addWorksheet("Sheet 1");

        // === Tạo header công ty (dòng 1) ===
       worksheet.addRow([companyName]);
        worksheet.mergeCells('A1:E1');
        worksheet.getRow(1).font = { bold: true };
        worksheet.getRow(1).alignment = { vertical: 'middle', horizontal: 'left' };

        // === Dòng 2: Thời gian xuất (phải) ===
        const now = new Date();
        const exportDate = now.toLocaleString("vi-VN");
        worksheet.addRow(['', '', '', '', ' ' + exportDate]);
        worksheet.mergeCells('E2:H2');
        worksheet.getRow(2).alignment = { vertical: 'middle', horizontal: 'right' };

        // === Dòng 3–4: Trống
        worksheet.addRow([]);
        worksheet.addRow([]);

        // === Dòng 5: Tên báo cáo ở giữa ===
        const reportRow = worksheet.addRow(['', '', selectedReport]);
        worksheet.mergeCells('C5:F5');
        reportRow.font = { bold: true, size: 14 };
        reportRow.alignment = { vertical: 'middle', horizontal: 'center' };

        // === Dòng 6: Trống trước khi xuất dữ liệu
        worksheet.addRow([]);

        // === Export dữ liệu từ DevExtreme (bắt đầu từ dòng 7)
        DevExpress.excelExporter.exportDataGrid({
            component: grid,
            worksheet: worksheet,
            autoFilterEnabled: true,
            topLeftCell: { row: 7, column: 1 } // dữ liệu bắt đầu từ dòng 7
        }).then(function () {
            // Footer
            const lastRow = worksheet.lastRow.number + 2;
          
            worksheet.mergeCells(`A${lastRow}:F${lastRow}`);
            worksheet.getCell(`A${lastRow}`).alignment = { horizontal: 'center' };
            worksheet.getCell(`A${lastRow}`).font = { italic: true };

            // Ghi file
            let fileName = selectedReport + ".xlsx";
            workbook.xlsx.writeBuffer().then(function (buffer) {
                saveAs(new Blob([buffer], { type: "application/octet-stream" }), fileName);
            });
        });
    });


    // Nút xuất PDF
          $("#btnExportPdf").click(function () {
        const grid = $("#gridContainer").dxDataGrid("instance");

        // Lấy đối tượng jsPDF từ window
        const { jsPDF } = window.jspdf;
        const doc = new jsPDF({ orientation: "landscape", unit: "pt", format: "A4" });

        const selectedReport = '@ViewBag.ReportTitle';
        const companyName = localStorage.getItem("CompanyName") || "Tên công ty chưa xác định";

        grid.getDataSource().load().then(data => {
            const columns = grid.getVisibleColumns();

            const head = [columns.map(col => col.caption)];
            const body = data.map(row =>
                columns.map(col =>
                    col.calculateCellValue ? col.calculateCellValue(row) : row[col.dataField]
                )
            );

            doc.setFontSize(14);
            doc.setFont("Helvetica", "bold");
            doc.text(companyName, doc.internal.pageSize.getWidth() / 2, 40, { align: "center" });

            doc.setFontSize(12);
            doc.setFont("Helvetica", "normal");
            doc.text(selectedReport, doc.internal.pageSize.getWidth() / 2, 60, { align: "center" });

            // AutoTable
            doc.autoTable({
                startY: 80,
                head: head,
                body: body,
                 styles: { fontSize: 9, cellPadding: 4 , lineWidth: 0.5, lineColor: [0, 0, 0]    },
                headStyles: { fillColor: [41, 128, 185], textColor: 255, fontStyle: 'bold' },
                alternateRowStyles: { fillColor: [240, 240, 240] },
                margin: { left: 20, right: 20 }
            });

            doc.save(selectedReport + ".pdf");
        });
    });
</script>
