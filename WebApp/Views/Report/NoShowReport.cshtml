@using DevExpress.XtraReports.UI
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    ViewBag.Title = ViewBag.ReportHeader;
    var rtList = ViewBag.RoomClassList;
    var zoneList = ViewBag.ZoneList;
}


<style>
    .filter_wrapper {
        /*     background-color: #ececec; */
        /*   margin: 0px 8px 14px 8px; */
        padding: 18px 0px 0px 14px;
        border-radius: 8px;
    }

    .gridContainer {
        margin: 0px 8px;
    }

    .button_wrapper {
        display: flex;
        column-gap: 12px;
        margin: 0px 8px;
    }

        .button_wrapper .fa-solid {
            margin-right: 5px;
        }

    .selected {
        background-color: #4CAF50; /* Màu xanh */
        color: white;
    }
 

    .sticky-header label,
    .sticky-header .form-control-sm {
        font-size: 14px;
        line-height: 1.2;
    }


    .sticky-header .form-control-sm {
        padding:  2px 8px;
        height: 28px;
    }

    .sticky-header label[class*="me-"] {
        margin-right: .5rem !important;
    }

 

    .sticky-header input[type="date"].form-control-sm {
        font-size: 12px !important; /* đúng 12 px */
        height: 28px; /* giữ cùng chiều cao */
    }

    .report-bar {
        position: relative;
        margin-bottom: 1rem; /* = mb-3 của bạn */
    }

        /* Tiêu đề ở giữa, full width để text-center hoạt động */
        .report-bar #reportTitle {
            font-size: 20px;
            margin: 0; /* bỏ margin dưới h4/h5 mặc định */
            text-align: center;
        }

        /* Nhóm nút cố định góc phải, canh theo chiều dọc */
        .report-bar .action-buttons {
            position: absolute;
            left: 0;
            top: 50%;
            transform: translateY(-50%);
        }

    .sticky-header label {
        font-size: 12px !important;
        line-height: 1.2;
    }

    .tomselect-custom {
        width: 500px;
        min-height: 30px; /* hoặc tùy theo chiều cao bạn muốn */
        font-size: 0.65rem;

    }

</style>
 
<div class="text-center" id="reportTitle" style="font-size: 20px">No Show Report</div>
<div class="sticky-header bg-white p-2 shadow-sm z-3">
    <div class="d-flex flex-wrap align-items-center gap-2 mb-1" style="border: 1px solid #ced4da; border-radius: 6px; padding: 8px;">
        <!-- From Date -->
        <div class="d-flex align-items-center me-3">
            <label class="me-2 mb-0">From Date:</label>
            <div data-date-input business-date data-format="DD/MM/YYYY" data-name="fromDate" style="min-width:140px;">
                <input type="text" class="date-ui form-control form-control-sm"
                       placeholder="dd/mm/yyyy" autocomplete="off" />
            </div>
        </div>

        <!-- To Date -->
        <div class="d-flex align-items-center me-3">
            <label class="me-2 mb-0">To Date:</label>
            <div data-date-input business-date data-format="DD/MM/YYYY" data-name="toDate" style="min-width:140px;">
                <input type="text" class="date-ui form-control form-control-sm"
                       placeholder="dd/mm/yyyy" autocomplete="off" />
            </div>
        </div>
        <div class="d-flex align-items-center">
            <label class="me-2 mb-0">Room Class:</label>
            <select id="roomClass" name="roomClass" class="form-control form-control-sm w-auto">
                <option value="0">--All--</option>
                @foreach (var item in rtList)
                {
                    <option value="@item.ID">@item.Code</option>
                }
            </select>

        </div>
        <div class="d-flex align-items-center me-1">
            <label class="me-2 mb-0">Zone:</label>
            <select id="zone" name="zone" class="form-control form-control-sm report-dd">
                        <option value="">--All--</option>
                @foreach (var item in zoneList)
                {
                    <option value="@item.Code">@item.Code</option>
                }
            </select>

        </div>
    </div>
    <div class="">
        <button  id="btnPrint" class="mui-button mui-button-new">View</button>
        <button  id="btnExportExcel" class="mui-button mui-button-new" type="button">  Excel</button>
        <button  id="btnExportPdf" class="mui-button mui-button-new" type="button"> PDF</button>
    </div>
</div>

<div class="mui-card">
@*     <div style="font-size: 20px;" class="mt-1" id="reportTitle"></div> *@
    <div id="gridWrapper" class="mt-2">
        <div class="gridContainer mt-2" id="gridContainer"></div>
    </div>
</div>
<div id="loadingSpinner" style="display:none; position:fixed; top:50%; left:50%; transform:translate(-50%, -50%); z-index:1000;">
    <i class="fa-solid fa-spinner fa-spin"></i>
</div>
<script>
 

    $(document).ready(function () {
         document.getElementById("reportTitle").innerText = '@ViewBag.ReportTitle';
              window.initDateInputs();
       

    });
    function readNoShowDate(name) {
        const text = ($('[data-date-input][data-name="' + name + '"] .date-ui').val() || $("#" + name).val() || "").trim();
        const m = text.match(/^(\d{1,2})\/(\d{1,2})\/(\d{2}|\d{4})$/);
        if (!m) return text;
        let year = parseInt(m[3], 10);
        if (year < 100) year += 2000;
        return year + "-" + String(m[2]).padStart(2, "0") + "-" + String(m[1]).padStart(2, "0");
    }
    $(document).off("click", "#btnPrint").on("click", "#btnPrint", function () {
        $("#loadingSpinner").show();
        $.ajax({
            url: '/Report/NoShowReportData',
            type: 'GET',
            data: {
                fromDate: readNoShowDate("fromDate"),
                toDate: readNoShowDate("toDate"),
                roomClass: $("#roomClass").val() || 0,
                zone: $("#zone").val() || ""
            },
            traditional: true,
            headers: { "X-CSRF-TOKEN-HEADERNAME": jQuery("input[name='__RequestVerificationToken']").val() },
            success: function (result) {
                if (!Array.isArray(result)) {
                    alert((result && result.error) ? result.error : "Không thể tải báo cáo.");
                    $("#loadingSpinner").hide();
                    return;
                }
                initializeNoShowReportDataGrid(result);
                $("#loadingSpinner").hide();
            },
            error: function () {
                alert("Không thể tải báo cáo.");
                $("#loadingSpinner").hide();
            }
        });
    });

    function noShowGridHeight() {
        var el = document.getElementById("gridContainer");
        var top = el ? el.getBoundingClientRect().top : 260;
        return Math.max(480, Math.floor(window.innerHeight - top - 12));
    }
    function initializeNoShowReportDataGrid(data) {
        const w = 180;
        pmshBindDxReportGrid("#gridContainer", {
            dataSource: Array.isArray(data) ? data : [],
            height: noShowGridHeight(),
            allowColumnResizing: true,
            loadPanel: { enabled: false },
            headerFilter: { visible: false },
            columns: [
                { dataField: "confirmationNo", caption: "Conf No", width: w - 80 },
                { dataField: "roomNo", caption: "Room No", width: w - 70 },
                { dataField: "guestName", caption: "Guest Name", width: w + 80 },
                { dataField: "companySource", caption: "Company / Travel Agent / Source", width: w + 120 },
                { dataField: "arrivalDate", caption: "Arrival", width: 100, dataType: "date", format: "dd/MM/yyyy" },
                { dataField: "departureDate", caption: "Dep", width: 100, dataType: "date", format: "dd/MM/yyyy" },
                { dataField: "roomType", caption: "R.Type", width: w - 80 },
                { dataField: "businessBlockCode", caption: "Block Code", width: w - 60 },
                { dataField: "marketCode", caption: "MrkCode", width: w - 70 },
                { dataField: "paymentMethod", caption: "Pay mth", width: w - 80 },
                { dataField: "reservationTypeCode", caption: "Rsv.Type", width: w },
                { dataField: "creditCardNo", caption: "CC no", width: w - 80 },
                { dataField: "rateCode", caption: "Rate Code", width: w - 60 },
                { dataField: "expirationDate", caption: "Exp.Date", width: 100, dataType: "date", format: "dd/MM/yyyy" },
                { dataField: "rateAmount", caption: "Rate Amount", width: w - 50, dataType: "number", format: "#,##0" },
                { dataField: "noOfRoom", caption: "Rms", width: 56, dataType: "number", format: "#,##0" },
                { dataField: "noOfNight", caption: "Nts", width: 56, dataType: "number", format: "#,##0" },
                { dataField: "totalAmount", caption: "Revenue", width: w - 50, dataType: "number", format: "#,##0" },
                { dataField: "depositPaid", caption: "DepositPaid", width: w - 50, dataType: "number", format: "#,##0" }
            ],
            paging: { enabled: false },
            pager: { visible: false },
            selection: { mode: "none" },
            filterRow: { visible: true, applyFilter: "auto" },
            showBorders: true
        });
    }
    $(window).off("resize.noShowReport").on("resize.noShowReport", function () {
        var grid = $("#gridContainer").data("dxDataGrid");
        if (grid) grid.option("height", noShowGridHeight());
    });




    $("#btnExportExcel").click(function () {
               const grid = $("#gridContainer").dxDataGrid("instance"); var selectedReport2 = '@ViewBag.ReportTitle';
        var selectedReport = '@ViewBag.ReportTitle';
        if (!selectedReport) {
            alert("Vui lòng chọn báo cáo trước khi xuất Excel.");
            return;
        }

                     const workbook = new ExcelJS.Workbook();const companyName = localStorage.getItem("CompanyName") || "Tên công ty chưa xác định";
        const worksheet = workbook.addWorksheet("Sheet 1");

        // === Tạo header công ty (dòng 1) ===
       worksheet.addRow([companyName]);
        worksheet.mergeCells('A1:E1');
        worksheet.getRow(1).font = { bold: true };
        worksheet.getRow(1).alignment = { vertical: 'middle', horizontal: 'left' };

        // === Dòng 2: Thời gian xuất (phải) ===
        const now = new Date();
        const exportDate = now.toLocaleString("vi-VN");
        worksheet.addRow(['', '', '', '', ' ' + exportDate]);
        worksheet.mergeCells('E2:H2');
        worksheet.getRow(2).alignment = { vertical: 'middle', horizontal: 'right' };

        // === Dòng 3–4: Trống
        worksheet.addRow([]);
        worksheet.addRow([]);

        // === Dòng 5: Tên báo cáo ở giữa ===
        const reportRow = worksheet.addRow(['', '', selectedReport]);
        worksheet.mergeCells('C5:F5');
        reportRow.font = { bold: true, size: 14 };
        reportRow.alignment = { vertical: 'middle', horizontal: 'center' };

        // === Dòng 6: Trống trước khi xuất dữ liệu
        worksheet.addRow([]);

        // === Export dữ liệu từ DevExtreme (bắt đầu từ dòng 7)
        DevExpress.excelExporter.exportDataGrid({
            component: grid,
            worksheet: worksheet,
            autoFilterEnabled: true,
            topLeftCell: { row: 7, column: 1 } // dữ liệu bắt đầu từ dòng 7
        }).then(function () {
            // Footer
            const lastRow = worksheet.lastRow.number + 2;

            worksheet.mergeCells(`A${lastRow}:F${lastRow}`);
            worksheet.getCell(`A${lastRow}`).alignment = { horizontal: 'center' };
            worksheet.getCell(`A${lastRow}`).font = { italic: true };

            // Ghi file
            let fileName = selectedReport + ".xlsx";
            workbook.xlsx.writeBuffer().then(function (buffer) {
                saveAs(new Blob([buffer], { type: "application/octet-stream" }), fileName);
            });
        });
    });


    // Nút xuất PDF
         $("#btnExportPdf").click(function () {
        const grid = $("#gridContainer").dxDataGrid("instance");

        // Lấy đối tượng jsPDF từ window
        const { jsPDF } = window.jspdf;
        const doc = new jsPDF({ orientation: "landscape", unit: "pt", format: "A4" });

        const selectedReport = '@ViewBag.ReportTitle';
        const companyName = localStorage.getItem("CompanyName") || "Tên công ty chưa xác định";

        grid.getDataSource().load().then(data => {
            const columns = grid.getVisibleColumns();

            const head = [columns.map(col => col.caption)];
            const body = data.map(row =>
                columns.map(col =>
                    col.calculateCellValue ? col.calculateCellValue(row) : row[col.dataField]
                )
            );

            doc.setFontSize(14);
            doc.setFont("Helvetica", "bold");
            doc.text(companyName, doc.internal.pageSize.getWidth() / 2, 40, { align: "center" });

            doc.setFontSize(12);
            doc.setFont("Helvetica", "normal");
            doc.text(selectedReport, doc.internal.pageSize.getWidth() / 2, 60, { align: "center" });

            // AutoTable
            doc.autoTable({
                startY: 80,
                head: head,
                body: body,
                 styles: { fontSize: 9, cellPadding: 4 , lineWidth: 0.5, lineColor: [0, 0, 0]    },
                headStyles: { fillColor: [41, 128, 185], textColor: 255, fontStyle: 'bold' },
                alternateRowStyles: { fillColor: [240, 240, 240] },
                margin: { left: 20, right: 20 }
            });

            doc.save(selectedReport + ".pdf");
        });
    });
</script>
