@* Item Daily Inventory (Room Management): tồn kho Item theo từng ngày (15 ngày), nạp tồn kho theo khoảng ngày.
   Popup theo chuẩn của dự án (ModalManager + mui-button), logic tương ứng màn frmItemDailyInventory / frmItemInventoryLoad của PMS desktop. *@

<style>
    /* Tiêu đề cột ngày gồm 3 dòng: 15-Sept / Tue / CW 38 */
    #idi_grid .dx-header-row > td { white-space: pre-line; text-align: center; font-size: 12px; }
    #idi_grid .dx-data-row > td { text-align: center; }
    #idi_grid .dx-data-row > td:first-child { text-align: left; }
</style>

<div class="modal fade" id="idi_modal" data-bs-backdrop="static" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content modal-full-height">
            <div class="modal-header bg-light py-2">
                <h5 class="modal-title">Item Daily Inventory</h5>
            </div>

            <div class="modal-body d-flex flex-column" style="height: calc(100vh - 120px);">
                <div class="py-2">
                    <button id="idi_btnSearch" class="mui-button mui-button-view">Search</button>
                    <button id="idi_btnLoad" class="mui-button mui-button-new" data-action="rmg_ItemListDailyInv" disabled>Load</button>
                    <button class="mui-button mui-button-close" data-bs-dismiss="modal">Close</button>
                </div>

                <div class="mui-card mb-2 bg-light border-0 d-flex flex-column flex-grow-1 overflow-hidden">
                    <div class="p-2 flex-shrink-0">
                        <div class="row g-2 align-items-center">
                            <div class="col-xl-3 col-lg-4 col-md-6">
                                <div class="d-flex align-items-center gap-2">
                                    <label class="mb-0 fw-semibold text-nowrap">Item Group:</label>
                                    <select id="idi_group" class="form-select form-select-sm flex-grow-1">
                                        <option value="0">--All--</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-xl-5 col-lg-6 col-md-8">
                                <div class="d-flex align-items-center gap-2">
                                    <label class="mb-0 fw-semibold">Date:</label>
                                    <div style="width:140px;" data-date-input data-format="DD/MM/YYYY" business-date data-name="idi_date">
                                        <input type="text" class="date-ui form-control form-control-sm" placeholder="dd/mm/yyyy" autocomplete="off" />
                                    </div>
                                    <button type="button" id="idi_btnPrev" class="mui-button mui-button-new">- 15 days</button>
                                    <button type="button" id="idi_btnNext" class="mui-button mui-button-new">+ 15 days</button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="gridContainer mt-2 d-flex flex-column flex-grow-1 overflow-auto">
                        <div id="idi_grid"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ===== Load: nạp tồn kho cho một Item theo khoảng ngày ===== -->
<div class="modal fade" id="idi_loadModal" data-bs-backdrop="static" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Load Item Inventory</h5>
            </div>

            <div class="modal-body">
                <div class="py-2 d-flex gap-2">
                    <button type="button" id="idi_btnSave" class="mui-button mui-button-save">Save</button>
                    <button type="button" class="mui-button mui-button-close" data-bs-dismiss="modal">Close</button>
                </div>

                <form id="idi_form" novalidate autocomplete="off">
                    <div class="container-fluid px-2">
                        <div class="row mb-3 align-items-center">
                            <label class="col-12 col-md-4 fw-bold">Group</label>
                            <div class="col-12 col-md-8">
                                <select id="idi_loadGroup" class="form-select form-select-sm"></select>
                            </div>
                        </div>
                        <div class="row mb-3 align-items-center">
                            <label class="col-12 col-md-4 fw-bold">Item <span class="text-danger">*</span></label>
                            <div class="col-12 col-md-8">
                                <select id="idi_loadItem" name="item" class="form-select form-select-sm"></select>
                                <div class="invalid-feedback"></div>
                            </div>
                        </div>
                        <div class="row mb-3 align-items-center">
                            <label class="col-12 col-md-4 fw-bold">Begin Date <span class="text-danger">*</span></label>
                            <div class="col-12 col-md-8">
                                <div data-date-input data-format="DD/MM/YYYY" business-date data-name="idi_loadFrom" name="fromDate">
                                    <input type="text" class="date-ui form-control form-control-sm" placeholder="dd/mm/yyyy" autocomplete="off" />
                                </div>
                                <div class="invalid-feedback"></div>
                            </div>
                        </div>
                        <div class="row mb-3 align-items-center">
                            <label class="col-12 col-md-4 fw-bold">End Date <span class="text-danger">*</span></label>
                            <div class="col-12 col-md-8">
                                <div data-date-input data-format="DD/MM/YYYY" business-date data-name="idi_loadTo" name="toDate">
                                    <input type="text" class="date-ui form-control form-control-sm" placeholder="dd/mm/yyyy" autocomplete="off" />
                                </div>
                                <div class="invalid-feedback"></div>
                            </div>
                        </div>
                        <div class="row mb-3 align-items-center">
                            <label class="col-12 col-md-4 fw-bold">Quantity <span class="text-danger">*</span></label>
                            <div class="col-12 col-md-8">
                                <input type="number" id="idi_quantity" name="quantity" class="form-control form-control-sm" min="0" step="1" />
                                <div class="invalid-feedback"></div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    var idi_Module = {
        selectedRowData: null,
        lookups: { groups: [], items: [] },

        // Cột ngày: tên field trả về từ SP theo thứ tự 15 ngày
        dateFields: ["firstDate", "secondDate", "thirthDate", "fourthDate", "fifthDate", "sixthDate", "seventhDate", "eighthDate",
                     "ninthDate", "tenthDate", "eleventhDate", "twelvethDate", "thirtheenDate", "fourtheenDate", "fiftheenDate"],

        init: function () {
            this.initEvents();
            this.initDOMEvents();
        },

        initEvents: function () {
            const self = this;

            window.openModalItemDailyInv = function () {
                if (typeof window.hasFunctionRight === "function") {
                    $("#idi_modal [data-action]").each(function () {
                        if (!window.hasFunctionRight($(this).data("action"))) $(this).hide();
                    });
                }

                self.loadLookups().always(function () { self.reloadGrid(); });

                $("#idi_modal").on("hidden.bs.modal", function () {
                    if ($("#idi_grid").data("dxDataGrid")) $("#idi_grid").dxDataGrid("dispose");
                    $("#idi_grid").empty();
                    self.selectedRowData = null;
                    if (typeof reloadBusinessDate === "function") reloadBusinessDate();
                });

                $("#idi_loadModal").on("hidden.bs.modal", function () {
                    ValidationAdapter.clear("#idi_form");
                    if (typeof reloadBusinessDate === "function") reloadBusinessDate();
                });
            };
        },

        initDOMEvents: function () {
            const self = this;
            $("#idi_btnSearch").on("click", () => self.reloadGrid());
            $("#idi_group").on("change", () => self.reloadGrid());
            $("#idi_btnPrev").on("click", () => self.shiftDate(-15));
            $("#idi_btnNext").on("click", () => self.shiftDate(15));
            $("#idi_btnLoad").on("click", () => self.openLoad());
            $("#idi_btnSave").on("click", () => self.saveLoad());
            $("#idi_loadGroup").on("change", () => self.fillItems());
        },

        // ---------------------------------------------------------------------------------------
        //  Ngày
        // ---------------------------------------------------------------------------------------
        ymd: function (d) {
            return d.getFullYear() + "-" + String(d.getMonth() + 1).padStart(2, "0") + "-" + String(d.getDate()).padStart(2, "0");
        },

        parseYmd: function (s) {
            const p = (s || "").split("T")[0].split("-");
            return new Date(parseInt(p[0], 10), parseInt(p[1], 10) - 1, parseInt(p[2], 10));
        },

        firstDate: function () {
            return this.parseYmd($("#idi_date").val() || window.dateSystem);
        },

        shiftDate: function (days) {
            const d = this.firstDate();
            d.setDate(d.getDate() + days);
            UI.setHiddenDate("idi_date", this.ymd(d));
            this.reloadGrid();
        },

        // Tiêu đề cột: "15-Sept\nTue\nCW 38" (tuần tính theo tuần chứa ngày 1/1, bắt đầu từ Chủ nhật như bản desktop)
        caption: function (d) {
            const months = ["Jan", "Feb", "Mar", "Apr", "May", "June", "July", "Aug", "Sept", "Oct", "Nov", "Dec"];
            const dows = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];
            const jan1 = new Date(d.getFullYear(), 0, 1);
            const dayOfYear = Math.round((new Date(d.getFullYear(), d.getMonth(), d.getDate()) - jan1) / 86400000);
            const cw = Math.floor((dayOfYear + jan1.getDay()) / 7) + 1;
            return d.getDate() + "-" + months[d.getMonth()] + "\n" + dows[d.getDay()] + "\nCW " + cw;
        },

        // ---------------------------------------------------------------------------------------
        //  Dữ liệu tham chiếu
        // ---------------------------------------------------------------------------------------
        loadLookups: function () {
            const self = this;
            return $.ajax({ url: "/RoomManagement/ItemLookups", type: "GET" }).done(function (res) {
                if (!res || res.success === false) {
                    showToast("Error", (res && res.message) || "Unable to load lookups.", false);
                    return;
                }
                self.lookups = res;
                const $g = $("#idi_group").empty().append('<option value="0">--All--</option>');
                const $l = $("#idi_loadGroup").empty();
                (res.groups || []).forEach(function (g) {
                    $g.append($("<option>").val(g.ID).text(g.Code));
                    $l.append($("<option>").val(g.ID).text(g.Code));
                });
            }).fail(function () { showToast("Error", "Unable to load lookups.", false); });
        },

        // ---------------------------------------------------------------------------------------
        //  Lưới
        // ---------------------------------------------------------------------------------------
        reloadGrid: function () {
            const self = this;
            const first = self.firstDate();
            if (isNaN(first)) return;

            const params = { groupId: $("#idi_group").val() || 0 };
            const days = [];
            for (let i = 0; i < 15; i++) {
                const d = new Date(first);
                d.setDate(first.getDate() + i);
                days.push(d);
                params[self.dateFields[i]] = self.ymd(d);
            }

            self.selectedRowData = null;
            $("#idi_btnLoad").prop("disabled", true);

            $.ajax({
                url: "/RoomManagement/GetItemDailyInventory",
                type: "GET",
                loadingGrid: "#idi_grid",
                data: params,
                success: function (data) {
                    if (!Array.isArray(data)) {
                        showToast("Error", typeof data === "string" ? data : "Unable to load data", false);
                        data = [];
                    }
                    self.renderGrid(data, days);
                },
                error: function () { showToast("Error", "Unable to load data", false); }
            });
        },

        renderGrid: function (data, days) {
            const self = this;
            const cols = [
                { dataField: "id", visible: false },
                { dataField: "itemID", visible: false },
                { dataField: "itemName", caption: "Item Name", width: 200, allowSorting: false }
            ];
            self.dateFields.forEach(function (f, i) {
                cols.push({ dataField: f, caption: self.caption(days[i]), width: 56, alignment: "center", allowSorting: false });
            });

            $("#idi_grid").dxDataGrid({
                dataSource: data,
                keyExpr: "id",
                height: "100%",
                width: "100%",
                showBorders: true,
                hoverStateEnabled: true,
                columnAutoWidth: false,
                allowColumnResizing: true,
                selection: { mode: "single" },
                scrolling: { mode: "standard", showScrollbar: "always", useNative: true },
                paging: { enabled: false },
                columns: cols,
                onSelectionChanged: function (e) {
                    self.selectedRowData = e.selectedRowsData[0] || null;
                    $("#idi_btnLoad").prop("disabled", !self.selectedRowData);
                },
                onRowDblClick: function (e) {
                    self.selectedRowData = e.data;
                    self.openLoad();
                }
            });
        },

        // ---------------------------------------------------------------------------------------
        //  Load
        // ---------------------------------------------------------------------------------------
        fillItems: function (selectedId) {
            const gid = parseInt($("#idi_loadGroup").val(), 10) || 0;
            const $i = $("#idi_loadItem").empty();
            (this.lookups.items || []).filter(i => i.ItemGroupID === gid)
                .forEach(i => $i.append($("<option>").val(i.ID).text(i.Name)));
            if (selectedId) $i.val(String(selectedId));
        },

        openLoad: function () {
            const self = this;
            window.initDateInputs();
            if (!self.selectedRowData) {
                showToast("Warning", "Please select an item first!", false);
                return;
            }

            // Nhóm của Item đang chọn
            const item = (self.lookups.items || []).find(i => i.ID === self.selectedRowData.id);
            if (item) $("#idi_loadGroup").val(String(item.ItemGroupID));
            self.fillItems(self.selectedRowData.id);

            ValidationAdapter.clear("#idi_form");
            $("#idi_quantity").val("");

            // Mặc định: từ ngày nghiệp vụ đến ngày kế tiếp
            const bd = self.parseYmd(window.dateSystem);
            const next = new Date(bd);
            next.setDate(bd.getDate() + 1);
            UI.setHiddenDate("idi_loadFrom", self.ymd(bd));
            UI.setHiddenDate("idi_loadTo", self.ymd(next));

            $("#idi_loadModal").modal("show");
        },

        saveLoad: function () {
            const self = this;
            const q = $("#idi_quantity").val();
            const payload = {
                itemID: parseInt($("#idi_loadItem").val(), 10) || 0,
                fromDate: $("#idi_loadFrom").val() || window.dateSystem,
                toDate: $("#idi_loadTo").val() || window.dateSystem,
                quantity: q === "" ? null : parseInt(q, 10)
            };

            $.ajax({
                url: "/RoomManagement/ItemInventoryLoad",
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify(payload),
                headers: { "X-CSRF-TOKEN-HEADERNAME": jQuery("input[name='__RequestVerificationToken']").val() },
                success: function (res) {
                    if (res.success) {
                        showToast("Success", res.message, true);
                        $("#idi_loadModal").modal("hide");
                        self.reloadGrid();
                    } else if (res.errors && res.errors.length) {
                        ValidationAdapter.apply(res.errors, "#idi_form");
                        showToast("Warning", res.errors[0].message, false);
                    } else {
                        showToast("Error", res.message || "Something went wrong.", false);
                    }
                },
                error: function (xhr) {
                    showToast("Error", xhr.status === 403 ? "Access Denied" : "Server error occurred.", false);
                }
            });
        }
    };

    $(document).ready(function () {
        idi_Module.init();
    });
</script>
