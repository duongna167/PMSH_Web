@{
    var listusg = ViewBag.UserGroupList;
    var listjt = ViewBag.JobTitleList;
    var listdp = ViewBag.DepartmentList;
}

<div class="modal fade" id="ousm_modal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-xl modal-4by3 modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content modal-full-height">
            <div class="modal-header">
                <h5 class="modal-title">Users Management</h5>
            </div>

            <div class="modal-body">
                <div class="sticky-header bg-white p-2 shadow-sm z-3">
                    <div class="pb-2">
                        <button id="ousm_btnPrint" class="mui-button mui-button-view">View</button>
                        <button id="ousm_btnNewUsermana" class="mui-button mui-button-new" type="button">New</button>
                        <button id="ousm_btnEditUsermana" class="mui-button mui-button-edit" type="button">Edit</button>
                        <button id="ousm_btnDeleteUsermana" class="mui-button mui-button-delete" type="button">Delete</button>
                        <button class="mui-button mui-button-new" id="ousm_btnClose">Close</button>
                    </div>

                    <div class="d-flex flex-wrap align-items-center gap-2 mb-1 pt-2 filter-panel">
                        <div class="row g-3 align-items-center filter-panel">
                            <div class="container-fluid filter-panel pt-2">
                                <div class="row g-2 align-items-center">

                                    <div class="col-4">
                                        <div class="row align-items-center">
                                            <label class="col-4 col-form-label text-end">Last Name</label>
                                            <div class="col-8">
                                                <input id="ousm_lastName" type="text" class="form-control form-control-sm">
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-4">
                                        <div class="row align-items-center">
                                            <label class="col-4 col-form-label text-end">User Status</label>
                                            <div class="col-8">
                                                <select id="ousm_userStatus" class="form-select form-select-sm">
                                                    <option value="0">Active</option>
                                                    <option value="1">Inactive</option>
                                                    <option value="2">Terminated</option>
                                                    <option value="3">All</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-4">
                                        <div class="row align-items-center">
                                            <label class="col-4 col-form-label text-end">User Group</label>
                                            <div class="col-8">
                                                <select id="ousm_usergroup" name="ousm_usergroup" class="form-select form-select-sm">
                                                    <option value=""></option>
                                                    @foreach (var item in listusg)
                                                    {
                                                        <option value="@item.Code">@item.Name</option>
                                                    }
                                                </select>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-4">
                                        <div class="row align-items-center">
                                            <label class="col-4 col-form-label text-end">First Name</label>
                                            <div class="col-8">
                                                <input type="text" id="ousm_firstName" class="form-control form-control-sm">
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-4">
                                        <div class="row align-items-center">
                                            <label class="col-4 col-form-label text-end">Cashier status</label>
                                            <div class="col-8">
                                                <select id="ousm_cashierStatus" class="form-select form-select-sm">
                                                    <option value="0">Cashier</option>
                                                    <option value="1">None Cashier</option>
                                                    <option value="2" selected>All</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-4">
                                        <div class="row align-items-center">
                                            <label class="col-4 col-form-label text-end">Job Title</label>
                                            <div class="col-8">
                                                <select id="ousm_jobtitle" name="ousm_jobtitle" class="form-select form-select-sm">
                                                    <option value=""></option>
                                                    @foreach (var item in listjt)
                                                    {
                                                        <option value="@item.Code">@item.Name</option>
                                                    }
                                                </select>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-4">
                                        <div class="row align-items-center">
                                            <label class="col-4 col-form-label text-end">Login name</label>
                                            <div class="col-8">
                                                <input type="text" id="ousm_loginName" class="form-control form-control-sm">
                                            </div>
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="mui-card">
                    <div id="ousm_gridContainerUser" class="gridContainer mt-2"></div>
                </div>

                <div id="ousm_loadingSpinner"
                     style="display:none; position:fixed; top:50%; left:50%; transform:translate(-50%, -50%); z-index:1000;">
                    <i class="fa-solid fa-spinner fa-spin"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    #ousm_modal.modal.show,
    #ousm_popupNewGrid.modal.show {
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
    }
    #ousm_modal .modal-dialog,
    #ousm_popupNewGrid .modal-dialog {
        margin: 0 auto !important;
    }
    #ousm_popupNewGrid .form-check-label { margin-left: 3px; }
    #ousm_resetpass .ousm-reset-spin { margin-right: 4px; }
    #ousm_popupNewGrid .modal-dialog {
        display: block !important;
        max-width: 800px !important;
        width: 800px !important;
        height: fit-content !important;
        min-height: 0 !important;
        margin: auto !important;
    }
    #ousm_popupNewGrid .modal-content {
        height: fit-content !important;
        min-height: 0 !important;
        max-height: none !important;
        aspect-ratio: unset !important;
        flex: 0 0 auto !important;
        align-self: center !important;
        display: block !important;
    }
    #ousm_popupNewGrid .modal-body {
        flex: none !important;
        overflow: visible !important;
        height: auto !important;
        min-height: 0 !important;
        padding-bottom: 12px !important;
    }
    #ousm_popupNewGrid .border .row.align-items-center {
        margin-bottom: 0 !important;
        padding-top: 4px !important;
        padding-bottom: 4px !important;
    }
    #ousm_popupNewGrid .modal-body > .container-fluid {
        height: auto !important;
        min-height: 0 !important;
    }
    #ousm_popupNewGrid .ousm-edit-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        grid-template-rows: auto auto;
        gap: 8px;
        align-items: stretch;
    }
    #ousm_popupNewGrid .ousm-edit-grid > .ousm-cell {
        height: 100%;
        min-width: 0;
        box-sizing: border-box;
    }
    #ousm_popupNewGrid .ousm-edit-grid .row.align-items-center {
        display: grid !important;
        grid-template-columns: 136px minmax(0, 1fr);
        gap: 8px;
        flex-wrap: nowrap !important;
        align-items: center;
    }
    #ousm_popupNewGrid .ousm-edit-grid .row.align-items-center:has(> :nth-child(3)) {
        grid-template-columns: 136px minmax(0, 1fr) minmax(0, 1fr);
    }
    #ousm_popupNewGrid .ousm-edit-grid .row.ousm-field-expire {
        grid-template-columns: 136px minmax(0, 1fr) auto !important;
    }
    #ousm_popupNewGrid .ousm-edit-grid .row.align-items-center > [class*="col-"] {
        width: auto !important;
        max-width: none !important;
        flex: none !important;
        padding-left: 0 !important;
        padding-right: 0 !important;
    }
    #ousm_popupNewGrid .form-control,
    #ousm_popupNewGrid .form-select {
        height: 28px !important;
        min-height: 28px !important;
        padding-top: 2px !important;
        padding-bottom: 2px !important;
    }
    #ousm_popupNewGrid .btn {
        padding: 2px 8px !important;
    }
    #ousm_popupNewGrid .row {
        display: flex !important;
        flex-wrap: wrap !important;
    }
    #ousm_popupNewGrid .col-6 {
        flex: 0 0 50% !important;
        max-width: 50% !important;
        width: 50% !important;
    }
    #ousm_popupNewGrid .col-8 {
        flex: 0 0 66.666% !important;
        max-width: 66.666% !important;
        width: 66.666% !important;
    }
    #ousm_popupNewGrid .col-5 {
        flex: 0 0 41.666% !important;
        max-width: 41.666% !important;
        width: 41.666% !important;
    }
    #ousm_popupNewGrid .col-4 {
        flex: 0 0 33.333% !important;
        max-width: 33.333% !important;
        width: 33.333% !important;
    }
    #ousm_popupNewGrid .col-3 {
        flex: 0 0 25% !important;
        max-width: 25% !important;
        width: 25% !important;
    }
    #ousm_popupNewGrid .form-check-inline {
        display: inline-flex !important;
        width: auto !important;
    }
    .ousm-select-menu {
        position: fixed;
        z-index: 2000;
        background: #fff;
        border: 1px solid #7a7a7a;
        box-shadow: 0 2px 6px rgba(0,0,0,.2);
        overflow-y: auto;
        overflow-x: hidden;
        font-size: 13px;
        padding: 1px 0;
    }
    .ousm-select-menu .ousm-select-item {
        padding: 2px 8px;
        cursor: default;
        white-space: nowrap;
    }
    .ousm-select-menu .ousm-select-item:hover,
    .ousm-select-menu .ousm-select-item.active {
        background: #0078d7;
        color: #fff;
    }
</style>
<div class="modal fade" id="ousm_popupNewGrid" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-lg" style="min-height:0 !important;height:fit-content !important;margin:auto !important;">
        <div class="modal-content" style="height:fit-content !important;min-height:0 !important;aspect-ratio:unset !important;">
            <div class="modal-header py-2">
                <h5 class="modal-title">Edit User</h5>
            </div>
            <div class="modal-body p-3">
                <div class="d-flex justify-content-start mb-3 gap-2 pt-2">
                    <button id="ousm_btnSaveAtt" class="mui-button mui-button-search">Save</button>
                    <button type="button" id="ousm_btnClosePopup" class="mui-button mui-button-new" data-bs-dismiss="modal">Close</button>
                </div>

                <input type="hidden" id="ousm_txtid" name="ousm_txtid" />
                <div class="ousm-edit-grid">
                            <div class="border p-2 ousm-cell">
                                <div class="row g-2 align-items-center mb-1">
                                    <div class="col-4 text-end text-nowrap">Last Name</div>
                                    <div class="col-8">
                                        <input id="ousm_lastNamenew" class="form-control form-control-sm">
                                    </div>
                                </div>

                                <div class="row g-2 align-items-center mb-1">
                                    <div class="col-4 text-end text-nowrap">First / Middle</div>
                                    <div class="col-4">
                                        <input id="ousm_firstNamenew" class="form-control form-control-sm">
                                    </div>
                                    <div class="col-4">
                                        <input id="ousm_middleNamenew" class="form-control form-control-sm">
                                    </div>
                                </div>

                                <div class="row g-2 align-items-center mb-1">
                                    <div class="col-4 text-end text-nowrap">Sex</div>
                                    <div class="col-8">
                                        <div class="form-check form-check-inline">
                                            <input id="ousm_sex_male" type="radio" name="ousm_sex" value="1">
                                            <label class="form-check-label" for="ousm_sex_male">Male</label>
                                        </div>
                                        <div class="form-check form-check-inline">
                                            <input id="ousm_sex_female" type="radio" name="ousm_sex" checked value="0">
                                            <label class="form-check-label" for="ousm_sex_female">Female</label>
                                        </div>
                                    </div>
                                </div>

                                <div class="row g-2 align-items-center mb-1">
                                    <div class="col-4 text-end text-nowrap">Job Title</div>
                                    <div class="col-8">
                                        <select id="ousm_jobtitlenew" name="ousm_jobtitlenew" class="form-select form-select-sm">
                                            <option value=""></option>
                                            @foreach (var item in listjt)
                                            {
                                                <option value="@item.ID">@item.Name</option>
                                            }
                                        </select>
                                    </div>
                                </div>

                                <div class="row g-2 align-items-center mb-1">
                                    <div class="col-4 text-end text-nowrap">Department</div>
                                    <div class="col-8">
                                        <select id="ousm_department" name="ousm_department" class="form-select form-select-sm">
                                            <option value=""></option>
                                            @foreach (var item in listdp)
                                            {
                                                <option value="@item.ID">@item.Name</option>
                                            }
                                        </select>
                                    </div>
                                </div>

                                <div class="row g-2 align-items-center mb-1">
                                    <div class="col-4 text-end text-nowrap">User Group</div>
                                    <div class="col-8">
                                        <select id="ousm_usergroupnew" name="ousm_usergroupnew" class="form-select form-select-sm">
                                            <option value=""></option>
                                            @foreach (var item in listusg)
                                            {
                                                <option value="@item.ID">@item.Name</option>
                                            }
                                        </select>
                                    </div>
                                </div>

                                <div class="row g-2 align-items-center">
                                    <div class="col-4 text-end text-nowrap">Date of Birth</div>
                                    <div class="col-8">
                                        <div data-date-input data-format="DD/MM/YYYY" data-name="ousm_dateofbirth">
                                            <input type="text" class="date-ui form-control form-control-sm" placeholder="dd/mm/yyyy" autocomplete="off" />
                                        </div>
                                    </div>
                                </div>

                                <div class="row g-2 align-items-center">
                                    <div class="col-4 text-end text-nowrap">Working Date</div>
                                    <div class="col-8">
                                        <div data-date-input data-format="DD/MM/YYYY" data-name="ousm_workingdate">
                                            <input type="text" class="date-ui form-control form-control-sm" placeholder="dd/mm/yyyy" autocomplete="off" />
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="border p-2 ousm-cell">
                                <div class="row g-2 align-items-center mb-1">
                                    <div class="col-4 text-end text-nowrap">Login Name</div>
                                    <div class="col-8">
                                        <input id="ousm_loginNamenew" class="form-control form-control-sm">
                                    </div>
                                </div>

                                <div class="row g-2 align-items-center mb-1">
                                    <div class="col-4 text-end text-nowrap">Password</div>
                                    <div class="col-8">
                                        <input id="ousm_passWord" type="password" class="form-control form-control-sm">
                                    </div>
                                </div>

                                <div class="row g-2 align-items-center mb-1">
                                    <div class="col-4 text-end text-nowrap">Confirm password</div>
                                    <div class="col-8">
                                        <input id="ousm_confirmPass" type="password" class="form-control form-control-sm">
                                    </div>
                                </div>

                                <div class="row g-2 align-items-center mb-1 ousm-field-expire">
                                    <div class="col-4 text-end text-nowrap">Pws expire date</div>
                                    <div class="col-5">
                                        <div data-date-input data-format="DD/MM/YYYY" data-name="ousm_expiredate">
                                            <input type="text" class="date-ui form-control form-control-sm" placeholder="dd/mm/yyyy" autocomplete="off" />
                                        </div>
                                    </div>
                                    <div class="col-3 d-flex align-items-center">
                                        <button id="ousm_resetpass" type="button" class="btn btn-outline-secondary btn-sm px-1 py-0 text-nowrap w-100">
                                            <i class="fa-solid fa-spinner fa-spin ousm-reset-spin d-none"></i>
                                            Reset Pws
                                        </button>
                                    </div>
                                </div>

                                <div class="row g-2 align-items-center mb-1">
                                    <div class="col-4 text-end text-nowrap">Email Address</div>
                                    <div class="col-8">
                                        <input id="ousm_emailAdress" class="form-control form-control-sm">
                                    </div>
                                </div>

                                <div class="row g-2 align-items-center mb-1">
                                    <div class="col-4 text-end text-nowrap">Cashier status</div>
                                    <div class="col-4">
                                        <div class="form-check">
                                            <input id="ousm_ischeckCashier" type="checkbox">
                                            <label class="form-check-label" for="ousm_ischeckCashier">Is Cashier</label>
                                        </div>
                                    </div>
                                    <div class="col-4">
                                        <input id="ousm_cachierNo" class="form-control form-control-sm" placeholder="Cashier No">
                                    </div>
                                </div>

                                <div class="row g-2 align-items-center">
                                    <div class="col-4 text-end text-nowrap">Status</div>
                                    <div class="col-8">
                                        <select id="ousm_statusNew" class="form-select form-select-sm">
                                            <option value="1">Active</option>
                                            <option value="0">Inactive</option>
                                            <option value="-1">Terminated</option>
                                        </select>
                                    </div>
                                </div>
                            </div>

                            <div class="border p-2 ousm-cell">
                                <div class="row g-2 align-items-center mb-1">
                                    <div class="col-4 text-end text-nowrap">Address</div>
                                    <div class="col-8">
                                        <input id="ousm_address" class="form-control form-control-sm">
                                    </div>
                                </div>

                                <div class="row g-2 align-items-center mb-1">
                                    <div class="col-4 text-end text-nowrap">Telephone</div>
                                    <div class="col-8">
                                        <input id="ousm_telephone" class="form-control form-control-sm">
                                    </div>
                                </div>

                                <div class="row g-2 align-items-center mb-1">
                                    <div class="col-4 text-end text-nowrap">Hand phone</div>
                                    <div class="col-8">
                                        <input id="ousm_handPhone" class="form-control form-control-sm">
                                    </div>
                                </div>

                                <div class="row g-2 align-items-center mb-1">
                                    <div class="col-4 text-end text-nowrap">Communication</div>
                                    <div class="col-8">
                                        <input id="ousm_communication" class="form-control form-control-sm">
                                    </div>
                                </div>

                                <div class="row g-2 align-items-center mb-1">
                                    <div class="col-4 text-end text-nowrap">Postal Code</div>
                                    <div class="col-8">
                                        <input id="ousm_postalCode" class="form-control form-control-sm">
                                    </div>
                                </div>

                                <div class="row g-2 align-items-center">
                                    <div class="col-4 text-end text-nowrap">Resident</div>
                                    <div class="col-8">
                                        <input id="ousm_resident" class="form-control form-control-sm">
                                    </div>
                                </div>
                            </div>

                            <div class="border p-2 ousm-cell">
                                <strong>Application Access Control:</strong>
                                <div class="form-check">
                                    <input id="ousm_access_pms" type="checkbox" checked>
                                    <label class="form-check-label" for="ousm_access_pms">Property Management System (PMS)</label>
                                </div>
                                <div class="form-check">
                                    <input id="ousm_access_pos" type="checkbox" checked>
                                    <label class="form-check-label" for="ousm_access_pos">Point Of Sale (POS)</label>
                                </div>
                                <div class="form-check">
                                    <input id="ousm_access_inventory" type="checkbox" checked>
                                    <label class="form-check-label" for="ousm_access_inventory">Inventory</label>
                                </div>
                                <div class="form-check">
                                    <input id="ousm_access_pbx" type="checkbox" checked>
                                    <label class="form-check-label" for="ousm_access_pbx">PBX</label>
                                </div>
                                <div class="form-check">
                                    <input id="ousm_access_smartcard" type="checkbox">
                                    <label class="form-check-label" for="ousm_access_smartcard">Smart Card</label>
                                </div>
                                <div class="form-check">
                                    <input id="ousm_access_bookingonline" type="checkbox">
                                    <label class="form-check-label" for="ousm_access_bookingonline">Booking Online</label>
                                </div>
                            </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
(function (window, $) {
    "use strict";

    const ousm_Module = {
        selectedRowData: null,
        originalStatus: null,

        init: function () {
            this.destroyPopupSelects();
            this.bindEvents();
            this.usersManagementData();
            if (window.applyPopupRights) {
                window.applyPopupRights("UsersManagement_web", {
                    new: "#ousm_btnNewUsermana",
                    edit: "#ousm_btnEditUsermana",
                    delete: "#ousm_btnDeleteUsermana",
                    save: "#ousm_btnSaveAtt"
                });
            }
        },

        destroyPopupSelects: function () {
            ["#ousm_jobtitlenew", "#ousm_department", "#ousm_usergroupnew", "#ousm_statusNew"].forEach(function (id) {
                const el = document.querySelector(id);
                if (el && el.tomselect) el.tomselect.destroy();
            });
        },

        closeSelectMenu: function () {
            $(".ousm-select-menu").remove();
        },

        defaultFormDate: function () {
            const d = new Date();
            const pad = n => String(n).padStart(2, "0");
            return d.getFullYear() + "-" + pad(d.getMonth() + 1) + "-" + pad(d.getDate());
        },

        applyDefaultDates: function () {
            const today = this.defaultFormDate();
            if (!today) return;
            UI.setHiddenDate("ousm_dateofbirth", today);
            UI.setHiddenDate("ousm_workingdate", today);
            const expire = new Date();
            expire.setDate(expire.getDate() + 60);
            const pad = n => String(n).padStart(2, "0");
            UI.setHiddenDate(
                "ousm_expiredate",
                expire.getFullYear() + "-" + pad(expire.getMonth() + 1) + "-" + pad(expire.getDate())
            );
        },

        openUserPopup: function (afterInit) {
            const $popup = $("#ousm_popupNewGrid");
            if ($popup.length) {
                document.body.appendChild($popup[0]);
            }
            $popup.find(".modal-dialog").css({
                minHeight: 0,
                height: "fit-content",
                margin: "auto"
            });
            $popup.find(".modal-content").first().css({
                height: "fit-content",
                minHeight: 0,
                aspectRatio: "unset",
                maxHeight: "none"
            });
            if (typeof initDateInputs === "function") {
                initDateInputs($popup[0]);
            }
            if (typeof afterInit === "function") afterInit();
            $popup.modal("show");
        },

        toggleSelectMenu: function (selectEl) {
            const self = this;
            const $open = $(".ousm-select-menu");
            if ($open.length && $open.data("selectId") === selectEl.id) {
                self.closeSelectMenu();
                return;
            }
            self.closeSelectMenu();

            const parent = document.querySelector("#ousm_modal .modal-content");
            if (!parent) return;

            const selectRect = selectEl.getBoundingClientRect();
            const parentRect = parent.getBoundingClientRect();
            const spaceBelow = parentRect.bottom - selectRect.bottom - 4;
            const spaceAbove = selectRect.top - parentRect.top - 4;
            const openDown = spaceBelow >= 80 || spaceBelow >= spaceAbove;
            const maxHeight = Math.max(80, Math.floor(openDown ? spaceBelow : spaceAbove));

            const $menu = $("<div class='ousm-select-menu'></div>").data("selectId", selectEl.id);
            Array.from(selectEl.options).forEach(function (opt) {
                if (opt.disabled) return;
                const $item = $("<div class='ousm-select-item'></div>")
                    .text(opt.text)
                    .attr("data-value", opt.value);
                if (opt.selected) $item.addClass("active");
                $item.on("mousedown", function (e) {
                    e.preventDefault();
                    e.stopPropagation();
                    $(selectEl).val(opt.value).trigger("change");
                    self.closeSelectMenu();
                });
                $menu.append($item);
            });

            $menu.css({
                left: selectRect.left,
                width: selectRect.width,
                maxHeight: maxHeight
            });
            if (openDown) {
                $menu.css({ top: selectRect.bottom });
            } else {
                $menu.css({ bottom: window.innerHeight - selectRect.top });
            }

            $("body").append($menu);
            const $active = $menu.find(".ousm-select-item.active");
            if ($active.length) {
                $menu.scrollTop($active.position().top - 20);
            }
        },

        bindEvents: function () {
            const self = this;
            const selectSelector = "#ousm_popupNewGrid select, #ousm_modal select";

            $(document)
                .off("mousedown.ousmSelect click.ousmSelect", selectSelector)
                .on("mousedown.ousmSelect", selectSelector, function (e) {
                    e.preventDefault();
                    self.toggleSelectMenu(this);
                })
                .on("click.ousmSelect", selectSelector, function (e) {
                    e.preventDefault();
                });

            $(document)
                .off("mousedown.ousmSelectClose")
                .on("mousedown.ousmSelectClose", function (e) {
                    if (!$(e.target).closest(".ousm-select-menu, " + selectSelector).length) {
                        self.closeSelectMenu();
                    }
                });

            $(document)
                .off("click.ousm", "#ousm_btnPrint")
                .on("click.ousm", "#ousm_btnPrint", function () {
                    self.usersManagementData();
                });

            $(document)
                .off("click.ousm", "#ousm_btnClose")
                .on("click.ousm", "#ousm_btnClose", function () {
                    $("#ousm_modal").modal("hide");
                    self.clearForm();
                });

            $(document)
                .off("click.ousm", "#ousm_btnEditUsermana")
                .on("click.ousm", "#ousm_btnEditUsermana", function () {
                    self.editSelected();
                });
                     $(document)
                        .off("click.ousm", "#ousm_btnDeleteUsermana")
                        .on("click.ousm", "#ousm_btnDeleteUsermana", function () {
                        self.deleteSelected();
                    });

            $(document)
                .off("change.ousmStatus", "#ousm_statusNew")
                .on("change.ousmStatus", "#ousm_statusNew", function () {
                    self.guardTerminatedStatus();
                });

            $(document)
                .off("click.ousm", "#ousm_btnNewUsermana")
                .on("click.ousm", "#ousm_btnNewUsermana", function () {
                    self.clearForm();
                    self.openUserPopup(function () {
                        self.applyDefaultDates();
                    });
                });

            $(document)
                .off("click.ousm", "#ousm_btnSaveAtt")
                .on("click.ousm", "#ousm_btnSaveAtt", function () {
                    self.saveForm();
                });

            $(document)
                .off("keydown.ousm")
                .on("keydown.ousm", function (e) {
                    if (e.key !== "Escape") return;

                    if ($(".ousm-select-menu").length) {
                        e.preventDefault();
                        e.stopPropagation();
                        self.closeSelectMenu();
                        return;
                    }

                    if ($("#ousm_popupNewGrid").hasClass("show")) {
                        e.preventDefault();
                        e.stopPropagation();
                        $("#ousm_popupNewGrid").modal("hide");
                        return;
                    }

                    if ($("#ousm_modal").hasClass("show")) {
                        e.preventDefault();
                        $("#ousm_modal").modal("hide");
                    }
                });

            $("#ousm_popupNewGrid")
                .off("hidden.bs.modal.ousm")
                .on("hidden.bs.modal.ousm", function () {
                    self.closeSelectMenu();
                    if ($("#ousm_modal").hasClass("show")) {
                        $("body").addClass("modal-open");
                    }
                });

            $("#ousm_modal")
                .off("hidden.bs.modal.ousm")
                .on("hidden.bs.modal.ousm", function () {
                    self.closeSelectMenu();
                    $(document).off("keydown.ousm");
                    const $popup = $("#ousm_popupNewGrid");
                    $popup.modal("hide");
                    if ($popup.parent()[0] === document.body) {
                        $popup.remove();
                    }
                });

            $(document)
                .off("click.ousm", "#ousm_resetpass")
                .on("click.ousm", "#ousm_resetpass", function () {
                    self.resetPass();
                });
        },

        usersManagementData: function () {
            const self = this;

            $("#ousm_loadingSpinner").show();

            $.ajax({
                url: "/UsersManagement/UsersManagementData",
                type: "GET",
                data: {
                    lastName: $("#ousm_lastName").val(),
                    firstName: $("#ousm_firstName").val(),
                    loginName: $("#ousm_loginName").val(),
                    userStatus: $("#ousm_userStatus").val(),
                    cashierStatus: $("#ousm_cashierStatus").val(),
                    jobtitle: $("#ousm_jobtitle").val(),
                    department: $("#ousm_usergroup").val()
                },
                traditional: true,
                crossDomain: false,
                headers: {
                    "X-CSRF-TOKEN-HEADERNAME": $("input[name='__RequestVerificationToken']").val()
                },
                success: function (result) {
                    self.initializeDataGridSearch(result);
                    $("#ousm_loadingSpinner").hide();
                },
                error: function () {
                    alert("Không thể tải báo cáo.");
                    $("#ousm_loadingSpinner").hide();
                }
            });
        },

        editSelected: function () {
            const self = this;

            if (!self.selectedRowData) {
                 showToast("Warning", "Please select a row before editing.", false);
                return;
            }

            $("#ousm_loadingSpinner").show();

            $.ajax({
                url: "/UsersManagement/UsersManagementDetail",
                type: "GET",
                data: {
                    id: self.selectedRowData.id
                },
                traditional: true,
                headers: {
                    "X-CSRF-TOKEN-HEADERNAME": $("input[name='__RequestVerificationToken']").val()
                },
                success: function (res) {
                    self.openUserPopup(function () {
                        self.populateForm(res);
                    });
                    $("#ousm_loadingSpinner").hide();
                },
                error: function () {
                    alert("Không thể tải chi tiết.");
                    $("#ousm_loadingSpinner").hide();
                }
            });
        },
            applyTerminatedStatusLock: function (status) {
                const terminated = Number(status) === -1;
                this.originalStatus = status == null || status === "" ? null : Number(status);
                $("#ousm_statusNew option[value='1']").prop("disabled", terminated);
            },

            guardTerminatedStatus: function () {
                const $sel = $("#ousm_statusNew");
                if (this.originalStatus === -1 && Number($sel.val()) === 1) {
                    $sel.val("-1");
                    showToast("Warning", "A terminated user cannot be activated again.", false);
                    return false;
                }
                return true;
            },

            deleteSelected: function () {
                const self = this;

                if (!self.selectedRowData) {
                        showToast("Warning", "Please select a user.", false);
                    return;
                }

                $("#ousm_loadingSpinner").show();

                $.ajax({
                    url: "/UsersManagement/UsersManagementDelete",
                    type: "POST",
                    data: {
                        id: self.selectedRowData.id
                    },
                    traditional: true,
                    headers: {
                        "X-CSRF-TOKEN-HEADERNAME": $("input[name='__RequestVerificationToken']").val()
                    },
                    success: function (res) {
                             showToast("Success", res.message, true);
                        $("#ousm_loadingSpinner").hide();
                                 self.usersManagementData();
                    },
                    error: function () {
                                       showToast("Error", "Không thể lưu dữ liệu.", false);
                        $("#ousm_loadingSpinner").hide();
                    }
                });
            },
        saveForm: function () {
          const self = this;

            // Lấy value trước
            const loginName = $("#ousm_loginNamenew").val();
            const password = $("#ousm_passWord").val();
            const confirmPass = $("#ousm_confirmPass").val();

            const firstName = $("#ousm_firstNamenew").val();
            const lastName = $("#ousm_lastNamenew").val();
            const middleName = $("#ousm_middleNamenew").val();

            const jobTitle = $("#ousm_jobtitlenew").val();
            const department = $("#ousm_department").val();
            const userGroup = $("#ousm_usergroupnew").val();

            const sex = $("input[name='ousm_sex']:checked").val();

            // ===== VALIDATE =====
            if (!loginName) {
                showToast("Warning", "Login Name is required", false);
                return;
            }

            if (!password) {
                showToast("Warning", "Password is required", false);
                return;
            }

            if (!confirmPass) {
                showToast("Warning", "Confirm Password is required", false);
                return;
            }

            if (password !== confirmPass) {
                showToast("Warning", "Password and Confirm Password do not match", false);
                return;
            }

            if (!firstName) {
                showToast("Warning", "First Name is required", false);
                return;
            }

            if (!lastName) {
                showToast("Warning", "Last Name is required", false);
                return;
            }

            if (!middleName) {
                showToast("Warning", "Middle Name is required", false);
                return;
            }

            if (!jobTitle || jobTitle == "0") {
                showToast("Warning", "Please select Job Title", false);
                return;
            }

            if (!department || department == "0") {
                showToast("Warning", "Please select Department", false);
                return;
            }

            if (!userGroup || userGroup == "0") {
                showToast("Warning", "Please select User Group", false);
                return;
            }

            if (!sex) {
                showToast("Warning", "Please select Gender", false);
                return;
            }

            if (!self.guardTerminatedStatus()) {
                return;
            }

            // ===== DATA =====
            const data = {
                ID: $("#ousm_txtid").val() || 0,
                LoginName: loginName,
                PasswordHash: password,

                FirstName: firstName,
                LastName: lastName,
                MiddleName: middleName,

                Sex: sex,

                BirthOfDate: $("#ousm_dateofbirth").val(),

                Telephone: $("#ousm_telephone").val(),
                HandPhone: $("#ousm_handPhone").val(),
                HomeAddress: $("#ousm_address").val(),
                Resident: $("#ousm_resident").val(),
                PostalCode: $("#ousm_postalCode").val(),

                DepartmentID: parseInt(department) || 0,
                Status: $("#ousm_statusNew").val(),

                Communication: $("#ousm_communication").val(),
                PassExpireDate: $("#ousm_expiredate").val(),

                IsCashier: $("#ousm_ischeckCashier").is(":checked"),
                CashierNo: parseInt($("#ousm_cachierNo").val()) || 0,

                Email: $("#ousm_emailAdress").val(),
                StartWorking: $("#ousm_workingdate").val(),

                UserInsertID: JSON.parse(localStorage.getItem("userID")),
                UserUpdateID: JSON.parse(localStorage.getItem("userID")),

                JobTitleID: parseInt(jobTitle) || 0,
                UserGroupID: parseInt(userGroup) || 0,
                FullName: loginName,

                IsShow: true
            };

            $.ajax({
                url: "/UsersManagement/UpdateUsersManagement",
                type: "POST",
                data: data,
                traditional: true,
                headers: {
                    "X-CSRF-TOKEN-HEADERNAME": $("input[name='__RequestVerificationToken']").val()
                },
                success: function (response) {
                    if (response.success) {
                        $("#ousm_popupNewGrid").modal("hide");
                        self.usersManagementData();
                        self.clearForm();
                    } else {
                        showToast("Warning", response.message, false);
                    }
                },
                error: function () {
                    showToast("Error", "Không thể lưu dữ liệu.", false);
                }
            });
        },

        setResetBusy: function (busy) {
            const $btn = $("#ousm_resetpass");
            $btn.prop("disabled", !!busy);
            $btn.find(".ousm-reset-spin").toggleClass("d-none", !busy);
        },

        resetPass: function () {
            const self = this;
            const id = parseInt($("#ousm_txtid").val(), 10) || 0;
            if (id === 0) {
                showToast("Warning", "Please save the user before resetting the password.", false);
                return;
            }
            if (!confirm("Are you sure you want to reset the password?")) {
                return;
            }

            const data = {
                ID: id,
                UserInsertID: JSON.parse(localStorage.getItem("userID")),
                UserUpdateID: JSON.parse(localStorage.getItem("userID"))
            };

            self.setResetBusy(true);
            $.ajax({
                url: "/UsersManagement/ResetPassUsersManagement",
                type: "POST",
                data: data,
                traditional: true,
                headers: {
                    "X-CSRF-TOKEN-HEADERNAME": $("input[name='__RequestVerificationToken']").val()
                },
                success: function (response) {
                    self.setResetBusy(false);
                    if (response.success) {
                        $("#ousm_passWord, #ousm_confirmPass")
                            .attr("type", "text")
                            .val(response.plainPassword || "");
                        if (response.passExpireDate) {
                            UI.setHiddenDate("ousm_expiredate", response.passExpireDate);
                        }
                        if (response.status != null && Number(response.status) !== -1) {
                            $("#ousm_statusNew").val("1");
                        }
                        showToast("Success", response.message, true);
                        self.usersManagementData();
                        if (!response.hasEmail) {
                            showToast("Warning", "The password was reset. Email was not sent because this user has no email address.", false);
                            return;
                        }
                        self.sendResetPasswordEmail(id, response.plainPassword);
                    } else {
                        showToast("Warning", response.message, false);
                    }
                },
                error: function () {
                    self.setResetBusy(false);
                    showToast("Error", "Unable to reset the password.", false);
                }
            });
        },

        sendResetPasswordEmail: function (id, plainPassword) {
            $.ajax({
                url: "/UsersManagement/SendResetPasswordEmail",
                type: "POST",
                data: { id: id, plainPassword: plainPassword },
                traditional: true,
                headers: {
                    "X-CSRF-TOKEN-HEADERNAME": $("input[name='__RequestVerificationToken']").val()
                },
                success: function (response) {
                    showToast(response.success ? "Success" : "Warning", response.message, !!response.success);
                },
                error: function () {
                    showToast("Warning", "The password was reset but the email could not be sent.", false);
                }
            });
        },

        populateForm: function (data) {
            if (!data) return;

            $("#ousm_passWord, #ousm_confirmPass").attr("type", "password");
            $("#ousm_txtid").val(data.id || "");

            $("#ousm_lastNamenew").val(data.lastName ?? "");
            $("#ousm_firstNamenew").val(data.firstName ?? "");
            $("#ousm_middleNamenew").val(data.middleName ?? "");

            $("input[name='ousm_sex']").prop("checked", false);
            if (Number(data.sex) === 1) {
                $("#ousm_sex_male").prop("checked", true);
            } else {
                $("#ousm_sex_female").prop("checked", true);
            }

            $("#ousm_jobtitlenew").val(data.jobTitleID ?? "");
            $("#ousm_department").val(data.departmentID ?? "");
            $("#ousm_usergroupnew").val(data.userGroupID ?? "");

            UI.setHiddenDate("ousm_dateofbirth", data.birthOfDate);
            UI.setHiddenDate("ousm_workingdate", data.startWorking);

            $("#ousm_address").val(data.homeAddress ?? "");
            $("#ousm_telephone").val(data.telephone ?? "");
            $("#ousm_handPhone").val(data.handPhone ?? "");
            $("#ousm_communication").val(data.communication ?? "");
            $("#ousm_postalCode").val(data.postalCode ?? "");
            $("#ousm_resident").val(data.resident ?? "");

            $("#ousm_loginNamenew").val(data.loginName ?? "");
            $("#ousm_passWord").val(data.passwordHash ?? "");
            $("#ousm_confirmPass").val(data.passwordHash ?? "");

            UI.setHiddenDate("ousm_expiredate", data.passExpireDate);

            $("#ousm_emailAdress").val(data.email ?? "");
            $("#ousm_ischeckCashier").prop("checked", !!data.isCashier);
            $("#ousm_cachierNo").val(data.cashierNo ?? "");
            $("#ousm_statusNew").val(data.status ?? 1);
            this.applyTerminatedStatusLock(data.status);
        },

        clearForm: function () {
            $("#ousm_passWord, #ousm_confirmPass").attr("type", "password");
            $("#ousm_txtid").val("");

            $("#ousm_lastNamenew").val("");
            $("#ousm_firstNamenew").val("");
            $("#ousm_middleNamenew").val("");

            $("input[name='ousm_sex']").prop("checked", false);
            $("#ousm_sex_male").prop("checked", true);

            $("#ousm_jobtitlenew").val("");
            $("#ousm_department").val("");
            $("#ousm_usergroupnew").val("");

            UI.setHiddenDate("ousm_dateofbirth", "");
            UI.setHiddenDate("ousm_workingdate", "");
            UI.setHiddenDate("ousm_expiredate", "");

            $("#ousm_address").val("");
            $("#ousm_telephone").val("");
            $("#ousm_handPhone").val("");
            $("#ousm_communication").val("");
            $("#ousm_postalCode").val("");
            $("#ousm_resident").val("");

            $("#ousm_loginNamenew").val("");
            $("#ousm_passWord").val("");
            $("#ousm_confirmPass").val("");
            $("#ousm_emailAdress").val("");

            $("#ousm_ischeckCashier").prop("checked", false);
            $("#ousm_cachierNo").val("");

            $("#ousm_statusNew").val(1);
            this.applyTerminatedStatusLock(null);
        },

        initializeDataGridSearch: function (data) {
            const self = this;

            $("#ousm_gridContainerUser").dxDataGrid({
                dataSource: data,
                height: 500,
                allowColumnResizing: true,
                columnAutoWidth: true,

                grouping: { autoExpandAll: true },
                groupPanel: { visible: false },

                columns: [
                    {
                        dataField: "department",
                        caption: "Department",
                        groupIndex: 0,
                        visible: false,
                        groupCellTemplate: function (container, options) {
                            $("<div>")
                                .text("Department: " + options.value)
                                .css({ fontWeight: "600", fontSize: "14px" })
                                .appendTo(container);
                        }
                    },
                    { dataField: "statusText", caption: "Status", width: 120 },
                    { dataField: "loginName", caption: "Login Name", width: 140 },
                    { dataField: "fullName", caption: "Full Name", width: 160 },
                    { dataField: "sex", caption: "Sex", width: 80 },
                    {
                        dataField: "birthOfDate",
                        caption: "Birth Date",
                        dataType: "date",
                        format: "dd/MM/yyyy",
                        width: 120
                    },
                    { dataField: "telephone", caption: "Tel", width: 120 },
                    { dataField: "handPhone", caption: "Mobile", width: 120 },
                    { dataField: "homeAddress", caption: "Home Address", width: 120 },
                    { dataField: "resident", caption: "Resident", width: 120 },
                    { dataField: "postalCode", caption: "Postal", width: 90 },
                    {
                        dataField: "isCashier",
                        caption: "Cashier",
                        width: 100,
                        alignment: "center",
                        cellTemplate: function (container, options) {
                            $("<div>")
                                .dxCheckBox({
                                    value: options.value,
                                    readOnly: true
                                })
                                .css({
                                    transform: "scale(0.85)",
                                    margin: "0 auto"
                                })
                                .appendTo(container);
                        }
                    },
                    { dataField: "jobTitle", caption: "Job Title", width: 160 },
                    { dataField: "createBy", caption: "Create By", width: 120 },
                    {
                        dataField: "createDate",
                        caption: "Create Date",
                        dataType: "date",
                        format: "dd/MM/yyyy",
                        width: 120
                    },
                    { dataField: "updateBy", caption: "Update By", width: 120 },
                    {
                        dataField: "updateDate",
                        caption: "Update Date",
                        dataType: "date",
                        format: "dd/MM/yyyy",
                        width: 120
                    }
                ],

                paging: { pageSize: 25 },
                pager: {
                    visible: true,
                    allowedPageSizes: [25, 50, "all"],
                    showPageSizeSelector: true,
                    showInfo: true,
                    showNavigationButtons: true
                },

                filterRow: { visible: true, applyFilter: "auto" },
                headerFilter: { visible: true },
                selection: { mode: "single" },
                showBorders: true,

                onRowClick: function (e) {
                    self.selectedRowData = e.data;
                }
            });
        }
    };

    window.openModalOusm = function () {
        $("#ousm_modal").modal("show");
        ousm_Module.init();
    };

    window.ousm_Module = ousm_Module;

})(window, jQuery);
</script>
