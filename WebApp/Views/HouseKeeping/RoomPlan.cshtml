@{
    ViewBag.Title = ViewBag.ReportHeader;
    var zoneList = ViewBag.ZoneList;
    var roomtypeList = ViewBag.RoomTypeList;
    var roomList = ViewBag.RoomList;
    var roomFloor = ViewBag.FloorList;
}

@* <link href="~/css/new_reservation.css" rel="stylesheet" asp-append-version="true" />
<link asp-append-version="true" href="~/css/reservation.css" rel="stylesheet" /> *@

<style>


    .dx-datagrid-headers .dx-header-row td {
        white-space: pre-line !important;
        text-align: center;
        font-size: 11px;
    }


    .dx-datagrid .dx-editor-with-menu .dx-menu-item-content .dx-icon.dx-icon-filter-operation-default,
    .dx-datagrid-container .dx-editor-with-menu .dx-menu-item-content .dx-icon.dx-icon-filter-operation-default {
        display: none;
    }

    .swal2-popup.small-swal {
        max-width: 400px;
        font-size: 14px;
    }

    .filter_wrapper {
        /*     background-color: #ececec; */
        /*   margin: 0px 8px 14px 8px; */
        padding: 18px 0px 0px 14px;
        border-radius: 8px;
    }

 /*    .gridContainer {
        margin: 0px 8px;
    } */

    .button_wrapper {
        display: flex;
        column-gap: 12px;
        margin: 0px 8px;
    }

    .button_wrapper .fa-solid {
        margin-right: 5px;
    }

    .selected {
        background-color: #4CAF50;
        /* Màu xanh */
        color: white;
    }
    .filter-panel {
        font-size: 12px;
    }

    .filter-panel .form-control-sm,
    .filter-panel .form-select-sm,
    .filter-panel .ts-control {
        font-size: 12px;
        padding: .1rem .35rem;
        height: calc(1.1em + .2rem + 2px);
    }

    .dx-scheduler-header {
        height: 33px;
    }

    .dx-scheduler-header-panel-empty-cell {
        display: none;
    }

    .dx-scheduler-header-row th[title="0:00"] {
        display: none !important;
    }



    .dx-scheduler-group-table {
        display: none !important;
    }

    .dx-scheduler-date-table-row {
        height: 27px !important;
    }

    /* Thu nhỏ ô.
       Lịch dùng cuộn ảo (virtual scrolling) nên DevExtreme tự tính chiều cao hàng từ chính ô này:
       - ô phải cao đúng bằng hàng (27px) và bỏ min-height 50px mặc định của theme, nếu không hàng bị kéo lên 50px;
       - thanh đặt phòng cao 19px, nằm ở phần đầu hàng như bản cũ. */
    .dx-scheduler-timeline .dx-scheduler-date-table .dx-scheduler-date-table-cell,
    .dx-scheduler-date-table-cell {
        height: 27px !important;
        min-height: 0 !important;
        padding: 0px !important;
        line-height: 16px !important;
    }

    .dx-scheduler-appointment {
        height: 19px !important;
    }

    th[title="12:00 AM"] {
        display: none !important;
        border: none !important;
    }


    #scrollWrapper {
        display: flex;
        flex-direction: row;
        /* Chia theo chiều ngang */
        height: 100vh;
        width: 100%;
        margin-top: 54px;
        box-sizing: border-box;
        gap: 10px;
        padding: 10px;
    }

    #gridWrapper {
        width: 30%;
        min-width: 250px;
        /* Tránh quá nhỏ nếu màn hình nhỏ */
        padding-top: 65px;
        position: relative;
        left: 10px;
    }

    #schedulerWrapper {
        width: 100%;

        min-width: 600px;
        margin-top: -50px;
        overflow-x: hidden; /* khi zoom nhỏ, khung lịch rộng hơn 100% rồi mới scale lại; tránh sinh thanh cuộn ngang của trang */
    }

    #gridContainer,
    #schedulerContainer {
        height: 600px;
        /* Hoặc giá trị phù hợp */
        overflow-y: auto;
        width: 100%;
        transform-origin: left center;
        /* co giãn từ mép trái, giữ chiều cao */
        transition: transform 0.2s ease;
        /* mượt mà khi zoom */
    }

    .custom-room-label {
        line-height: normal;
        padding: 4px 8px;
        font-size: 13px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        display: flex;
        align-items: center;
        height: 100%;
        /* Giữ label luôn nằm đúng hàng */
    }

    .dx-scheduler-group-header-content {
        padding: 0 !important;
        margin: 0 !important;
        display: flex;
        align-items: center;
        /* Canh giữa theo chiều dọc */
        height: 100%;
    }

    /* Cột tên phòng cố định + chữ không bị méo khi zoom ngang (--inv = 1/tỉ lệ zoom, --lblw = rộng cột ở hệ tọa độ đã scale) */
    #schedulerContainer {
        position: relative;
        --inv: 1;
        --lblw: 100px;
    }

    .rp-labels {
        position: absolute;
        left: 0;
        width: var(--lblw);
        overflow: hidden;
        background: #fff;
        border-right: 1px solid #e0e0e0;
        z-index: 20;
    }

    .rp-label {
        height: 27px;
        line-height: 27px;
        font-size: 13px;
        white-space: nowrap;
        padding-left: 2px;
        transform: scaleX(var(--inv));
        transform-origin: left center;
    }

    .dx-scheduler-header-panel-cell-date {
        display: inline-block;
        transform: scaleX(var(--inv));
        transform-origin: left center;
    }

    .room-label {
        position: relative;
        font-size: 13px;
        display: flex;
        align-items: center;
        top: 3px; /* căn giữa hàng 27px (cuộn ảo không còn cần đẩy lên -9px như trước) */
        left:2px;
    }
    /*     .dx-scheduler-appointment-empty.dx-scheduler-appointment-horizontal {
        position: absolute !important; 
        left:100px;
        margin-top: 4px;
    } */

    .dx-scheduler-header-panel-cell.dx-scheduler-cell-sizes-horizontal.dx-scheduler-header-panel-week-cell {
        position: relative;
        /* để phần tử con tuyệt đối bám theo */
    }

    .dx-scheduler-header-panel-cell.dx-scheduler-cell-sizes-horizontal.dx-scheduler-header-panel-week-cell::after {
        content: "";
        position: absolute;
        bottom: 4px;
        /* cách mép dưới 4px, bạn có thể chỉnh */
        left: 50%;
        /* nằm giữa theo chiều ngang */
        transform: translateX(-50%);
        width: 1px;
        /* độ dày gạch */
        height: 10px;
        /* chiều dài gạch */
        background-color: black;
        /* màu gạch */
    }

    .filter-popup {
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
        transition: all 0.2s ease-in-out;
    }

    .tomselect-custom {
        width: 300px;
        min-height: 30px;
        /* hoặc tùy theo chiều cao bạn muốn */
        font-size: 0.65rem;
        margin-left: 5px;
    }

    .tomselect-custom .ts-control {
        padding-left: 8px !important;
        /* hoặc bất kỳ giá trị nào bạn muốn */
    }
    /* ===== RESERVATION ===== */
    .resv-pending {
        background-color: gold !important;
    }

    .resv-checkin {
        background-color: #4CAF50 !important;
    }

    .resv-checkout {
        background-color: #ffffff !important;
        color: #000 !important;
    }

    .resv-dueout {
        background-color: violet !important;
    }

    /* ===== OOOS ===== */
    .ooo-order {
        background-color: indianred !important;
    }

    .ooo-service {
        background-color: orangered !important;
    }

    .ooo-default {
        background-color: #a82f19 !important;
    }



    /* ===== Bộ lọc Room Plan: bố cục theo form WinForms ===== */
    .rp-filter {
        font-size: 13px;
    }

    /* Chú giải màu: ô chữ nhật có viền như WinForms */
    .rp-legend-row {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 6px;
        margin-bottom: 12px;
    }

    .rp-lg {
        display: inline-block;
        min-width: 76px;
        padding: 3px 10px;
        text-align: center;
        border: 1px solid #555;
        color: #000;
    }

    .rp-note {
        margin-left: 6px;
        font-style: italic;
        color: #555;
    }

    .rp-main {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-start;
        gap: 14px 18px;
    }

    /* Cụm 1: lưới 4 cột x 2 hàng */
    .rp-checks {
        display: grid;
        grid-template-columns: repeat(4, auto);
        column-gap: 10px;
        row-gap: 14px;
        padding-top: 4px;
    }

    .rp-chk {
        display: flex;
        align-items: center;
        gap: 6px;
        margin: 0;
        white-space: nowrap;
        font-weight: normal;
    }

    .rp-chk input {
        margin: 0;
    }

    /* Các cụm có nhãn bên trái, nhãn căn phải thẳng cột */
    .rp-col {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .rp-f {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .rp-f > label {
        flex: 0 0 70px;
        margin: 0;
        text-align: right;
        white-space: nowrap;
    }

    .rp-col-wide .rp-f > select,
    .rp-col-wide .rp-f > .ts-wrapper {
        width: 190px;
    }

    .rp-sel {
        width: 110px;
    }

    #filterPopup .tomselect-custom {
        width: 190px;
        margin-left: 0;
    }

    /* Cụm 4: hai khung nhóm Order By / Zoom */
    .rp-groups {
        display: flex;
        gap: 14px;
    }

    .rp-group {
        display: flex;
        align-items: center;
        gap: 14px;
        margin: 0;
        padding: 2px 12px 8px 12px;
        border: 1px solid #c8c8c8;
        border-radius: 3px;
    }

    .rp-group > legend {
        float: none;
        width: auto;
        margin: 0;
        padding: 0 4px;
        font-size: 12px;
    }

    /* Nút − / +: chữ rõ, đậm, canh giữa (CSS chung của button làm mất chữ nên đặt !important) */
    #filterPopup .rp-zoom-btn {
        display: inline-flex !important;
        align-items: center;
        justify-content: center;
        width: 30px !important;
        height: 28px !important;
        padding: 0 !important;
        border: 1px solid #555 !important;
        border-radius: 3px !important;
        background: #f0f0f0 !important;
        color: #000 !important;
        font-size: 18px !important;
        font-weight: 400 !important;
        line-height: 1 !important;
        cursor: pointer;
    }

    #filterPopup .rp-zoom-btn:hover {
        background: #dcdcdc !important;
    }

    .rp-dates {
        display: flex;
        align-items: center;
        gap: 6px;
        margin-top: 10px;
    }

    .rp-dates > label {
        margin: 0;
        white-space: nowrap;
    }

    .rp-dates > input {
        width: 116px;
    }
</style>
<div class="text-center" id="reportTitle" style="font-size: 20px"></div>

<div class="sticky-header bg-white p-2 shadow-sm z-3">
    <div id="overlay" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%;
     background-color: rgba(0, 0, 0, 0.3); z-index: 1040;"></div>


    <div>
        <div class="">
            <button id="btnPrint" class="mui-button mui-button-new">View</button>
            <button id="btnExportExcel" class="mui-button mui-button-new" type="button">   Excel</button>
            @*  <button  id="btnExportPdf" class="mui-button mui-button-new" type="button"> PDF</button> *@
            <button style="border-radius: 4px;  margin-right: 6px;" id="toggleFilterBtn"
                class="mui-button mui-button-search">
                 Filter
            </button>
        </div>
        <div id="filterPopup" class="filter-popup shadow p-3 bg-white rounded border mt-2"
            style="display: none; width: 100%;">

            @* Bố cục bộ lọc theo form Room Plan của WinForms: chú giải màu ở trên; bên dưới 4 cụm
               (trạng thái phòng | Zone/Room/Room Type/Owner | Smoking/Floor/Special | Order By + Zoom + ngày). *@
            <div class="rp-filter">

                <!-- Chú giải màu + ghi chú -->
                <div class="rp-legend-row">
                    <span class="rp-lg" style="background:#cd5c5c">OOO</span>
                    <span class="rp-lg" style="background:#ff4500">OOS</span>
                    <span class="rp-lg" style="background:violet">Due Out</span>
                    <span class="rp-lg" style="background:gold">Expected</span>
                    <span class="rp-lg" style="background:#4CAF50">Checked In</span>
                    <span class="rp-note">Note: '*' character stand for room without balcony. '-&gt;' character stand for Room has a connecting door</span>
                </div>

                <div class="rp-main">

                    <!-- Cụm 1: trạng thái phòng (lưới 4 cột x 2 hàng như WinForms) -->
                    <div class="rp-checks">
                        <label class="rp-chk" style="grid-area:1/1"><input type="checkbox" id="occupied" name="masterllioup" value="1" checked>Occupied</label>
                        <label class="rp-chk" style="grid-area:1/2"><input type="checkbox" id="vacant" name="masterllioup" value="1" checked>Vacant</label>
                        <label class="rp-chk" style="grid-area:1/3"><input type="checkbox" id="dueout" name="masterllioup" value="1" checked>Due Out</label>
                        <label class="rp-chk" style="grid-area:1/4"><input type="checkbox" id="ooos" name="masterllioup" value="1" checked>OOO/S</label>
                        <label class="rp-chk" style="grid-area:2/1"><input type="checkbox" id="cleanupop" name="masterllioup" value="1" checked>Clean</label>
                        <label class="rp-chk" style="grid-area:2/2"><input type="checkbox" id="cleannonupop" name="masterllioup" value="1" checked>Clean Non-Checked</label>
                        <label class="rp-chk" style="grid-area:2/4"><input type="checkbox" id="dirtyupop" name="masterllioup" value="1" checked>Dirty</label>
                    </div>

                    <!-- Cụm 2: Zone / Room / Room Type / Owner -->
                    <div class="rp-col rp-col-wide">
                        <div class="rp-f">
                            <label>Zone</label>
                            <select data-single-choice id="zone" name="zone" class="tomselect-custom" multiple>
                                <option value=""></option>
                                @foreach (var item in zoneList)
                                {
                                    <option value="@item.Code">@item.Code</option>
                                }
                            </select>
                        </div>
                        <div class="rp-f">
                            <label>Room</label>
                            <select id="room" name="room" class="tomselect-custom" multiple>
                                <option value=""></option>
                                @foreach (var item in roomList)
                                {
                                    <option value="@item.RoomNo">@item.RoomNo</option>
                                }
                            </select>
                        </div>
                        <div class="rp-f">
                            <label>Room Type</label>
                            <select id="roomType" name="roomType" class="tomselect-custom" multiple>
                                <option value=""></option>
                                @foreach (var item in roomtypeList)
                                {
                                    <option value="@item.Code">@item.Code</option>
                                }
                            </select>
                        </div>
                        <div class="rp-f">
                            <label>Owner</label>
                            <select id="viewBy" name="viewBy" class="form-control form-control-sm rp-sel">
                                <option value="">--ALL--</option>
                                <option value="--Hotel--">--Hotel--</option>
                                <option value="--Owner--">--Owner--</option>
                            </select>
                        </div>
                    </div>

                    <!-- Cụm 3: Smoking / Floor / Special -->
                    <div class="rp-col">
                        <div class="rp-f">
                            <label>Smoking</label>
                            <select id="smoking" name="smoking" class="form-control form-control-sm rp-sel">
                                <option value="">--ALL--</option>
                                <option value="1">--Yes--</option>
                                <option value="0">--No--</option>
                            </select>
                        </div>
                        <div class="rp-f">
                            <label>Floor</label>
                            <select id="floor" name="floor" class="form-control form-control-sm rp-sel">
                                <option value="">--ALL--</option>
                                @foreach (var item in roomFloor)
                                {
                                    <option value="@item.Code">@item.Code</option>
                                }
                            </select>
                        </div>
                        <div class="rp-f">
                            <label>Special</label>
                            <select id="special" name="special" class="form-control form-control-sm rp-sel">
                                <option value="0">--ALL--</option>
                                <option value="1">Connecting-Door</option>
                                <option value="2">Without-Balcony</option>
                            </select>
                        </div>
                    </div>

                    <!-- Cụm 4: Order By + Zoom (khung nhóm), bên dưới là Min/Max Date -->
                    <div class="rp-col rp-col-right">
                        <div class="rp-groups">
                            <fieldset class="rp-group">
                                <legend>Order By</legend>
                                <label class="rp-chk"><input type="radio" id="roomno" name="masterlliouppop" value="1" checked>Room No</label>
                                <label class="rp-chk"><input type="radio" id="roomtype" name="masterlliouppop" value="0">Room Type</label>
                            </fieldset>
                            <fieldset class="rp-group">
                                <legend>Zoom</legend>
                                <button type="button" class="rp-zoom-btn" id="zoom-out">-</button>
                                <button type="button" class="rp-zoom-btn" id="zoom-in">+</button>
                            </fieldset>
                        </div>
                        <div class="rp-dates">
                            <label>Min Date</label>
                            <input type="date" id="fromDate" name="fromDate" class="form-control form-control-sm" />
                            <label>Max Date</label>
                            <input type="date" id="toDate" name="toDate" class="form-control form-control-sm" />
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>
<div style="display:flex">

    <div id="scrollWrapper">
    @*     <div class="mui-card" id="gridWrapper">
            <div class="gridContainer" id="gridContainer"></div>
        </div> *@
        <div id="schedulerWrapper">
            <div id="schedulerContainer"></div>
        </div>
    </div>

</div>

<div id="loadingSpinner"
     style="display:none;
            position:fixed;
            top:50%;
            left:50%;
            transform:translate(-50%, -50%);
            z-index:150;
            text-align:center;">
    
    <i class="fa-solid fa-spinner fa-spin" style="font-size:36px;"></i>
    <div style="margin-top:8px; font-size:14px; font-weight:500;">
        Please wait...
    </div>
</div>

<script>


    $(document).ready(function () {
        getBusinessDate();
        initTomSelect(".tomselect-custom");
        // Khi nhấn nút Filter
        $('#toggleFilterBtn').on('click', function (e) {
            e.stopPropagation();

            // Gắn filterPopup ngay sau nút
            $(this).after($('#filterPopup'));

            // Toggle hiển thị
            $('#filterPopup').toggle();
        });

        // Click ra ngoài sẽ đóng popup và overlay
        $(document).on('click', function (e) {

            const $popup = $('#filterPopup');
            const $button = $('#toggleFilterBtn');

            if (
                !$popup.is(e.target) && $popup.has(e.target).length === 0 &&
                !$button.is(e.target) && $button.has(e.target).length === 0
            ) {
                $popup.hide();
                $('#overlay').hide();
            }
        });
        let currentScaleX = 1.0;      // Zoom ngang mặc định 100%
        const step = 0.1;             // Mỗi lần zoom ±10%
        const minScaleX = 0.5;        // Tối thiểu 50%
        const maxScaleX = 2.0;        // Tối đa 200%

        function applyHorizontalZoom() {
            // scaleX chỉ co/giãn hình, không đổi bề rộng khung nên zoom nhỏ sẽ để trống bên phải.
            // Đặt bề rộng khung = 100% / tỉ lệ để sau khi scale vẫn phủ đủ chiều ngang
            // (zoom nhỏ -> hiện thêm ngày, zoom lớn -> hiện ít ngày hơn), rồi vẽ lại lịch theo bề rộng mới.
            const $sch = $('#schedulerContainer');
            // --inv = 1/tỉ lệ: dùng để "scale ngược" chữ (tên phòng, ngày) cho khỏi bị méo khi co/giãn ngang,
            // và giữ cột tên phòng luôn rộng 100px trên màn hình.
            $sch[0].style.setProperty('--inv', 1 / currentScaleX);
            $sch[0].style.setProperty('--lblw', (100 / currentScaleX) + 'px');
            $sch.css({
                transform: 'scaleX(' + currentScaleX + ')',
                width: (100 / currentScaleX) + '%'
            });
            // Chỉ báo đổi kích thước (nhẹ). Không dùng repaint(): nó dựng lại toàn bộ lịch nên mỗi lần bấm phải chờ vài giây.
            $sch.trigger('dxresize');
        }

        $('#zoom-in').on('click', function () {
            if (currentScaleX < maxScaleX) {
                currentScaleX += step;
                applyHorizontalZoom();
            }
        });

        $('#zoom-out').on('click', function () {
            if (currentScaleX > minScaleX) {
                currentScaleX -= step;
                applyHorizontalZoom();
            }
        });

        $('input[name="masterlliouppop"]').on('change', function () {
            if ($(this).is(':checked')) {
                $("#btnPrint").trigger("click");
            }
        });
        document.getElementById("reportTitle").innerText = 'Room Plan';
         initTomSelect(".tomselect-custom");
         const DAY_RANGE = 30;

        const parseDate = (val) => {
            if (!val) return null;
            return new Date(val + 'T00:00:00');
        };

        const formatDate = (d) => d.toISOString().split('T')[0];

        $('#fromDate').on('change', function () {
            const fromDate = parseDate(this.value);
            if (!fromDate) return;

            const toDate = new Date(fromDate);
            toDate.setDate(toDate.getDate() + DAY_RANGE);

            $('#toDate').val(formatDate(toDate));
        });

        $('#toDate').on('change', function () {
            const toDate = parseDate(this.value);  
            if (!toDate) return;

            const fromDate = new Date(toDate);
            fromDate.setDate(fromDate.getDate() - DAY_RANGE);

            $('#fromDate').val(formatDate(fromDate));
        });
    });

    function getBusinessDate() {
        return $.ajax({
            url: '/Reservation/GetBusinessDate',
            type: 'get',
            dataType: 'json',
            crossDomain: false,
            headers: { "X-CSRF-TOKEN-HEADERNAME": jQuery("input[name='__RequestVerificationToken']").val() },
            success: function (result) {

                const baseDateStr = result.split('T')[0]; // YYYY-MM-DD

                const baseDate = new Date(baseDateStr);
                const toDate = new Date(baseDate);
                toDate.setDate(toDate.getDate() + 30);

                // format YYYY-MM-DD
                const formatDate = (d) => d.toISOString().split('T')[0];

                $('#fromDate').val(formatDate(baseDate));
                $('#toDate').val(formatDate(toDate));
                $("#btnPrint").trigger("click");
            },
            error: function (xhr, statusText, err) {
                if (xhr.status == 401) {
                    sessionTimeout();
                }
            }
        });
    }

    function parseVNDateOnly(str) {
        if (!str) return null;

        // format: "dd/MM/yyyy HH:mm:ss"
        // lấy trực tiếp ký tự
        const dd = (str.charCodeAt(0) - 48) * 10 + (str.charCodeAt(1) - 48);
        const MM = (str.charCodeAt(3) - 48) * 10 + (str.charCodeAt(4) - 48);
        const yyyy =
            (str.charCodeAt(6) - 48) * 1000 +
            (str.charCodeAt(7) - 48) * 100 +
            (str.charCodeAt(8) - 48) * 10 +
            (str.charCodeAt(9) - 48);

        if (!dd || !MM || !yyyy) return null;

        return new Date(yyyy, MM - 1, dd);
    }




    $(document).off("click", "#btnPrint").on("click", "#btnPrint", function () {
        $("#loadingSpinner").show();
        const owner = $("#viewBy").val();
        let orderbyroom = $("input[name='masterlliouppop']:checked").val() || "";
        $.ajax({
            url: '/HouseKeeping/RoomPlanData',
            type: 'GET',
            data: {
                fromDate: $("#fromDate").val(),
                toDate: $("#toDate").val(),
                orderbyroom: orderbyroom, // sẽ là "1" hoặc "0"
                owner: owner
            },
            traditional: true,
            crossDomain: false,
            headers: { "X-CSRF-TOKEN-HEADERNAME": jQuery("input[name='__RequestVerificationToken']").val() },
            success: function (data) {

                // console.log(data);
                // initializeRoomPlanGrid(data);

                const fromDate = $("#fromDate").val();
                const toDate = $("#toDate").val();
                initializeRoomScheduler(data, fromDate, toDate);

                $("#loadingSpinner").hide();
            }

            ,


            error: function () {
                alert("Không thể tải báo cáo.");
                $("#loadingSpinner").hide();
            }
        });
    });
    let roomNorl, roomtypeid, idReservationrl, roomIDrl;
    let originalAppointmentData = null;

       function initializeRoomScheduler(schedulerData, fromDate, toDate) {

        if (!schedulerData || schedulerData.length === 0) return;

        /* =======================
         * DATE RANGE (cache time)
         * ======================= */
        const MS_PER_DAY = 86400000;

        const from = new Date(fromDate);
        from.setHours(0, 0, 0, 0);
        const fromTime = from.getTime();

        const to = new Date(toDate);
        to.setHours(0, 0, 0, 0);
        const toTime = to.getTime();

        const daysToShow = Math.ceil((toTime - fromTime) / MS_PER_DAY) + 1;

        /* =======================
         * PREPROCESS (ONE LOOP ONLY)
         * ======================= */
        const roomMap = Object.create(null);
        const roomGroups = [];
        const validRoomIDs = Object.create(null);
        const roomInfoMap = Object.create(null);
        const appointments = [];

        for (let i = 0, l = schedulerData.length; i < l; i++) {

            const d = schedulerData[i];
            const roomID = d.roomID;

            if (!roomID) continue;

            const roomIDStr = String(roomID);

            /* ===== ROOM GROUP BUILD (only once per room) ===== */
            if (!validRoomIDs[roomIDStr] && d.roomNo && d.roomNo.trim() !== "") {

                validRoomIDs[roomIDStr] = true;

                roomGroups.push({
                    id: roomIDStr,
                    text: d.roomNo.trim()
                });

                roomInfoMap[roomIDStr] = {
                    roomNo: d.roomNo,
                    roomNumber: d.roomNumber,
                    roomTypeCode: d.roomTypeCode
                };
            }

            /* ===== APPOINTMENT BUILD ===== */

            const a = parseVNDateOnly(d.arrivalDate);
            const dep = parseVNDateOnly(d.departureDate);
            if (!a || !dep) continue;

            const aTime = a.getTime();
            const depTime = dep.getTime();

            if (aTime > toTime || depTime < fromTime) continue;

            appointments.push({
                text: d.lastName || "",
                startDate: aTime < fromTime ? from : a,
                endDate: depTime > toTime ? to : dep,
                roomID: roomIDStr,

                type: d.type || "",
                reservationStatus: d.reservationStatus,
                reservationID:
                    !d.reservationID || String(d.reservationID) === "0"
                        ? d.oooid
                        : d.reservationID,

                roomTypeCode: d.roomTypeCode || "",
                oooStatus: d.oooStatus || "",
                roomNumber: d.roomNumber || "",

                tooltipData: {
                    company: d.company,
                    agent: d.agent,
                    paymentMethod: d.paymentMethod,
                    comment: d.comment,
                    confirmationNo: d.confirmationNo,
                    code: d.code
                }
            });
        }

        /* =======================
         * DÙNG LẠI LỊCH CÓ SẴN KHI BẤM VIEW
         * Dựng cả lịch (hơn 1.000 phòng x số ngày) mất vài giây. Nếu khoảng ngày và danh sách phòng (theo thứ tự)
         * không đổi thì chỉ cần nạp lại dữ liệu đặt phòng/OOO, lịch tự vẽ lại phần đang nhìn thấy (rất nhanh).
         * ======================= */
        const $scheduler = $("#schedulerContainer");
        const signature = fromDate + "|" + toDate + "|" + roomGroups.map(function (g) { return g.id; }).join(",");
        if ($scheduler.data("dxScheduler") && $scheduler.data("rpSignature") === signature) {
            $scheduler.dxScheduler("instance").option("dataSource", appointments);
            return;
        }
        // Đổi ngày/thứ tự phòng: huỷ lịch cũ rồi dựng mới. Cấu hình lại lịch đang có chậm gấp nhiều lần dựng mới.
        if ($scheduler.data("dxScheduler")) {
            $scheduler.dxScheduler("dispose");
            $scheduler.empty();
        }
        $scheduler.data("rpSignature", signature);

        /* =======================
         * INIT SCHEDULER
         * ======================= */
        $("#schedulerContainer").dxScheduler({

            dataSource: appointments,

            views: [{
                type: "timelineDay",
                intervalCount: daysToShow,
                startDate: from
            }],

            currentView: "timelineDay",
            currentDate: from,

            startDayHour: 0,
            endDayHour: 24,
            cellDuration: 1440,

            groups: ["roomID"],
            crossScrollingEnabled: true,

            // Cuộn ảo: chỉ dựng các phòng đang nhìn thấy. Dựng hết (khoảng 359 phòng x 31 ngày = hơn 11.000 ô) rất chậm.
            // Chiều cao phải cố định và khớp #schedulerContainer (600px).
            height: 600,
            scrolling: { mode: "virtual", orientation: "vertical" },
            // Hàng thấp (27px) làm DevExtreme tự gộp thanh thành "n more" từng ô; bắt buộc vẽ thanh liền như bản cũ.
            maxAppointmentsPerCell: "unlimited",

            resources: [{
                fieldExpr: "roomID",
                dataSource: roomGroups,
                allowMultiple: false
            }],

            /* Tên phòng không còn nằm trong ô ngày đầu (cuộn ngang là mất) mà do cột cố định renderRoomLabelColumn vẽ. */
            /* =======================
             * APPOINTMENT RENDER
             * ======================= */
            onAppointmentRendered: function (e) {

                const el = $(e.appointmentElement);
                const data = e.appointmentData;
                const tooltipData = data.tooltipData || {};

                /* ===== TITLE ===== */
                // let titleText = data.text || "";
                // if (data.type === "OOOS") {
                //     titleText = `${tooltipData.code || "Code"} (Out of Order)`;
                // }

                // let titleEl = el.find(".dx-scheduler-appointment-title");
                // if (titleEl.length === 0) {
                //     titleEl = $('<div class="dx-scheduler-appointment-title"></div>');
                //     el.append(titleEl);
                // }
                // titleEl.text(titleText).css("display", "block");

                /* ===== TOOLTIP ===== */
                el.attr("title",
                    `Company: ${tooltipData.company || ""}\n` +
                    `Agent: ${tooltipData.agent || ""}\n` +
                    `PaymentMethod: ${tooltipData.paymentMethod || ""}\n` +
                    `Comment: ${tooltipData.comment || ""}\n` +
                    `ConfirmationNo: ${tooltipData.confirmationNo || ""}`
                );

                /* ===== COLOR LOGIC ===== */
                if (data.type === "Reservation") {

                    switch (String(data.reservationStatus)) {
                        case "0":
                        case "5":
                        case "8":
                            el.addClass("resv-pending"); break;
                        case "1":
                            el.addClass("resv-checkin"); break;
                        case "2":
                            el.addClass("resv-checkout"); break;
                        case "6":
                            el.addClass("resv-dueout"); break;
                        default:
                            el.addClass("resv-checkin");
                    }

                } else if (data.type === "OOOS") {

                    const oooStatus = String(data.oooStatus || "");

                    if (oooStatus === "1") {
                        el.addClass("ooo-order");
                    } else if (oooStatus === "2") {
                        el.addClass("ooo-service");
                    } else {
                        el.addClass("ooo-default");
                    }
                }

                /* ===== POSITION LOGIC ===== */
                const startTime = new Date(data.startDate).setHours(0,0,0,0);
                const endTime = new Date(data.endDate).setHours(0,0,0,0);

                // Thanh nằm sát đầu hàng; phần đầu thanh trùng ngày bắt đầu nằm dưới cột tên phòng cố định.
                if (fromTime >= startTime && fromTime <= endTime) {
                    el.css({ marginTop: "4px" });
                }

                /* ===== TRANSLATE Y =====
                 * Bản cũ dịch thanh lên 30px để bù cách dựng cũ. Với cuộn ảo, DevExtreme đã đặt thanh đúng hàng,
                 * dịch thêm sẽ làm thanh lệch lên một hàng nên không còn dịch nữa. */
            },
            onAppointmentUpdating: async function (e) {
                const oldData = e.oldData;
                const newData = e.newData;
                idReservationrl = oldData.reservationID;

                const isMoved =
                    oldData.startDate.getTime() !== newData.startDate.getTime() ||
                    oldData.endDate.getTime() !== newData.endDate.getTime() ||
                    oldData.roomID !== newData.roomID;

                try {
                    const result = await getRoomID(newData.roomID);
                    roomIDrl = result.id;
                    roomNorl = result.roomNo;
                    roomtypeid = result.roomTypeID;

                    const isSameRoomType =
                        result.roomTypeCode === oldData.roomTypeCode;

                    if (!isMoved) return;

                    if (isSameRoomType) {
                        const action = await askUpdateOrReview();

                        if (action === "cancel") {
                            e.cancel = true;
                            return;
                        }

                        if (action === "review") {
                            e.cancel = true;
                            $('#modalEdit').modal('show');
                            goReview(idReservationrl);
                            return;
                        }

                        if (action === "update") {
                            goUpdate(
                                idReservationrl,
                                newData.startDate,
                                newData.endDate,
                                roomNorl,
                                roomtypeid,
                                roomIDrl
                            );
                        }
                    } else {
                        if (!confirm("Are you sure to edit?")) {
                            e.cancel = true;
                            return;
                        }

                        if (oldData.type === "OOOS") {
                            goReview(idReservationrl);
                        } else {
                            goUpdate(
                                idReservationrl,
                                newData.startDate,
                                newData.endDate,
                                roomNorl,
                                roomtypeid,
                                roomIDrl
                            );
                        }
                    }
                } catch (err) {
                    console.error("Room info error:", err);
                    e.cancel = true;
                }
            }

        });

        renderRoomLabelColumn(roomGroups, roomInfoMap);
    }

    /* =======================
     * CỘT TÊN PHÒNG CỐ ĐỊNH BÊN TRÁI
     * Tên phòng trước đây nằm trong ô ngày đầu tiên nên cuộn ngang là mất. Dựng một cột riêng đè lên bên trái lịch,
     * cuộn dọc đồng bộ với lịch (mỗi phòng một hàng cao 27px) nên luôn nhìn thấy khi cuộn ngang.
     * ======================= */
    function renderRoomLabelColumn(roomGroups, roomInfoMap) {
        const $c = $("#schedulerContainer");
        $c.find(".rp-labels").remove();

        const $scrollable = $c.find(".dx-scheduler-date-table-scrollable");
        const scrollable = $scrollable.data("dxScrollable") ? $scrollable.dxScrollable("instance") : null;
        if (!scrollable) return;

        const html = roomGroups.map(function (g) {
            const info = roomInfoMap[g.id] || {};
            return '<div class="rp-label">' + (info.roomNumber || "") + "-" + (info.roomTypeCode || "") + "</div>";
        }).join("");

        const $labels = $('<div class="rp-labels"><div class="rp-labels-inner">' + html + "</div></div>").appendTo($c);
        const inner = $labels.find(".rp-labels-inner")[0];

        // Vị trí/chiều cao khớp vùng lưới ngày (trừ thanh cuộn ngang)
        const cTop = $c[0].getBoundingClientRect().top;
        const sTop = $scrollable[0].getBoundingClientRect().top;
        const viewport = $scrollable.find(".dx-scrollable-container")[0];
        $labels.css({ top: (sTop - cTop) + "px", height: viewport.clientHeight + "px" });

        scrollable.on("scroll", function (e) {
            inner.style.transform = "translateY(" + (-e.scrollOffset.top) + "px)";
        });
    }


    function goUpdate(idReservationrl, startDate, endDate, roomNorl, roomtypeid, roomIDrl) {
         var modal = $('#newReservationModal');

        // Luôn hiển thị loading
        modal.find('.modal-body').html(`
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p class="mt-3">Loading reservation...</p>
            </div>
        `);

        modal.modal('show');
        $.ajax({
            url: '/Reservation/EncryptId',
            type: 'POST',
            data: { id: idReservationrl },
            success: function (response) {
                if (response.success) {
                    var start = formatDate(startDate);
                    var end = formatDate(endDate);
                    var data = start + "|" + end + "|" + roomNorl + "|" + roomtypeid + "|" + idReservationrl;


                    localStorage.setItem("ReservationRoomPlan", data);
                    // chỉ encode cái encryptedId
                    // window.location.href = '/Reservation/NewReservation?key=' + encodeURIComponent(response.encryptedId);
                     $.ajax({
                        url: '/Reservation/NewReservation',
                        type: 'GET',
                        data: { key: response.encryptedId },
                        cache: false,
                        success: function (html) {
                            modal.find('.modal-body').html(html);
                           
                        },
                        error: function () {
                            modal.find('.modal-body').html(`
                                <div class="alert alert-danger m-4">
                                    <strong>Lỗi!</strong> Không thể tải thông tin đặt chỗ.
                                </div>
                            `);
                        }
                    });
                }
            }
        });
    }


    function goReview(idReservationrl) {
        var modal = $('#newReservationModal');

        // Luôn hiển thị loading
        modal.find('.modal-body').html(`
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p class="mt-3">Loading reservation...</p>
            </div>
        `);

        modal.modal('show');
        $.ajax({
            url: '/Reservation/EncryptId',
            type: 'POST',
            data: { id: idReservationrl },
            success: function (response) {
                if (response.success) {
                    // Chuyển hướng đến trang chỉnh sửa
                   // window.location.href = '/Reservation/NewReservation?key=' + encodeURIComponent(response.encryptedId);
                    $.ajax({
                        url: '/Reservation/NewReservation',
                        type: 'GET',
                        data: { key: response.encryptedId },
                        cache: false,
                        success: function (html) {
                            modal.find('.modal-body').html(html);

                        },
                        error: function () {
                            modal.find('.modal-body').html(`
                                <div class="alert alert-danger m-4">
                                    <strong>Lỗi!</strong> Không thể tải thông tin đặt chỗ.
                                </div>
                            `);
                        }
                    });
                } else {
                    // Nếu mã hóa thất bại, hiển thị thông báo và xóa lớp phủ
                    alert('Lỗi khi mã hóa ID');

                }
            },
            error: function () {
                // Nếu API thất bại, hiển thị thông báo và xóa lớp phủ
                alert('Lỗi khi gọi API mã hóa');
                $('#overlay').hide();
                $('body').css('pointer-events', 'auto');
            }
        });
    }

    function getRoomID(roomID) {
        return new Promise((resolve, reject) => {
            $.ajax({
                url: '/HouseKeeping/GetRoomID',
                type: 'get',
                dataType: 'json',
                data: { id: roomID },
                headers: {
                    "X-CSRF-TOKEN-HEADERNAME": jQuery("input[name='__RequestVerificationToken']").val()
                },
                success: function (result) {
                    resolve(result);
                },
                error: function (xhr) {
                    if (xhr.status === 401) {
                        sessionTimeout();
                    }
                    reject(xhr);
                }
            });
        });
    }
    function askUpdateOrReview() {
        return Swal.fire({
            title: 'Update date only or review rate?',
            icon: 'question',
            showCancelButton: true,
            showDenyButton: true,
            confirmButtonText: 'Update',
            denyButtonText: 'Review',
            cancelButtonText: 'Cancel',
            customClass: {
                popup: 'small-swal'
            }
        }).then((result) => {
            if (result.isConfirmed) return "update";
            if (result.isDenied) return "review";
            return "cancel";
        });
    }

    $("#btnExportExcel").click(function () {
        const grid = $("#gridContainer").dxDataGrid("instance"); var selectedReport2 = '@ViewBag.ReportTitle';
        var selectedReport = '@ViewBag.ReportTitle';
        if (!selectedReport) {
            alert("Vui lòng chọn báo cáo trước khi xuất Excel.");
            return;
        }

        const workbook = new ExcelJS.Workbook(); const companyName = localStorage.getItem("CompanyName") || "Tên công ty chưa xác định";
        const worksheet = workbook.addWorksheet("Sheet 1");

        // === Tạo header công ty (dòng 1) ===
        worksheet.addRow([companyName]);
        worksheet.mergeCells('A1:E1');
        worksheet.getRow(1).font = { bold: true };
        worksheet.getRow(1).alignment = { vertical: 'middle', horizontal: 'left' };

        // === Dòng 2: Thời gian xuất (phải) ===
        const now = new Date();
        const exportDate = now.toLocaleString("vi-VN");
        worksheet.addRow(['', '', '', '', ' ' + exportDate]);
        worksheet.mergeCells('E2:H2');
        worksheet.getRow(2).alignment = { vertical: 'middle', horizontal: 'right' };

        // === Dòng 3–4: Trống
        worksheet.addRow([]);
        worksheet.addRow([]);

        // === Dòng 5: Tên báo cáo ở giữa ===
        const reportRow = worksheet.addRow(['', '', selectedReport]);
        worksheet.mergeCells('C5:F5');
        reportRow.font = { bold: true, size: 14 };
        reportRow.alignment = { vertical: 'middle', horizontal: 'center' };

        // === Dòng 6: Trống trước khi xuất dữ liệu
        worksheet.addRow([]);

        // === Export dữ liệu từ DevExtreme (bắt đầu từ dòng 7)
        DevExpress.excelExporter.exportDataGrid({
            component: grid,
            worksheet: worksheet,
            autoFilterEnabled: true,
            topLeftCell: { row: 7, column: 1 } // dữ liệu bắt đầu từ dòng 7
        }).then(function () {
            // Footer
            const lastRow = worksheet.lastRow.number + 2;
            worksheet.getCell(`A${lastRow}`).value = "--- END  ---";
            worksheet.mergeCells(`A${lastRow}:F${lastRow}`);
            worksheet.getCell(`A${lastRow}`).alignment = { horizontal: 'center' };
            worksheet.getCell(`A${lastRow}`).font = { italic: true };

            // Ghi file
            let fileName = selectedReport + ".xlsx";
            workbook.xlsx.writeBuffer().then(function (buffer) {
                saveAs(new Blob([buffer], { type: "application/octet-stream" }), fileName);
            });
        });
    });



    // Nút xuất PDF
    $("#btnExportPdf").click(function () {
        const { jsPDF } = window.jspdf; // 👈 Bổ sung dòng này

        const doc = new jsPDF();

        DevExpress.pdfExporter.exportDataGrid({
            jsPDFDocument: doc,
            component: $("#gridContainer").dxDataGrid("instance"),
            autoTableOptions: {
                styles: { cellPadding: 2, fontSize: 8 },
                margin: { top: 20 }
            }
