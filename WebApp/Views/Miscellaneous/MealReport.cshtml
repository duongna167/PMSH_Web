@{ Layout = null; }
<style>
    #mrep_modal .modal-dialog { width: calc(100% - 32px); max-width: 1000px; }
    #mrep_modal .modal-content { height: min(720px, 92vh); }
    #mrep_modal .modal-body { display: flex; flex-direction: column; gap: 6px; min-height: 0; padding: 8px; }
    #mrep_modal [hidden] { display: none !important; }
    #mrep_modal .mrep-tabs { flex-wrap: nowrap; overflow-x: auto; flex-shrink: 0; }
    #mrep_modal .mrep-tabs .nav-link { white-space: nowrap; padding: 5px 8px; font-size: 13px; }
    #mrep_modal .mrep-toolbar { display: flex; gap: 4px; border-bottom: 1px solid #ddd; padding-bottom: 6px; }
    #mrep_modal .mrep-toolbar .mui-button { min-width: 80px; margin: 0; }
    #mrep_modal .mrep-filters { margin: 0; padding: 6px 10px 10px; border: 1px solid #d1d5db; border-radius: 4px; }
    #mrep_modal .mrep-filters legend { float: none; width: auto; padding: 0 4px; margin: 0; font-size: 13px; }
    #mrep_modal .mrep-filter-layout { display: flex; gap: 32px; flex-wrap: wrap; align-items: flex-start; }
    #mrep_modal .mrep-date-column { display: grid; grid-template-columns: auto 140px; gap: 4px 8px; align-items: center; }
    #mrep_modal .mrep-extra-column { display: grid; grid-template-columns: auto 170px; gap: 4px 8px; align-items: center; }
    #mrep_modal label { margin: 0; white-space: nowrap; }
    #mrep_modal .mrep-date-column label { text-align: right; }
    #mrep_modal [data-date-input] { width: 140px; }
    #mrep_modal .mrep-grid-wrap { flex: 1; min-height: 0; }
    #mrep_grid { width: 100%; height: 100%; }
    #mrep_cancelModal .mrep-cancel-fields { display: grid; grid-template-columns: auto 1fr; gap: 8px; align-items: center; }
</style>
<div class="modal fade" id="mrep_modal" tabindex="-1" aria-labelledby="mrep_title" aria-hidden="true" data-business-date="@ViewBag.MealBusinessDate">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="mrep_title">Report Meal</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                @Html.AntiForgeryToken()
                <div class="nav nav-tabs mrep-tabs" role="tablist" aria-label="Meal reports">
                    <button class="nav-link active" type="button" role="tab" aria-selected="true" data-mode="change">Report Change Meal</button>
                    <button class="nav-link" type="button" role="tab" aria-selected="false" data-mode="custom">Report Custom</button>
                    <button class="nav-link" type="button" role="tab" aria-selected="false" data-mode="cancel">Report Cancel Meal</button>
                    <button class="nav-link" type="button" role="tab" aria-selected="false" data-mode="waive">Report Waive Meal</button>
                    <button class="nav-link" type="button" role="tab" aria-selected="false" data-mode="used_bf">Report Used Breakfast Meal</button>
                    <button class="nav-link" type="button" role="tab" aria-selected="false" data-mode="use_bf">Report Use Breakfast Meal</button>
                </div>
                <div class="mrep-toolbar">
                    <button type="button" class="mui-button mui-button-search" id="mrep_search">Search</button>
                    <button type="button" class="mui-button mui-button-export" id="mrep_excel">Excel</button>
                    <button type="button" class="mui-button mui-button-delete" id="mrep_cancel" hidden disabled>Cancel Meal</button>
                    <button type="button" class="mui-button mui-button-close ms-auto" data-bs-dismiss="modal">Close</button>
                </div>
                <fieldset class="mrep-filters">
                    <legend>Information Search</legend>
                    <div class="mrep-filter-layout">
                        <div class="mrep-date-column">
                            <label for="mrep_fromUi">From Date</label>
                            <div data-date-input data-format="DD/MM/YYYY" data-name="mrep_from" data-default="@ViewBag.MealBusinessDate">
                                <input id="mrep_fromUi" type="text" class="date-ui form-control form-control-sm" autocomplete="off" placeholder="dd/mm/yyyy">
                            </div>
                            <label for="mrep_toUi">To Date</label>
                            <div data-date-input data-format="DD/MM/YYYY" data-name="mrep_to" data-default="@ViewBag.MealBusinessDate">
                                <input id="mrep_toUi" type="text" class="date-ui form-control form-control-sm" autocomplete="off" placeholder="dd/mm/yyyy">
                            </div>
                        </div>
                        <div class="mrep-extra-column">
                            <label for="mrep_type" data-filter="type">Meal Change Type</label>
                            <select id="mrep_type" class="form-select form-select-sm" data-filter="type">
                                <option value="0">Change Meal</option><option value="1">Add Meal</option><option value="2">Cancel Meal</option>
                            </select>
                            <label for="mrep_shift" data-filter="shift" hidden>Meal Shift</label>
                            <select id="mrep_shift" class="form-select form-select-sm" data-filter="shift" hidden></select>
                            <label for="mrep_room" data-filter="room" hidden>Room No</label>
                            <input id="mrep_room" type="text" class="form-control form-control-sm" data-filter="room" hidden maxlength="50">
                        </div>
                    </div>
                </fieldset>
                <div class="mrep-grid-wrap"><div id="mrep_grid"></div></div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="mrep_cancelModal" tabindex="-1" aria-labelledby="mrep_cancelTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered"><div class="modal-content">
        <div class="modal-header"><h5 class="modal-title" id="mrep_cancelTitle">Cancel Meal</h5></div>
        <div class="modal-body">
            <div class="mrep-cancel-fields">
                <label for="mrep_guest">Guest Name</label><input id="mrep_guest" class="form-control" readonly>
                <label for="mrep_usingDate">Using Date</label><input id="mrep_usingDate" class="form-control" readonly>
            </div>
            <p class="mt-2 mb-0">Cancel this meal record? Only meals from the current business date can be cancelled.</p>
        </div>
        <div class="modal-footer">
            <button type="button" class="mui-button mui-button-save" id="mrep_confirmCancel">OK</button>
            <button type="button" class="mui-button mui-button-close" id="mrep_closeCancel" data-bs-dismiss="modal">Close</button>
        </div>
    </div></div>
</div>
<script>
    var mrep_Module = (function () {
        const root = '#mrep_modal';
        const col = (field, caption, extra) => Object.assign({ dataField: field, caption: caption }, extra);
        const date = (field, caption) => col(field, caption, { dataType: 'date', format: 'dd/MM/yyyy' });
        const stt = col('stt', 'STT', { width: 48 });
        const guest = col('account', 'Guest Name', { minWidth: 140 });
        const room = col('roomno', 'Room No');
        const shift = col('mealshift', 'Meal Shift');
        const restaurant = col('restaurantname', 'Restaurant');
        const zone = col('zone', 'Zone');
        const card = col('cardid', 'Card ID');
        const configs = {
            change: { name: 'Report Change Meal', action: 'GetMealReport', filters: ['type'],
                columns: [stt, guest, col('frommeal', 'From Meal'), date('fromdate', 'From Date'), col('tomeal', 'To Meal'), date('todate', 'To Date'), room, card] },
            custom: { name: 'Report Custom', action: 'GetMealSearchCustom', filters: ['shift', 'room'],
                columns: [stt, date('usingdate', 'Using Date'), shift, guest, restaurant, room, zone] },
            cancel: { name: 'Report Cancel Meal', action: 'GetReportCancelMeal', filters: [],
                columns: [stt, date('canceldate', 'Cancel Date'), shift, guest, restaurant, room, zone, card] },
            waive: { name: 'Report Waive Meal', action: 'GetReportWaiveMeal', filters: ['shift', 'room'],
                columns: [date('ratedate', 'Rate Date'), col('breakfast', 'Breakfast'), col('lunch', 'Lunch'), col('dinner', 'Dinner'), guest, room] },
            used_bf: { name: 'Report Used Breakfast Meal', action: 'GetReportUsedBreakFastMeal', filters: ['room'],
                columns: [stt, date('usingdate', 'Using Date'), shift, guest, restaurant, room, zone, col('amount', 'Amount', { dataType: 'number', format: '#,##0.##' })] },
            use_bf: { name: 'Report Use Breakfast Meal', action: 'GetReportUseBreakFastMeal', filters: ['room'],
                columns: [stt, room, date('usingdate', 'Date'), shift, guest, zone, col('amount', 'Revenue', { dataType: 'number', format: '#,##0.##' })] }
        };
        let mode = 'change', grid, request, cancelRequest, selected, cancelId = 0, version = 0;
        const states = {};
        const error = (xhr, fallback) => xhr.responseJSON?.message || fallback;
        const warn = message => showToast('Warning', message, false);
        function readFilters() {
            return { fromDate: $('#mrep_from').val(), toDate: $('#mrep_to').val(), type: $('#mrep_type').val(), shift: $('#mrep_shift').val(), roomNo: $('#mrep_room').val().trim() };
        }
        function setDate(name, value) {
            const input = document.querySelector(root + ' [data-name="' + name + '"]');
            if (input?.dateInput) input.dateInput.setISO(value);
        }
        function columns() {
            if (mode !== 'change' || $('#mrep_type').val() === '0') return configs[mode].columns;
            return [stt, guest, date('fromdate', 'From Date'), date('todate', 'To Date'), col('breakfast', 'Breakfast'), col('lunch', 'Lunch'), col('dinner', 'Dinner'), room, card];
        }
        function clearSelection() { selected = null; $('#mrep_cancel').prop('disabled', true); }
        function search() {
            const values = readFilters();
            if (!values.fromDate || !values.toDate || values.fromDate > values.toDate) return warn('Please enter a valid From Date and To Date.');
            const cfg = configs[mode], params = { fromDate: values.fromDate, toDate: values.toDate };
            if (mode === 'change') params.type = values.type;
            if (cfg.filters.includes('room')) params.roomNo = values.roomNo;
            if (mode === 'custom') params.mealShiftID = values.shift;
            if (mode === 'waive') params.mealShift = values.shift;
            states[mode] = values;
            const current = ++version;
            if (request) request.abort();
            clearSelection();
            grid.clearFilter(); grid.clearSelection(); grid.pageIndex(0);
            grid.option({ columns: columns(), dataSource: [] });
            grid.beginCustomLoading('Loading...');
            $('#mrep_excel').prop('disabled', true);
            request = $.get('/Miscellaneous/' + cfg.action, params)
                .done(function (data) {
                    if (current !== version) return;
                    if (!Array.isArray(data)) { showToast('Error', 'Invalid meal report response.', false); return; }
                    // SP field casing varies across existing databases.
                    const rows = data.map(row => Object.fromEntries(Object.entries(row).map(([key, value]) => [key.toLowerCase(), value])));
                    grid.option('dataSource', rows);
                })
                .fail(function (xhr, status) { if (status !== 'abort' && current === version) showToast('Error', error(xhr, 'Cannot load meal report.'), false); })
                .always(function () { if (current === version && grid) { grid.endCustomLoading(); $('#mrep_excel').prop('disabled', false); request = null; } });
        }
        function switchTab(next) {
            if (!configs[next]) return;
            states[mode] = readFilters(); mode = next;
            const cfg = configs[mode];
            $(root + ' [data-mode]').each(function () { const active = this.dataset.mode === mode; $(this).toggleClass('active', active).attr('aria-selected', active ? 'true' : 'false'); });
            $(root + ' [data-filter]').each(function () { this.hidden = !cfg.filters.includes(this.dataset.filter); });
            $('#mrep_cancel').prop('hidden', mode !== 'custom');
            const choices = mode === 'waive' ? [['', '--Select--'], ['BF', 'Breakfast'], ['LN', 'Lunch'], ['DN', 'Dinner']]
                : [['', '--Select--'], ['1', 'Breakfast'], ['2', 'Lunch'], ['3', 'Dinner']];
            $('#mrep_shift').empty(); choices.forEach(([value, text]) => $('#mrep_shift').append(new Option(text, value)));
            const businessDate = $(root).attr('data-business-date');
            const saved = states[mode] || { fromDate: businessDate, toDate: businessDate, type: '0', shift: '', roomNo: '' };
            setDate('mrep_from', saved.fromDate); setDate('mrep_to', saved.toDate);
            $('#mrep_type').val(saved.type); $('#mrep_shift').val(saved.shift); $('#mrep_room').val(saved.roomNo);
            search();
        }
        async function exportExcel() {
            if (!grid || request) return;
            if (!grid.getDataSource().items().length) return warn('No data to export.');
            $('#mrep_excel').prop('disabled', true);
            try {
                const workbook = new ExcelJS.Workbook(), sheet = workbook.addWorksheet('Report Meal');
                sheet.addRow([localStorage.getItem('CompanyName') || '']);
                sheet.addRow([configs[mode].name]);
                const filters = states[mode];
                sheet.addRow(['From Date', filters.fromDate, 'To Date', filters.toDate]);
                await DevExpress.excelExporter.exportDataGrid({ component: grid, worksheet: sheet, topLeftCell: { row: 5, column: 1 }, autoFilterEnabled: true });
                const buffer = await workbook.xlsx.writeBuffer();
                saveAs(new Blob([buffer], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' }), configs[mode].name + '.xlsx');
            } catch (e) { showToast('Error', 'Cannot export the meal report.', false); }
            finally { $('#mrep_excel').prop('disabled', false); }
        }
        function openCancel() {
            if (mode !== 'custom' || !selected || !(Number(selected.id) > 0)) return warn('Please select a meal record.');
            cancelId = Number(selected.id);
            $('#mrep_guest').val(selected.account || '');
            const value = selected.usingdate;
            $('#mrep_usingDate').val(value ? DevExpress.localization.formatDate(new Date(value), 'dd/MM/yyyy HH:mm') : '');
            bootstrap.Modal.getOrCreateInstance(document.getElementById('mrep_cancelModal'), { backdrop: 'static' }).show();
        }
        function cancelMeal() {
            if (!cancelId || cancelRequest) return;
            $('#mrep_confirmCancel, #mrep_closeCancel').prop('disabled', true);
            cancelRequest = $.ajax({ url: '/Miscellaneous/CancelReportedMeal', type: 'POST',
                data: { id: cancelId, __RequestVerificationToken: $(root + ' input[name="__RequestVerificationToken"]').val() } })
                .done(function (res) {
                    if (!res.success) { showToast('Error', res.message || 'Cannot cancel meal.', false); return; }
                    bootstrap.Modal.getInstance(document.getElementById('mrep_cancelModal')).hide();
                    cancelId = 0; search();
                })
                .fail(xhr => showToast('Error', error(xhr, 'Cannot cancel meal.'), false))
                .always(function () { cancelRequest = null; $('#mrep_confirmCancel, #mrep_closeCancel').prop('disabled', false); });
        }
        function init() {
            if (grid) return;
            window.initDateInputs(document.getElementById('mrep_modal'));
            grid = $('#mrep_grid').dxDataGrid({ dataSource: [], columns: columns(), height: '100%', width: '100%',
                showBorders: true, showRowLines: true, columnAutoWidth: true, allowColumnResizing: true, columnResizingMode: 'widget',
                selection: { mode: 'single' }, filterRow: { visible: true, applyFilter: 'auto' },
                paging: { enabled: false }, scrolling: { mode: 'standard', showScrollbar: 'always' },
                summary: { totalItems: [{ column: 'account', summaryType: 'count', displayFormat: 'Count: {0}' }] },
                onSelectionChanged: function (e) { selected = e.selectedRowsData[0] || null; $('#mrep_cancel').prop('disabled', mode !== 'custom' || !selected); }
            }).dxDataGrid('instance');
            $(root).off('.mrep').on('click.mrep', '[data-mode]', function () { switchTab(this.dataset.mode); })
                .on('click.mrep', '#mrep_search', search).on('click.mrep', '#mrep_excel', exportExcel)
                .on('click.mrep', '#mrep_cancel', openCancel)
                .on('change.mrep', '#mrep_type, #mrep_shift', search);
            $('#mrep_confirmCancel').off('.mrep').on('click.mrep', cancelMeal);
            $(root).one('hide.bs.modal.mrep', function () { ++version; if (request) request.abort(); });
            $(root).one('hidden.bs.modal.mrep', function () { if (grid) { grid.dispose(); grid = null; } $(root).off('.mrep'); $('#mrep_confirmCancel').off('.mrep'); });
            search();
        }
        return { init: init };
    })();
    window.openModalMealReport = function () { mrep_Module.init(); };
</script>
