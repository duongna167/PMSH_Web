@* Item Availability (Room Management): số lượng Item còn lại theo từng ngày (15 ngày) và chi tiết các đặt chỗ đang giữ Item.
   Popup theo chuẩn của dự án (ModalManager + mui-button), logic tương ứng màn frmItemInventoryAvailable / frmItemReservationDetails của PMS desktop. *@

<style>
    /* Tiêu đề cột ngày gồm 3 dòng: 15-Sept / Tue / CW 38 */
    #iia_grid .dx-header-row > td { white-space: pre-line; text-align: center; font-size: 12px; }
    #iia_grid .dx-data-row > td { text-align: center; }
    #iia_grid .dx-data-row > td:first-child { text-align: left; }
    /* Dòng tổng tồn kho vật lý (Total-Physical) */
    #iia_grid .dx-data-row.iia-total-row > td { background-color: #f0ffff; }
    /* Ô ngày đang chọn */
    #iia_grid .dx-data-row > td.iia-selected-cell { background-color: rgba(120, 120, 120, 0.25) !important; font-weight: 600; }
</style>

<div class="modal fade" id="iia_modal" data-bs-backdrop="static" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content modal-full-height">
            <div class="modal-header bg-light py-2">
                <h5 class="modal-title">Item Availability</h5>
            </div>

            <div class="modal-body d-flex flex-column" style="height: calc(100vh - 120px);">
                <div class="py-2">
                    <button id="iia_btnSearch" class="mui-button mui-button-view">Search</button>
                    <button id="iia_btnDetail" class="mui-button mui-button-new" disabled>Detail</button>
                    <button class="mui-button mui-button-close" data-bs-dismiss="modal">Close</button>
                </div>

                <div class="mui-card mb-2 bg-light border-0 d-flex flex-column flex-grow-1 overflow-hidden">
                    <div class="p-2 flex-shrink-0">
                        <div class="row g-2 align-items-center">
                            <div class="col-xl-3 col-lg-4 col-md-6">
                                <div class="d-flex align-items-center gap-2">
                                    <label class="mb-0 fw-semibold text-nowrap">Item Group:</label>
                                    <select id="iia_group" class="form-select form-select-sm flex-grow-1">
                                        <option value="0">--All--</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-xl-5 col-lg-6 col-md-8">
                                <div class="d-flex align-items-center gap-2">
                                    <label class="mb-0 fw-semibold">Date:</label>
                                    <div data-date-input data-format="DD/MM/YYYY" business-date data-name="iia_date">
                                        <input type="text" class="date-ui form-control form-control-sm" placeholder="dd/mm/yyyy" autocomplete="off" />
                                    </div>
                                    <button type="button" id="iia_btnPrev" class="mui-button mui-button-new">- 15 days</button>
                                    <button type="button" id="iia_btnNext" class="mui-button mui-button-new">+ 15 days</button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="gridContainer mt-2 d-flex flex-column flex-grow-1 overflow-auto">
                        <div id="iia_grid"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ===== Chi tiết các đặt chỗ giữ Item trong một ngày ===== -->
<div class="modal fade" id="iia_detailModal" data-bs-backdrop="static" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Item Reservation</h5>
            </div>

            <div class="modal-body">
                <div class="py-2 d-flex gap-2">
                    <button type="button" id="iia_btnReservation" class="mui-button mui-button-new" disabled>Detail</button>
                    <button type="button" class="mui-button mui-button-close" data-bs-dismiss="modal">Close</button>
                </div>

                <div class="row g-2 align-items-center mb-2">
                    <div class="col-md-6">
                        <div class="d-flex align-items-center gap-2">
                            <label class="mb-0 fw-semibold text-nowrap">Item Name:</label>
                            <input type="text" id="iia_detailItem" class="form-control form-control-sm" readonly />
                        </div>
                    </div>
                    <div class="col-md-3">
                        <span class="fw-semibold">Date: <span id="iia_detailDate"></span></span>
                    </div>
                    <div class="col-md-3">
                        <span class="fw-semibold">Total quantity: <span id="iia_detailTotal">0</span></span>
                    </div>
                </div>

                <div class="gridContainer">
                    <div id="iia_detailGrid" style="height: 50vh;"></div>
                </div>
                <div id="iia_detailEmpty" class="text-muted text-center py-2 d-none">There is no reservation for this item on this date.</div>
            </div>
        </div>
    </div>
</div>

<script>
    var iia_Module = {
        selectedRowData: null,
        selectedDay: null,

        // Tên field trả về từ SP theo thứ tự 15 ngày (tham số của controller là cùng tên nhưng "eleven"/"twelve")
        dateFields: ["firstDate1", "secondDate1", "thirthDate1", "fourthDate1", "fifthDate1", "sixthDate1", "seventhDate1", "eighthDate1",
                     "ninthDate1", "tenthDate1", "eleventhDate1", "twelvethDate1", "thirtheenDate1", "fourtheenDate1", "fiftheenDate1"],
        dateParams: ["firstDate", "secondDate", "thirthDate", "fourthDate", "fifthDate", "sixthDate", "seventhDate", "eighthDate",
                     "ninthDate", "tenthDate", "elevenDate", "twelveDate", "thirtheenDate", "fourtheenDate", "fiftheenDate"],

        init: function () {
            this.initEvents();
            this.initDOMEvents();
        },

        initEvents: function () {
            const self = this;

            window.openModalItemAvailability = function () {
                self.loadGroups().always(function () { self.reloadGrid(); });

                $("#iia_modal").on("hidden.bs.modal", function () {
                    if ($("#iia_grid").data("dxDataGrid")) $("#iia_grid").dxDataGrid("dispose");
                    $("#iia_grid").empty();
                    self.selectedRowData = null;
                    self.selectedDay = null;
                    if (typeof reloadBusinessDate === "function") reloadBusinessDate();
                });

                $("#iia_detailModal").on("hidden.bs.modal", function () {
                    if ($("#iia_detailGrid").data("dxDataGrid")) $("#iia_detailGrid").dxDataGrid("dispose");
                    $("#iia_detailGrid").empty();
                });
            };
        },

        initDOMEvents: function () {
            const self = this;
            $("#iia_btnSearch").on("click", () => self.reloadGrid());
            $("#iia_group").on("change", () => self.reloadGrid());
            $("#iia_btnPrev").on("click", () => self.shiftDate(-15));
            $("#iia_btnNext").on("click", () => self.shiftDate(15));
            $("#iia_btnDetail").on("click", () => self.openDetail());
            $("#iia_btnReservation").on("click", () => self.openReservation());
        },

        // ---------------------------------------------------------------------------------------
        //  Ngày
        // ---------------------------------------------------------------------------------------
        ymd: function (d) {
            return d.getFullYear() + "-" + String(d.getMonth() + 1).padStart(2, "0") + "-" + String(d.getDate()).padStart(2, "0");
        },

        parseYmd: function (s) {
            const p = (s || "").split("T")[0].split("-");
            return new Date(parseInt(p[0], 10), parseInt(p[1], 10) - 1, parseInt(p[2], 10));
        },

        firstDate: function () {
            return this.parseYmd($("#iia_date").val() || window.dateSystem);
        },

        shiftDate: function (days) {
            const d = this.firstDate();
            d.setDate(d.getDate() + days);
            UI.setHiddenDate("iia_date", this.ymd(d));
            this.reloadGrid();
        },

        // Tiêu đề cột: "15-Sept\nTue\nCW 38" (tuần tính theo tuần chứa ngày 1/1, bắt đầu từ Chủ nhật như bản desktop)
        caption: function (d) {
            const months = ["Jan", "Feb", "Mar", "Apr", "May", "June", "July", "Aug", "Sept", "Oct", "Nov", "Dec"];
            const dows = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];
            const jan1 = new Date(d.getFullYear(), 0, 1);
            const dayOfYear = Math.round((new Date(d.getFullYear(), d.getMonth(), d.getDate()) - jan1) / 86400000);
            const cw = Math.floor((dayOfYear + jan1.getDay()) / 7) + 1;
            return d.getDate() + "-" + months[d.getMonth()] + "\n" + dows[d.getDay()] + "\nCW " + cw;
        },

        loadGroups: function () {
            return $.ajax({ url: "/RoomManagement/ItemLookups", type: "GET" }).done(function (res) {
                if (!res || res.success === false) {
                    showToast("Error", (res && res.message) || "Unable to load item groups.", false);
                    return;
                }
                const $g = $("#iia_group").empty().append('<option value="0">--All--</option>');
                (res.groups || []).forEach(g => $g.append($("<option>").val(g.ID).text(g.Code)));
            }).fail(function () { showToast("Error", "Unable to load item groups.", false); });
        },

        // ---------------------------------------------------------------------------------------
        //  Lưới
        // ---------------------------------------------------------------------------------------
        reloadGrid: function () {
            const self = this;
            const first = self.firstDate();
            if (isNaN(first)) return;

            const params = { groupId: $("#iia_group").val() || 0 };
            const days = [];
            for (let i = 0; i < 15; i++) {
                const d = new Date(first);
                d.setDate(first.getDate() + i);
                days.push(d);
                params[self.dateParams[i]] = self.ymd(d);
            }

            self.selectedRowData = null;
            self.selectedDay = null;
            $("#iia_btnDetail").prop("disabled", true);

            $.ajax({
                url: "/RoomManagement/GetItemInventoryAvailable",
                type: "GET",
                loadingGrid: "#iia_grid",
                data: params,
                success: function (data) {
                    if (!Array.isArray(data)) {
                        showToast("Error", typeof data === "string" ? data : "Unable to load data", false);
                        data = [];
                    }
                    self.renderGrid(data, days);
                },
                error: function () { showToast("Error", "Unable to load data", false); }
            });
        },

        renderGrid: function (data, days) {
            const self = this;
            const cols = [
                { dataField: "id", visible: false },
                { dataField: "itemID", visible: false },
                { dataField: "itemName", caption: "Item Name", width: 200, allowSorting: false }
            ];
            self.dateFields.forEach(function (f, i) {
                cols.push({ dataField: f, caption: self.caption(days[i]), width: 56, alignment: "center", allowSorting: false });
            });

            $("#iia_grid").dxDataGrid({
                dataSource: data,
                height: "100%",
                width: "100%",
                showBorders: true,
                hoverStateEnabled: true,
                columnAutoWidth: false,
                allowColumnResizing: true,
                // Dòng thứ 2 của mỗi Item là Total-Physical: tô màu riêng
                selection: { mode: "none" },
                scrolling: { mode: "standard", showScrollbar: "always", useNative: true },
                paging: { enabled: false },
                sorting: { mode: "none" },
                columns: cols,
                onRowPrepared: function (e) {
                    if (e.rowType === "data" && e.data.itemName === "Total-Physical") $(e.rowElement).addClass("iia-total-row");
                },
                // Bấm vào một ô ngày để chọn (Detail chỉ bật khi chọn ô ngày), bấm đúp để xem chi tiết
                onCellClick: function (e) {
                    if (e.rowType !== "data" || !e.column.dataField) return;
                    const idx = self.dateFields.indexOf(e.column.dataField);
                    $("#iia_grid .iia-selected-cell").removeClass("iia-selected-cell");
                    if (idx < 0) {
                        self.selectedRowData = null;
                        self.selectedDay = null;
                        $("#iia_btnDetail").prop("disabled", true);
                        return;
                    }
                    $(e.cellElement).addClass("iia-selected-cell");
                    self.selectedRowData = e.data;
                    self.selectedDay = days[idx];
                    $("#iia_btnDetail").prop("disabled", false);
                },
                onCellDblClick: function (e) {
                    if (e.rowType === "data" && self.dateFields.indexOf(e.column.dataField) >= 0) self.openDetail();
                }
            });
        },

        // ---------------------------------------------------------------------------------------
        //  Chi tiết đặt chỗ
        // ---------------------------------------------------------------------------------------
        openDetail: function () {
            const self = this;
            if (!self.selectedRowData || !self.selectedDay) {
                showToast("Warning", "Please select a date cell first!", false);
                return;
            }

            // id của cả dòng Item và dòng Total-Physical đều là ID của Item
            const itemId = self.selectedRowData.id;
            $("#iia_detailItem").val(self.selectedRowData.itemName === "Total-Physical" ? self.itemNameOf(itemId) : self.selectedRowData.itemName);
            $("#iia_detailDate").text(self.selectedDay.toLocaleDateString("en-GB"));
            $("#iia_btnReservation").prop("disabled", true);

            $.ajax({
                url: "/RoomManagement/GetItemResvDetail",
                type: "GET",
                data: { itemID: itemId, day: self.ymd(self.selectedDay) },
                success: function (data) {
                    if (!Array.isArray(data)) {
                        showToast("Error", typeof data === "string" ? data : "Unable to load data", false);
                        data = [];
                    }
                    self.renderDetailGrid(data);
                    $("#iia_detailModal").modal("show");
                },
                error: function () { showToast("Error", "Unable to load data", false); }
            });
        },

        // Tên Item khi chọn dòng Total-Physical: lấy từ dòng Item cùng ID
        itemNameOf: function (id) {
            const grid = $("#iia_grid").dxDataGrid("instance");
            const rows = grid ? grid.getDataSource().items() : [];
            const r = rows.find(x => x.id === id && x.itemName !== "Total-Physical");
            return r ? r.itemName : "";
        },

        renderDetailGrid: function (data) {
            const self = this;
            const total = data.reduce((s, r) => s + (parseInt(r.qty, 10) || 0), 0);
            $("#iia_detailTotal").text(total);
            $("#iia_detailEmpty").toggleClass("d-none", data.length > 0);

            if ($("#iia_detailGrid").data("dxDataGrid")) $("#iia_detailGrid").dxDataGrid("dispose");
            $("#iia_detailGrid").dxDataGrid({
                dataSource: data,
                height: "50vh",
                width: "100%",
                showBorders: true,
                hoverStateEnabled: true,
                columnAutoWidth: true,
                allowColumnResizing: true,
                selection: { mode: "single" },
                scrolling: { mode: "standard", showScrollbar: "always", useNative: true },
                paging: { pageSize: 20 },
                pager: { visible: true, allowedPageSizes: [20, 50, 100], showPageSizeSelector: true, showInfo: true, showNavigationButtons: true },
                columns: [
                    { dataField: "id", visible: false },
                    { dataField: "confirmationNo", caption: "Confirmation No", width: 130 },
                    { dataField: "name", caption: "Name", minWidth: 200 },
                    { dataField: "roomNo", caption: "Room No", width: 90 },
                    { dataField: "reservedFrom", caption: "Reserved From", dataType: "date", format: "dd/MM/yyyy", width: 120 },
                    { dataField: "reservedTo", caption: "Reserved To", dataType: "date", format: "dd/MM/yyyy", width: 120 },
                    { dataField: "qty", caption: "Qty", width: 70, alignment: "right" }
                ],
                onSelectionChanged: function (e) {
                    const row = e.selectedRowsData[0];
                    self.selectedReservationId = row ? parseInt(row.id, 10) || 0 : 0;
                    $("#iia_btnReservation").prop("disabled", !self.selectedReservationId);
                },
                onRowDblClick: function (e) {
                    self.selectedReservationId = parseInt(e.data.id, 10) || 0;
                    self.openReservation();
                }
            });
        },

        // Mở màn Reservation (popup dùng chung của layout) của dòng đang chọn
        openReservation: function () {
            const id = this.selectedReservationId;
            if (!id) return;

            const modal = $("#newReservationModal");
            modal.find(".modal-body").html('<div class="text-center py-5"><div class="spinner-border text-primary" role="status"></div><p class="mt-3">Loading reservation...</p></div>');
            modal.modal("show");

            $.ajax({
                url: "/Reservation/EncryptId", type: "POST", data: { id: id },
                success: function (response) {
                    if (!response.success) { modal.modal("hide"); showToast("Error", "Cannot open reservation.", false); return; }
                    $.ajax({
                        url: "/Reservation/NewReservation", type: "GET", data: { key: response.encryptedId }, cache: false,
                        success: function (html) { modal.find(".modal-body").html(html); },
                        error: function () { modal.find(".modal-body").html('<div class="alert alert-danger m-4">Unable to load reservation.</div>'); }
                    });
                },
                error: function () { modal.modal("hide"); showToast("Error", "Server connection error.", false); }
            });
        }
    };

    $(document).ready(function () {
        iia_Module.init();
    });
</script>
