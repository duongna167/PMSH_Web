<!-- Modal cancel-->
<div class="modal fade modal" id="modalCancel" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered cxl-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="staticBackdropLabel">Cancel Reservation</h5>
            </div>
            <div class="modal-body">
                <div class="action-buttons py-2 mb-3 border-bottom">
                    <button type="button" class="mui-button mui-button-save" onclick="CancelReservation();">OK</button>
                    <button type="button" class="mui-button mui-button-close" onclick="closeModalCancel()">Close</button>
                </div>

                <!-- Thông tin booking sắp hủy -->
                <div class="cxl-summary">
                    <div class="cxl-summary-icon"><i class="fa-solid fa-calendar-xmark"></i></div>
                    <div class="cxl-summary-body">
                        <div class="cxl-guest" id="cxlGuestName">-</div>
                        <div class="cxl-meta">
                            <span><b>Conf.No:</b> <span id="cxlConfNo">-</span></span>
                            <span><b>Room:</b> <span id="cxlRoomNo">-</span></span>
                            <span><b>Stay:</b> <span id="cxlStay">-</span></span>
                        </div>
                    </div>
                </div>

                <div class="cxl-field">
                    <label for="reasonCancel">Reason</label>
                    <select id="reasonCancel" class="form-select" asp-items="ViewBag.cboReason"></select>
                </div>
                <div class="cxl-field">
                    <label for="descriptionCancel">Description</label>
                    <textarea class="form-control" id="descriptionCancel" rows="4"
                              placeholder="Enter cancellation note..."></textarea>
                </div>
                <div class="cxl-hint">
                    <i class="fa-solid fa-circle-info"></i>
                    The booking will be moved to <b>Cancelled</b> status. Please check the reason before confirming.
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    #modalCancel .cxl-dialog { max-width: 600px; }
    #modalCancel .modal-body { padding: 14px 20px 20px; }

    #modalCancel .cxl-summary {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 12px 14px;
        margin-bottom: 16px;
        border: 1px solid #e3ebe7;
        border-radius: 10px;
        background: #f6faf8;
    }
    #modalCancel .cxl-summary-icon {
        flex: 0 0 42px;
        height: 42px;
        border-radius: 50%;
        background: #fde8e8;
        color: #dc2626;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
    }
    #modalCancel .cxl-guest {
        font-size: 15px;
        font-weight: 700;
        color: #1f2937;
        margin-bottom: 3px;
    }
    #modalCancel .cxl-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 4px 18px;
        font-size: 13px;
        color: #4b5563;
    }
    #modalCancel .cxl-meta b { color: #2f5d4a; font-weight: 600; }

    #modalCancel .cxl-field { margin-bottom: 14px; }
    #modalCancel .cxl-field label {
        display: block;
        font-size: 13px;
        font-weight: 600;
        color: #2f5d4a;
        margin-bottom: 6px;
    }
    #modalCancel .cxl-req { color: #dc2626; }
    #modalCancel .cxl-field .form-select,
    #modalCancel .cxl-field .form-control {
        font-size: 14px;
        border-radius: 8px;
        border-color: #cfd8d3;
    }
    #modalCancel .cxl-field .form-select { height: 38px; }
    #modalCancel .cxl-field textarea {
        resize: vertical;
        height: 96px !important;
        min-height: 72px;
        max-height: 200px;
    }
    #modalCancel .cxl-field .form-select:focus,
    #modalCancel .cxl-field .form-control:focus {
        border-color: #63af90;
        box-shadow: 0 0 0 3px rgba(99, 175, 144, .18);
    }
    #modalCancel .cxl-hint {
        font-size: 12.5px;
        color: #92400e;
        background: #fffbeb;
        border: 1px solid #fde68a;
        border-radius: 8px;
        padding: 8px 12px;
    }
    #modalCancel .cxl-hint i { margin-right: 6px; color: #d97706; }
</style>

<style>
    .cf-overlay {
        position: fixed;
        inset: 0;
        background: rgba(15, 23, 42, 0.4);
        z-index: 99999;
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0;
        transition: opacity .15s ease;
    }
    .cf-overlay.cf-show { opacity: 1; }
    .cf-box {
        background: #fff;
        width: 380px;
        max-width: calc(100vw - 32px);
        border-radius: 12px;
        border-top: 4px solid #f59e0b;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.22);
        overflow: hidden;
        transform: translateY(8px) scale(.97);
        transition: transform .15s ease;
    }
    .cf-overlay.cf-show .cf-box { transform: none; }
    .cf-body {
        display: flex;
        gap: 14px;
        padding: 22px 22px 10px;
    }
    .cf-icon {
        flex: 0 0 38px;
        height: 38px;
        border-radius: 50%;
        background: #fef3c7;
        color: #d97706;
        font-weight: 800;
        font-size: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .cf-title {
        font-weight: 700;
        font-size: 15px;
        color: #1f2937;
        margin-bottom: 4px;
    }
    .cf-message {
        font-size: 13.5px;
        color: #4b5563;
        line-height: 1.6;
        white-space: pre-line;
    }
    .cf-footer {
        display: flex;
        justify-content: flex-end;
        gap: 8px;
        padding: 14px 22px 18px;
    }
    .cf-btn {
        min-width: 84px;
        padding: 7px 18px;
        border-radius: 6px;
        border: 1px solid transparent;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        transition: background .15s ease;
    }
    .cf-btn-no { background: #f3f4f6; color: #374151; border-color: #e5e7eb; }
    .cf-btn-no:hover { background: #e5e7eb; }
    .cf-btn-yes { background: #63af90; color: #fff; }
    .cf-btn-yes:hover { background: #4f9a7c; }
    .cf-btn:focus-visible { outline: 2px solid #93c5fd; outline-offset: 2px; }
</style>

<script>
    function openModalCancel(){
        if(idReservation == 0){
            showToast('Warning', 'Please choose booking', false);
            return;
        }
        if(reservationStatus != 5 && reservationStatus!= 0 && reservationStatus != 1){
            showToast('Error', 'Cannot cancel because booking is not in Reservation status', false);
            return;
        }
        if (reservationStatus == 1) {
            showCancelConfirmDialog('Confirmation', 'Do you want to change room to dirty?')
                .then(function (ok) {
                    if (ok) CancelReservation(true);
                });
            return;
        }

        fillCancelSummary();
        $('#modalCancel').modal('show');
        reloadGrid();
    }

    // Hiển thị thông tin booking đang hủy (lấy từ dòng đang chọn trên Search Reservation)
    // Lấy thẳng từ server theo booking đang chọn (không phụ thuộc biến dùng chung trên trang)
    function fillCancelSummary() {
        $('#cxlGuestName').text('Loading...');
        $('#cxlConfNo, #cxlRoomNo, #cxlStay').text('-');
        const rid = parseInt(idReservation, 10) || 0;
        if (rid <= 0) { $('#cxlGuestName').text('-'); return; }

        const fmtDate = function (d) {
            if (!d) return '';
            const m = String(d).match(/^(\d{4})-(\d{2})-(\d{2})/);
            return m ? m[3] + '/' + m[2] + '/' + m[1] : String(d);
        };
        const guestName = function (last, first) {
            last = (last || '').trim(); first = (first || '').trim();
            // LastName đã là tên đầy đủ dạng "Họ, Tên" -> bỏ dấu phẩy, không ghép thêm FirstName
            if (last.indexOf(',') >= 0) return last.replace(/\s*,\s*/, ' ').replace(/\s+/g, ' ');
            return (first && !last.toLowerCase().endsWith(first.toLowerCase())) ? (last + ' ' + first).trim() : last;
        };

        $.ajax({
            url: '/Reservation/GetReservationByID',
            type: 'GET',
            data: { ID: rid },
            success: function (r) {
                if (!r || typeof r !== 'object') { $('#cxlGuestName').text('-'); return; }
                const pick = function (a, b) { return r[a] != null ? r[a] : r[b]; };
                const arr = fmtDate(pick('arrivalDate', 'ArrivalDate'));
                const dep = fmtDate(pick('departureDate', 'DepartureDate'));
                $('#cxlGuestName').text(guestName(pick('lastName', 'LastName'), pick('firstName', 'FirstName')) || '-');
                $('#cxlConfNo').text(pick('confirmationNo', 'ConfirmationNo') || '-');
                $('#cxlRoomNo').text(pick('roomNo', 'RoomNo') || '-');
                $('#cxlStay').text(arr || dep ? (arr || '?') + ' → ' + (dep || '?') : '-');
            },
            error: function () { $('#cxlGuestName').text('-'); }
        });
    }

    // Mở xong popup -> focus vào ô Reason để chọn nhanh
    $(document).off('shown.bs.modal.cxl', '#modalCancel')
        .on('shown.bs.modal.cxl', '#modalCancel', function () {
            $('#reasonCancel').trigger('focus');
        });

    function showCancelConfirmDialog(title, message) {
        return new Promise(function (resolve) {
            var el = document.createElement('div');
            el.className = 'cf-overlay';
            el.innerHTML =
                '<div class="cf-box" role="dialog" aria-modal="true">' +
                  '<div class="cf-body">' +
                    '<div class="cf-icon">!</div>' +
                    '<div class="cf-content">' +
                      '<div class="cf-title"></div>' +
                      '<div class="cf-message"></div>' +
                    '</div>' +
                  '</div>' +
                  '<div class="cf-footer">' +
                    '<button type="button" class="cf-btn cf-btn-no">Cancel</button>' +
                    '<button type="button" class="cf-btn cf-btn-yes">OK</button>' +
                  '</div>' +
                '</div>';
            el.querySelector('.cf-title').textContent = title;
            el.querySelector('.cf-message').textContent = message;
            document.body.appendChild(el);
            requestAnimationFrame(function () { el.classList.add('cf-show'); });

            var onKey = function (e) {
                if (e.key === 'Escape') { e.preventDefault(); done(false); }
                else if (e.key === 'Enter') { e.preventDefault(); done(true); }
            };
            var done = function (result) {
                if (!el.parentNode) return;
                document.removeEventListener('keydown', onKey, true);
                el.classList.remove('cf-show');
                setTimeout(function () { el.remove(); }, 150);
                resolve(result);
            };
            document.addEventListener('keydown', onKey, true);
            el.querySelector('.cf-btn-yes').addEventListener('click', function () { done(true); });
            el.querySelector('.cf-btn-no').addEventListener('click', function () { done(false); });
            el.querySelector('.cf-btn-yes').focus();
        });
    }

    function closeModalCancel(){
        clearCancel();
        $('#modalCancel').modal('hide');
    }

    $('#reasonCancel').on('change', function() {
        const text = ($(this).find('option:selected').text() || '');
        const parts = text.split('-');
        const desc = (parts.length > 1 ? parts.slice(1).join('-') : '').trim();
        $('#descriptionCancel').val(desc);
    });

    function reloadGrid(reservationID) {

            $.ajax({
                url: '/Reservation/FindCancelReservation',
                type: 'GET',
                data: {reservationID:idReservation},
                success: function (result) {
                    const rows = result?.data || [];
                    gridCancel(rows);
                    // Không hiển thị warning khi chưa có lịch sử cancel
                },
                error: function () {
                    showToast("Error", "Cannot load data.", false);
                }
            });
        }

    function gridCancel(data) {
    gridRateCodes = $("#cancel_grid").dxDataGrid({
        dataSource: data,
        showBorders: true,
        width: "100%",
        height: "100%",
        selection: { mode: "single" },
        paging: { pageSize: 20 },
        pager: {
            visible: true,
            showPageSizeSelector: true,
            allowedPageSizes: [20, 50, 100, "all"],
            showInfo: true,
            showNavigationButtons: true
        },
        filterRow: { visible: true, applyFilter: "auto" },
        columns: [
            { dataField: "ID", visible: false },
            { dataField: "CancellationNo", caption: "Cancel No", minWidth: 120,cssClass: "col-description" },
            { dataField: "ReasonCancellation", caption: "Code", width: 140 },
            { dataField: "Description", caption: "Description", dataType: "date", format: "dd/MM/yyyy", width: 80 },
            { dataField: "LoginName", caption: "User", dataType: "date", format: "dd/MM/yyyy", width: 80 },
            { dataField: "CreateDate", caption: "Date", dataType: "date", format: "dd/MM/yyyy", width: 80 }
        ],
    }).dxDataGrid("instance");
}

    function clearCancel(){
        $('#reasonCancel').val('');
        $('#descriptionCancel').val('');
    }
    function CancelReservation(changeRoomToDirty) {

        const userName = JSON.parse(localStorage.getItem("Loginname"));
        const userID = JSON.parse(localStorage.getItem("userID"));
        var formData = new FormData();
        formData.append('rsvID', idReservation);
        formData.append('reasonCancellation', $('#reasonCancel').val() || '');
        formData.append('description', $('#descriptionCancel').val() || '');
        formData.append('userID', userID);
        formData.append('userName', userName);
        formData.append('changeRoomToDirty', changeRoomToDirty);
        $.ajax({
            url: '/Reservation/CancelReservation',
            type: 'POST',
            processData: false,
            contentType: false,
            // headers: { "X-CSRF-TOKEN-HEADERNAME": jQuery("input[name='__RequestVerificationToken']").val() },
            data: formData,
            success: function (data) {
                if (data.code == 0) {
                    closeModalCancel();
                    showToast('Success', data.msg, true);
                    searchReservation();
                } else {
                    showToast('Error', data.msg, false);
                }

            },
            error: function (xhr, statusText, err) {

            }
        });

    }

</script>
