@using DevExpress.XtraReports.UI

@{
    ViewBag.Title = ViewBag.ReportHeader;
    var rmAva_zoneList = ViewBag.ZoneList;
    var rmAva_restyList = ViewBag.ReservationType;
}

<!-- Main Modal -->
<div class="modal fade" id="rmAva_mainModal" tabindex="-1" aria-labelledby="rmAva_mainModalLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-fullscreen">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="rmAva_mainModalLabel">Room Availability</h5>
            </div>

            <div class="modal-body">
                <div class="search-filter">
                    <div>
                        <button id="rmAva_btnPrint" type="button" class="mui-button mui-button-new">View</button>
                        <button id="rmAva_btnExportExcel" type="button" class="mui-button mui-button-new">Excel</button>
                        <button id="rmAva_btnDetail" type="button" class="mui-button mui-button-new">Detail</button>
                        <button id="rmAva_btnColor" type="button" class="mui-button mui-button-new">Color</button>
                        <button id="rmAva_btnText" type="button" class="mui-button mui-button-new">Text</button>
                        <button id="rmAva_btnAllotment" type="button" class="mui-button mui-button-new" data-code="resv_ReservationAllotmentReport">View Allotment</button>
                        <button id="rmAva_btnClose" type="button" data-bs-dismiss="modal" class="mui-button mui-button-new">Close</button>
                    </div>

                    <div class="d-flex flex-wrap align-items-center gap-2 mt-1 filter-panel">
                        <!-- From Date -->

                        <div class="container-fluid px-0">
                            <div class="row g-2 align-items-center">

                                <!-- From Date -->
                                <div class="col-auto">
                                    <label class="col-form-label mb-0">From :</label>
                                </div>
                                <div class="col-auto">
                                    <div style="width:140px;" data-date-input data-format="DD/MM/YYYY" data-name="rmAva_fromDate" business-date>
                                        <input type="text" class="date-ui form-control form-control-sm"
                                            placeholder="dd/mm/yyyy" autocomplete="off" />
                                    </div>
                                </div>

                                <!-- Display No of Days -->
                                <div class="col-auto">
                                    <label class="col-form-label mb-0">Display No of Days:</label>
                                </div>
                                <div class="col-auto">
                                    <select id="rmAva_displayOfDay" name="rmAva_displayOfDay" class="form-control form-control-sm">
                                        <option value="0"></option>
                                        <option value="1">1</option>
                                        <option value="2">2</option>
                                        <option value="3">3</option>
                                        <option value="4">4</option>
                                        <option value="5">5</option>
                                        <option value="10">10</option>
                                        <option value="15">15</option>
                                        <option value="20">20</option>
                                        <option value="28">28</option>
                                        <option value="30">30</option>
                                        <option value="31">31</option>
                                    </select>
                                </div>

                                <!-- Zone -->
                                <div class="col-auto">
                                    <label class="col-form-label mb-0">Zone:</label>
                                </div>
                                <div class="col-md-3 col-sm-6">
                                    <select id="rmAva_zone" name="rmAva_zone" class="tomselect-custom" multiple>
                                        @foreach (var item in rmAva_zoneList)
                                        {
                                            if (item == rmAva_zoneList[0])
                                            {
                                                <option value="@item.Code" selected>@item.Code</option>
                                            }
                                            else
                                            {
                                                <option value="@item.Code">@item.Code</option>
                                            }
                                        }
                                    </select>
                                </div>

                                <!-- Res.Type -->
                                <div class="col-auto">
                                    <label class="col-form-label mb-0">Res.Type:</label>
                                </div>
                                <div class="col-md-3 col-sm-6">
                                    <select id="rmAva_resType" name="rmAva_resType" class="tomselect-custom" multiple>
                                        @foreach (var item in rmAva_restyList)
                                        {
                                            <option value="@item.ID">@item.Name</option>
                                        }
                                    </select>
                                </div>

                            </div>
                        </div>

                        <div class="container-fluid px-0 mt-2">
                            <div class="row g-3">

                                <div class="col-auto d-flex align-items-center gap-2">
                                    <span class="status-color-box color-clean-uncheck"></span>
                                    <input type="checkbox" id="rmAva_showNonDeduct" name="includeOptions" value="1">
                                    <label class="form-check-label mb-0" for="rmAva_showNonDeduct">Show Non Deduct</label>
                                </div>

                                <div class="col-auto d-flex align-items-center gap-2">
                                    <input type="checkbox" id="rmAva_showOcc3" name="includeOptions" value="1">
                                    <label class="form-check-label mb-0" for="rmAva_showOcc3">Show %Occ3</label>
                                </div>

                                <div class="col-auto d-flex align-items-center gap-2">
                                    <input type="checkbox" id="rmAva_showRoomNight" name="includeOptions" value="1">
                                    <label class="form-check-label mb-0" for="rmAva_showRoomNight">Show Room Night</label>
                                </div>

                                <div class="col-auto d-flex align-items-center gap-2">
                                    <input type="checkbox" id="rmAva_includeOutOfOrder" name="includeOptions" value="1"
                                        checked>
                                    <label class="form-check-label mb-0" for="rmAva_includeOutOfOrder">
                                        Include Out of Order
                                    </label>
                                </div>

                                <div class="col-auto d-flex align-items-center gap-2">
                                    <input type="checkbox" id="rmAva_includeOverbooking" name="includeOptions" value="1">
                                    <label class="form-check-label mb-0" for="rmAva_includeOverbooking">
                                        Include Overbooking
                                    </label>
                                </div>

                                <div class="col-auto d-flex align-items-center gap-2">
                                    <input type="checkbox" id="rmAva_includeAllotment" name="includeOptions" value="1"
                                        checked>
                                    <label class="form-check-label mb-0" for="rmAva_includeAllotment">
                                        Include Allotment
                                    </label>
                                </div>

                            </div>
                        </div>

                    </div>
                </div>

                <div class="mui-card mt-1">
                    <div id="rmAva_gridContainer" class="gridContainer"></div>
                </div>

            </div>
        </div>
    </div>
</div>

<style>
    /* Ô đang chọn để xem Detail */
    #rmAva_gridContainer td.rmAva-picked { outline: 2px solid #027C75; outline-offset: -2px; background-color: #d9f2ef !important; }
</style>

<!-- Room Available Resvs Detail -->
<div class="modal fade" id="rmAva_detailModal" tabindex="-1" aria-labelledby="rmAva_detailTitle" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content" style="height:auto !important; max-height:none !important;">
            <div class="modal-header">
                <h5 class="modal-title" id="rmAva_detailTitle">Room Available Resvs Detail</h5>
            </div>
            <div class="modal-body" style="overflow:visible; padding:12px;">
                <div class="mb-2">
                    <button type="button" class="mui-button mui-button-new" data-bs-dismiss="modal">Close</button>
                </div>
                <div id="rmAva_detailGrid"></div>
            </div>
        </div>
    </div>
</div>

<!-- Room Availability Color / Text: dùng chung một hộp thoại -->
<div class="modal fade" id="rmAva_noteModal" tabindex="-1" aria-labelledby="rmAva_noteTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 640px;">
        <div class="modal-content" style="height:auto !important; max-height:none !important;">
            <div class="modal-header">
                <h5 class="modal-title" id="rmAva_noteTitle">Room Availability Color</h5>
            </div>
            <div class="modal-body" style="overflow:visible; padding:12px;">
                @Html.AntiForgeryToken()
                <div class="mb-2">
                    <button type="button" class="mui-button mui-button-new" id="rmAva_noteSave">Save</button>
                    <button type="button" class="mui-button mui-button-new" data-bs-dismiss="modal">Close</button>
                </div>
                <div class="d-flex flex-wrap align-items-center gap-3 mb-2">
                    <label class="d-flex align-items-center gap-2 mb-0 text-nowrap">From Date
                        <input type="date" id="rmAva_noteFrom" class="form-control form-control-sm" style="width:150px;">
                    </label>
                    <label class="d-flex align-items-center gap-2 mb-0 text-nowrap">To Date
                        <input type="date" id="rmAva_noteTo" class="form-control form-control-sm" style="width:150px;">
                    </label>
                    <div class="d-flex align-items-center gap-2" data-note="color">
                        <span>Color</span>
                        <input type="color" id="rmAva_noteColor" class="form-control form-control-color form-control-sm" value="#00ff00" aria-label="Color">
                        <label class="mb-0 text-nowrap"><input type="checkbox" id="rmAva_noteNoColor"> No color</label>
                    </div>
                </div>
                <!-- value theo DayOfWeek: 0 = Sunday -->
                <div class="d-flex flex-wrap justify-content-center gap-3 mb-2" id="rmAva_noteDays">
                    <label class="mb-0"><input type="checkbox" value="1" checked> Mon</label>
                    <label class="mb-0"><input type="checkbox" value="2" checked> Tue</label>
                    <label class="mb-0"><input type="checkbox" value="3" checked> Wed</label>
                    <label class="mb-0"><input type="checkbox" value="4" checked> Thur</label>
                    <label class="mb-0"><input type="checkbox" value="5" checked> Fri</label>
                    <label class="mb-0"><input type="checkbox" value="6" checked> Sat</label>
                    <label class="mb-0"><input type="checkbox" value="0" checked> Sun</label>
                </div>
                <div class="d-flex gap-2 mb-2" data-note="text">
                    <label for="rmAva_noteDescription" class="mb-0">Description</label>
                    <textarea id="rmAva_noteDescription" class="form-control form-control-sm" rows="2" maxlength="200"></textarea>
                </div>
                <div id="rmAva_noteGrid"></div>
            </div>
        </div>
    </div>
</div>

<!-- View Report By... (Go To Allotment bên WinForms) -->
<div class="modal fade" id="rmAva_allotModal" tabindex="-1" aria-labelledby="rmAva_allotTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 600px;">
        <div class="modal-content" style="height:auto !important; max-height:none !important;">
            <div class="modal-header">
                <h5 class="modal-title" id="rmAva_allotTitle">View Report By...</h5>
            </div>
            <!-- Cao theo nội dung để không bị cắt mất dòng lựa chọn cuối -->
            <div class="modal-body" style="overflow:visible; padding:12px 12px 20px;">
                <div class="mb-3">
                    <button type="button" class="mui-button mui-button-new" id="rmAva_allotOk">OK</button>
                    <button type="button" class="mui-button mui-button-new" data-bs-dismiss="modal">Close</button>
                </div>
                <div style="display:grid; grid-template-columns:1fr 1fr; gap:8px 24px;">
                    <label><input type="radio" name="rmAva_allotBy" value="allotType" checked> By Allotment Type</label>
                    <label><input type="radio" name="rmAva_allotBy" value="profile"> By Profile</label>
                    <label><input type="radio" name="rmAva_allotBy" value="roomType"> By Room Type</label>
                    <label><input type="radio" name="rmAva_allotBy" value="roomTypeDetail"> By Room Type Detail</label>
                    <label style="grid-column:1 / -1;"><input type="radio" name="rmAva_allotBy" value="typeDetail"> By Allotment Type Detail</label>
                    <label style="grid-column:1 / -1;"><input type="radio" name="rmAva_allotBy" value="typeAndRoom"> By Allotment Type and Room Type</label>
                    <label style="grid-column:1 / -1;"><input type="radio" name="rmAva_allotBy" value="groupAllotment"> By Allotment Type and Room Type Group By Allotment</label>
                    <label style="grid-column:1 / -1;"><input type="radio" name="rmAva_allotBy" value="groupRoomType"> By Allotment Type and Room Type Group By Room Type</label>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="rmAva_allotResultModal" tabindex="-1" aria-labelledby="rmAva_allotResultTitle" aria-hidden="true">
    <div class="modal-dialog modal-fullscreen">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="rmAva_allotResultTitle">Allotment</h5>
            </div>
            <div class="modal-body">
                <div class="mb-2">
                    <button type="button" class="mui-button mui-button-new" id="rmAva_allotExcel">Excel</button>
                    <button type="button" class="mui-button mui-button-new" data-bs-dismiss="modal">Close</button>
                </div>
                <div id="rmAva_allotGrid"></div>
            </div>
        </div>
    </div>
</div>

<script>
    var rmAva_Module = (() => {
        let rmAva_selectedRowData = null;
        let rmAva_parsedBusinessDate = null;

        const rmAva_selectors = {
            mainModal: "#rmAva_mainModal",
            grid: "#rmAva_gridContainer",

            btnPrint: "#rmAva_btnPrint",
            btnExportExcel: "#rmAva_btnExportExcel",

            displayOfDay: "#rmAva_displayOfDay",
            zone: "#rmAva_zone",
            resType: "#rmAva_resType",

            showNonDeduct: "#rmAva_showNonDeduct",
            showOcc3: "#rmAva_showOcc3",
            showRoomNight: "#rmAva_showRoomNight",
            includeOutOfOrder: "#rmAva_includeOutOfOrder",
            includeOverbooking: "#rmAva_includeOverbooking",
            includeAllotment: "#rmAva_includeAllotment",

            fromDate: "#rmAva_fromDate"
        };

        function rmAva_init() {
            initTomSelect(".tomselect-custom");
            rmAva_bindEvents();
        }

        function rmAva_bindEvents() {

            $(document)
                .off("click.rmAvaNote change.rmAvaNote")
                .on("click.rmAvaNote", "#rmAva_btnDetail", rmAva_openDetail)
                .on("click.rmAvaNote", "#rmAva_btnColor", () => rmAva_openNote("color"))
                .on("click.rmAvaNote", "#rmAva_btnText", () => rmAva_openNote("text"))
                .on("click.rmAvaNote", "#rmAva_noteSave", rmAva_saveNote)
                .on("change.rmAvaNote", "#rmAva_noteFrom, #rmAva_noteTo", rmAva_loadNoteList);

            $(document)
                .off("click.rmAvaAllot")
                .on("click.rmAvaAllot", "#rmAva_btnAllotment", function () {
                    bootstrap.Modal.getOrCreateInstance(document.getElementById("rmAva_allotModal"), { backdrop: "static" }).show();
                })
                .on("click.rmAvaAllot", "#rmAva_allotOk", rmAva_loadAllotment)
                .on("click.rmAvaAllot", "#rmAva_allotExcel", rmAva_exportAllotment);

            $(document)
                .off("click", rmAva_selectors.btnPrint)
                .on("click", rmAva_selectors.btnPrint, function () {
                    rmAva_loadReport();
                });

            $(document)
                .off("click", rmAva_selectors.btnExportExcel)
                .on("click", rmAva_selectors.btnExportExcel, function () {
                    rmAva_exportExcel();
                });

            $(document)
                .off("click", "#rmAva_btnExportPdf")
                .on("click", "#rmAva_btnExportPdf", function () {
                    rmAva_exportPdf();
                });
        }

        // ===== Set Color / Set Text theo ngày (hiện trên tiêu đề cột ngày) =====
        let rmAva_notes = {};          // 'yyyy-MM-dd' -> { color, description }
        let rmAva_range = null;        // khoảng ngày đang hiển thị trên bảng
        let rmAva_noteType = "color";

        function rmAva_isoDate(date) {
            return [date.getFullYear(), String(date.getMonth() + 1).padStart(2, "0"), String(date.getDate()).padStart(2, "0")].join("-");
        }

        function rmAva_fetchNotes(fromDate, toDate) {
            return $.get("/HouseKeeping/GetRoomAvailabilityNotes", { fromDate: fromDate, toDate: toDate });
        }

        // Một ngày có thể có nhiều dòng (dữ liệu cũ): lấy giá trị khác rỗng sau cùng
        function rmAva_setNotes(list) {
            rmAva_notes = {};
            (list || []).forEach(function (item) {
                const note = rmAva_notes[item.date] || (rmAva_notes[item.date] = {});
                if (item.color) note.color = item.color;
                if (item.description) note.description = item.description;
            });
        }

        // Tải lại màu/ghi chú rồi vẽ lại tiêu đề, không tải lại số liệu
        function rmAva_refreshNotes() {
            if (!rmAva_range) return;
            rmAva_fetchNotes(rmAva_range.from, rmAva_range.to).done(function (list) {
                rmAva_setNotes(list);
                $(rmAva_selectors.grid).dxDataGrid("instance")?.repaint();
            });
        }

        function rmAva_openNote(type) {
            rmAva_noteType = type;
            $("#rmAva_noteTitle").text(type === "color" ? "Room Availability Color" : "Room Availability Text");
            $("#rmAva_noteModal [data-note]").each(function () {
                // d-flex của Bootstrap dùng !important nên phải đổi class thay vì .hide()
                const visible = this.dataset.note === type;
                $(this).toggleClass("d-flex", visible).toggleClass("d-none", !visible);
            });
            const fromDate = $(rmAva_selectors.fromDate).val();
            $("#rmAva_noteFrom, #rmAva_noteTo").val(fromDate);
            $("#rmAva_noteDescription").val("");
            $("#rmAva_noteNoColor").prop("checked", false);
            $("#rmAva_noteDays input").prop("checked", true);

            const modal = document.getElementById("rmAva_noteModal");
            $(modal).off("shown.bs.modal.rmAva").one("shown.bs.modal.rmAva", rmAva_loadNoteList);
            bootstrap.Modal.getOrCreateInstance(modal, { backdrop: "static" }).show();
        }

        function rmAva_loadNoteList() {
            const fromDate = $("#rmAva_noteFrom").val(), toDate = $("#rmAva_noteTo").val();
            const show = function (rows) {
                $("#rmAva_noteGrid").addClass("gridContainer").dxDataGrid({
                    dataSource: rows, height: 260, showBorders: true, showRowLines: true, noDataText: "",
                    paging: { enabled: false }, selection: { mode: "single" },
                    columns: [
                        { dataField: "date", caption: "Date", dataType: "date", format: "dd/MM/yy", width: 100 },
                        { dataField: "description", caption: "Description" },
                        { dataField: "dayOfWeek", caption: "Day Of Week", width: 110 },
                        {
                            dataField: "color", caption: "Color", width: 70,
                            cellTemplate: function (container, options) {
                                if (options.value) container.css("background-color", options.value);
                            }
                        }
                    ],
                    // Bấm vào một dòng để sửa lại đúng ngày đó
                    onRowClick: function (e) {
                        if (e.rowType !== "data") return;
                        $("#rmAva_noteFrom, #rmAva_noteTo").val(e.data.date);
                        $("#rmAva_noteDescription").val(e.data.description || "");
                        if (e.data.color) $("#rmAva_noteColor").val(e.data.color);
                    }
                });
            };
            if (!fromDate || !toDate || toDate < fromDate) return show([]);
            rmAva_fetchNotes(fromDate, toDate)
                .done(list => show(list.filter(x => x.color || x.description)))
                .fail(() => { show([]); showToast("Error", "Cannot load color and text.", false); });
        }

        function rmAva_saveNote() {
            const button = $("#rmAva_noteSave").prop("disabled", true);
            $.ajax({
                url: "/HouseKeeping/SaveRoomAvailabilityNotes", type: "POST", traditional: true,
                data: {
                    type: rmAva_noteType,
                    fromDate: $("#rmAva_noteFrom").val(),
                    toDate: $("#rmAva_noteTo").val(),
                    weekdays: $("#rmAva_noteDays input:checked").map(function () { return this.value; }).get(),
                    color: $("#rmAva_noteNoColor").is(":checked") ? "" : $("#rmAva_noteColor").val(),
                    description: $("#rmAva_noteDescription").val(),
                    __RequestVerificationToken: $("#rmAva_noteModal input[name='__RequestVerificationToken']").val()
                }
            })
                .done(function () {
                    showToast("Success", "Saved successfully!", true);
                    rmAva_loadNoteList();
                    rmAva_refreshNotes();
                })
                .fail(function (xhr) {
                    showToast("Warning", xhr.responseJSON?.message || xhr.responseJSON?.msg || "Cannot save.", false);
                })
                .always(() => button.prop("disabled", false));
        }

        // Tô màu và ghi chú lên tiêu đề cột của ngày
        function rmAva_paintHeader(e) {
            if (e.rowType !== "header" || !e.column.isoDate) return;
            const note = rmAva_notes[e.column.isoDate];
            const cell = e.cellElement[0];
            if (note?.color) {
                const rgb = parseInt(note.color.slice(1), 16);
                const dark = ((rgb >> 16) * 299 + ((rgb >> 8) & 255) * 587 + (rgb & 255) * 114) / 1000 < 128;
                cell.style.setProperty("background-color", note.color, "important");
                cell.style.setProperty("color", dark ? "#fff" : "#000", "important");
            }
            if (note?.description) {
                cell.title = note.description;
                $(cell).find(".rmAva-note").text(note.description);
            }
        }

        // ===== Detail: các booking của loại phòng (dòng) trong ngày (cột) đang chọn =====
        let rmAva_picked = null;       // { roomType, date }

        function rmAva_pickCell(e) {
            if (e.rowType !== "data" || !e.column.isoDate) return;
            rmAva_picked = { roomType: e.data.roomType, date: e.column.isoDate };
            $(rmAva_selectors.grid).find("td.rmAva-picked").removeClass("rmAva-picked");
            $(e.cellElement).addClass("rmAva-picked");
        }

        function rmAva_openDetail() {
            if (!rmAva_picked) {
                showToast("Warning", "Please select a cell: a room type row and a date column.", false);
                return;
            }
            const picked = rmAva_picked;
            const button = $("#rmAva_btnDetail").prop("disabled", true);
            $.get("/HouseKeeping/GetRoomAvailabilityDetail", { roomTypeCode: picked.roomType, date: picked.date })
                .done(function (rows) {
                    const day = picked.date.split("-").reverse().join("/");
                    $("#rmAva_detailTitle").text("Room Available Resvs Detail - " + picked.roomType + " - " + day);
                    const modal = document.getElementById("rmAva_detailModal");
                    $(modal).off("shown.bs.modal.rmAva").one("shown.bs.modal.rmAva", function () {
                        const dateColumn = (field, caption) => ({ dataField: field, caption: caption, dataType: "date", format: "dd/MM/yyyy", width: 100 });
                        $("#rmAva_detailGrid").addClass("gridContainer").dxDataGrid({
                            dataSource: rows, height: "60vh", showBorders: true, showRowLines: true, noDataText: "No data",
                            allowColumnResizing: true, columnResizingMode: "widget",
                            paging: { enabled: false }, selection: { mode: "single" },
                            columns: [
                                { dataField: "index", caption: "Index", width: 60, alignment: "center" },
                                { dataField: "confirmationNo", caption: "Conf. No", width: 100 },
                                { dataField: "crsNo", caption: "CRSNo", width: 100 },
                                { dataField: "type", caption: "Type", width: 120 },
                                { dataField: "room", caption: "Room", width: 90 },
                                { dataField: "noOfRoom", caption: "N.Rms", width: 70, alignment: "center" },
                                { dataField: "profile", caption: "Profile", minWidth: 180 },
                                dateColumn("fromDate", "From Date"),
                                dateColumn("toDate", "To Date")
                            ],
                            summary: { totalItems: [{ name: "total", column: "noOfRoom", summaryType: "sum", showInColumn: "profile", alignment: "left", displayFormat: "Total Rooms: {0}" }] }
                        });
                    });
                    bootstrap.Modal.getOrCreateInstance(modal, { backdrop: "static" }).show();
                })
                .fail(function (xhr) {
                    showToast("Warning", xhr.responseJSON?.message || xhr.responseJSON?.msg || "Cannot load detail.", false);
                })
                .always(() => button.prop("disabled", false));
        }

        // ===== View Allotment: dùng lại dữ liệu của màn Allotment Report =====
        const rmAva_allotViews = {
            allotType: { title: "By Allotment Type", params: { byAllotmentType: 0 }, labels: ["AllotmentType"] },
            roomType: { title: "By Room Type", params: { byAllotmentType: 1 }, labels: ["RoomType"] },
            typeDetail: { title: "By Allotment Type Detail", params: { byAllotmentDetail: 1 }, labels: ["AllotmentType", "AllotmentCode", "AccountName"] },
            typeAndRoom: { title: "By Allotment Type and Room Type", params: { byAllotmentandRoomType: 1 }, labels: ["RoomType"] },
            groupAllotment: { title: "By Allotment Type and Room Type Group By Allotment", params: { byAllotmentandRoomTypeGroupbyAll: 1 }, labels: ["AllotmentCode", "AccountName", "RoomType"], group: "AccountName" },
            groupRoomType: { title: "By Allotment Type and Room Type Group By Room Type", params: { byAllotmentandRoomTypeGroupbyRT: 1 }, labels: ["RoomType", "AllotmentCode", "AccountName"], group: "RoomType" },
            profile: { title: "By Profile", params: { byProfile: 1 }, labels: ["ProfileCode", "Account", "Code"] },
            roomTypeDetail: { title: "By Room Type Detail", params: { byRoomtypedetail: 1 }, labels: ["RoomType", "AllotmentCode", "AccountName"], group: "RoomType" }
        };
        const rmAva_labelCaptions = {
            AllotmentType: "Allotment Type", RoomType: "Room Type", AllotmentCode: "Allotment Code",
            AccountName: "Account Name", ProfileCode: "Profile Code", Account: "Account", Code: "Code"
        };
        let rmAva_allotRequest = null;

        function rmAva_loadAllotment() {
            const key = $("input[name='rmAva_allotBy']:checked").val();
            const view = rmAva_allotViews[key];
            const fromDate = $(rmAva_selectors.fromDate).val();
            if (!fromDate) {
                showToast("Warning", "Please select a From date.", false);
                return;
            }

            // Dữ liệu đặt tên cột theo số ngày nên khoảng ngày không được có 2 ngày trùng số
            const wanted = Number($(rmAva_selectors.displayOfDay).val()) || 30;
            const cursor = new Date(fromDate + "T00:00:00"), seen = new Set();
            while (seen.size <= wanted && !seen.has(cursor.getDate())) {
                seen.add(cursor.getDate());
                cursor.setDate(cursor.getDate() + 1);
            }
            const days = seen.size - 1;

            bootstrap.Modal.getInstance(document.getElementById("rmAva_allotModal"))?.hide();
            $("#rmAva_allotResultTitle").text("Allotment - " + view.title);

            const resultModal = document.getElementById("rmAva_allotResultModal");
            // Đóng bảng kết quả thì quay lại màn chọn "View Report By..."
            $(resultModal).off("hidden.bs.modal.rmAva").one("hidden.bs.modal.rmAva", function () {
                if (rmAva_allotRequest) rmAva_allotRequest.abort();
                bootstrap.Modal.getOrCreateInstance(document.getElementById("rmAva_allotModal"), { backdrop: "static" }).show();
            });
            $(resultModal).off("shown.bs.modal.rmAva").one("shown.bs.modal.rmAva", function () {
                const grid = rmAva_allotGrid(view, []);
                grid.beginCustomLoading("Loading...");
                if (rmAva_allotRequest) rmAva_allotRequest.abort();
                rmAva_allotRequest = $.get("/Allotment/GetAllotmentReport", Object.assign({
                    fromDate: fromDate, displayofday: days, allotmentType: 0,
                    byAllotmentType: 2, byAllotmentDetail: 0, byAllotmentandRoomType: 0,
                    byAllotmentandRoomTypeGroupbyAll: 0, byAllotmentandRoomTypeGroupbyRT: 0,
                    byProfile: 0, byRoomtypedetail: 0
                }, view.params))
                    .done(function (data) {
                        // Server trả về chuỗi hoặc object khi lỗi
                        if (!Array.isArray(data)) {
                            grid.endCustomLoading();
                            showToast("Error", "Unable to load allotment data.", false);
                            return;
                        }
                        rmAva_allotGrid(view, data, fromDate, days).endCustomLoading();
                    })
                    .fail(function (xhr, status) {
                        if (status === "abort") return;
                        grid.endCustomLoading();
                        showToast("Error", "Unable to load allotment data.", false);
                    });
            });
            bootstrap.Modal.getOrCreateInstance(resultModal, { backdrop: "static" }).show();
        }

        function rmAva_allotGrid(view, data, fromDate, days) {
            const columns = view.labels.map(function (field) {
                const column = { dataField: field, caption: rmAva_labelCaptions[field], width: field === "AccountName" ? 180 : 130, fixed: true };
                if (view.group === field) column.groupIndex = 0;
                return column;
            });

            if (fromDate) {
                const date = new Date(fromDate + "T00:00:00");
                for (let i = 0; i <= days; i++) {
                    const field = [date.getFullYear(), String(date.getMonth() + 1).padStart(2, "0"), String(date.getDate()).padStart(2, "0")].join("-");
                    const caption = String(date.getDate()).padStart(2, "0") + "-" + date.toLocaleString("en-US", { month: "short" })
                        + "<br>" + date.toLocaleString("en-US", { weekday: "short" }) + "<br>CW" + rmAva_getWeekNumber(date);
                    columns.push({
                        dataField: field, caption: caption.replace(/<br>/g, " "), width: 70, alignment: "right",
                        headerCellTemplate: function (container) {
                            container.html(`<div style="white-space:nowrap; text-align:center; font-size:11px;">${caption}</div>`);
                        }
                    });
                    date.setDate(date.getDate() + 1);
                }
            }

            const $grid = $("#rmAva_allotGrid");
            if ($grid.data("dxDataGrid")) $grid.dxDataGrid("dispose");
            $grid.empty().addClass("gridContainer");
            return $grid.dxDataGrid({
                dataSource: data, columns: columns, height: "calc(100vh - 110px)", showBorders: true, showRowLines: true,
                allowColumnResizing: true, columnResizingMode: "widget", paging: { enabled: false },
                scrolling: { mode: "standard", showScrollbar: "always", useNative: true },
                grouping: { autoExpandAll: true }, noDataText: "No data"
            }).dxDataGrid("instance");
        }

        async function rmAva_exportAllotment() {
            const grid = $("#rmAva_allotGrid").dxDataGrid("instance");
            if (!grid || !grid.getDataSource()?.items().length) {
                showToast("Warning", "No data to export.", false);
                return;
            }
            const workbook = new ExcelJS.Workbook();
            const sheet = workbook.addWorksheet("Allotment");
            sheet.addRow([localStorage.getItem("CompanyName") || ""]);
            sheet.addRow([$("#rmAva_allotResultTitle").text()]);
            await DevExpress.excelExporter.exportDataGrid({ component: grid, worksheet: sheet, topLeftCell: { row: 4, column: 1 } });
            const buffer = await workbook.xlsx.writeBuffer();
            saveAs(new Blob([buffer], { type: "application/octet-stream" }), "Allotment.xlsx");
        }

        function rmAva_loadReport() {
            const rmAva_fromDate = $(rmAva_selectors.fromDate).val();
            const zoneValues  = $(rmAva_selectors.zone).val() || [];  
            const resTypeValues = $(rmAva_selectors.resType).val() || [];          

            if (!zoneValues || zoneValues.length === 0) {
                showToast("Warning", "Please select a Zone before printing!", false);
                return;
            }

            $.ajax({
                url: "/HouseKeeping/RoomAvailabilityData",
                type: "GET",
                data: {
                    fromDate: rmAva_fromDate || dateSystem,
                    zone: zoneValues.join(","),
                    restype: resTypeValues.join(","),
                    displayofday: $(rmAva_selectors.displayOfDay).val(),
                    showNonDeduct: $(rmAva_selectors.showNonDeduct).is(":checked") ? 1 : 0,
                    showOcc3: $(rmAva_selectors.showOcc3).is(":checked") ? 1 : 0,
                    showRoomNight: $(rmAva_selectors.showRoomNight).is(":checked") ? 1 : 0,
                    includeOutOfOrder: $(rmAva_selectors.includeOutOfOrder).is(":checked") ? 1 : 0,
                    includeOverbooking: $(rmAva_selectors.includeOverbooking).is(":checked") ? 1 : 0,
                    includeAllotment: $(rmAva_selectors.includeAllotment).is(":checked") ? 1 : 0                
                },
                traditional: true,
                crossDomain: false,
                headers: {
                    "X-CSRF-TOKEN-HEADERNAME": jQuery("input[name='__RequestVerificationToken']").val()
                },
                success: function (rmAva_result) {
                    rmAva_range = {
                        from: rmAva_isoDate(new Date(rmAva_result.fromDate)),
                        to: rmAva_isoDate(new Date(rmAva_result.toDate))
                    };
                    // Lỗi tải màu/ghi chú không được chặn bảng số liệu
                    rmAva_fetchNotes(rmAva_range.from, rmAva_range.to)
                        .done(rmAva_setNotes)
                        .fail(() => rmAva_setNotes([]))
                        .always(() => rmAva_initializeReservationSummaryGrid(rmAva_result.data, rmAva_result.fromDate, rmAva_result.toDate));
                },
                error: function () {
                    alert("Không th? t?i báo cáo.");
                }
            });
        }

        function rmAva_generateDateColumns(rmAva_fromDate, rmAva_toDate) {
            const rmAva_columns = [];
            const rmAva_start = new Date(rmAva_fromDate);
            const rmAva_end = new Date(rmAva_toDate);

            let rmAva_index = 1;

            while (rmAva_start <= rmAva_end) {
                const rmAva_day = rmAva_start.getDate().toString().padStart(2, "0");
                const rmAva_month = rmAva_start.toLocaleString("en-US", { month: "short" });
                const rmAva_weekday = rmAva_start.toLocaleString("en-US", { weekday: "short" });
                const rmAva_weekNumber = rmAva_getWeekNumber(rmAva_start);

                const rmAva_captionHtml = `${rmAva_day}-${rmAva_month}<br>${rmAva_weekday}<br>CW${rmAva_weekNumber}`;

                rmAva_columns.push({
                    dataField: `date${rmAva_index}`,
                    isoDate: rmAva_isoDate(rmAva_start),
                    width: 50,
                    alignment: "right",
                    // dataType: "number",
                    cellTemplate: function (rmAva_container, rmAva_options) {
                        rmAva_container.css({ textAlign: "right" });
                        let rmAva_value = rmAva_options.value;
         
                        let rmAva_num = parseFloat(rmAva_value);

                        const rmAva_formatNumber = (rmAva_val) =>
                            new Intl.NumberFormat("en-US").format(rmAva_val);

                           if (rmAva_options.data.roomType === "% OCC") {
                                if (rmAva_value !== null && rmAva_value !== undefined && rmAva_value !== "") {
                                      
                                     let rmAva_occNum = parseFloat(
                                        rmAva_value.toString().replace(",", ".") // ✅ fix tại đây
                                    );
                                                
                                    if (!isNaN(rmAva_occNum)) {
                                        rmAva_container.text(rmAva_occNum.toFixed(1) + " %");  
                                    } else {
                                        rmAva_container.text(rmAva_value + " %");
                                    }
                                } else {
                                    rmAva_container.text("");
                                }
                            }
                        else if (rmAva_options.data.roomType === "R.Night") {
                            if (!rmAva_num || rmAva_num === 0) {
                                rmAva_container.text("0").css("color", "red");
                            } else {
                                rmAva_container.text(rmAva_formatNumber(rmAva_num));
                            }
                        }
                        else if (rmAva_options.data.roomType === "Allotment") {
                            rmAva_container.text(rmAva_num ? rmAva_formatNumber(rmAva_num) : "0");
                        }
                        else {
                            if (!isNaN(rmAva_num)) {
                                if (rmAva_num <= 0) {
                                    rmAva_container.text(rmAva_formatNumber(rmAva_num)).css("color", "red");
                                } else {
                                    rmAva_container.text(rmAva_formatNumber(rmAva_num));
                                }
                            } else {
                                rmAva_container.text("");
                            }
                        }
                    },
                    headerCellTemplate: function (rmAva_container) {
                        rmAva_container.html(
                            `<div style="white-space: normal; text-align:center; font-size:11px;">${rmAva_captionHtml}`
                            + `<div class="rmAva-note" style="max-width:44px; margin:0 auto; overflow:hidden; white-space:nowrap; text-overflow:ellipsis;"></div></div>`
                        );
                    }
                });

                rmAva_start.setDate(rmAva_start.getDate() + 1);
                rmAva_index++;
            }

            return rmAva_columns;
        }

        function rmAva_getWeekNumber(rmAva_date) {
            const rmAva_d = new Date(Date.UTC(rmAva_date.getFullYear(), rmAva_date.getMonth(), rmAva_date.getDate()));
            const rmAva_dayNum = rmAva_d.getUTCDay() || 7;
            rmAva_d.setUTCDate(rmAva_d.getUTCDate() + 4 - rmAva_dayNum);
            const rmAva_yearStart = new Date(Date.UTC(rmAva_d.getUTCFullYear(), 0, 1));
            return Math.ceil((((rmAva_d - rmAva_yearStart) / 86400000) + 1) / 7);
        }

        function rmAva_initializeReservationSummaryGrid(rmAva_data, rmAva_fromDate, rmAva_toDate) {
            const rmAva_columnWidth = 120;
            let rmAva_hasPassedBookedRoom = false;
            const rmAva_dateColumns = rmAva_generateDateColumns(rmAva_fromDate, rmAva_toDate);

            $(rmAva_selectors.grid).dxDataGrid({
                dataSource: rmAva_data,
                allowColumnResizing: true,
                columnAutoWidth: true,
                columns: [
                    { dataField: "roomType", caption: "Room Type", width: rmAva_columnWidth - 10 },
                    {
                        dataField: "totalRooms",
                        caption: "Total Rooms",
                        width: 70,
                        dataType: "number",
                        alignment: "right",
                        cellTemplate: function (rmAva_container, rmAva_options) {
                            rmAva_container.css({ textAlign: "right" });
                            let rmAva_value = rmAva_options.value;

                            if (rmAva_options.data.roomType === "Allotment" || rmAva_options.data.roomType === "BookedRoom") {
                                if (rmAva_value === null || rmAva_value === undefined || rmAva_value === "") {
                                    rmAva_container.text("0");
                                } else {
                                    rmAva_container.text(rmAva_value);
                                }
                            } else {
                                rmAva_container.text(rmAva_value ?? "");
                            }
                        },
                        headerCellTemplate: function (rmAva_container) {
                            rmAva_container.append(
                                $("<div>")
                                    .text("Total")
                                    .append("<br>")
                                    .append("Rooms")
                            );
                        }
                    },
                    ...rmAva_dateColumns
                ],
                paging: { pageSize: 25 },
                scrolling: {
                    useNative: true,
                    showScrollbar: "always"
                },
                pager: {
                    visible: true,
                    allowedPageSizes: [25, 50, "all"],
                    showPageSizeSelector: true,
                    showInfo: true,
                    showNavigationButtons: true
                },
                filterRow: { visible: true, applyFilter: "auto" },
                headerFilter: { visible: true },
                selection: { mode: "multiple", showCheckBoxesMode: "none" },
                showBorders: true,
                onCellPrepared: rmAva_paintHeader,
                onCellClick: rmAva_pickCell,
                onCellDblClick: function (e) {
                    if (e.rowType !== "data" || !e.column.isoDate) return;
                    rmAva_pickCell(e);
                    rmAva_openDetail();
                },
                // Tải lại bảng hoặc đổi trang thì ô đã chọn không còn
                onContentReady: function () {
                    if (!$(rmAva_selectors.grid).find("td.rmAva-picked").length) rmAva_picked = null;
                },
                onRowPrepared: function (rmAva_e) {
                    if (rmAva_e.rowType === "data") {
                        if (rmAva_e.data.roomType === "Allotment") {
                            rmAva_hasPassedBookedRoom = true;
                        }

                        if (rmAva_hasPassedBookedRoom) {
                            rmAva_e.rowElement.css({
                                "background-color": "#bdf8fc"
                            });
                        }

                        if (rmAva_e.data?.isTotal) {
                            rmAva_e.rowElement.css({
                                "font-weight": "bold",
                                "background-color": "#f6f6f6"
                            });
                        }
                    }
                }
            });
        }

        function rmAva_exportExcel() {
            const rmAva_grid = $(rmAva_selectors.grid).dxDataGrid("instance");
            const rmAva_selectedReport = "RoomAvailability";
            const rmAva_workbook = new ExcelJS.Workbook();
            const rmAva_companyName = localStorage.getItem("CompanyName") || "Tên công ty chưa xác định";
            const rmAva_worksheet = rmAva_workbook.addWorksheet("Sheet 1");

            rmAva_worksheet.addRow([rmAva_companyName]);
            rmAva_worksheet.mergeCells("A1:E1");
            rmAva_worksheet.getRow(1).font = { bold: true };
            rmAva_worksheet.getRow(1).alignment = { vertical: "middle", horizontal: "left" };

            const rmAva_now = new Date();
            const rmAva_exportDate = rmAva_now.toLocaleString("vi-VN");
            rmAva_worksheet.addRow(["", "", "", "", " " + rmAva_exportDate]);
            rmAva_worksheet.mergeCells("E2:H2");
            rmAva_worksheet.getRow(2).alignment = { vertical: "middle", horizontal: "right" };

            rmAva_worksheet.addRow([]);
            rmAva_worksheet.addRow([]);

            const rmAva_reportRow = rmAva_worksheet.addRow(["", "", rmAva_selectedReport]);
            rmAva_worksheet.mergeCells("C5:F5");
            rmAva_reportRow.font = { bold: true, size: 14 };
            rmAva_reportRow.alignment = { vertical: "middle", horizontal: "center" };

            rmAva_worksheet.addRow([]);

            DevExpress.excelExporter.exportDataGrid({
                component: rmAva_grid,
                worksheet: rmAva_worksheet,
                autoFilterEnabled: true,
                topLeftCell: { row: 7, column: 1 }
            }).then(function () {
                const rmAva_lastRow = rmAva_worksheet.lastRow.number + 2;
                rmAva_worksheet.getCell(`A${rmAva_lastRow}`).value = "--- END  ---";
                rmAva_worksheet.mergeCells(`A${rmAva_lastRow}:F${rmAva_lastRow}`);
                rmAva_worksheet.getCell(`A${rmAva_lastRow}`).alignment = { horizontal: "center" };
                rmAva_worksheet.getCell(`A${rmAva_lastRow}`).font = { italic: true };

                let rmAva_fileName = rmAva_selectedReport + ".xlsx";
                rmAva_workbook.xlsx.writeBuffer().then(function (rmAva_buffer) {
                    saveAs(new Blob([rmAva_buffer], { type: "application/octet-stream" }), rmAva_fileName);
                });
            });
        }

        function rmAva_exportPdf() {
            const { jsPDF } = window.jspdf;
            const rmAva_doc = new jsPDF();

            DevExpress.pdfExporter.exportDataGrid({
                jsPDFDocument: rmAva_doc,
                component: $(rmAva_selectors.grid).dxDataGrid("instance"),
                autoTableOptions: {
                    styles: { cellPadding: 2, fontSize: 8 },
                    margin: { top: 20 }
                }
            }).then(() => {
                rmAva_doc.save("BaoCao.pdf");
            });
        }

        return {
            init: rmAva_init,
            loadData: rmAva_loadReport,
            openModal: function () {
                $(rmAva_selectors.mainModal).modal("show");
            }
        };
    })();

    $(document).ready(function () {
        rmAva_Module.init();
        rmAva_Module.openModal();
    });

    window.openModalRoomAvailability = function () {
        $("#rmAva_mainModal").modal("show");
        rmAva_Module.loadData();
    };
</script>
