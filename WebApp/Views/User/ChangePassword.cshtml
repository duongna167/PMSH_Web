@{
    Layout = null;
    var mode = (ViewBag.Mode as string) ?? "first";
    var isRenew = string.Equals(mode, "renew", StringComparison.OrdinalIgnoreCase);
}
<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<link rel="icon" type="image/png" href="~/images/logo.png" />
<link href="~/css/assets/button.css" rel="stylesheet" />

<style>
    body {
        color: #000;
        overflow-x: hidden;
        height: 100%;
        margin: 0;
    }
    .login-wrapper {
        min-height: 100vh;
        width: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
        background-image: url("/images/background-login.png");
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
    }
    .login-card {
        background: #ffffff;
        border-radius: 24px;
        width: 100%;
        max-width: 420px;
        max-height: 99vh;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
    }
    .login-header {
        background: #f3f6f3;
        padding: 28px 20px;
        text-align: center;
    }
    .login-logo {
        max-width: 180px;
        width: 100%;
        height: auto;
    }
    .login-title {
        font-size: 20px;
        font-weight: 700;
        background: linear-gradient(90deg, #44593d, #65805b);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }
    .login-body { padding: 24px; }
    .form-group { margin-bottom: 16px; }
    .form-group label {
        color: #425044;
        font-size: 15px;
        font-weight: 600;
        display: block;
        margin-bottom: 6px;
    }
    .form-control {
        width: 100%;
        padding: 10px 12px;
        border-radius: 8px;
        border: 1px solid #dcdcdc;
        font-size: 14px;
        outline: none;
    }
    .form-control:focus { border-color: #00509f; }
    .btn-login {
        width: 100%;
        padding: 12px;
        border: none;
        border-radius: 8px;
        background: #63af90;
        color: #fff;
        font-size: 15px;
        font-weight: 600;
        cursor: pointer;
    }
    .btn-login:hover { background: #a2d3be; }
    .btn-cancel {
        width: 100%;
        padding: 12px;
        margin-top: 8px;
        border: 1px solid #dcdcdc;
        border-radius: 8px;
        background: #fff;
        color: #425044;
        font-size: 15px;
        font-weight: 600;
        cursor: pointer;
    }
</style>
<div class="login-wrapper">
    <div class="login-card">
        <div class="login-header">
            <img src="/images/logo-company.png" alt="Logo" class="login-logo">
            <div class="login-title">
                PROPERTY MANAGEMENT SYSTEM FOR HOTEL AND RESORT
            </div>
        </div>
        <div class="login-body">
            <div id="alert"></div>
            @if (isRenew)
            {
                <div class="form-group">
                    <label>Current Password</label>
                    <input type="password" class="form-control" placeholder="Enter current password" id="txtCurrentPassword">
                </div>
            }
            <div class="form-group">
                <label>New Password</label>
                <input type="password" class="form-control" placeholder="Enter new password" id="txtNewPassword">
            </div>
            <div class="form-group">
                <label>Confirm Password</label>
                <input type="password" class="form-control" placeholder="Confirm new password" id="txtConfirmPassword">
            </div>
            <button type="button" class="btn-login" id="btnSavePassword">OK</button>
            <button type="button" class="btn-cancel" id="btnCancelPassword">Cancel</button>
        </div>
    </div>
</div>
<script>
    var isRenew = @(isRenew ? "true" : "false");

    function showFieldAlert(msg) {
        $('#alert').empty().append('<div class="alert alert-danger" role="alert">' + msg + '</div>');
    }

    function enterHome(data) {
        localStorage.removeItem("PermissionNames");
        localStorage.removeItem("PermissionDataCodes");
        localStorage.setItem("PermissionNames", JSON.stringify(data.data || []));
        localStorage.setItem("PermissionDataCodes", JSON.stringify(data.dataPermissions || []));
        localStorage.setItem("crashierLogin", "NotYet");
        localStorage.removeItem("Loginname");
        localStorage.setItem("Loginname", JSON.stringify(data.namelogin));
        localStorage.setItem("userID", JSON.stringify(data.userID));
        if (data.businessDate != null && data.businessDate !== '') {
            localStorage.setItem("businessDate", JSON.stringify(data.businessDate));
        }
        window.location.href = "/Home/Index";
    }

    function submitChange() {
        var currentPassword = ($('#txtCurrentPassword').val() || '');
        var newPassword = ($('#txtNewPassword').val() || '');
        var confirmPassword = ($('#txtConfirmPassword').val() || '');
        $('#alert').empty();

        if (isRenew && !currentPassword) {
            showFieldAlert('Please enter your current password.');
            return;
        }
        if (!newPassword) {
            showFieldAlert('Please enter a new password.');
            return;
        }
        if (!confirmPassword) {
            showFieldAlert('Please confirm the new password.');
            return;
        }
        if (newPassword !== confirmPassword) {
            showFieldAlert('The new password and confirmation do not match.');
            return;
        }
        if (!/[A-Za-z]/.test(newPassword) || !/[0-9]/.test(newPassword)) {
            showFieldAlert('The password must contain both letters and numbers.');
            return;
        }

        var formData = new FormData();
        formData.append('CurrentPassword', currentPassword);
        formData.append('NewPassword', newPassword);
        formData.append('ConfirmPassword', confirmPassword);

        $.ajax({
            url: '/User/ChangePassword',
            type: 'POST',
            processData: false,
            contentType: false,
            data: formData,
            success: function (data) {
                if (data.code === 0) {
                    enterHome(data);
                    return;
                }
                showFieldAlert(data.msg || 'Unable to change password.');
            },
            error: function () {
                showFieldAlert(window.PMSH_SERVER_CONNECTION_MSG ||
                    "Unable to connect server. Please check connection or server");
            }
        });
    }

    $(document).ready(function () {
        $('#btnSavePassword').on('click', submitChange);
        $('#txtNewPassword, #txtConfirmPassword, #txtCurrentPassword').on('keypress', function (e) {
            if (e.which === 13) submitChange();
        });
        $('#btnCancelPassword').on('click', function () {
            $.ajax({
                url: '/User/CancelChangePassword',
                type: 'POST',
                complete: function () {
                    window.location.href = '/User/Index';
                }
            });
        });
    });
</script>
