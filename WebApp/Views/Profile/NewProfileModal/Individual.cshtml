<style>
    #modalIndividual .modal-dialog {
        max-width: 96vw;
        width: 96vw;
        margin: 0.45rem auto;
    }

    #modalIndividual .modal-content {
        height: 94vh;
        max-height: 94vh;
        display: flex;
        flex-direction: column;
    }

    #modalIndividual .modal-body {
        padding: 6px 12px 8px !important;
        overflow: auto;
        flex: 1 1 auto;
        min-height: 0;
    }

    #modalIndividual .modal-header {
        padding: 6px 12px;
    }

    #modalIndividual .ind-toolbar {
        display: flex;
        align-items: center;
        gap: 6px;
        margin-bottom: 6px;
    }

    #modalIndividual .ind-layout {
        display: grid;
        grid-template-columns: 132px minmax(0, 1.18fr) minmax(0, 1.08fr) minmax(0, 0.95fr);
        gap: 8px 12px;
        align-items: start;
    }

    #modalIndividual .ind-sec {
        color: #c00000;
        font-weight: 700;
        font-size: 13px;
        margin: 0 0 4px;
        line-height: 1.2;
    }

    #modalIndividual .ind-row {
        display: grid;
        grid-template-columns: 9.5rem minmax(0, 1fr);
        align-items: center;
        column-gap: 8px;
        margin-bottom: 4px;
        min-height: 28px;
    }

    #modalIndividual .ind-row > :not(label) {
        min-width: 0;
        overflow: hidden;
    }

    #modalIndividual .ind-row > label {
        margin: 0;
        font-size: 13px;
        text-align: right;
        white-space: nowrap;
        line-height: 1.15;
    }

    #modalIndividual .ind-pair {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 6px;
        min-width: 0;
    }

    #modalIndividual .ind-inline {
        display: flex;
        align-items: center;
        gap: 6px;
        min-width: 0;
    }

    #modalIndividual .ind-inline > * {
        min-width: 0;
        flex: 1;
    }

    #modalIndividual .form-control,
    #modalIndividual .form-control-sm {
        height: 28px;
        min-height: 28px;
        font-size: 14px;
        padding: 2px 8px;
    }

    #modalIndividual select.form-control {
        padding-right: 1.85rem;
        min-width: 0;
    }

    #modalIndividual textarea.form-control {
        height: auto;
        min-height: 72px;
        font-size: 14px;
    }

    #modalIndividual .ind-address {
        min-height: 88px;
        height: 88px;
        resize: vertical;
    }

    #modalIndividual .ind-notes {
        min-height: 64px;
        height: 64px;
        resize: vertical;
    }

    #modalIndividual .ind-image {
        border: 1px solid #c8c8c8;
        background: #f3f3f3;
        height: 168px;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }

    #modalIndividual .ind-image img {
        max-width: 100%;
        max-height: 100%;
        object-fit: contain;
    }

    #modalIndividual .ind-image-cap {
        text-align: center;
        font-size: 13px;
        margin-bottom: 4px;
    }

    #modalIndividual .ind-footer {
        display: flex;
        gap: 18px;
        font-size: 12px;
        color: #444;
        margin-top: 6px;
        flex-wrap: wrap;
    }

    #ind_txtBlackListReason {
        background-color: #fff !important;
        color: #000 !important;
        border: 1px solid #ced4da !important;
    }

    #ind_txtBlackListReason.black-active {
        background-color: #000 !important;
        color: #fff !important;
        border-color: #000 !important;
    }
</style>

