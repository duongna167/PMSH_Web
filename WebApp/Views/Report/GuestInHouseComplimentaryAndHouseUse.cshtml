@using DevExpress.XtraReports.UI
@{
    ViewBag.Title = ViewBag.ReportHeader;
    var vipList = ViewBag.VIPList;
}
<style>
    .filter_wrapper { padding: 18px 0px 0px 14px !important; border-radius: 8px; }
    .gridContainer { margin: 0px 8px; }
    .sticky-header label, .sticky-header .form-control-sm { font-size: 14px; line-height: 1.2; }
    .sticky-header .form-control-sm { padding: 2px 8px; height: 28px; }
    .sticky-header label { margin-bottom: 0; white-space: nowrap; }
    .nrp-grid {
        display: grid;
        grid-template-columns: max-content max-content 160px;
        column-gap: 6px;
        row-gap: 8px;
        align-items: center;
        width: max-content;
        max-width: 100%;
    }
    .nrp-grid > label { margin: 0; white-space: nowrap; }
    .nrp-grid select { width: 160px; min-width: 128px; max-width: 220px; }
    .nrp-check {
        display: grid;
        grid-template-columns: max-content max-content max-content;
        column-gap: 16px;
        align-items: center;
        width: max-content;
        margin-top: 8px;
    }
    .nrp-check > .fw-bold { margin: 0; padding-right: 4px; }
    .nrp-check .form-check { margin: 0 !important; display: flex; align-items: center; gap: 6px; }
    #gridContainer .dx-datagrid-rowsview .dx-selection { background-color: #01579b !important; color: white !important; }
    #gridContainer .dx-datagrid-rowsview .dx-selection * { color: white !important; }
</style>
<div class="text-center" id="reportTitle" style="font-size: 20px"></div>
<div class="sticky-header bg-white p-2 shadow-sm z-3">
    <div class="">
        <button id="btnPrint" class="mui-button mui-button-new">View</button>
        <button id="btnExportExcel" class="mui-button mui-button-new" type="button">Excel</button>
        <button id="btnExportPdf" class="mui-button mui-button-new" type="button">PDF</button>
    </div>
    <div class="mb-1" style="border: 1px solid #ced4da; border-radius: 6px; padding: 8px;">
        <div class="nrp-check">
            <label class="fw-bold">Filters</label>
            <div class="form-check"><input class="form-check-input" type="checkbox" id="vipOnly" /><label class="form-check-label" for="vipOnly">VIP Only</label></div>
            <select id="vipIds" class="form-control form-control-sm" style="width:160px;min-width:128px;max-width:220px;height:28px;">
                <option value="">--All--</option>
                @if (vipList != null) { foreach (var item in vipList) { <option value="@item.ID">@item.Code</option> } }
            </select>
        </div>
        <div class="nrp-check">
            <label class="fw-bold">Include</label>
            <div class="form-check"><input class="form-check-input" type="checkbox" id="showPackages" checked /><label class="form-check-label" for="showPackages">Packages</label></div>
            <div class="form-check"><input class="form-check-input" type="checkbox" id="showNotes" checked /><label class="form-check-label" for="showNotes">Notes</label></div>
        </div>
        <div class="nrp-check">
            <label class="fw-bold">Display</label>
            <div class="form-check"><input class="form-check-input" type="checkbox" id="displayComment" /><label class="form-check-label" for="displayComment">Comments</label></div>
        </div>
        <div class="nrp-grid">
            <label class="fw-bold">Sort</label>
            <label>Order:</label>
            <select id="sort" class="form-control form-control-sm">
                <option value="Room No.">Room No.</option>
                <option value="Name">Name</option>
                <option value="Arr. Date">Arr. Date</option>
                <option value="Group Code">Group Code</option>
            </select>
        </div>
    </div>
</div>
<div class="mui-card">
    <div id="gridWrapper" class="mt-2" style="max-height: 500px;">
        <div class="gridContainer mt-2" id="gridContainer"></div>
    </div>
</div>
<div id="loadingSpinner" style="display:none; position:fixed; top:50%; left:50%; transform:translate(-50%, -50%); z-index:1000;">
    <i class="fa-solid fa-spinner fa-spin"></i>
</div>
<script>
    function pick(row, names) {
        for (var i = 0; i < names.length; i++) {
            if (row[names[i]] !== undefined && row[names[i]] !== null && row[names[i]] !== "") return row[names[i]];
        }
        return "";
    }
    $(document).ready(function () {
        document.getElementById("reportTitle").innerText = '@ViewBag.ReportTitle';
        if (typeof window.initDateInputs === "function") window.initDateInputs();
    });
    function bindGrid(data) {
        var showCmt = $("#displayComment").is(":checked") || $("#showNotes").is(":checked");
        var rows = (Array.isArray(data) ? data : []).map(function (r) {
            return {
                roomNo: pick(r, ["Room No.", "RoomNo", "roomNo"]),
                name: pick(r, ["Name", "name"]),
                adl: pick(r, ["Adl.", "Adl", "adl"]),
                chl: pick(r, ["Chl.", "Chl", "chl"]),
                holder: pick(r, ["Res. Holder", "ResHolder", "res. Holder"]),
                groupCode: pick(r, ["Group Code", "GroupCode", "groupCode"]),
                arr: pick(r, ["Arr. Date", "ArrivalDate", "arrivalDate"]),
                dep: pick(r, ["Dep. Date", "DepartureDate", "departureDate"]),
                roomType: pick(r, ["Room Type", "RoomType", "roomType"]),
                market: pick(r, ["Market Code", "MarketCode", "marketCode"]),
                vip: pick(r, ["VIP", "vip"]),
                comments: pick(r, ["Res. Comments", "Comment", "comment"])
            };
        });
        $("#gridContainer").dxDataGrid({
            dataSource: rows, height: 500, allowColumnResizing: true,
            columns: [
                { dataField: "roomNo", caption: "Room No.", width: 90 },
                { dataField: "name", caption: "Name", minWidth: 160 },
                { dataField: "adl", caption: "Adl.", width: 50, dataType: "number" },
                { dataField: "chl", caption: "Chl.", width: 50, dataType: "number" },
                { dataField: "holder", caption: "Res. Holder", minWidth: 160 },
                { dataField: "groupCode", caption: "Group Code", width: 110 },
                { dataField: "arr", caption: "Arr. Date", dataType: "date", format: "dd/MM/yyyy", width: 100 },
                { dataField: "dep", caption: "Dep. Date", dataType: "date", format: "dd/MM/yyyy", width: 100 },
                { dataField: "roomType", caption: "Room Type", width: 90 },
                { dataField: "market", caption: "Market Code", width: 100 },
                { dataField: "vip", caption: "VIP", width: 70 },
                { dataField: "comments", caption: "Comments", minWidth: 160, visible: showCmt }
            ],
            paging: { pageSize: 25 },
            scrolling: { mode: "standard", useNative: false, showScrollbar: "always" },
            pager: { visible: true, allowedPageSizes: [25, 50, "all"], showPageSizeSelector: true, showInfo: true, showNavigationButtons: true },
            filterRow: { visible: true, applyFilter: "auto" },
            headerFilter: { visible: true },
            showBorders: true,
            summary: { totalItems: [
                { column: "adl", summaryType: "sum", displayFormat: "{0}" },
                { column: "chl", summaryType: "sum", displayFormat: "{0}" }
            ]}
        });
    }
    $(document).off("click", "#btnPrint").on("click", "#btnPrint", function () {
        $("#loadingSpinner").show();
        $.ajax({
            url: "/Report/GuestInHouseComplimentaryAndHouseUseData", type: "GET",
            data: {
                vipOnly: $("#vipOnly").is(":checked"), vipIds: $("#vipIds").val(),
                showComp: true, showHU: true,
                displayComment: $("#displayComment").is(":checked") || $("#showNotes").is(":checked"),
                sort: $("#sort").val()
            },
            success: function (result) {
                if (typeof result === "string") { alert(result); $("#loadingSpinner").hide(); return; }
                bindGrid(result); $("#loadingSpinner").hide();
            },
            error: function () { alert("Không thể tải báo cáo."); $("#loadingSpinner").hide(); }
        });
    });
    $(document).off("click", "#btnExportExcel").on("click", "#btnExportExcel", function () {
        const grid = $("#gridContainer").dxDataGrid("instance"); if (!grid) return;
        const workbook = new ExcelJS.Workbook(); const worksheet = workbook.addWorksheet("Report");
        const selectedReport = '@ViewBag.ReportTitle';
        DevExpress.excelExporter.exportDataGrid({ component: grid, worksheet: worksheet, autoFilterEnabled: true })
            .then(function () { workbook.xlsx.writeBuffer().then(function (buffer) { saveAs(new Blob([buffer], { type: "application/octet-stream" }), selectedReport + ".xlsx"); }); });
    });
    $(document).off("click", "#btnExportPdf").on("click", "#btnExportPdf", function () {
        const grid = $("#gridContainer").dxDataGrid("instance"); if (!grid) return;
        const { jsPDF } = window.jspdf; const doc = new jsPDF({ orientation: "landscape", unit: "pt", format: "A4" });
        const selectedReport = '@ViewBag.ReportTitle';
        grid.getDataSource().load().then(data => {
            const columns = grid.getVisibleColumns().filter(c => c.dataField);
            doc.text(selectedReport, doc.internal.pageSize.getWidth() / 2, 40, { align: "center" });
            doc.autoTable({ startY: 56, head: [columns.map(c => c.caption)], body: data.map(row => columns.map(c => row[c.dataField] ?? "")), styles: { fontSize: 8 } });
            doc.save(selectedReport + ".pdf");
        });
    });
</script>
