@using DevExpress.XtraReports.UI
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    ViewBag.Title = ViewBag.ReportHeader;
    var rclList = ViewBag.RoomClassList;
    var rtList = ViewBag.RoomTypeList;
    var lzone = ViewBag.ZoneList;
}


<style>
    .rsvco-filter-grid {
        display: grid;
        grid-template-columns: max-content max-content minmax(140px, 1fr) max-content minmax(140px, 1fr) max-content minmax(100px, 1fr) max-content 70px;
        align-items: center;
        column-gap: 8px;
        row-gap: 8px;
        width: 100%;
        max-width: 100%;
        min-width: 0;
        box-sizing: border-box;
    }

    .rsvco-filter-grid > label {
        margin-right: 0 !important;
    }

    .rsvco-filter-grid select,
    .rsvco-filter-grid input.form-control-sm {
        min-width: 0 !important;
        width: 100% !important;
        max-width: 100%;
    }

    .rsvco-filter-grid [data-date-input] {
        width: 100%;
        min-width: 0;
        margin-right: 0 !important;
    }

    .rsvco-filter-grid #noOfRoom {
        width: 70px !important;
    }

    .filter_wrapper {
        /*     background-color: #ececec; */
        /*   margin: 0px 8px 14px 8px; */
        padding: 18px 0px 0px 14px;
        border-radius: 8px;
    }

    .gridContainer {
        margin: 0px 8px;
    }

    .button_wrapper {
        display: flex;
        column-gap: 12px;
        margin: 0px 8px;
    }

        .button_wrapper .fa-solid {
            margin-right: 5px;
        }

    .selected {
        background-color: #4CAF50; /* Màu xanh */
        color: white;
    }
 
 
</style>
<div class="text-center" id="reportTitle" style="font-size: 20px"></div>
<div class="sticky-header bg-white p-2 shadow-sm z-3">
    <div class="d-flex flex-wrap align-items-center gap-2 mb-1" style="border: 1px solid #ced4da; border-radius: 6px; padding: 8px;">

        <div class="rsvco-filter-grid">
            <label class="fw-bold mb-0">Date Range:</label>
            <label class="mb-0">From Date:</label>
            <div data-date-input business-date data-format="DD/MM/YYYY" data-name="fromDate">
                <input type="text" class="date-ui form-control form-control-sm"
                       placeholder="dd/mm/yyyy" autocomplete="off" />
            </div>
            <label class="mb-0">To Date:</label>
            <div data-date-input business-date data-format="DD/MM/YYYY" data-name="toDate">
                <input type="text" class="date-ui form-control form-control-sm"
                       placeholder="dd/mm/yyyy" autocomplete="off" />
            </div>
            <span></span><span></span><span></span><span></span>

            <label class="fw-bold mb-0">Filter:</label>
            <label class="mb-0">Room Class:</label>
            <select id="roomClass" name="roomClass" class="form-control form-control-sm report-dd">
                <option value="">--All--</option>
                @foreach (var item in rclList)
                {
                    <option value="@item.Code">@item.Code-@item.Description</option>
                }
            </select>
            <label class="mb-0">Room Type:</label>
            <select id="roomType" name="roomType" class="form-control form-control-sm report-dd">
                <option value="">--All--</option>
                @foreach (var item in rtList)
                {
                    <option value="@item.Code">@item.Code-@item.Description</option>
                }
            </select>
            <label class="mb-0">Zone:</label>
            <select id="zone" name="zone" class="form-control form-control-sm report-dd">
                <option value="">--All--</option>
                @foreach (var item in lzone)
                {
                    <option value="@item.ID">@item.Code - @item.Description</option>
                }
            </select>
            <label class="mb-0">No of Room:</label>
            <input id="noOfRoom" name="noOfRoom" class="form-control form-control-sm" />
        </div>


        <div class="d-flex flex-column me-3">
          
            <div class="d-flex flex-wrap gap-2">
                <label class="d-flex align-items-center mb-0 fw-bold">Search Criteria:</label>
                <!-- Row 1 -->
                <div class="form-check me-3">
                    <input class="form-check-input include-option" type="checkbox" id="company" name="includeOptions" value="0" checked>
                    <label class="form-check-label" for="arrival">Company</label>
                </div>
                <div class="form-check me-3">
                    <input class="form-check-input include-option" type="checkbox" id="travelAgent" name="includeOptions" value="1">
                    <label class="form-check-label" for="cancel">Travel Agent</label>
                </div>
                <div class="form-check me-3">
                    <input class="form-check-input include-option" type="checkbox" id="source" name="includeOptions" value="2">
                    <label class="form-check-label" for="cancel">Source</label>
                </div>
                 <div class="form-check me-3">
                    <input class="form-check-input include-option" type="checkbox" id="group" name="includeOptions" value="3">
                    <label class="form-check-label" for="cancel">Group</label>
                </div>
                 <div class="form-check me-3">
                    <input class="form-check-input include-option" type="checkbox" id="rateCode" name="includeOptions" value="4">
                    <label class="form-check-label" for="cancel">Rate Code</label>
                </div>
                <div class="form-check me-3">
                    <input class="form-check-input include-option" type="checkbox" id="resType" name="includeOptions" value="5">
                    <label class="form-check-label" for="cancel">Res. Type</label>
                </div>
            </div>
        </div>

        <div class="d-flex align-items-center">
            <label class="me-2 mb-0 fw-bold">Sort Order:</label>
            <select id="sortOrder" name="sortOrder" class="form-control form-control-sm w-auto">
                <option value="3">Room</option>              
                <option value="1">Arrival Date</option>
                <option value="2">Market Code</option>
                <option value="0">Alphabetical</option>
            </select>
        </div>
    </div>
    <div class="">
        <button class="mui-button mui-button-new"   id="btnPrint">
             View
        </button>
        <button class="mui-button mui-button-new" id="btnExportExcel">
             Excel
        </button>
        <button class="mui-button mui-button-new"   id="btnExportPdf">
             PDF
        </button>
    </div>
</div>

<div class="mui-card">
@*     <div style="font-size: 20px;" class="mt-1" id="reportTitle"></div> *@
    <div id="gridWrapper" class="mt-2" style="max-height: 500px;">
        <div class="gridContainer mt-2" id="gridContainer"></div>
    </div>
</div>
<div id="loadingSpinner" style="display:none; position:fixed; top:50%; left:50%; transform:translate(-50%, -50%); z-index:1000;">
    <i class="fa-solid fa-spinner fa-spin"></i>
</div>
<script>

 

    $(document).ready(function () {
            DevExpress.localization.locale("vi");
         document.getElementById("reportTitle").innerText = '@ViewBag.ReportTitle';
             window.initDateInputs();

    });
    
    $(".include-option").on("change", function () {
        $(".include-option").not(this).prop("checked", false);
    });
    $(document).off("click", "#btnPrint").on("click", "#btnPrint", function () {
        $("#loadingSpinner").show();
         var typeDate = $(".include-option:checked").val();
        $.ajax({
            url: '/Report/ReservationbyCompanyReport',
            type: 'GET',
            data: {
                fromDate: $("#fromDate").val(),
                toDate: $("#toDate").val(),
                roomClass: ($("#roomClass").val() || ""),
                roomType: ($("#roomType").val() || ""),
                searchCrip: typeDate,
                sortOrder: $("#sortOrder").val(),
                noOfRoom: $("#noOfRoom").val(),
                zone: ($("#zone").val() || "")
            },
            traditional: true,
              crossDomain: false,
                headers: { "X-CSRF-TOKEN-HEADERNAME": jQuery("input[name='__RequestVerificationToken']").val() },
            success: function (result) {
                // $("#reportViewerContainer").html(result);
                // $("#loadingSpinner").hide();
                     console.log(result);
                  const processedData = prepareReservationByCompanyData(result);
           initializeReservationbyCompanyGrid(processedData);

                    $("#loadingSpinner").hide();
            },
            error: function () {
                alert("Không thể tải báo cáo.");
                $("#loadingSpinner").hide();
            }
        });
    });
          function prepareReservationByCompanyData(data) {
        const groupedData = {};
        const selectedOptions = [];

        // Lấy các checkbox được chọn
        $(".include-option:checked").each(function() {
            selectedOptions.push($(this).val());
        });

        // Group dữ liệu theo các checkbox được chọn
        data.forEach(item => {
            let key = null;

            if (selectedOptions.includes("0") && item.company) {
                key = item.company;
            } else if (selectedOptions.includes("1") && item.agent) {
                key = item.agent;
            } else if (selectedOptions.includes("2") && item.source) {
                key = item.source;
            } else if (selectedOptions.includes("3") && item.group) {
                key = item.group;
            }  
            else if (selectedOptions.includes("4") && item.group) {
                key = item.rateCode;
            }
            else if (selectedOptions.includes("5") && item.group) {
                key = item.reservationTypeCode;
            }

            if (key) {
                if (!groupedData[key]) groupedData[key] = [];
                groupedData[key].push(item);
            }
        });

        const finalData = [];

        Object.entries(groupedData).forEach(([groupKey, records]) => {
            finalData.push(...records);

            const totalRow = {
                company: "TOTAL",  // Đặt tên hiển thị
        agent: "",
        source: "",
        group: groupKey,  // Hiển thị tên nhóm (nếu có)
        // Tính tổng cho các trường cần thiết
        noOfAdult: sum(records, 'noOfAdult'),
        noOfChild: sum(records, 'noOfChild'),
        noOfChild1: sum(records, 'noOfChild1'),
        noOfRoom: sum(records, 'noOfRoom'),
        noOfNight: sum(records, 'noOfNight'),
               cssClass: "custom",
        isTotal: true // Cờ dòng tổng
            };

            finalData.push(totalRow);
        });

        return finalData;
    }

     function sum(arr, field) {
        return arr.reduce((total, item) => total + (item[field] || 0), 0);
    }

   

    function initializeReservationbyCompanyGrid(data) {
        const columnWidth = 180;
        $("#gridContainer").dxDataGrid({
    dataSource: data,     height: 500, allowColumnResizing: true,
     scrolling: {
         mode: "standard",
         useNative: false,
         showScrollbar: "always"
     },
            columns: [
               { dataField: "roomNo", caption: "RoomNo", width: columnWidth -70},

            { dataField: "account", caption: "Name", width: columnWidth },
            {
                  caption: "Company/Travel Agent/Source",
                 width: columnWidth+90,
                  dataType: "string",
                  calculateCellValue: function (data) {
                        return data.company || data.agent || data.source || "";
                  }
            },

            { dataField: "arrivalDate", caption: "Arr.Date", width: columnWidth-70, dataType: "date", format: "dd/MM/yyyy" },
            { dataField: "departureDate", caption: "Dep.Date", width: columnWidth-70 , dataType: "date", format: "dd/MM/yyyy" },

            { dataField: "noOfAdult", caption: "Adl", width:  columnWidth-100, dataType: "number", format: "#,##0" },
             { dataField: "noOfChild", caption: "Chi", width: columnWidth-100, dataType: "number", format: "#,##0" },
            { dataField: "noOfChild1", caption: "Chi1", width: columnWidth-100, dataType: "number", format: "#,##0" },
            { dataField: "noOfRoom", caption: "Rms", width:  columnWidth-100, dataType: "number", format: "#,##0" },
             { dataField: "noOfNight", caption: "Nst", width:  columnWidth-100, dataType: "number", format: "#,##0" },

              { dataField: "reservationTypeCode", caption: "Res.Type", width:  columnWidth-30 },
             { dataField: "roomType", caption: "Room Type", width: columnWidth-60 },
            { dataField: "marketCode", caption: "Mct.Code", width: columnWidth-60},
                        { dataField: "", caption: "C/H", width: columnWidth-60},
            { dataField: "sourceCode", caption: "Src.Code", width:  columnWidth-50 },
             { dataField: "loginName", caption: "User", width:  columnWidth-70 },

               { dataField: "createDate", caption: "Made On", width:  columnWidth-70, dataType: "date", format: "dd/MM/yyyy" },
             { dataField: "rateCode", caption: "Rate Code", width: columnWidth-70},
            { dataField: "rate", caption: "Rate Amt.", width: columnWidth-60, dataType: "number",
             format: {
                    type: "fixedPoint",
                    precision: 0
                    }
            },
            { dataField: "packages", caption: "Packages", width:  columnWidth-70 },
             { dataField: "currencyID", caption: "Crr.", width:  columnWidth-90 }
            ],
            paging: { pageSize: 25 },
             scrolling:  {
                   
               useNative: false,
               showScrollbar: "always"
               },
            pager: {
                visible: true,
                allowedPageSizes: [25, 50, 'all'],
                showPageSizeSelector: true,
                showInfo: true,
                showNavigationButtons: true,
            },
            
             filterRow: {
                 visible: true,
                 applyFilter: "auto"
              },
               headerFilter: {
                  visible: true
              },
              
            onRowPrepared: function (e) {
                if (e.rowType === "data" && e.data?.cssClass) {
                    e.rowElement.addClass(e.data.cssClass);
                }
            },
            selection: { mode: "multiple", showCheckBoxesMode: "none" },
            showBorders: true

        });
    }




    $("#btnExportExcel").click(function () {
               const grid = $("#gridContainer").dxDataGrid("instance"); var selectedReport2 = '@ViewBag.ReportTitle';
        var selectedReport = '@ViewBag.ReportTitle';
        if (!selectedReport) {
            alert("Vui lòng chọn báo cáo trước khi xuất Excel.");
            return;
        }

                     const workbook = new ExcelJS.Workbook();const companyName = localStorage.getItem("CompanyName") || "Tên công ty chưa xác định";
        const worksheet = workbook.addWorksheet("Sheet 1");

        // === Tạo header công ty (dòng 1) ===
       worksheet.addRow([companyName]);
        worksheet.mergeCells('A1:E1');
        worksheet.getRow(1).font = { bold: true };
        worksheet.getRow(1).alignment = { vertical: 'middle', horizontal: 'left' };

        // === Dòng 2: Thời gian xuất (phải) ===
        const now = new Date();
        const exportDate = now.toLocaleString("vi-VN");
        worksheet.addRow(['', '', '', '', ' ' + exportDate]);
        worksheet.mergeCells('E2:H2');
        worksheet.getRow(2).alignment = { vertical: 'middle', horizontal: 'right' };

        // === Dòng 3–4: Trống
        worksheet.addRow([]);
        worksheet.addRow([]);

        // === Dòng 5: Tên báo cáo ở giữa ===
        const reportRow = worksheet.addRow(['', '', selectedReport]);
        worksheet.mergeCells('C5:F5');
        reportRow.font = { bold: true, size: 14 };
        reportRow.alignment = { vertical: 'middle', horizontal: 'center' };

        // === Dòng 6: Trống trước khi xuất dữ liệu
        worksheet.addRow([]);

        // === Export dữ liệu từ DevExtreme (bắt đầu từ dòng 7)
        DevExpress.excelExporter.exportDataGrid({
            component: grid,
            worksheet: worksheet,
            autoFilterEnabled: true,
            topLeftCell: { row: 7, column: 1 } // dữ liệu bắt đầu từ dòng 7
        }).then(function () {
            // Footer
            const lastRow = worksheet.lastRow.number + 2;
       
            worksheet.mergeCells(`A${lastRow}:F${lastRow}`);
            worksheet.getCell(`A${lastRow}`).alignment = { horizontal: 'center' };
            worksheet.getCell(`A${lastRow}`).font = { italic: true };

            // Ghi file
            let fileName = selectedReport + ".xlsx";
            workbook.xlsx.writeBuffer().then(function (buffer) {
                saveAs(new Blob([buffer], { type: "application/octet-stream" }), fileName);
            });
        });
    });


    // Nút xuất PDF
           $("#btnExportPdf").click(function () {
        const grid = $("#gridContainer").dxDataGrid("instance");

        // Lấy đối tượng jsPDF từ window
        const { jsPDF } = window.jspdf;
        const doc = new jsPDF({ orientation: "landscape", unit: "pt", format: "A4" });

        const selectedReport = '@ViewBag.ReportTitle';
        const companyName = localStorage.getItem("CompanyName") || "Tên công ty chưa xác định";

        grid.getDataSource().load().then(data => {
            const columns = grid.getVisibleColumns();

            const head = [columns.map(col => col.caption)];
            const body = data.map(row =>
                columns.map(col =>
                    col.calculateCellValue ? col.calculateCellValue(row) : row[col.dataField]
                )
            );

            doc.setFontSize(14);
            doc.setFont("Helvetica", "bold");
            doc.text(companyName, doc.internal.pageSize.getWidth() / 2, 40, { align: "center" });

            doc.setFontSize(12);
            doc.setFont("Helvetica", "normal");
            doc.text(selectedReport, doc.internal.pageSize.getWidth() / 2, 60, { align: "center" });

            // AutoTable
            doc.autoTable({
                startY: 80,
                head: head,
                body: body,
                 styles: { fontSize: 9, cellPadding: 4 , lineWidth: 0.5, lineColor: [0, 0, 0]    },
                headStyles: { fillColor: [41, 128, 185], textColor: 255, fontStyle: 'bold' },
                alternateRowStyles: { fillColor: [240, 240, 240] },
                margin: { left: 20, right: 20 }
            });

            doc.save(selectedReport + ".pdf");
        });
    });
</script>
