@* History > Summary (WinForm: frmProfileSummaryHistory) *@
<div class="modal fade managed-modal" id="pro_search_modalHistorySummary" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">History Summary</h5>
            </div>
            <div class="modal-body d-flex flex-column" style="height: 60vh;">
                <div class="py-2">
                    <button class="mui-button mui-button-new" data-bs-dismiss="modal">Close</button>
                </div>
                <div class="gridContainer mt-2 flex-grow-1 d-flex flex-column position-relative" style="min-height: 0;">
                    <div id="pro_search_gridContainerHistorySummary"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    var pro_search_Module = {
        // --- State ---
        saleInChargeData: [],
        profileID: 0,
        profileType: 0,
        profileName: "",
        gridInstance: null,
        selectedCallback: null,

        // --- Khởi tạo ---
        init: function (callback) {
            this.selectedCallback = callback;
        
            this.initDOMEvents();
            
            this.loadInitialData();
        
            this.initializeDataGrid();
        },

        initDOMEvents: function () {
            const self = this;
        
            $("#pro_search_btnSearch").on("click", () => self.getAllProfiles());
            $("#pro_search_btnClear").on("click", () => self.clearSearchForm());
            $("#pro_search_btnOption").on("click", () => self.openModalOption());
            $("#pro_search_btnExcel").on("click", () => self.exportToExcel());

            // Ctrl+E giống WinForm (chỉ khi đang ở modal Search Profile)
            $("#pro_search_mainModal").on("keydown", function (e) {
                if (e.ctrlKey && !e.shiftKey && !e.altKey && (e.key === "e" || e.key === "E")) {
                    e.preventDefault();
                    self.exportToExcel();
                }
            });
            $("#pro_search_btnHistory").on("click", () => self.getProfileHistory());
            $("#pro_search_btnDelete").on("click", () => self.deleteProfile());
            $("#pro_search_btnChanges").on("click", () => self.openOpChangesModal());
            $("#pro_search_btnFuture").off("click").on("click", () => self.openFutureModal());
            $("#pro_search_btnMembership").off("click").on("click", () => self.openMembershipModal());
            $("#pro_search_btnNegRate").off("click").on("click", () => self.openRateCodeNegotiatedModal());
            $("#pro_search_btnProfileUpdate").off("click").on("click", () => self.openProfileUpdateModal());
            $("#pro_search_btnProfileUpdate").off("click").on("click", () => self.openProfileUpdateModal());
            $("#pro_search_btnMerge").off("click").on("click", () => self.openConfirmMerge());
            $("#pro_search_excel_history").off("click").on("click", () => self.exportToExcelHistory());
            $("#pro_search_btnHistorySummary").off("click").on("click", () => self.openHistorySummary());
            $("#pro_search_btnHistoryResv").off("click").on("click", () => self.openHistoryReservation());
            $("#pro_search_btnHistoryFolio").off("click").on("click", () => self.openHistoryFolio());

            $("#pro_search_txtType").on("change", function () {
                self.getAllProfiles();
                const by = $("#pro_search_txtType").val();
                console.log(" view by: "+ by);
            });

            // Nút New của modal SearchProfile
            $("#pro_search_btnNew").click(function () {
                const type = $("#pro_search_txtType").val();
                const typedName = ($("#pro_search_txtAccount").val() || "").trim();

                switch (type) {
                    case "":  // View by All -> giống WinForm: tạo Individual
                    case "0": // Individual
                        ModalManager.load('/Profile/Individual', 'modalIndividual', function () {
                            waitForFunction("pro_ind_Module", () => {
                                window.pro_ind_Module.init();
                                // Giống WinForm: điền sẵn tên đang gõ ở ô Name
                                if (typedName) {
                                    $("#ind_txtFullName").val(typedName);
                                    window.pro_ind_Module.syncPartsFromFullName?.();
                                }
                            });
                        });
                        break;

                    case "1": // Travel Agent
                    case "2": // Company
                    case "3": // Source
                        if (typeof openModalCompany === 'function') {
                            openModalCompany(parseInt(type));
                        }
                        break;

                    case "4": // Group
                        if (typeof openModalGroup === 'function') {
                            openModalGroup();
                        }
                        break;

                    case "5": // Contact
                        if (typeof openModalContact === 'function') {
                            openModalContact();
                        }
                        break;

                    default:
                        showToast("Warning","Chooise view by profile type (Not view all)",false);
                }
            });

            // Nút edit của modal SearchProfile
            $("#pro_search_btnEdit").click(function () {
                if (!self.profileID || self.profileID <= 0) {
                    showToast("Warning", "Please select a profile to edit", false);
                    return;
                }

                const id = self.profileID;
                const type = String(self.profileType);

                switch (type) {
                    case "0": { // Individual
                        // Gọi lấy profile ngay khi bấm, chạy song song với việc tải/mở modal
                        const profileRequest = $.ajax({
                            url: '/Profile/GetProfileByID/',
                            type: 'GET',
                            data: { id: id }
                        });
                        ModalManager.load('/Profile/Individual', 'modalIndividual', function() {
                            waitForFunction("pro_ind_Module", () => {
                                window.pro_ind_Module.init();
                                if (window.pro_ind_Module.loadProfileByID) {
                                    window.pro_ind_Module.loadProfileByID(id, profileRequest);
                                }
                            });
                        });
                        break;
                    }
                    case "1": // Travel Agent
                    case "2": // Company
                    case "3": // Source
                        ModalManager.load('/Profile/Company', 'modalCompany', function() {
                            waitForFunction("pro_com_Module", () => {
                                window.pro_com_Module.init(parseInt(type));
                                if (window.pro_com_Module.loadProfileByID) {
                                    setTimeout(() => window.pro_com_Module.loadProfileByID(id), 300);
                                }
                            });
                        });
                        break;
                    case "4": // Group
                        ModalManager.load('/Profile/Group', 'modalGroup', function() {
                            waitForFunction("pro_gro_Module", () => {
                                window.pro_gro_Module.init();
                                if (window.pro_gro_Module.loadProfileByID) {
                                    setTimeout(() => window.pro_gro_Module.loadProfileByID(id), 300);
                                }
                            });
                        });
                        break;
                    case "5": // Contact
                        ModalManager.load('/Profile/Contact', 'modalContact', function() {
                            waitForFunction("pro_con_Module", () => {
                                window.pro_con_Module.init();
                                if (window.pro_con_Module.loadProfileByID) {
                                    setTimeout(() => window.pro_con_Module.loadProfileByID(id), 300);
                                }
                            });
                        });
                        break;
                    default:
                        showToast("Warning", "Edit logic for this type is under development", false);
                }
            });

            $('#pro_search_modalHistory').on('hidden.bs.modal', function () {
                var $grid = $("#pro_search_gridContainerHistory");
                if ($grid.data("dxDataGrid")) {
                    $grid.dxDataGrid("instance").option("dataSource", []);
                    $grid.dxDataGrid("instance").endCustomLoading();
                }
            });
        },

        loadInitialData: function() {
            initTomSelect('.tomselect-custom');
            const mapCode = (item) => ({
                value: item.id || item.ID,
                text: (item.code || item.Code) + "-" + (item.name || item.Name),
                data: item
            });
            loadDataToTomSelect("#pro_search_txtCity", "/Profile/GetAllCity", mapCode);


        }, 

        getAllProfiles: function () {
            const grid = this.gridInstance;
            const currentType = $("#pro_search_txtType").val() || "";
            // Chưa có grid, hoặc View By đổi -> dựng lại grid với đúng bộ cột của loại profile
            if (!grid || this.gridType !== currentType) {
                if (grid) {
                    grid.dispose();
                    $("#pro_search_gridContainer").empty(); // dispose không xóa markup cũ
                }
                this.gridInstance = null;
                this.profileID = 0;
                this.profileType = 0;
                this.profileName = "";
                this.initializeDataGrid();
                return;
            }
            // Điều kiện lọc mới: bỏ dòng đang chọn và quay về trang 1
            // (tránh đứng ở trang cũ không còn dữ liệu sau khi lọc / clear)
            grid.clearSelection();
            if (grid.pageIndex() !== 0) {
                grid.pageIndex(0); // tự load lại dữ liệu
            } else {
                grid.refresh();
            }
        },

        initializeDataGrid: function () {
            const self = this;
            var dataSource = new DevExpress.data.CustomStore({
                key: "id",
                load: function (loadOptions) {
                    var d = $.Deferred();
                    var params = {
                        skip: loadOptions.skip || 0,
                        take: loadOptions.take || 20,
                        code: $('#pro_search_txtCode').val(),
                        account: $('#pro_search_txtAccount').val(),
                        firstName: $('#pro_search_txtFirstName').val(),
                        keyWord: $('#pro_search_txtKeyword').val(),
                        city: $('#pro_search_txtCity').val(),
                        type: $('#pro_search_txtType').val(),
                        showSaleInCharge: $("#pro_search_txtShowSaleInCharge").is(":checked")
                    };

                    $.ajax({
                        url: '/Profile/GetAllProfileTest',
                        type: 'GET',
                        loadingGrid: '#pro_search_gridContainer',
                        dataType: 'json',
                        data: params,
                        cache: false,
                        success: function (result) {
                            d.resolve({
                                data: result.data,
                                totalCount: result.totalCount
                            });
                        },
                        error: function () {
                            d.reject("Error loading data from the server.");
                        }
                    });
                    return d.promise();
                }
            });

            var columnWidth = 150;
            var typeValue = $("#pro_search_txtType").val();
            this.gridType = typeValue || ""; // để getAllProfiles biết khi nào cần dựng lại cột

            var taxCodeColumn = {
                dataField: "taxCode",
                caption: "Tax Code",
                width: columnWidth - 30
            };

            // 1. Khởi tạo mảng columns cơ bản
            var columns = [
                { dataField: "id", caption: "ID", width: columnWidth - 80, visible: false },
                { dataField: "code", caption: "Code", width: columnWidth - 50 },
                {
                    dataField: "vip",
                    caption: "Vip",
                    width: columnWidth - 80,
                    visible: typeValue != "1"
                },
                { dataField: "account", caption: "Account", width: columnWidth * 2 },
            ];

            // 2. Thêm Tax Code nếu là Travel Agent (Type 1)
            if (typeValue === "1") {
                columns.push(taxCodeColumn);
            }

            // 3. Ghép các cột thông tin cá nhân/liên lạc
            columns = columns.concat([
                {
                    dataField: "dateOfBirth",
                    caption: "Date Of Birth",
                    width: columnWidth,
                    dataType: "date",
                    format: "dd/MM/yyyy",
                    visible: typeValue != "1",
                    calculateCellValue: function (data) {
                        if (!data.dateOfBirth) return null;
                        // Xử lý format chuỗi dd.MM.yyyy từ server
                        const parts = data.dateOfBirth.split(".");
                        if (parts.length === 3) {
                            return new Date(parts[2], parts[1] - 1, parts[0]);
                        }
                        return data.dateOfBirth;
                    }
                },
                { dataField: "passPort", caption: "PassPort", width: columnWidth, visible: typeValue != "1" },
                { dataField: "identityCard", caption: "Identity Card", width: columnWidth, visible: typeValue != "1" },
                { dataField: "city", caption: "City", width: columnWidth },
                { dataField: "nationality", caption: "Nat", width: columnWidth - 60 },
                { dataField: "address", caption: "Address", width: columnWidth + 50 },
                { dataField: "handPhone", caption: "HandPhone", width: columnWidth },
                { dataField: "telephone", caption: "Telephone", width: columnWidth },
                { dataField: "email", caption: "Email", width: columnWidth },
                { dataField: "website", caption: "Website", width: columnWidth }
            ]);

            // 4. Thêm Tax Code phía sau nếu không phải Type 1
            if (typeValue !== "1") {
                columns.push(taxCodeColumn);
            }

            // 5. Ghép các cột thông tin doanh nghiệp và quản lý
            columns = columns.concat([
                { dataField: "fullAccount", caption: "Company", width: columnWidth },
                { dataField: "homeAddress", caption: "Business Address", width: columnWidth + 30 },
                { dataField: "arNo", caption: "ARNo", width: columnWidth, visible: typeValue == "1" },
                { dataField: "postalCode", caption: "Postal Code", width: columnWidth },
                { dataField: "keyword", caption: "Keyword", width: columnWidth },
                { dataField: "acctContact", caption: "Acct.Contact", width: columnWidth, visible: typeValue == "1" },
                { dataField: "description", caption: "Description", width: columnWidth },
                { dataField: "returnGuest", caption: "Return", width: columnWidth - 60, visible: typeValue != "1" },
                { dataField: "stayNo", caption: "Stay No", width: columnWidth - 60, visible: typeValue != "1" },
                {
                    dataField: "personInChargeID",
                    caption: "Sale In Charge",
                    width: columnWidth,
                    lookup: {
                        dataSource: self.saleInChargeData, // Lấy từ biến của Module
                        valueExpr: "id",
                        displayExpr: function (item) {
                            return item ? item.name : "";
                        }
                    }
                }
            ]);

            // 6. Khởi tạo Grid Instance vào thẻ HTML có prefix
            this.gridInstance = $("#pro_search_gridContainer").dxDataGrid({
                dataSource: dataSource,
                remoteOperations: {
                    paging: true,
                    filtering: false,
                    sorting: false
                },
                columns: columns,
                height: "100%",
                allowColumnResizing: true,
                columnResizingMode: "widget",
                hoverStateEnabled: true,
                paging: { pageSize: 20 },
                pager: {
                    visible: true,
                    showPageSizeSelector: true,
                    allowedPageSizes: [20, 50, 100],
                    showInfo: true,
                    showNavigationButtons: true
                },
                scrolling: {
                    mode: "standard",
                    showScrollbar: "always"
                },
                loadPanel: {
                    enabled: false
                },
                selection: {
                    mode: "multiple",
                    showCheckBoxesMode: "none",
                    selectByClick: true,
                    allowSelectAll: false
                },
                onSelectionChanged: function (e) {
                    const selectedRows = e.selectedRowsData;
                    if (selectedRows.length > 0) {
                        const lastSelected = selectedRows[selectedRows.length - 1];
                        self.profileID = lastSelected.id || lastSelected.ID;
                        self.profileType = lastSelected.type !== undefined ? lastSelected.type : lastSelected.Type;
                        self.profileName = lastSelected.account || lastSelected.Account;
                        console.log("Selected Profile:", self.profileID, "Type:", self.profileType);
                    } else {
                        self.profileID = 0;
                        self.profileType = 0;
                        self.profileName = "";
                    }
                },
                onRowDblClick: function(e) {
                    if (self.selectedCallback && typeof self.selectedCallback === "function") {
                        self.selectedCallback(e.data);
                        const modalEl = document.getElementById('pro_search_mainModal');
                        const modal = bootstrap.Modal.getInstance(modalEl);
                        if (modal) modal.hide();
                    }
                },
            }).dxDataGrid("instance");
        },

        // Bộ lọc dùng chung cho grid và export
        getSearchParams: function () {
            return {
                code: $('#pro_search_txtCode').val() || "",
                account: $('#pro_search_txtAccount').val() || "",
                firstName: $('#pro_search_txtFirstName').val() || "",
                keyWord: $('#pro_search_txtKeyword').val() || "",
                city: $('#pro_search_txtCity').val() || "",
                type: $('#pro_search_txtType').val() || "",
                showSaleInCharge: $("#pro_search_txtShowSaleInCharge").is(":checked")
            };
        },

        // Xuất toàn bộ kết quả theo bộ lọc hiện tại (server tạo file .xlsx)
        exportToExcel: function () {
            const self = this;
            if (self._exporting) return;

            const total = self.gridInstance ? self.gridInstance.totalCount() : -1;
            if (total === 0) {
                showToast("Warning", "No data to export!", false);
                return;
            }

            const $btn = $("#pro_search_btnExcel");
            const oldText = $btn.text();
            self._exporting = true;
            $btn.prop("disabled", true).text("Exporting...");
            if (total > 50000) {
                showToast("Info", `Exporting ${total.toLocaleString()} profiles, please wait...`, true);
            }

            const query = $.param(self.getSearchParams());
            fetch(`/Profile/ExportProfileSearchExcel?${query}`)
                .then(async (res) => {
                    if (!res.ok) throw new Error(await res.text() || `HTTP ${res.status}`);
                    const blob = await res.blob();
                    const disposition = res.headers.get("Content-Disposition") || "";
                    const match = /filename="?([^";]+)"?/i.exec(disposition);
                    saveAs(blob, match ? match[1] : "ProfileSearch.xlsx");
                })
                .catch((err) => showToast("Error", err.message || "Export failed", false))
                .finally(() => {
                    self._exporting = false;
                    $btn.prop("disabled", false).text(oldText);
                });
        },

