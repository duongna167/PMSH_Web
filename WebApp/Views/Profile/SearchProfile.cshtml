        <div class="modal-content modal-full-height">
            <div class="modal-header">
                <h5 class="modal-title">History</h5>
            </div>
            <div class="modal-body  d-flex flex-column" style="height: calc(100vh - 120px);">
                <div class="py-2">
                    @* <button class="mui-button mui-button-new">Attach</button> *@
                    @* <button class="mui-button mui-button-new">Detach</button> *@
                    @* Thứ tự nút theo WinForm frmProfileHistoryStayInfo: Summary, Resv., View Folio, Excel, Close *@
                    <button class="mui-button mui-button-new" id="pro_search_btnHistorySummary">Summary</button>
                    <button class="mui-button mui-button-new" id="pro_search_btnHistoryResv">Resv.</button>
                    <button class="mui-button mui-button-new" id="pro_search_btnHistoryFolio">View Folio</button>
