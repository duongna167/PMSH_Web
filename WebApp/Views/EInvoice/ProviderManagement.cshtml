                        </div></div>
                        <div class="col-12 col-lg-6"><div class="row g-1 align-items-center">
                            <label class="col-md-4 col-form-label col-form-label-sm text-md-end">Authentication Operation</label>
                            <div class="col-md-8"><select name="authenticationOperationID" data-int="1" class="form-select form-select-sm"></select><div class="invalid-feedback"></div></div>
                        </div></div>

                        <div class="col-12 col-lg-4"><div class="row g-1 align-items-center">
