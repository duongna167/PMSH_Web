@using BaseBusiness.Model
@{
    var fromName = ViewBag.FromName as string ?? "";
    var departments = ViewBag.Departments as IEnumerable<DepartmentModel>;
}
<style>
    #foim_modal .search-filter {
        margin-bottom: 14px;
    }
    #foim_modal .foim-field {
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: 6px;
        margin-bottom: 12px;
    }
    #foim_modal .foim-field label {
        margin: 0;
        white-space: nowrap;
        min-width: 120px;
        font-size: 14px;
    }
    #foim_modal textarea {
        min-height: 140px;
        font-size: 14px;
        border-radius: 4px;
        flex: 1;
    }
    #foim_modal .foim-field [data-date-input] {
        width: 160px;
        min-width: 128px;
        max-width: 220px;
        position: relative;
        overflow: visible;
    }
    #foim_modal .foim-field [data-date-input] .date-ui {
        width: 100%;
        height: 28px;
        font-size: 14px;
        box-sizing: border-box;
        padding: 2px 1.85rem 2px 8px;
        border-radius: 4px;
        border: 1px solid #ced4da;
    }
    #foim_modal #foim_from {
        width: 160px;
        min-width: 128px;
        max-width: 220px;
        height: 28px;
        font-size: 14px;
        padding: 2px 8px;
        border-radius: 4px;
        border: 1px solid #ced4da;
        background: #f5f5f5;
    }
    #foim_modal .foim-toDept {
        flex: 0 0 260px;
        width: 260px;
        min-width: 220px;
        max-width: 280px;
        position: relative;
        z-index: 5;
        overflow: visible;
    }
    #foim_modal .foim-toDept .ts-wrapper {
        overflow: visible !important;
        width: 100% !important;
    }
    #foim_modal .foim-toDept .ts-control {
        min-height: 28px !important;
        max-height: 28px !important;
        flex-wrap: nowrap !important;
        overflow: hidden !important;
    }
    #foim_modal .foim-toDept .ts-control .item {
        flex: 1 1 0 !important;
        min-width: 0 !important;
        max-width: none !important;
        width: auto !important;
        padding: 0 2px 0 4px !important;
        margin-right: 2px !important;
    }
    #foim_modal .foim-toDept .ts-control .item > div,
    #foim_modal .foim-toDept .ts-control .item .ts-item-text,
    #foim_modal .foim-toDept .ts-control .item > span {
        min-width: 0 !important;
        max-width: 100% !important;
        overflow: hidden !important;
        text-overflow: ellipsis !important;
        white-space: nowrap !important;
        display: block !important;
    }
    #foim_modal .foim-toDept .ts-control .item .remove {
        opacity: 1 !important;
        visibility: visible !important;
        margin-left: 2px !important;
        flex-shrink: 0 !important;
    }
    #foim_modal .foim-toDept .ts-wrapper.has-items .ts-control input {
        flex: 0 0 8px !important;
        width: 8px !important;
        min-width: 8px !important;
        max-width: 8px !important;
    }
    body > .ts-dropdown.foim-ts-dropdown {
        position: fixed !important;
        min-width: 0 !important;
        width: var(--foim-dd-w, 260px) !important;
        max-width: var(--foim-dd-w, 260px) !important;
        left: var(--foim-dd-x, 0px) !important;
        top: var(--foim-dd-y, 0px) !important;
        right: auto !important;
        z-index: 5000 !important;
    }
</style>
<div class="modal fade" id="foim_modal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false" data-bs-focus="false">
    <div class="modal-dialog modal-md-4by3 modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Create Message</h5>
            </div>
            <div class="modal-body">
                <div class="search-filter">
                    <div>
                        <button type="button" id="foim_btnSave" class="mui-button mui-button-edit">OK</button>
                        <button type="button" id="foim_btnClose" class="mui-button mui-button-new">Close</button>
                    </div>
                </div>
                <div class="foim-field">
                    <label>From Department</label>
                    <input id="foim_from" type="text" class="form-control form-control-sm" value="@fromName" readonly />
                </div>
                <div class="foim-field">
                    <label>To Department</label>
                    <div class="foim-toDept">
                        <select id="foim_toDept" class="tomselect-custom" multiple>
                            <option value="0">All</option>
                            @if (departments != null)
                            {
                                foreach (var d in departments)
                                {
                                    <option value="@d.ID">@d.Name</option>
                                }
                            }
                        </select>
                    </div>
                </div>
                <div class="foim-field">
                    <label>From Date</label>
                    <div data-date-input business-date data-format="DD/MM/YYYY" data-name="foim_fromDate">
                        <input type="text" class="date-ui form-control form-control-sm" placeholder="dd/mm/yyyy" autocomplete="off" />
                    </div>
                </div>
                <div class="foim-field">
                    <label>To Date</label>
                    <div data-date-input business-date data-format="DD/MM/YYYY" data-name="foim_toDate">
                        <input type="text" class="date-ui form-control form-control-sm" placeholder="dd/mm/yyyy" autocomplete="off" />
                    </div>
                </div>
                <div class="foim-field" style="align-items:flex-start;">
                    <label>Message</label>
                    <textarea id="foim_text" class="form-control" rows="6"></textarea>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    function foim_pinToDeptDropdown(ts) {
        if (!ts || !ts.control) return;
        var box = ts.control.getBoundingClientRect();
        var root = document.documentElement;
        root.style.setProperty("--foim-dd-w", Math.round(box.width) + "px");
        root.style.setProperty("--foim-dd-x", Math.round(box.left) + "px");
        root.style.setProperty("--foim-dd-y", Math.round(box.bottom + 1) + "px");
        if (ts.dropdown) ts.dropdown.classList.add("foim-ts-dropdown");
    }

    function foim_initToDept() {
        var el = document.getElementById("foim_toDept");
        if (!el) return;
        if (el.tomselect) {
            try { el.tomselect.destroy(); } catch (e) { }
        }
        if (typeof initTomSelect === "function") {
            initTomSelect("#foim_toDept", {
                placeholder: "Select...",
                dropdownParent: "body",
                hidePlaceholder: false
            });
        }
        var ts = el.tomselect;
        if (!ts) return;
        ts.on("item_add", function (value) {
            if (value === "0") {
                var others = (ts.getValue() || []).filter(function (v) { return v !== "0"; });
                others.forEach(function (v) { ts.removeItem(v, true); });
            } else if ((ts.getValue() || []).indexOf("0") >= 0) {
                ts.removeItem("0", true);
            }
        });
        if (ts.dropdown) ts.dropdown.classList.add("foim-ts-dropdown");
        ts.on("dropdown_open", function () {
            foim_pinToDeptDropdown(ts);
            requestAnimationFrame(function () { foim_pinToDeptDropdown(ts); });
        });
        ts.clear(true);
    }

    window.openModalCreateMessage = function () {
        if (typeof window.initDateInputs === "function") window.initDateInputs(document.getElementById("foim_modal"));
        $("#foim_text").val("");
        foim_initToDept();
    };
    $(document).off("click.foim", "#foim_btnClose").on("click.foim", "#foim_btnClose", function () {
        $("#foim_modal").modal("hide");
    });
    $(document).off("click.foim", "#foim_btnSave").on("click.foim", "#foim_btnSave", function () {
        var raw = $("#foim_toDept").val();
        var toDept = Array.isArray(raw) ? raw.join(",") : (raw || "");
        $.ajax({
            url: "/Notification/SaveMessage",
            type: "POST",
            data: {
                message: $("#foim_text").val(),
                fromDate: $("#foim_fromDate").val(),
                toDate: $("#foim_toDate").val(),
                toDepartmentIds: toDept
            },
            success: function (res) {
                if (res && res.code === 0) {
                    if (window.showToast) showToast("Success", res.msg, true);
                    $("#foim_modal").modal("hide");
                    if (typeof loadNotificationCount === "function") loadNotificationCount();
                } else {
                    if (window.showToast) showToast("Error", (res && res.msg) || "Save failed.", false);
                }
            },
            error: function (xhr) {
                if (window.showToast) showToast("Error", xhr.responseText || "Save failed.", false);
            }
        });
    });
</script>
