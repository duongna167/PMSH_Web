@{
    ViewBag.Title = ViewBag.ReportHeader;
    var mkList = ViewBag.MarketList as IEnumerable<dynamic>;
}
<style>
    .gridContainer { margin: 0px 8px; }
    .sticky-header label, .sticky-header .form-control-sm { font-size: 14px; line-height: 1.2; }
    .sticky-header .form-control-sm { padding: 2px 8px; height: 28px; }
    .sticky-header label { margin-bottom: 0; white-space: nowrap; }
    .bbh-my { display: flex; align-items: center; gap: 4px; }
    .bbh-my select { width: 72px; min-width: 64px; }
    .bbh-my #bbhYear { width: 88px; }
    .nrp-grid {
        display: grid;
        grid-template-columns: max-content max-content max-content max-content 160px max-content 220px;
        column-gap: 6px;
        row-gap: 8px;
        align-items: center;
        width: max-content;
        max-width: 100%;
    }
    .nrp-grid > label { margin: 0; white-space: nowrap; }
    .nrp-grid .pair-gap { margin-left: 10px; }
    .nrp-grid > select, .nrp-grid > input { width: 160px; min-width: 128px; max-width: 220px; }
    .nrp-grid #holder { width: 220px; max-width: 220px; }
    .nrp-grid .bbh-my select { width: 72px; min-width: 64px; max-width: 88px; }
    .nrp-grid .bbh-my #bbhYear { width: 88px; max-width: 88px; }
    #gridContainer .dx-datagrid-rowsview .dx-selection { background-color: #01579b !important; color: white !important; }
    #gridContainer .dx-datagrid-rowsview .dx-selection * { color: white !important; }
</style>
<div class="text-center" id="reportTitle" style="font-size: 20px"></div>
<div class="sticky-header bg-white p-2 shadow-sm z-3">
    <div class="">
        <button id="btnPrint" class="mui-button mui-button-new">View</button>
        <button id="btnExportExcel" class="mui-button mui-button-new" type="button">Excel</button>
        <button id="btnExportPdf" class="mui-button mui-button-new" type="button">PDF</button>
    </div>
    <div class="mb-1" style="border: 1px solid #ced4da; border-radius: 6px; padding: 8px;">
        <div class="nrp-grid">
            <label class="fw-bold">Filter</label>
            <label>Month/Year:</label>
            <div class="bbh-my">
                <select id="bbhMonth" class="form-control form-control-sm"></select>
                <span>/</span>
                <select id="bbhYear" class="form-control form-control-sm"></select>
            </div>
            <label class="pair-gap">Market:</label>
            <select id="market" class="form-control form-control-sm" data-pmsh-select-down>
                <option value="">--All--</option>
                @if (mkList != null)
                {
                    foreach (var item in mkList)
                    {
                        string marketLabel = item.Name;
                        if (string.IsNullOrWhiteSpace(marketLabel)) marketLabel = item.Description;
                        if (string.IsNullOrWhiteSpace(marketLabel)) marketLabel = item.Code;
                        if (string.IsNullOrWhiteSpace(marketLabel)) { continue; }
                        <option value="@item.ID">@marketLabel</option>
                    }
                }
            </select>
            <label class="pair-gap">Holder:</label>
            <select id="holder" class="form-control form-control-sm" data-pmsh-select-down>
                <option value="">--All--</option>
            </select>
        </div>
    </div>
</div>
<div class="mui-card">
    <div id="gridWrapper" class="mt-2" style="max-height: 500px;">
        <div class="gridContainer mt-2" id="gridContainer"></div>
    </div>
</div>
<div id="loadingSpinner" style="display:none; position:fixed; top:50%; left:50%; transform:translate(-50%, -50%); z-index:1000;">
    <i class="fa-solid fa-spinner fa-spin"></i>
</div>
<script>
    function businessMonthYear() {
        var m = "", y = "";
        try {
            var raw = JSON.parse(localStorage.getItem("businessDate") || "null");
            var d = String(raw || "").split(" ")[0];
            var p = d.split(/[\/\-]/);
            if (p.length >= 3) {
                if (p[0].length === 4) { y = p[0]; m = p[1]; }
                else { y = p[2]; m = p[1]; }
            }
        } catch (e) { }
        var now = new Date();
        if (!/^\d{4}$/.test(y)) y = String(now.getFullYear());
        m = String(parseInt(m, 10) || (now.getMonth() + 1)).padStart(2, "0");
        return { m: m, y: y };
    }
    function fillMonthYear() {
        var cur = businessMonthYear();
        var y0 = parseInt(cur.y, 10);
        var $m = $("#bbhMonth").empty();
        var $y = $("#bbhYear").empty();
        for (var i = 1; i <= 12; i++) {
            var v = String(i).padStart(2, "0");
            $m.append($("<option/>").val(v).text(v));
        }
        for (var yy = y0 - 5; yy <= y0 + 1; yy++) $y.append($("<option/>").val(String(yy)).text(String(yy)));
        $m.val(cur.m);
        $y.val(cur.y);
    }
    function fillHolders() {
        $.get("/Report/ReportHolderLookup", function (list) {
            if (!Array.isArray(list)) return;
            var $h = $("#holder");
            list.forEach(function (r) {
                var id = r.ID ?? r.id;
                var acc = r.Account ?? r.account;
                if (!id || !acc) return;
                $h.append($("<option/>").val(id).text(acc));
            });
        });
    }
    $(document).ready(function () {
        document.getElementById("reportTitle").innerText = '@ViewBag.ReportTitle';
        fillMonthYear();
        fillHolders();
    });
    function pick(row, names) {
        for (var i = 0; i < names.length; i++) {
            if (row[names[i]] !== undefined && row[names[i]] !== null && row[names[i]] !== "") return row[names[i]];
        }
        return "";
    }
    function bindGrid(data) {
        var src = Array.isArray(data) ? data : [];
        var days = new Date(parseInt($("#bbhYear").val(), 10), parseInt($("#bbhMonth").val(), 10), 0).getDate();
        var rows = src.map(function (r) {
            var o = { RoomType: pick(r, ["RoomType", "roomType"]), Total: pick(r, ["Total", "total"]) || 0 };
            for (var d = 1; d <= days; d++) o[String(d)] = pick(r, [String(d)]) || 0;
            return o;
        });
        var columns = [{ dataField: "RoomType", caption: "Room Type", minWidth: 110, fixed: true }];
        for (var d = 1; d <= days; d++) {
            var key = String(d);
            columns.push({ dataField: key, caption: key, width: 46, dataType: "number", format: "#,##0" });
        }
        columns.push({ dataField: "Total", caption: "Total", width: 70, dataType: "number", format: "#,##0" });
        $("#gridContainer").dxDataGrid({
            dataSource: rows, height: 500, allowColumnResizing: true, columns: columns,
            paging: { pageSize: 25 },
            scrolling: { mode: "standard", useNative: false, showScrollbar: "always" },
            pager: { visible: true, allowedPageSizes: [25, 50, "all"], showPageSizeSelector: true, showInfo: true, showNavigationButtons: true },
            filterRow: { visible: true, applyFilter: "auto" },
            headerFilter: { visible: true },
            showBorders: true
        });
    }
    $(document).off("click", "#btnPrint").on("click", "#btnPrint", function () {
        $("#loadingSpinner").show();
        $.ajax({
            url: "/Report/BookingbyHolderData", type: "GET",
            data: { date: $("#bbhYear").val() + "-" + $("#bbhMonth").val() + "-01", holder: $("#holder").val(), market: $("#market").val() },
            success: function (result) {
                if (typeof result === "string") { alert(result); $("#loadingSpinner").hide(); return; }
                bindGrid(result);
                $("#loadingSpinner").hide();
            },
            error: function () { alert("Không thể tải báo cáo."); $("#loadingSpinner").hide(); }
        });
    });
    $(document).off("click", "#btnExportExcel").on("click", "#btnExportExcel", function () {
        const grid = $("#gridContainer").dxDataGrid("instance"); if (!grid) return;
        const workbook = new ExcelJS.Workbook(); const worksheet = workbook.addWorksheet("Report");
        const selectedReport = '@ViewBag.ReportTitle';
        worksheet.addRow([localStorage.getItem("CompanyName") || ""]);
        DevExpress.excelExporter.exportDataGrid({ component: grid, worksheet: worksheet, autoFilterEnabled: true, topLeftCell: { row: 3, column: 1 } })
            .then(function () { workbook.xlsx.writeBuffer().then(function (buffer) { saveAs(new Blob([buffer], { type: "application/octet-stream" }), selectedReport + ".xlsx"); }); });
    });
    $(document).off("click", "#btnExportPdf").on("click", "#btnExportPdf", function () {
        const grid = $("#gridContainer").dxDataGrid("instance"); if (!grid) return;
        const { jsPDF } = window.jspdf; const doc = new jsPDF({ orientation: "landscape", unit: "pt", format: "A4" });
        const selectedReport = '@ViewBag.ReportTitle';
        grid.getDataSource().load().then(data => {
            const columns = grid.getVisibleColumns().filter(c => c.dataField);
            doc.text(selectedReport, doc.internal.pageSize.getWidth() / 2, 40, { align: "center" });
            doc.autoTable({ startY: 56, head: [columns.map(c => c.caption)], body: data.map(row => columns.map(c => row[c.dataField] ?? "")), styles: { fontSize: 7 } });
            doc.save(selectedReport + ".pdf");
        });
    });
</script>
